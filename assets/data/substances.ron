            description: Some("p-Menthane is a hydrocarbon with the formula (CH3)2CHC6H10CH3.  It is the product of the hydrogenation or hydrogenolysis of various terpenoids, including p-cymene, terpinolenes, phellandrene, and limonene.  It is a colorless liquid with a fragrant fennel-like odor.  It occurs naturally, especially in exudates of Eucalyptus fruits.  The compound is generally encountered as a mixture of the cis and trans isomers, which have very similar properties"),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["All Other Basic Organic Chemical Manufacturing", "Odor agents"],
            logp: Some(3.469),
            appearance: Some("Colorless liquid"),
            synonyms: ["1-methyl-4-isopropylcyclohexane", "RefChem:1055810", "p-Menthane", "99-82-1", "6069-98-3", "cis-1-isopropyl-4-methylcyclohexane", "1678-82-6", "trans-1-isopropyl-4-methylcyclohexane"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=55241687"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C99821&Units=SI")],
            element_info: None,
