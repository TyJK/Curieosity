    7370: (
            id: 7370,
            name: "Cycloserine",
            formula: "C3H6N2O2",
            state: Solid,
            molar_mass_g_mol: 102.0429,
            color_hex: None,
            melting_point_c: Some(155.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(1.0378),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Cycloserine, sold under the brand name Seromycin, is a GABA transaminase inhibitor and an antibiotic, used to treat tuberculosis. Specifically it is used, along with other antituberculosis medications, for active drug resistant tuberculosis. It is given by mouth.
Common side effects include allergic reactions, seizures, sleepiness, unsteadiness, and numbness. It is not recommended in people who have kidney failure, epilepsy, depression, or are alcoholics. It is unclear if use during pregnancy is safe for the baby. Cycloserine is similar in structure to the amino acid D-alanine and works by interfering with the formation of the bacteria's cell wall.
Cycloserine was discovered in 1954 from a type of Streptomyces. It is on the World Health Organization's List of Essential Medicines."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-0.9),
            appearance: None,
            synonyms: ["D-cycloserine", "68-41-7", "Seromycin", "orientomycin", "Oxamycin", "Cyclo-D-serine", "Cicloserina", "Cyclorin"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=4423825"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C68417&Units=SI")],
            element_info: None,
        ),
    7371: (
            id: 7371,
            name: "Hydroxyzine",
            formula: "C21H27ClN2O2",
            state: Solid,
            molar_mass_g_mol: 374.1761,
            color_hex: None,
            melting_point_c: Some(193.0),
            boiling_point_c: None,
