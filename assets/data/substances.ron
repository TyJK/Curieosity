    8886: (
            id: 8886,
            name: "Eugenol",
            formula: "C10H12O2",
            state: Liquid,
            molar_mass_g_mol: 164.2,
            color_hex: None,
            melting_point_c: Some(-7.55),
            boiling_point_c: Some(253.85),
            density_g_cm3: Some(1.06),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6602),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Eugenol  is an allyl chain-substituted guaiacol, a member of the allylbenzene class of chemical compounds. It is a colorless to pale yellow, aromatic oily liquid extracted from certain essential oils especially from clove, nutmeg, cinnamon, basil and bay leaf. It is present in concentrations of 80–90% in clove bud oil and at 82–88% in clove leaf oil. Containing eugenol, clove essential oil is obtained from unopened clove buds. Eugenol has a pleasant, spicy, clove-like scent. The name is derived from Eugenia caryophyllata, the former Linnean nomenclature term for cloves. The currently accepted name is Syzygium aromaticum."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H302 (17.3%): Harmful if swallowed [Warning Acute toxicity, oral]"),
            uses: ["Fragrance", "Odor agents", "All Other Basic Organic Chemical Manufacturing", "Calculated removal (%): 76.5"],
            logp: Some(2.129),
            appearance: Some("Eugenol appears as clear colorless pale yellow or amber-colored liquid. Odor of cloves. Spicy pungent taste. (NTP, 1992)"),
            synonyms: ["Engenol", "p-Eugenol", "Eugenic acid", "1,3,4-Eugenol", "Allylguaiacol", "4-Allylguaiacol", "p-Allylguaiacol", "Caryophyllic acid"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1362656"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/3314"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_4917"), ("Wikidata", "http://www.wikidata.org/entity/Q423357"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C97530&Units=SI")],
            element_info: None,
