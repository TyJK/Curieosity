            appearance: None,
            synonyms: ["AlPC", "aluminium chloride", "aluminum trichloride", "aluminum phthalocyanine", "aluminum chloride anhydrous", "trichloroalumane", "Aluminium trichloride", "Trichloroaluminum"],
