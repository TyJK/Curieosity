            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Carbon disulfide (also spelled as carbon disulphide) is an inorganic compound with the chemical formula CS2 and structure S=C=S. It is also considered as the anhydride of thiocarbonic acid. It is a colorless, flammable, neurotoxic liquid that is used as a building block in organic synthesis. Pure carbon disulfide has a pleasant, ether- or chloroform-like odor, but commercial samples are usually yellowish and are typically contaminated with foul-smelling impurities."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225: Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Fuels and fuel additives", "Abrasives", "All Other Basic Organic Chemical Manufacturing"],
            logp: Some(1.018),
            appearance: Some("Carbon disulfide appears as a clear colorless to light yellow volatile liquid with a strong disagreeable odor. Flammable over a wide vapor/air concentration range (1%-50%). Vapors are readily ignited; the heat of a common light bulb may suffice. Insoluble in water and more dense than water. Hence sinks in water. Vapors are heavier than air. Used in the manufacture of rayon and cellophane, in the manufacture of flotation agents and as a solvent."),
            synonyms: ["CS2", "disulfidocarbon", "methanedithione", "carbon bisulfide", "carbon bisulphide", "carbon disulphide", "dithiocarbonic anhydride", "75-15-0"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=241809"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6348"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_23012"), ("Wikidata", "http://www.wikidata.org/entity/Q243354"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C75150&Units=SI")],
            element_info: None,
        ),
