    5068: (
            id: 5068,
            name: "Imidazole",
            formula: "C3H4N2",
            state: Solid,
            molar_mass_g_mol: 68.08,
            color_hex: None,
            melting_point_c: Some(89.85),
            boiling_point_c: Some(255.85),
            density_g_cm3: Some(1.23),
            heat_capacity_solid_j_g_c: Some(1.0649),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Imidazole (ImH) is an organic compound with the formula (CH)3(NH)N. It is a white or colourless solid that is soluble in water, producing a mildly alkaline solution. It can be classified as a heterocycle, specifically as a diazole.
Many natural products, especially alkaloids, contain the imidazole ring. These imidazoles share the 1,3-C3N2 ring but feature varied substituents. This ring system is present in important biological building blocks, such as histidine and the related hormone histamine. Many drugs contain an imidazole ring, such as certain antifungal drugs, the nitroimidazole series of antibiotics, and the sedative midazolam.
When fused to a pyrimidine ring, it forms a purine, which is the most widely occurring nitrogen-containing heterocycle in nature.
The name \"imidazole\" was coined in 1887 by the German chemist Arthur Rudolf Hantzsch (1857–1935)."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H314: Causes severe skin burns and eye damage [Danger Skin corrosion/irritation]"),
            uses: ["All Other Basic Organic Chemical Manufacturing", "Intermediates"],
            logp: Some(0.41),
            appearance: Some("Liquid, Other Solid"),
            synonyms: ["Him", "IMD", "miazole", "glyoxalin", "iminazole", "1H-imidazole", "pyrro(b)monazole", "pyrro[b]monazole"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1117286"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/795"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_14434"), ("Wikidata", "http://www.wikidata.org/entity/Q328692"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C288324&Units=SI")],
            element_info: None,
        ),
