            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("1,2-Dichloroethylene (1,2-DCE) is a pair of organochlorine compounds with the molecular formula C2H2Cl2.  The two compounds are isomers, each being colorless liquids with a sweet odor.  It can exist as either of two geometric isomers, cis-1,2-dichloroethene or trans-1,2-dichloroethene, but is often used as a mixture of the two.  They have modest solubility in water.  These compounds have some applications as a degreasing solvent. In contrast to most cis-trans compounds, the Z isomer (cis) is more stable than the E isomer (trans) by 0.4 kcal/mol."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225: Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["All Other Basic Organic Chemical Manufacturing", "Cleaning agent"],
            logp: Some(1.935),
            appearance: Some("1,2-dichloroethylene, (mixed isomers) appears as a clear colorless liquid with ether-like odor. Mixture of cis and trans isomers. Flashpoint 36 - 43 °F. Denser than water and insoluble in water. Vapors heavier than air."),
            synonyms: ["(E)-1,2-dichloroethene", "trans-dichloroethylene", "(E)-1,2-dichloroethylene", "trans-1,2-Dichloroethene", "1,2-trans-dichloroethylene", "trans-1,2-dichloroethylene", "trans-Acetylene dichloride", "156-60-5"],
