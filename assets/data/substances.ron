    3919: (
            id: 3919,
            name: "Ivabradine",
            formula: "C27H36N2O5",
            state: Solid,
            molar_mass_g_mol: 468.2624,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7175),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Ivabradine, sold under the brand name Procoralan among others, is a medication, which is a pacemaker current (If) inhibitor, used for the symptomatic management of heart-related chest pain and heart failure. Patients who qualify for use of ivabradine for congestive heart failure are patients who have symptomatic heart failure, with reduced ejection fraction, and heart rate at least 70 bpm, and the condition not able to be fully managed by beta blockers.
Ivabradine acts by inducing negative chronotropy in the sinoatrial structure, thus reducing the heart rate via specific inhibition of the pacemaker current. It operates by a mechanism different from that of beta blockers and calcium channel blockers, which are two commonly prescribed antianginal classes of cardiac drugs. Ivabradine has no apparent inotropic properties and may be a cardiotonic agent."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.31),
            appearance: None,
            synonyms: ["S-16257", "155974-00-8", "Ivabradina", "S 16257", "3H48L0LPZQ", "DTXSID2048240", "CHEBI:85966", "s16257"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=5157696"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C155974008&Units=SI")],
            element_info: None,
        ),
    3921: (
            id: 3921,
            name: "4-Ethoxyaniline",
            formula: "C8H11NO",
            state: Liquid,
            molar_mass_g_mol: 137.18,
            color_hex: None,
            melting_point_c: Some(2.85),
            boiling_point_c: Some(253.85),
            density_g_cm3: Some(1.07),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.7414),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("p-Phenetidine (4-ethoxyaniline) is a chemical compound with the molecular formula C8H11NO.  It is one of the three isomers of phenetidine.  It is used as an intermediate in the synthesis of pharmaceutical drugs, dyes, and the sweetener dulcin.
p-Phenetidine is a metabolite of the pharmaceutical drugs bucetin and phenacetin and of the preservative ethoxyquin.  It is also used as a chemical intermediate in the manufacture of bucetin, phenacetin, ethoxyquin, and phenacaine.
p-Phenetidine has high renal toxicity and it is believed to be responsible for the adverse effects that led to the withdrawal of phenacetin and bucetin from pharmaceutical use.  p-Phenetidine is also a possible mutagen."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H331: Toxic if inhaled [Danger Acute toxicity, inhalation]"),
            uses: ["Explosives Manufacturing"],
            logp: Some(1.667),
            appearance: Some("P-phenetidine is a colorless to dark red liquid. (NTP, 1992)"),
            synonyms: ["phenetidine", "4-phenetidine", "4-phenitidine", "p-phenetidine", "p-phenitidine", "p-ethoxyaniline", "4-aminophenetole", "p-aminophenetole"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=60303387"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/9076"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_85505"), ("Wikidata", "http://www.wikidata.org/entity/Q27158608"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C156434&Units=SI")],
            element_info: None,
        ),
    3922: (
            id: 3922,
            name: "trans-1,2-Dichloroethylene",
