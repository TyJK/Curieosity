            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Digitoxin is a cardiac glycoside used for the treatment of heart failure and certain kinds of heart arrhythmia. It is a phytosteroid and is similar in structure and effects to digoxin, though the effects are longer-lasting. Unlike digoxin, which is eliminated from the body via the kidneys, it is eliminated via the liver, and so can be used in patients with poor or erratic kidney function. While several controlled trials have shown digoxin to be effective in a proportion of patients treated for heart failure, the evidence base for digitoxin is not as strong, although it is presumed to be similarly effective."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.85),
            appearance: None,
            synonyms: ["71-63-6", "Digitoxoside", "Crystodigin", "Carditoxin", "Cristapurat", "Digitophyllin", "Digitoxinum", "Unidigin"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=334966"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C71636&Units=SI")],
            element_info: None,
        ),
