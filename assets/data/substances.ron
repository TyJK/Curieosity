    7787: (
            id: 7787,
            name: "2,4,6-Tri-tert-butylphenol",
            formula: "C18H30O",
            state: Solid,
            molar_mass_g_mol: 262.4,
            color_hex: None,
            melting_point_c: Some(131.0),
            boiling_point_c: Some(278.0),
            density_g_cm3: Some(0.864),
            heat_capacity_solid_j_g_c: Some(0.5781),
            heat_capacity_liquid_j_g_c: None,
