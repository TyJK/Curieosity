    7116: (
            id: 7116,
            name: "Imipenem",
            formula: "C12H17N3O4S",
            state: Solid,
            molar_mass_g_mol: 299.094,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8506),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid, IsBase],
            description: Some("Imipenem, sold under the brand name Primaxin among others, is a synthetic β-lactam antibiotic belonging to the carbapenems chemical class. developed by Merck scientists Burton Christensen, William Leanza, and Kenneth Wildonger in the mid-1970s. Carbapenems are highly resistant to the β-lactamase enzymes produced by many multiple drug-resistant Gram-negative  bacteria, thus playing a key role in the treatment of infections not readily treated with other antibiotics. It is usually administered through intravenous injection.
Imipenem was patented in 1975 and approved for medical use in 1985. It was developed via a lengthy trial-and-error search for a more stable version of the natural product thienamycin, which is produced by the bacterium Streptomyces cattleya. Thienamycin has antibacterial activity, but is unstable in aqueous solution, thus it is practically of no medicinal use. Imipenem has a broad spectrum of activity against aerobic and anaerobic, Gram-positive and Gram-negative bacteria.
Imipenem is a therapeutic alternative on the World Health Organization's List of Essential Medicines."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-0.176),
            appearance: None,
            synonyms: ["64221-86-9", "Imipemide", "Imipenem anhydrous", "N-Formimidoylthienamycin", "Imipenemum", "N-formimidoyl thienamycin", "MK 0787", "CHEBI:471744"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2938458"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C64221869&Units=SI")],
            element_info: None,
        ),
