            logp: Some(3.987),
            appearance: Some("2,6-di-tert-butylphenol appears as odorless colorless to light yellow solid or liquid. Floats on water. Freezing point is 97 °F. (USCG, 1999)"),
            synonyms: ["2,6-Di-t-butylphenol", "2,6-Bis(t-butyl)phenol", "2,6-di-tert-butylphenol", "2,6-Bis(tert-butyl)phenol", "2,6-(1,1-Dimethylethyl)phenol", "2,6-Bis(1,1-dimethylethyl)phenol", "128-39-2", "Phenol, 2,6-bis(1,1-dimethylethyl)-"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3656926"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/31405"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_131421"), ("Wikidata", "http://www.wikidata.org/entity/Q2218184"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C128392&Units=SI")],
