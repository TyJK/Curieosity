            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Atovaquone, sold under the brand name Mepron, is a naphthoquinone antiprotozoal medication used in the prevention and treatment Pneumocystis jirovecii pneumonia (PCP), and malaria (in combination with proguanil), as well as for treatment of babesiosis (in combination with azithromycin).
Atovaquone is an analogue of ubiquinone (coenzyme Q10) and exerts its pharmaceutical effects by binding to the ubiquinone binding site on the parasitic mitochondrial cytochrome bc1 complex, thus inhibiting a step of protozoal pyrimidine synthesis.
Atovaquone is a hydroxy-1,4-naphthoquinone, an analog of both ubiquinone and lawsone."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(5.8),
