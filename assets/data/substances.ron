            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Saxagliptin, sold under the brand name Onglyza, is an oral hypoglycemic (anti-diabetic drug) of the dipeptidyl peptidase-4 (DPP-4) inhibitor class. Early development was solely by Bristol-Myers Squibb; in 2007 AstraZeneca joined with Bristol-Myers Squibb to co-develop the final compound and collaborate on the marketing of the drug.
In April 2016, the U.S. FDA added a warning about increased risk of heart failure. This was based on data in an article that concluded \"DPP-4 inhibition with saxagliptin did not increase or decrease the rate of ischemic events, though the rate of hospitalization for heart failure was increased. Although saxagliptin improves glycemic control, other approaches are necessary to reduce cardiovascular risk in patients with diabetes.\""),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.158),
            appearance: None,
            synonyms: ["BMS-477118", "361442-04-8", "Saxagliptin anhydrous", "BMS 477118", "Saxagliptine", "8I7IO46IVQ", "DTXSID7048580", "DTXCID3028506"],
