    7013: (
            id: 7013,
            name: "Sulfanilamide",
            formula: "C6H8N2O2S",
            state: Solid,
            molar_mass_g_mol: 172.0306,
            color_hex: None,
            melting_point_c: Some(165.0),
            boiling_point_c: None,
            density_g_cm3: Some(1.08),
            heat_capacity_solid_j_g_c: Some(0.8778),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Sulfanilamide (also spelled sulphanilamide) is a sulfonamide antibacterial drug. Chemically, it is an organic compound consisting of an aniline derivatized with a sulfonamide group.  Powdered sulfanilamide was used by the Allies in World War II to reduce infection rates and contributed to a dramatic reduction in mortality rates compared to previous wars.  Sulfanilamide is rarely if ever used systemically due to toxicity and because more effective sulfonamides are available for this purpose. Modern antibiotics have supplanted sulfanilamide on the battlefield; however, sulfanilamide remains in use today in the form of topical preparations, primarily for treatment of vaginal yeast infections such as vulvovaginitis caused by Candida albicans.
The term \"sulfanilamides\" is also sometimes used to describe a family of molecules containing these functional groups. Examples include: 

Furosemide, a loop diuretic
Sulfadiazine, an antibiotic
Sulfamethoxazole, an antibiotic"),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-0.62),
            appearance: Some("powder"),
            synonyms: ["4-Aminobenzenesulfonamide", "63-74-1", "Sulphanilamide", "Sulfamine", "p-Aminobenzenesulfonamide", "Sulfonamide", "Sulphonamide", "Prontylin"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=5642037"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C63741&Units=SI")],
            element_info: None,
        ),
