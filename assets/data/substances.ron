    3376: (
            id: 3376,
            name: "Tricresyl phosphate",
            formula: "C21H21O4P",
            state: Solid,
            molar_mass_g_mol: 368.4,
            color_hex: None,
            melting_point_c: Some(-40.15),
            boiling_point_c: Some(254.85),
            density_g_cm3: Some(1.247),
            heat_capacity_solid_j_g_c: Some(0.6713),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Tricresyl phosphate (TCP), is a mixture of three isomeric organophosphate compounds most notably used as a flame retardant. Other uses include as a plasticizer in manufacturing for lacquers and varnishes and vinyl plastics and as an antiwear additive in lubricants. Pure tricresyl phosphate is a colourless, viscous liquid, although commercial samples are typically yellow. It is virtually insoluble in water, but easily soluble in organic solvents like toluene, hexane, and diethyl ether among others. It was synthesized by Alexander Williamson in 1854 upon reacting phosphorus pentachloride with cresol (a mixture of para-, ortho-, and meta- isomers of methylphenol), though today's manufacturers can prepare TCP by mixing cresol with phosphorus oxychloride or phosphoric acid as well. TCP, especially the all-ortho isomer, is the causative agent in a number of acute poisonings. Its chronic toxicity is also of concern. The ortho-isomer is rarely used on its own outside of laboratory studies that require isomeric purity, due to its extremely toxic nature, and is generally excluded from commercial products where TCP is involved."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H360F: May damage fertility [Danger Reproductive toxicity]"),
            uses: ["Flame retardant", "Lubricants and lubricant additives", "Lubricating agent", "Adhesive Manufacturing", "As lead scavenger in gasoline"],
            logp: Some(6.257),
            appearance: Some("Tri-p-tolyl phosphate is a crystalline solid. (NTP, 1992)"),
            synonyms: ["phosphate", "phosphates", "tris(4-methylphenyl) phosphate", "phosphoric acid tris-p-tolyl ester", "phosphoric acid tris(4-methylphenyl) ester", "CAS Registry Number: 1330-78-5"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=8700475"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6529"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_26020"), ("Wikidata", "http://www.wikidata.org/entity/Q26840796"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1330785&Units=SI")],
            element_info: None,
        ),
