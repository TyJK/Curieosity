    6468: (
            id: 6468,
            name: "Cefuroxime",
            formula: "C16H16N4O8S",
            state: Solid,
            molar_mass_g_mol: 424.4,
            color_hex: None,
            melting_point_c: Some(221.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8864),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Cefuroxime, sold under the brand name Zinacef among others, is a second-generation cephalosporin antibiotic used to treat and prevent a number of bacterial infections. These include pneumonia, meningitis, otitis media, sepsis, urinary tract infections, and Lyme disease. It is used by mouth or by injection into a vein or muscle.
Common side effects include nausea, diarrhea, allergic reactions, and pain at the site of injection. Serious side effects may include Clostridioides difficile infection, anaphylaxis, and Stevens–Johnson syndrome. Use in pregnancy and breastfeeding is believed to be safe. It is a second-generation cephalosporin and works by interfering with a bacteria's ability to make a cell wall resulting in its death.
Cefuroxime was patented in 1971 and approved for medical use in 1977. It is on the World Health Organization's List of Essential Medicines. In 2023, it was the 279th most commonly prescribed medication in the United States, with more than 700,000 prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H334 (97.6%): May cause allergy or asthma symptoms or breathing difficulties if inhaled [Danger Sensitization, respiratory]"),
            uses: ["Calculated removal (%): 22", "Excretion rate: 0.95", "Use (kg) in Switzerland (2009): >100"],
            logp: Some(-0.536),
            appearance: Some("Solid"),
            synonyms: ["Sharox", "Cefuroxim", "cefuroximo", "Cephuroxime", "cefuroximum", "Zinacef Danmark", "3-[(carbamoyloxy)methyl]-7beta-[(2Z)-2-(furan-2…", "(6R,7R)-3-[(carbamoyloxy)methyl]-7-{[(2Z)-2-fur…"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1159557"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/2659"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_3515"), ("Wikidata", "http://www.wikidata.org/entity/Q27181001"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C55268752&Units=SI")],
