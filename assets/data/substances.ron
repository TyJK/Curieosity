    5987: (
            id: 5987,
            name: "Ajmalicine",
            formula: "C21H24N2O3",
            state: Solid,
            molar_mass_g_mol: 352.4,
            color_hex: None,
            melting_point_c: Some(262.75),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.731),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Ajmalicine, also known as δ-yohimbine or raubasine, is an antihypertensive drug used in the treatment of high blood pressure. It has been marketed under numerous brand names including Card-Lamuran, Circolene, Cristanyl, Duxil, Duxor, Hydroxysarpon, Iskedyl, Isosarpan, Isquebral, Lamuran, Melanex, Raunatin, Saltucin Co, Salvalion, and Sarpan. It is an alkaloid found naturally in various plants such as Rauvolfia spp., Catharanthus roseus, and Mitragyna speciosa.
Ajmalicine is structurally related to yohimbine, rauwolscine, and other yohimban derivatives. Like corynanthine, it acts as a α1-adrenergic receptor antagonist with preferential actions over α2-adrenergic receptors, underlying its hypotensive rather than hypertensive effects.
Additionally, it is a very strong inhibitor of the CYP2D6 liver enzyme, which is responsible for the breakdown of many drugs. Its binding affinity at this receptor is 3.30 nM."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.179),
            appearance: None,
            synonyms: ["Duxil", "Sarpan", "Lamuran", "Circolene", "Cristanyl", "ajmalicin", "raubasine", "delta-yohimbine"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=26474579"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/251561"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_2524"), ("Wikidata", "http://www.wikidata.org/entity/Q104167434"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C483045&Units=SI")],
            element_info: None,
        ),
