    8675: (
            id: 8675,
            name: "Coumarin",
            formula: "C9H6O2",
            state: Solid,
            molar_mass_g_mol: 146.14,
            color_hex: None,
            melting_point_c: Some(70.85),
            boiling_point_c: Some(301.71),
            density_g_cm3: Some(0.935),
            heat_capacity_solid_j_g_c: Some(0.6904),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(68.29),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Coumarin () or 2H-chromen-2-one is an aromatic organic chemical compound with formula C9H6O2.  Its molecule can be described as a benzene molecule with two adjacent hydrogen atoms replaced by an unsaturated lactone ring −(CH)=(CH)−(C=O)−O−, forming a second six-membered heterocycle that shares two carbons with the benzene ring. It belongs to the benzopyrone chemical class and is considered a lactone.
Coumarin is a colorless crystalline solid with a sweet odor resembling the scent of vanilla and a bitter taste. It is found in many plants, where it may serve as a chemical defense against predators. While coumarin is not an anticoagulant, its 3-alkyl-4-hydroxy derivatives, such as the fungal metabolite dicoumarol, inhibit synthesis of vitamin K, a key component in blood clotting. A related compound, the prescription drug anticoagulant warfarin, is used to inhibit formation of blood clots, deep vein thrombosis, and pulmonary embolism."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H301 (12.1%): Toxic if swallowed [Danger Acute toxicity, oral]"),
            uses: ["Fragrance", "Odor agents", "Processing aids not otherwise specified", "All Other Basic Organic Chemical Manufacturing"],
            logp: Some(1.793),
            appearance: Some("Coumarin appears as colorless crystals, flakes or colorless to white powder with a pleasant fragrant vanilla odor and a bitter aromatic burning taste. (NTP, 1992)"),
            synonyms: ["Rattex", "Cumarin", "Kumarin", "Coumarine", "chromen-2-one", "Benzo-a-pyrone", "1,2-Benzopyrone", "1, 2-Benzopyrone"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1116938"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/323"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_28794"), ("Wikidata", "http://www.wikidata.org/entity/Q111812"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C91645&Units=SI")],
            element_info: None,
        ),
