            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Biuret ( BYUR-ret) is a chemical compound with the chemical formula HN(CONH2)2. It is a white solid that is soluble in hot water. A variety of organic derivatives are known. The term \"biuret\" also describes a family of organic compounds with the chemical formula R1R2N−C(=O)−N(R3)−C(=O)−NR4R5, where R1, R2, R3, R4 and R5 are hydrogen, organyl or other groups. Also known as carbamylurea, it results from the condensation of two equivalents of urea. It is a common undesirable impurity in urea-based fertilizers, as biuret is toxic to plants."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H315 (100%): Causes skin irritation [Warning Skin corrosion/irritation]"),
            uses: ["Agricultural chemicals (non-pesticidal)", "Soil amendments (fertilizers)", "Agriculture, Forestry, Fishing and Hunting", "IN ANALYTICAL CHEMISTRY", "IN MFR OF UREA FERTILIZER"],
            logp: Some(-1.267),
            appearance: Some("Pellets or Large Crystals; Pellets or Large Crystals, Liquid"),
            synonyms: ["allophanamide", "carbamoylurea", "ureidoformamide", "aminocarbonylurea", "(aminocarbonyl)urea", "dicarbonimidic diamide", "imidodicarbonic diamide", "2-imidodicarbonic diamide"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2810615"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7913"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_18138"), ("Wikidata", "http://www.wikidata.org/entity/Q414902"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C108190&Units=SI")],
