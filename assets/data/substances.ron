    6006: (
            id: 6006,
            name: "Ethyl maltol",
            formula: "C7H8O3",
            state: Solid,
            molar_mass_g_mol: 140.14,
            color_hex: None,
            melting_point_c: Some(89.85),
            boiling_point_c: Some(160.85),
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7321),
