    2192: (
            id: 2192,
            name: "Glyburide",
            formula: "C23H28ClN3O5S",
            state: Solid,
            molar_mass_g_mol: 493.1438,
            color_hex: None,
            melting_point_c: Some(169.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7677),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Glibenclamide, also known as glyburide, is an antidiabetic medication used to treat type 2 diabetes. It is recommended that it be taken together with diet and exercise. It may be used with other antidiabetic medication. It is not recommended for use by itself in type 1 diabetes. It is taken by mouth.
Common side effects include nausea and heartburn. Serious side effects may include angioedema and low blood sugar. It is generally not recommended during pregnancy but can be used during breastfeeding. It is in the sulfonylureas class of medications and works by increasing the release of insulin from the pancreas.
Glibenclamide was discovered in 1969 and approved for medical use in the United States in 1984. It is available as a generic medication. In 2021, it was the 214th most commonly prescribed medication in the United States, with more than 2 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(4.7),
            appearance: None,
            synonyms: ["Glyburide (USAN US)", "Glibenclamide", "10238-21-8", "Glynase", "Euglucon", "Semi-daonil", "Libanil", "Glibenclamida"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2397075"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C10238218&Units=SI")],
            element_info: None,
