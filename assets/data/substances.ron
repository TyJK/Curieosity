    8499: (
            id: 8499,
            name: "Empagliflozin",
            formula: "C23H27ClO7",
            state: Solid,
            molar_mass_g_mol: 450.1445,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6984),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
