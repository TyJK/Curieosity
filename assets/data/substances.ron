    3240: (
            id: 3240,
            name: "Fulvestrant",
            formula: "C32H47F5O3S",
            state: Solid,
            molar_mass_g_mol: 606.3166,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
