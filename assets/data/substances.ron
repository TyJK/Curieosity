    6022: (
            id: 6022,
            name: "Arbutin",
            formula: "C12H16O7",
            state: Solid,
            molar_mass_g_mol: 272.0896,
            color_hex: None,
            melting_point_c: Some(200.85),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7604),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("β-Arbutin, also known by its International Nomenclature of Cosmetic Ingredients (INCI) name, arbutin, is a glycosylated derivative of hydroquinone. β-Arbutin is naturally present in the leaves and bark of a variety of plants, notably the bearberry plant, Arctostaphylos uva-ursi. Utilized as a biosynthetic active ingredient in topical treatments for skin lightening, β-arbutin is aimed at addressing hyperpigmentation issues. Its mechanism of action involves inhibiting the activity of tyrosinase, an essential enzyme for melanin synthesis in the human skin, thereby leading to a reduction in hyperpigmentation. It is important to distinguish β-arbutin from its structurally similar stereoisomer, α-arbutin, which exhibits similar effects in clinical applications."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-1.429),
            appearance: Some("Colorless to white solid powder"),
            synonyms: ["497-76-7", "Arbutoside", "Ursin", "Uvasol", "beta-Arbutin", "p-Hydroxyphenyl beta-D-glucoside", "Arbutinum", "Hydroquinone-O-beta-D-glucopyranoside"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=5723938"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C497767&Units=SI")],
            element_info: None,
        ),
