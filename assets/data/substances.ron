            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("The terpinenes are a group of isomeric hydrocarbons that are classified as monoterpenes.  They each have the same molecular formula and carbon framework, but they differ in the position of carbon-carbon double bonds.  α-Terpinene has been isolated from cardamom and marjoram oils, and from other natural sources.  β-Terpinene has no known natural source but has been prepared from sabinene.  γ-Terpinene and δ-terpinene (also known as terpinolene) have been isolated from a variety of plant sources.  They are all colorless liquids with a turpentine-like odor."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H304 (86.3%): May be fatal if swallowed and enters airways [Danger Aspiration hazard]"),
            uses: ["Fragrance", "Odor agents"],
            logp: Some(3.309),
            appearance: Some("Liquid"),
            synonyms: ["moslene", "Terpilene", "crithmene", "gamma-terpinen", "Alpha-terpinene", "gamma terpinene", "gamma-terpinene", "1,4-p-menthadiene"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3412148"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7461"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_10334"), ("Wikidata", "http://www.wikidata.org/entity/Q423975"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C99854&Units=SI")],
            element_info: None,
