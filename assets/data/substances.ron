            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Diatrizoate, also known as amidotrizoate, Gastrografin, is a contrast agent used during X-ray imaging. This includes visualizing veins, the urinary system, spleen, and joints, as well as computer tomography (CT scan). It is given by mouth, injection into a vein, injection into the bladder, through a nasogastric tube, or rectally.
Relatively common side effects include vomiting, diarrhea, and skin redness. Other side effects include itchiness, kidney problems, low blood pressure, and allergic reactions. It is not recommended in people who have an iodine allergy. Diatrizoate is an iodinated ionic radiocontrast agent with high osmolality.
Diatrizoate was approved for medical use in the United States in 1954. It is on the World Health Organization's List of Essential Medicines."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.3),
            appearance: Some("gas"),
            synonyms: ["Diatrizoic acid", "117-96-4", "amidotrizoic acid", "Urogranoic acid", "Amidotrizoate", "Urografin acid", "Urotrast", "Diat"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3018144"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C117964&Units=SI")],
            element_info: None,
        ),
    2825: (
            id: 2825,
            name: "Rabeprazole",
            formula: "C18H21N3O3S",
            state: Solid,
            molar_mass_g_mol: 359.1304,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7872),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid, IsBase],
            description: Some("Rabeprazole, sold under the brand name Aciphex, among others, is a medication that decreases stomach acid. It is used to treat peptic ulcer disease, gastroesophageal reflux disease, and excess stomach acid production such as in Zollinger–Ellison syndrome. It may also be used in combination with other medications to treat Helicobacter pylori. Effectiveness is similar to other proton pump inhibitors (PPIs). It is taken by mouth.
Common side effects include constipation, feeling weak, and throat inflammation. Serious side effects may include osteoporosis, low blood magnesium, Clostridioides difficile infection, and pneumonia. Use in pregnancy and breastfeeding is of unclear safety. It works by blocking H+/K+-ATPase in the parietal cells of the stomach.
Rabeprazole was patented in 1986, and approved for medical use in 1997. It is available as a generic medication. In 2017, it was the 288th most commonly prescribed medication in the United States, with more than 1 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(0.6),
            appearance: Some("gas"),
            synonyms: ["117976-89-3", "pariprazole", "Eraloc", "rabeprazol", "LY307640", "LY-307640", "CHEBI:8768", "E-3810 (PPI)"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=805735"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C117976893&Units=SI")],
            element_info: None,
        ),
    2826: (
            id: 2826,
            name: "Bromodiphenhydramine",
            formula: "C17H20BrNO",
            state: Liquid,
            molar_mass_g_mol: 333.0728,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
