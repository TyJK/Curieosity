            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Aluminium chloride, also known as aluminium trichloride, is an inorganic compound with the formula AlCl3. It forms a hexahydrate with the formula [Al(H2O)6]Cl3, containing six water molecules of hydration. Both the anhydrous form and the hexahydrate are colourless crystals, but samples are often contaminated with iron(III) chloride, giving them a yellow colour.
The anhydrous form is commercially important. It has a low melting and boiling point. It is mainly produced and consumed in the production of aluminium, but large amounts are also used in other areas of the chemical industry. The compound is often cited as a Lewis acid. It is an inorganic compound that reversibly changes from a polymer to a monomer at mild temperature."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H314: Causes severe skin burns and eye damage [Danger Skin corrosion/irritation]"),
            uses: ["Intermediates", "Solids separation agents", "Adhesives and sealant chemicals", "All Other Basic Inorganic Chemical Manufacturing", "All Other Basic Organic Chemical Manufacturing"],
            logp: Some(1.688),
            appearance: None,
            synonyms: ["AlPC", "aluminium chloride", "aluminum trichloride", "aluminum phthalocyanine", "aluminum chloride anhydrous", "trichloroalumane", "Aluminium trichloride", "Trichloroaluminum"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1362114"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/24012"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_195321"), ("Wikidata", "http://www.wikidata.org/entity/Q314036"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C7446700&Units=SI")],
