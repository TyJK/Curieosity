            logp: Some(0.016),
            appearance: Some("Sodium thiocyanate is an odorless white solid. Sinks and mixes with water. (USCG, 1999)"),
            synonyms: ["NaSCN", "sodium rhodanate", "sodium rhodanide", "thiocyanate sodium", "sodium sulfocyanate", "540-72-7", "Thiocyanic acid, sodium salt", "Scyan"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=5064230"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/131854942"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_30952"), ("Wikidata", "http://www.wikidata.org/entity/Q425176"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C540727&Units=SI")],
