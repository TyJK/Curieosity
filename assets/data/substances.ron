            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(315.88),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Melamine cyanurate, also known as melamine–cyanuric acid adduct or melamine–cyanuric acid complex, is a crystalline complex formed from a 1:1 mixture of melamine and cyanuric acid. The substance is not a salt despite its non-systematic name melamine cyanurate. The complex is held together by an extensive two-dimensional network of hydrogen bonds between the two compounds, reminiscent of the guanine–cytosine base pairs found in DNA. Melamine cyanurate forms spoke-like crystals from aqueous solutions  and has been implicated as a causative agent for toxicity seen in the Chinese protein export contamination and the 2007 pet food recall.  This complex is cited as an example of supramolecular chemistry."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H351 (15.4%): Suspected of causing cancer [Warning Carcinogenicity]"),
            uses: ["Flame retardants", "Adhesive Manufacturing", "Construction", "Custom Compounding of Purchased Resins"],
            logp: Some(-3.63),
            appearance: Some("Dry Powder; Pellets or Large Crystals, Other Solid; Pellets or Large Crystals"),
            synonyms: ["Melamine isocyanurate", "Melamine-cyanuric acid compd", "melamine-cyanuric acid adduct", "melamine–cyanuric acid adduct", "melamine-cyanuric acid complex", "melamine–isocyanuric acid adduct", "s-Triazine, 2,4,6-triamino-, compd. with s-tria…", "1,3,5-triazinane-2,4,6-trione--1,3,5-triazine-2…"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=16643661"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/93198"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_60153"), ("Wikidata", "http://www.wikidata.org/entity/Q3267336"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C37640576&Units=SI")],
