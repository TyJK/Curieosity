    6872: (
            id: 6872,
            name: "Acepromazine",
            formula: "C19H22N2OS",
            state: Solid,
            molar_mass_g_mol: 326.1453,
            color_hex: None,
            melting_point_c: Some(25.0),
            boiling_point_c: Some(230.0),
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7107),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Acepromazine, acetopromazine, or acetylpromazine (commonly known as ACP, Ace, or by the trade names Atravet or Acezine 2, number depending on mg/ml dose) is a phenothiazine derivative antipsychotic drug. It was used in humans during the 1950s as an antipsychotic, but is now almost exclusively used on animals as a sedative and antiemetic. A closely related analogue, chlorpromazine, is still used in humans.
The standard pharmaceutical preparation, acepromazine maleate, is used in veterinary medicine in dogs and cats. It is used widely in horses as a pre-anesthetic sedative and has been shown to reduce anesthesia related death. However, it should be used with caution (but is not absolutely contraindicated) in stallions due to the risk of paraphimosis and priapism. Its potential for cardiac effects can be profound, namely hypotension due to peripheral vasodilation, so it should be avoided or used with caution in geriatric or debilitated animals."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(4.444),
            appearance: None,
            synonyms: ["Acetylpromazine", "Acetopromazine", "Acepromazina", "61-00-7", "Atravet", "Acezine 2", "Acepromazinum", "Concentrat vo34"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1113331"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C61007&Units=SI")],
            element_info: None,
        ),
    6873: (
            id: 6873,
