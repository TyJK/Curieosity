            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Methanethiol ( METH-ayn-THY-ol), also called methyl mercaptan, is an organosulfur compound with the chemical formula CH3SH. It is a colorless flammable gas with a distinctive putrid smell. In small amounts, it is pervasive in nature and found in certain foods, such as some nuts and cheese. It contributes to many odors, including the emissions from pulp mills, bad breath, and flatus. Methanethiol is the simplest thiol and is sometimes abbreviated as MeSH."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H220: Extremely flammable gas [Danger Flammable gases]"),
            uses: ["Intermediate", "Agriculture, Forestry, Fishing and Hunting", "All Other Basic Organic Chemical Manufacturing", "Catalyst"],
            logp: None,
            appearance: Some("Methyl mercaptan appears as a colorless low-boiling liquid that is denser than water. Very toxic by inhalation. Can be absorbed through the skin. Has a sharp odor, but the sense of smell cannot be relied upon to warn of the presence of vapors at low concentrations.   Rate of onset: Immediate  Persistence: Minutes to hours  Odor threshold: 0.002 ppm  Source/use/other hazard: From decayed organic matter - pulp mills, oil refineries; highly flammable; liquid burns/frostbite."),
            synonyms: ["CH3SH", "Methvtiolo", "Methanthiol", "Thiomethane", "Thiomethanol", "Methanethiole", "Methylmercaptan", "Metilmercaptano"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=241815"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/878"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_16007"), ("Wikidata", "http://www.wikidata.org/entity/Q409309"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C74931&Units=SI")],
            element_info: None,
