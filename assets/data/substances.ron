            synonyms: ["Paresan", "Lipotril", "Biocolina", "Biocoline", "Hepacholine", "Luridin chloride", "Cholini chloridum", "Cloruro de colina"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2779443"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6209"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_133341"), ("Wikidata", "http://www.wikidata.org/entity/Q2964153"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C67481&Units=SI")],
