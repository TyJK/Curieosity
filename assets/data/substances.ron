            boiling_point_c: Some(34.85),
            density_g_cm3: Some(0.8617),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6051),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(-46.13),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Ethanethiol, commonly known as ethyl mercaptan, is an organosulfur compound with the formula CH3CH2SH. It is a colorless liquid with a distinct odor. Abbreviated EtSH, it consists of an ethyl group (Et), CH3CH2, attached to a thiol group, SH. Its structure parallels that of ethanol, but with sulfur in place of oxygen. The odor of EtSH is infamous. Ethanethiol is more volatile than ethanol due to a diminished ability to engage in hydrogen bonding. Ethanethiol is toxic in high concentrations. It occurs naturally as a minor component of petroleum, and may be added to otherwise odorless gaseous products such as liquefied petroleum gas (LPG) to help warn of gas leaks. At these concentrations, ethanethiol is not harmful."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H224: Extremely flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Intermediate", "All Other Basic Organic Chemical Manufacturing", "Intermediates", "Odor agents"],
            logp: None,
            appearance: Some("Ethyl mercaptan appears as a clear colorless low-boiling liquid (boiling point 97 °F) with an overpowering, garlic-like/skunk-like odor. Flash point -55 °F. Less dense than water and very slightly soluble in water. Vapors are heavier than air. Vapors may irritate nose and throat. May be toxic if swallowed, by inhalation or by contact. Added to natural gas as an odorant. Used as a stabilizer for adhesives."),
            synonyms: ["stench", "etantiolo", "stench gas", "Aethanethiol", "mercaptan C2", "1-ethanethiol", "etilmercaptano", "mercaptoethane"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=612451"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6343"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_46511"), ("Wikidata", "http://www.wikidata.org/entity/Q407918"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C75081&Units=SI")],
            element_info: None,
        ),
    7885: (
            id: 7885,
