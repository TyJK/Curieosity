            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("1-Chloro-3,3,3-trifluoropropene (HFO-1233zd) is the unsaturated chlorofluorocarbon with the formula HClC=C(H)CF3.  The compound exists as E- (trans-) and Z- (cis-) isomers.  The cis- isomer of this colorless gas is of interest as a more environmentally friendly (lower GWP; global warming potential) refrigerant in air conditioners(cis-isomer) or solvent(trans-isomer). The trans-isomer is of interest as a more environmentally friendly (lower GWP; global warming potential) solvent."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H280 (100%): Contains gas under pressure; may explode if heated [Warning Gases under pressure]"),
            uses: ["Foamant", "Insulators", "Refrigerants", "All Other Basic Inorganic Chemical Manufacturing", "Cleaning agent", "Fabricated Metal Product Manufacturing"],
            logp: Some(2.301),
            appearance: Some("Colorless liquid"),
            synonyms: ["HFO-1233zd", "3-chloro-trans,trans-muconic acid", "(2Z,4E)-3-chlorohexa-2,4-dienedioic acid", "102687-65-0", "1-Propene, 1-chloro-3,3,3-trifluoro-, (1E)-", "trans-1-chloro-3,3,3-trifluoropropene", "trans-HCFO-1233zd", "RefChem:431253"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=52070082"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/2779022"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_38433"), ("Wikidata", "http://www.wikidata.org/entity/Q30715333"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C102687650&Units=SI")],
