    4802: (
            id: 4802,
            name: "Povidone-iodine",
            formula: "(C6H9NO)n·xI",
            state: Solid,
            molar_mass_g_mol: 364.95,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.3801),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Povidone-iodine (PVP-I), also known as iodopovidone, is an antiseptic used for skin disinfection before and after surgery. It may be used both to disinfect the hands of healthcare providers and the skin of the person they are caring for. It may also be used for minor wounds. It may be applied to the skin as a liquid, an ointment or a powder.
Side effects include skin irritation and sometimes swelling. If used on large wounds, kidney problems, high blood sodium, and metabolic acidosis may occur. It is not recommended in women who are less than 32 weeks pregnant. Frequent use is not recommended in people with thyroid problems or who are taking lithium.
Povidone-iodine is a chemical complex of povidone, hydrogen iodide, and elemental iodine. The recommended strength solution contains 10% Povidone, with total iodine species equaling 10,000 ppm or 1% total titratable iodine. It works by releasing iodine which results in the death of a range of microorganisms.
Povidone-iodine came into commercial use in 1955. It is on the World Health Organization's List of Essential Medicines. Povidone-iodine is available over the counter. It is sold under a number of brand names including Betadine."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Calculated removal (%): 92.1", "Excretion rate: 1", "Use (kg) in Switzerland (2009): >5000", "Use (kg; approx.) in Germany (2009): >25000"],
            logp: Some(2.524),
            appearance: Some("powder, liquid"),
            synonyms: ["PVP-I", "Betadine", "E-Z Prep", "E-Z scrub", "E-Z Prep 220", "iodopovidone", "E-Z Scrub 201", "E-Z Scrub 241"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1817669"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/410087"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_8347"), ("Wikidata", "http://www.wikidata.org/entity/Q241516"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C25655418&Units=SI")],
