    4691: (
            id: 4691,
            name: "Hedione",
            formula: "C13H22O3",
            state: Liquid,
            molar_mass_g_mol: 226.31,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: Some(307.85),
            density_g_cm3: Some(0.997),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6522),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Methyl dihydrojasmonate (often referred to by its trade names of hedione or kharismal) is an aroma compound with an odor similar to that of jasmine. It is a synthetic relative of methyl jasmonate, a naturally occurring compound in floral scents such as jasmine, tuberose and magnolia. In racemic mixtures the odor is floral and citrus, while epimerized mixtures exhibit a dense buttery-floral odor with odor recognition thresholds of 15 parts per billion. Considered one of the compounds responsible for the projection of the scent in living flowers, it was first fully characterised and synthesized between 1957 and 1962 in jasmine absolute (0.8%) by the fragrance chemist Edouard Demole, who was working at Firmenich. and is used in fine fragrances as well as cosmetics, toiletries, and detergents."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H301: Toxic if swallowed [Danger Acute toxicity, oral]"),
            uses: ["Fragrance", "Odor agents", "All Other Basic Organic Chemical Manufacturing", "Flavoring and nutrient"],
            logp: Some(2.725),
            appearance: Some("Dry Powder, Liquid, Other Solid; Other Solid; Liquid"),
            synonyms: ["FEMA 3408", "Kharismal", "Trans-(-)-hedione", "Methyl hydrojasmonate", "Methyl dihydrojasmonate", "(-)-methyl dihydrojasmonate", "Methyl trans-dihydrojasmonate", "(1R,2R)-Methyl dihydrojasmonate"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=20668735"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/102861"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_89741"), ("Wikidata", "http://www.wikidata.org/entity/Q3144605"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C24851987&Units=SI")],
            element_info: None,
        ),
