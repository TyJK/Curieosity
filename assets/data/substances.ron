            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Para red (paranitraniline red, Pigment Red 1, C.I. 12070) is a dye. Chemically, it is similar to Sudan I.  It was discovered in 1880 by von Gallois and Ullrich. It dyes cellulose fabrics a brilliant red color, but is not very fast. The dye can be washed away easily from cellulose fabrics if not dyed correctly. Acidic and basic stages both occur during the standard formation of Para red, and acidic or basic byproducts may be present in the final product."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(4.869),
