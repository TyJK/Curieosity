            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Florbetapir (18F), sold under the brand name Amyvid, is a PET scanning radiopharmaceutical compound containing the radionuclide fluorine-18 that was approved for use in the United States in 2012, as a diagnostic tool for Alzheimer's disease. Florbetapir, like Pittsburgh compound B (PiB), binds to beta-amyloid, however fluorine-18 has a half-life of 109.75 minutes, in contrast to PiB's radioactive half life of 20 minutes. The longer life allows the tracer to accumulate significantly more in the brains of people with AD, particularly in the regions known to be associated with beta-amyloid deposits."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.675),
            appearance: None,
            synonyms: ["18", "F-AV-45, florbetapir-fluorine-18, Florbetapir F…", "Florbetapir F-18", "Amyvid", "Florbetapir", "Florbetapir F 18", "956103-76-7", "18F-AV-45"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=37972292"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C956103767&Units=SI")],
