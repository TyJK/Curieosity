    6663: (
            id: 6663,
            name: "Adenosine",
            formula: "C10H13N5O4",
            state: Solid,
            molar_mass_g_mol: 267.0968,
            color_hex: None,
            melting_point_c: Some(235.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.9989),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Adenosine (symbol A) is an organic compound that occurs widely in nature in the form of diverse derivatives. The molecule consists of an adenine attached to a ribose via a β-N9-glycosidic bond. Adenosine is one of the four nucleoside building blocks of RNA (and its derivative deoxyadenosine is a building block of DNA), which are essential for all life on Earth. Its derivatives include the energy carriers adenosine mono-, di-, and triphosphate, also known as AMP/ADP/ATP. Cyclic adenosine monophosphate (cAMP) is pervasive in signal transduction. Adenosine is used as an intravenous medication for some cardiac arrhythmias.
Adenosyl (abbreviated Ado or 5'-dAdo) is the chemical group formed by removal of the 5′-hydroxy (OH) group. It is found in adenosylcobalamin (an active form of vitamin B12) and as a radical in the radical SAM enzymes."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-1.05),
            appearance: None,
            synonyms: ["58-61-7", "Adenocard", "Adenoscan", "Adenine riboside", "beta-D-Adenosine", "Nucleocardyl", "Adenosin", "Boniton"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=89108"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C58617&Units=SI")],
            element_info: None,
        ),
    6664: (
            id: 6664,
            name: "Inosine",
            formula: "C10H12N4O5",
            state: Solid,
            molar_mass_g_mol: 268.0808,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.9643),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Inosine is a nucleoside that is formed when hypoxanthine is attached to a ribose ring (also known as a ribofuranose) via a β-N9-glycosidic bond. It was discovered in 1965 in analysis of RNA transferase.
Inosine is commonly found in tRNAs and is essential for proper translation of the genetic code in wobble base pairs.

Knowledge of inosine metabolism has led to advances in immunotherapy in recent decades. Inosine monophosphate is oxidised by the enzyme inosine monophosphate dehydrogenase, yielding xanthosine monophosphate, a key precursor in purine metabolism.  Mycophenolate mofetil is an anti-metabolite, anti-proliferative drug that acts as an inhibitor of inosine monophosphate dehydrogenase. It is used in the treatment of a variety of autoimmune diseases including granulomatosis with polyangiitis because the uptake of purine by actively dividing B cells can exceed 8 times that of normal body cells, and, therefore, this set of white cells (which cannot operate purine salvage pathways) is selectively targeted by the purine deficiency resulting from inosine monophosphate dehydrogenase (IMD) inhibition."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-2.1),
            appearance: Some("white"),
            synonyms: ["58-63-9", "Hypoxanthosine", "Ribonosine", "Atorel", "Oxiamin", "Hypoxanthine riboside", "Trophicardyl", "Selfer"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=89111"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C58639&Units=SI")],
            element_info: None,
        ),
    6666: (
            id: 6666,
            name: "Diphenhydramine",
            formula: "C17H21NO",
            state: Liquid,
            molar_mass_g_mol: 255.1623,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: Some(157.5),
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6631),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Diphenhydramine, sold under the brand name Benadryl among others, is an antihistamine and sedative. Although generally considered sedating, diphenhydramine can cause paradoxical central nervous system stimulation in some individuals, particularly at higher doses. This may manifest as agitation, anxiety, or restlessness rather than sedation. It is a first-generation H1-antihistamine and it works by blocking certain effects of histamine, which produces its antihistamine and sedative effects. Diphenhydramine is also a potent anticholinergic. It is mainly used to treat allergies, insomnia, and symptoms of the common cold. It is also less commonly used for tremors in parkinsonism, and nausea. It is taken by mouth, injected into a vein, injected into a muscle, or applied to the skin. Maximal effect is typically around two hours after a dose, and effects can last for up to seven hours.
Common side effects include sleepiness, poor coordination, and an upset stomach. There is no clear risk of harm when used during pregnancy; however, use during breastfeeding is not recommended.
It was developed by George Rieveschl and put into commercial use in 1946. It is available as a generic medication. In 2023, it was the 294th most commonly prescribed medication in the United States, with more than 700,000 prescriptions.
Its sedative and deliriant effects have led to some cases of recreational use."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.27),
            appearance: None,
            synonyms: ["58-73-1", "Benzhydramine", "Alledryl", "Probedryl", "Dihidral", "Antistominum", "Benzhydraminum", "Benzhydroamina"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=412096"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C58731&Units=SI")],
            element_info: None,
        ),
    6667: (
            id: 6667,
            name: "Papaverine",
            formula: "C20H21NO4",
            state: Liquid,
            molar_mass_g_mol: 339.1471,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.713),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Papaverine (Latin papaver, \"poppy\") is an opium alkaloid antispasmodic drug, used primarily in the treatment of visceral spasms and vasospasms (especially those involving the intestines, heart, or brain), occasionally in the treatment of erectile dysfunction and acute mesenteric ischemia. While it is found in the opium poppy, papaverine differs in both structure and pharmacological action from the analgesic morphine and its derivatives (such as codeine).
In addition to opium, papaverine is purported to be present in high concentrations in star gooseberry."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.0),
            appearance: None,
            synonyms: ["58-74-2", "Robaxapap", "1-(3,4-Dimethoxybenzyl)-6,7-dimethoxyisoquinoli…", "6,7-Dimethoxy-1-veratrylisoquinoline", "Pavatym", "Pavacap", "Papaverinum", "DAA13NKG2Q"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1195861"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C58742&Units=SI")],
            element_info: None,
