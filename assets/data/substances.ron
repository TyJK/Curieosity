    4818: (
            id: 4818,
            name: "Gemfibrozil",
            formula: "C15H22O3",
            state: Solid,
            molar_mass_g_mol: 250.1569,
            color_hex: None,
            melting_point_c: Some(62.0),
            boiling_point_c: Some(158.5),
