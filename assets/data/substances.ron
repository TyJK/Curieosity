            decay_particle_id: None,
            properties: [IsBase],
            description: Some("p-Phenylenediamine (PPD) is an organic compound with the formula C6H4(NH2)2. This derivative of aniline is a white solid, but samples can darken due to air oxidation. It is mainly used as a component of engineering polymers and composites like kevlar. It is also an ingredient in hair dyes and is occasionally used as a substitute for henna."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H301: Toxic if swallowed [Danger Acute toxicity, oral]"),
            uses: ["Dyes", "CIR ingredient: p-Phenylenediamine"],
            logp: Some(0.851),
            appearance: Some("P-phenylenediamine appears as a white to purple crystalline solid (melting point 234 F) that turns purple to black in air. Flash point 309 F. Toxic by skin absorption, inhalation or ingestion. Used for production of aramid fiber, antioxidants, as a laboratory reagent, in photographic developing, and as a dye for hair and furs."),
            synonyms: ["PPD", "pPDA", "4-Aminoaniline", "p-Diaminobenzene", "1,4-Benzenediamine", "1,4-diaminobenzene", "4-phenylenediamine", "p-Phenylenediamine"],
