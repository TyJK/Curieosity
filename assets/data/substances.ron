            synonyms: ["polyvinylenefluoride", "poly(vinylenefluoride)", "polyvinylidenefluoride", "Polyvinylidene fluoride", "poly(vinylene fluoride)", "polyvinylene difluoride", "poly(vinylidenefluoride)", "poly(vinylidene fluoride)"],
