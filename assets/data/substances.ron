    2131: (
            id: 2131,
            name: "Nitric oxide",
            formula: "NO",
            state: Gas,
            molar_mass_g_mol: 30.006,
            color_hex: None,
            melting_point_c: Some(-164.15),
            boiling_point_c: Some(-152.15),
            density_g_cm3: Some(1.3402),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: Some(1.3897),
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Nitric oxide (nitrogen oxide, nitrogen monooxide, or nitrogen monoxide) is a colorless gas with the formula NO.  It is one of the principal oxides of nitrogen. Nitric oxide is a free radical: it has an unpaired electron, which is sometimes denoted by a dot in its chemical formula (•N=O or •NO).  Nitric oxide is also a heteronuclear diatomic molecule, a class of molecules whose study spawned early modern theories of chemical bonding.
An important intermediate in industrial chemistry, nitric oxide forms in combustion systems and can be generated by lightning in thunderstorms. In mammals, including humans, nitric oxide is a signaling molecule in many physiological and pathological processes.  It was proclaimed the \"Molecule of the Year\" in 1992.  The 1998 Nobel Prize in Physiology or Medicine was awarded for discovering nitric oxide's role as a cardiovascular signalling molecule. Its impact extends beyond biology, with applications in medicine, such as the development of sildenafil (Viagra), and in industry, including semiconductor manufacturing.
Nitric oxide should not be confused with nitrogen dioxide (NO2), a brown gas and major air pollutant, or with nitrous oxide (N2O), an anesthetic gas."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H270 (100%): May cause or intensify fire; oxidizer [Danger Oxidizing gases]"),
            uses: ["MEDICATION", "TO PREPARE NITROSYL CARBONYLS"],
            logp: Some(-0.447),
            appearance: Some("Nitric oxide appears as a colorless gas. Noncombustible but accelerates the burning of combustible material. Vapors heavier than air. Very toxic by inhalation and skin absorption. Heating the containers may cause them to rupture violently and rocket."),
            synonyms: ["NO", "EDRF", "[NO]", "(.)NO", "NO(.)", "(NO)(.)", "nitrosyl", "nitroxyl"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=235287"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/145068"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_16480"), ("Wikidata", "http://www.wikidata.org/entity/Q207843"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C10102439&Units=SI")],
            element_info: None,
        ),
    2132: (
            id: 2132,
            name: "Nitrogen dioxide",
            formula: "NO2",
            state: Gas,
            molar_mass_g_mol: 46.006,
            color_hex: None,
            melting_point_c: Some(-9.35),
            boiling_point_c: Some(21.15),
            density_g_cm3: Some(1.88),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: Some(1.2694),
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Nitrogen dioxide is a chemical compound with the formula NO2. One of several nitrogen oxides, nitrogen dioxide is a reddish-brown gas.  It is a paramagnetic, bent molecule with C2v point group symmetry. Industrially, NO2 is an intermediate in the synthesis of nitric acid, millions of tons of which are produced each year, primarily for the production of fertilizers. 
Nitrogen dioxide is poisonous and can be fatal if inhaled in large quantities. Cooking with a gas stove produces nitrogen dioxide which causes poorer indoor air quality. Combustion of gas can lead to increased concentrations of nitrogen dioxide throughout the home environment which is linked to respiratory issues and diseases. The LC50 (median lethal dose)  for humans has been estimated to be 174 ppm for a 1-hour exposure. It is also included in the NOx family of atmospheric pollutants."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H270: May cause or intensify fire; oxidizer [Danger Oxidizing gases]"),
            uses: [],
            logp: Some(0.098),
            appearance: Some("Nitrogen dioxide appears as a reddish brown gas or yellowish-brown liquid when cooled or compressed. Shipped as a liquefied gas under own vapor pressure. Vapors are heavier than air. Toxic by inhalation (vapor) and skin absorption. Noncombustible, but accelerates the burning of combustible materials. Cylinders and ton containers may not be equipped with a safety relief device."),
            synonyms: ["NO2", "[NO2]", "NO2(.)", "ONO(.)", "nitryl", "(NO2)(.)", "nitrosooxidanyl", "Stickstoffdioxid"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=238528"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/3032552"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_33101"), ("Wikidata", "http://www.wikidata.org/entity/Q207895"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C10102440&Units=SI")],
            element_info: None,
        ),
