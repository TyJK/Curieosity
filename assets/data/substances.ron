            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Hydroxyethyl acrylate is the organic compound with the formula CH2=CHCO2CH2CH2OH.  It is a colorless viscous liquid.  The compound has dual functionality: a polymerizable acrylic and a hydroxy group. It is a monomer used to make emulsion polymers along with other monomers and the resultant resins are used in coatings, sealants, adhesives and elastomers and other applications."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H311: Toxic in contact with skin [Danger Acute toxicity, dermal]"),
            uses: ["Binder", "Dispersing agent", "Monomers", "Photosensitive agent"],
            logp: Some(-0.292),
            appearance: Some("Hydroxyethylacrylate appears as a clear colorless liquid. Less dense than water. Vapors heavier than air. Corrosive to tissue. May polymerize exothermically if heated or contaminated. If the polymerization takes place inside a container, the container may rupture violently. Used to make plastics."),
            synonyms: ["acrylate", "Propenoate", "2-propenoate", "prop-2-enoate", "2-propenoic acid, ion(1-)", "818-61-1", "Hydroxyethyl acrylate", "Ethylene glycol monoacrylate"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=73060426"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/13165"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_37080"), ("Wikidata", "http://www.wikidata.org/entity/Q27253959"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C818611&Units=SI")],
