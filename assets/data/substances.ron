    2278: (
            id: 2278,
            name: "Benzonatate",
            formula: "C30H53NO11",
            state: Solid,
            molar_mass_g_mol: 603.3619,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7188),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Benzonatate (), sold under the brand name Tessalon among others, is a medication that is used for the symptomatic relief of cough. Benzonatate is taken by mouth. Effects generally begin within 20 minutes and last between 3 and 8 hours.
Side effects include sleepiness, dizziness, headache, upset stomach, skin rash, hallucinations, and allergic reactions. Overdosage can result in serious adverse effects including seizures, irregular heartbeat, cardiac arrest, and death. Overdose of only a small number of capsules can be fatal. Chewing or sucking on the capsule, releasing the drug into the mouth, can also lead to laryngospasm, bronchospasm, and circulatory collapse. It is unclear if use in pregnancy or breastfeeding is safe. Benzonatate is a local anesthetic and voltage-gated sodium channel blocker. It is theorized to work by inhibiting stretch receptors in the lungs, in turn suppressing the cough reflex in the brain. Benzonatate is structurally related to other local anesthetics like procaine and tetracaine.
Benzonatate was discovered in 1956 and was approved for medical use in the United States in 1958. It is available as a generic medication. Availability worldwide is limited, with the drug remaining marketed only in the United States and Mexico. In 2023, it was the 122nd most commonly prescribed medication in the United States, with more than 5 million prescriptions. A 2023 systematic review found that there is inadequate evidence to support the effectiveness and safety of benzonatate for cough and highlighted rising safety concerns."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(2.45),
            appearance: None,
            synonyms: [],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1783208"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C104314&Units=SI")],
            element_info: None,
        ),
    2280: (
            id: 2280,
            name: "Anethole",
            formula: "C10H12O",
            state: Liquid,
            molar_mass_g_mol: 148.2,
            color_hex: None,
            melting_point_c: Some(20.35),
            boiling_point_c: Some(233.85),
            density_g_cm3: Some(0.998),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6188),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Anethole (also known as anise camphor) is an organic compound that is widely used as a flavoring substance. It is a derivative of the aromatic compound allylbenzene and occurs widely in the essential oils of plants. It is in the class of phenylpropanoid organic compounds. It contributes a large component of the odor and flavor of anise and fennel (both in the botanical family Apiaceae), anise myrtle (Myrtaceae), liquorice (Fabaceae), magnolia blossoms, and star anise (Schisandraceae). Closely related to anethole is its isomer estragole, which is abundant in tarragon (Asteraceae) and basil (Lamiaceae), and has a flavor reminiscent of anise. It is a colorless, fragrant, mildly volatile liquid. Anethole is only slightly soluble in water but exhibits high solubility in ethanol. This trait causes certain anise-flavored liqueurs to become cloudy when diluted with water; this is called the ouzo effect."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H317 (95.3%): May cause an allergic skin reaction [Warning Sensitization, Skin]"),
            uses: ["AS FLAVOR INGREDIENT", "All Other Basic Organic Chemical Manufacturing", "Calculated removal (%): 96.6"],
            logp: Some(2.728),
            appearance: Some("Anethole appears as white crystals or a liquid. Odor of anise oil and a sweet taste. (NTP, 1992)"),
            synonyms: ["p-propenylanisole", "1-methoxy-4-(prop-1-en-1-yl)benzene", "methyl 4-(prop-1-en-1-yl)phenyl ether", "104-46-1", "Anise camphor", "Monasirup", "Anethol", "4-Propenylanisole"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1584829"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7703"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_2716"), ("Wikidata", "http://www.wikidata.org/entity/Q27105777"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C104461&Units=SI")],
            element_info: None,
        ),
