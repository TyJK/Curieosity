    2678: (
            id: 2678,
            name: "Yttrium oxide",
            formula: "OY",
            state: Solid,
            molar_mass_g_mol: 106.921,
            color_hex: None,
            melting_point_c: Some(1525.85),
            boiling_point_c: Some(2929.85),
