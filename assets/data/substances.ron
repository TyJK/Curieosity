    5580: (
            id: 5580,
            name: "(Chloromethylene)dimethylammonium chloride",
            formula: "C3H7Cl2N",
            state: Solid,
            molar_mass_g_mol: 128.0,
            color_hex: None,
            melting_point_c: Some(131.85),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7617),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("The Vilsmeier reagent is an organic compound with the formula [(CH3)2NCHCl]Cl.  It is a salt consisting of the N,N-dimethyl­iminium cation ([(CH3)2N=CHCl]+) and chloride anion. Depending on the particular reaction, the anion can vary.  In typical POCl3-based reactions, the anion is PO2Cl2−. The iminium cation [(CH3)2N=CHCl]+ is the reactive component of interest.  This iminium species is a derivative of the imidoyl chloride CH3N=CHCl. Analogues of this particular reagent are generated when tertiary amides other than DMF are treated with POCl3.
The salt is a white solid that is soluble in polar organic solvents.  Vilsmeier reagent is the active intermediate in the formylation reactions, the Vilsmeier reaction or Vilsmeier-Haack reaction that use mixtures of dimethylformamide and phosphorus oxychloride to generate the Vilsmeier reagent, which in turn is attacked by a nucleophilic substrate and eventually hydrolyzes to give formyl.  It is a source of \"O=CH+\"."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H314: Causes severe skin burns and eye damage [Danger Skin corrosion/irritation]"),
            uses: ["Intermediates", "Pharmaceutical and Medicine Manufacturing"],
            logp: Some(-2.47),
            appearance: Some("Other Solid"),
            synonyms: ["Arnold's reagent", "Vilsmeier reagent", "benzyldimethyltetradecylazanium chloride", "(chloromethylene)dimethyliminium chloride", "C12-C14-Alkyl(ethylbenzyl)dimethylammonium chlo…", "N-Alkyl dimethyl benzyl ammonium chloride (C12-…", "chloromethylene dimethylammonium chloride", "chloro-n,n-dimethylformiminium chloride"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=58895181"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/77311"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_234578"), ("Wikidata", "http://www.wikidata.org/entity/Q27894258"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C3724434&Units=SI")],
            element_info: None,
        ),
