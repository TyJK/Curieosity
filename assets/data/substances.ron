    6595: (
            id: 6595,
            name: "Physostigmine",
            formula: "C15H21N3O2",
            state: Solid,
            molar_mass_g_mol: 275.1634,
            color_hex: None,
            melting_point_c: Some(105.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8028),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Physostigmine (also known as eserine from éséré, the West African name for the Calabar bean) is a highly toxic parasympathomimetic alkaloid, specifically, a reversible cholinesterase inhibitor. It occurs naturally in the Calabar bean and the fruit of the Manchineel tree.
The chemical was synthesized for the first time in 1935 by Percy Lavon Julian and Josef Pikl. It is available in the U.S. under the trade names Antilirium and Isopto Eserine, and as eserine salicylate and eserine sulfate. Today, physostigmine is most commonly used for its medicinal value. However, before its discovery by Sir Robert Christison in 1846, it was much more prevalent as an ordeal poison. The positive medical applications of the drug were first suggested in the gold medal-winning final thesis of Thomas Richard Fraser at the University of Edinburgh in 1862."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.58),
            appearance: None,
            synonyms: ["Eserine", "57-47-6", "Physostol", "Esromiotin", "(-)-physostigmine", "Ezerin", "Calabarine", "Fysostigmin"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=743397"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C57476&Units=SI")],
            element_info: None,
