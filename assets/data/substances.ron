            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Dihydrotachysterol (DHT) is a synthetic vitamin D analog activated in the liver that does not require renal hydroxylation like vitamin D2 (ergocalciferol) and vitamin D3 (cholecalciferol). DHT has a rapid onset of action (2 hours), a shorter half-life, and a greater effect on mineralization of bone salts than does vitamin D."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H301 (97.6%): Toxic if swallowed [Danger Acute toxicity, oral]"),
            uses: ["Bone Density Conservation Agents; Vitamins", "MEDICATION", "MEDICATION (VET)", "Treatment of hypocalcemic tetany"],
            logp: Some(7.721),
            appearance: Some("Solid"),
            synonyms: ["AT 10", "Dihidrotaquisterol", "Dihydrotachysterolum", "Anti-tetany substance 10", "(3S,5E,7E,10S,22E)-9,10-secoergosta-5,7,22-trie…", "Dichystrolum", "Antitanil", "Hytakerol"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2677559"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/3070"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_4591"), ("Wikidata", "http://www.wikidata.org/entity/Q155685"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C67969&Units=SI")],
            element_info: None,
