            uses: [],
            logp: Some(-0.6),
            appearance: None,
            synonyms: ["OGT 918, 1,5-(butylimino)-1,5-dideoxy-D-glucito…", "72599-27-0", "Zavesca", "N-Butyldeoxynojirimycin", "Butyldeoxynojirimycin", "N-Butylmoranoline", "NB-DNJ", "N-butyl-1-deoxynojirimycin"],
