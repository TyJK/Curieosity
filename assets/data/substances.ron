    5370: (
            id: 5370,
            name: "Etoposide",
            formula: "C29H32O13",
            state: Solid,
            molar_mass_g_mol: 588.1843,
            color_hex: None,
            melting_point_c: Some(243.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7389),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
