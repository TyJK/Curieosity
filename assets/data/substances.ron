    8059: (
            id: 8059,
            name: "Hexachlorocyclopentadiene",
            formula: "C5Cl6",
            state: Liquid,
            molar_mass_g_mol: 272.8,
            color_hex: None,
            melting_point_c: Some(-10.15),
            boiling_point_c: Some(238.85),
            density_g_cm3: Some(1.702),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6873),
