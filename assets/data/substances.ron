            density_g_cm3: Some(1.12),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.7055),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(-733.73),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Diethyl phthalate is a phthalate ester. This synthetic substance is commonly used to make plastics more flexible. Products in which it is found include toothbrushes, automobile parts, tools, toys, and food packaging. Diethyl phthalate can be released fairly easily from these products, as it is not part of the chain of chemicals (polymers) that makes up the plastic. Diethyl phthalate is also used in cosmetics, insecticides, and aspirin. Phthalate esters can cause reproductive and developmental toxicity. (L1900, A2883)"),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H315: Causes skin irritation [Warning Skin corrosion/irritation]"),
            uses: ["Fragrance", "Odor agents", "Plasticizer", "Plasticizers", "Surface active agents"],
            logp: Some(2.04),
            appearance: Some("Diethyl phthalate appears as a clear, colorless liquid without significant odor. More dense than water and insoluble in water. Hence sinks in water. Primary hazard is to the environment. Spread to the environment should be immediately stopped. Easily penetrates soil, contaminates groundwater and nearby waterways. Flash point 325 °F. Severely irritates eyes and mildly irritates skin. Used in the manufacture of perfumes, plastics, mosquito repellents and many other products."),
            synonyms: ["DEP", "Ethyl phthalate", "Diethyl o-phthalate", "1,2-Diethyl phthalate", "Phthalsaeurediaethylester", "Phthalic acid diethyl ester", "o-Bis(ethoxycarbonyl)benzene", "Diethyl ester of phthalic acid"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=21799023"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6781"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_34698"), ("Wikidata", "http://www.wikidata.org/entity/Q419811"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C84662&Units=SI")],
            element_info: None,
        ),
