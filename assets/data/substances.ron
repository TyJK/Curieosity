            references: [("Wikipedia", "https://en.wikipedia.org/?curid=22542034"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/61031"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_229419"), ("Wikidata", "http://www.wikidata.org/entity/Q209447"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C110418&Units=SI")],
