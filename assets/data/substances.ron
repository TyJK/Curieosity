            boiling_point_c: Some(175.85),
            density_g_cm3: Some(0.8411),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.5505),
            heat_capacity_gas_j_g_c: None,
