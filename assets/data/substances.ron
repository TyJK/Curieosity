            formula: "C17H24BrNO3",
            state: Solid,
            molar_mass_g_mol: 369.094,
            color_hex: None,
            melting_point_c: Some(191.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6194),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Homatropine methylbromide (INN; also known as methylhomatropine bromide) is a quaternary ammonium salt of methylhomatropine. It is a peripherally acting anticholinergic medication that inhibits muscarinic acetylcholine receptors and thus the parasympathetic nervous system.  It does not cross the blood–brain barrier. It is used to effectively relieve intestinal spasms and abdominal cramps, without producing the adverse effects of less specific anticholinergics.
It is used, in addition to papaverine, as a component of mild drugs that help \"flush\" the bile.
Certain preparations of drugs such as hydrocodone are mixed with a small, sub-therapeutic amount of homatropine methylbromide to discourage intentional overdose."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.421),
            appearance: None,
            synonyms: ["80-49-9", "Methylhomatropine bromide", "Omatropina metilbromuro", "8-Methylhomatropinium bromide", "Equipin", "Tropinium methobromide mandelate", "Methylhomatropinum bromatum", "Homapin-5"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=31416189"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C80499&Units=SI")],
            element_info: None,
