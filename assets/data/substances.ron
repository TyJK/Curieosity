            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Bisphenol A diglycidyl ether (commonly abbreviated BADGE or DGEBA) is an organic compound and is a liquid epoxy resin.  The compound is a colorless viscous liquid (commercial samples can appear pale straw-coloured). It is a key component of many epoxy resin formulations. Addition of further Bisphenol A and a catalyst and heat can produce Bisphenol A glycidyl ether epoxy resins of higher molecular weight that are solid."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H315: Causes skin irritation [Warning Skin corrosion/irritation]"),
            uses: ["Dispersing agent", "Intermediate", "Waterproofing agent", "Adhesive Manufacturing"],
            logp: Some(3.568),
            appearance: Some("Bisphenol a diglycidyl ether is an odorless yellowish brown liquid. Sinks in water. (USCG, 1999)"),
            synonyms: ["BADGE", "DGEBPA", "Bisphenol diglycidyl ether", "Diglycidyl bisphenol A ether", "2,2-Bis(4-glycidyloxyphenyl)propane", "2,2-bis(4'-glycidyloxyphenyl)propane", "4,4'-isopropylidenediphenol diglycidyl ether", "1675-54-3"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=24884697"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/2286"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_34578"), ("Wikidata", "http://www.wikidata.org/entity/Q2080808"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1675543&Units=SI")],
            element_info: None,
        ),
    4068: (
            id: 4068,
            name: "Flibanserin",
            formula: "C20H21F3N4O",
            state: Solid,
            molar_mass_g_mol: 390.1667,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.845),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Flibanserin, sold under the brand name Addyi, is a medication approved for the treatment of pre-menopausal women with hypoactive sexual desire disorder (HSDD). The medication attempts to improve sexual desire, increase the number of satisfying sexual events, and decrease the distress associated with low sexual desire. The most common side effects are dizziness, sleepiness, nausea, difficulty falling asleep or staying asleep and dry mouth.
Development by Boehringer Ingelheim was halted in October 2010, following a negative evaluation by the US Food and Drug Administration (FDA). The rights to the drug were then transferred to Sprout Pharmaceuticals, which achieved approval of the drug by the US FDA in August 2015. Addyi is approved for medical use in the United States for premenopausal women with hypoactive sexual desire disorder and in Canada for premenopausal and postmenopausal women with hypoactive sexual desire disorder.
Hypoactive sexual desire disorder was recognized as a distinct sexual function disorder for more than 30 years, but was removed from the Diagnostic and Statistical Manual of Mental Disorders in 2013, and replaced with a new diagnosis called female sexual interest/arousal disorder (FSIAD)."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.171),
            appearance: None,
            synonyms: ["167933-07-5", "Bimt-17", "Addyi", "Bimt 17", "Ectris", "Girosa", "BIMT 17 BS", "BIMT-17-BS"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=8650889"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C167933075&Units=SI")],
            element_info: None,
        ),
