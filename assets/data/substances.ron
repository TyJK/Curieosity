    8121: (
            id: 8121,
            name: "Calcium sulfate",
            formula: "CaSO4",
            state: Solid,
            molar_mass_g_mol: 138.16,
            color_hex: None,
            melting_point_c: Some(456.85),
            boiling_point_c: Some(2024.0),
            density_g_cm3: Some(2.96),
            heat_capacity_solid_j_g_c: Some(0.8353),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Calcium sulfate (or calcium sulphate) is an inorganic salt with the chemical formula CaSO4. It occurs in several hydrated forms; the anhydrous state (known as anhydrite) is a white crystalline solid often found in evaporite deposits. Its dihydrate form is the mineral gypsum, which may be dehydrated to produce bassanite, the hemihydrate state. Gypsum occurs in nature as crystals (selenite) or fibrous masses (satin spar), typically colorless to white, though impurities can impart other hues. All forms of calcium sulfate are sparingly soluble in water and cause permanent hardness when dissolved therein."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H335: May cause respiratory irritation [Warning Specific target organ toxicity, single exposure; Respiratory tract irritation]"),
            uses: ["Agricultural chemicals (non-pesticidal)", "Flame retardants"],
            logp: Some(-1.034),
            appearance: Some("Calcium sulfate appears as odorless, white powder or colorless, crystalline solid. Crystals sometimes have a blue, gray or reddish tinge or can be brick red. Density: 2.96 g cm-3."),
            synonyms: ["CaSO4", "Kalziumsulfat", "anhydrous gypsum", "calcium sulphate", "anhydrous calcium sulfate", "anhydrous sulfate of lime", "calcium sulfate anhydrous", "calcium sulfate, anhydrous"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=595183"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6335842"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_31346"), ("Wikidata", "http://www.wikidata.org/entity/Q407258"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C7778189&Units=SI")],
            element_info: None,
        ),
    8122: (
            id: 8122,
            name: "Calcium hypochlorite",
            formula: "Ca(OCl)2",
            state: Solid,
            molar_mass_g_mol: 92.54,
            color_hex: None,
            melting_point_c: Some(99.85),
            boiling_point_c: Some(174.85),
            density_g_cm3: Some(2.35),
            heat_capacity_solid_j_g_c: Some(0.7316),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Calcium hypochlorite is an inorganic compound with chemical formula Ca(ClO)2, also written as Ca(OCl)2. It is a white solid, although commercial samples appear yellow. It strongly smells of chlorine, owing to its slow decomposition in moist air. This compound is relatively stable as a solid and solution and has greater available chlorine than sodium hypochlorite. \"Pure\" samples have 99.2% active chlorine. Given common industrial purity, an active chlorine content of 65-70% is typical. It is the main active ingredient of commercial products called bleaching powder, used for water treatment and as a bleaching agent."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H272: May intensify fire; oxidizer [Danger Oxidizing liquids; Oxidizing solids]"),
            uses: [],
            logp: Some(-0.248),
            appearance: Some("Calcium hypochlorite appears as a white granular solid (or tablets compressed from the granules) with an odor of chlorine. Toxic, irritating to the skin. Noncombustible, but will accelerate the burning of combustible materials. Prolonged exposure to fire or heat may result in the vigorous decomposition of the material and rupture of the container. Diluted samples may undergo reactions as described above if they contain less than 39% available chlorine but take longer to become involved and react less vigorously. Used for water purification, disinfectant for swimming pools, for bleaching paper and textiles."),
            synonyms: ["Chlorinated lime", "bleaching powder", "7778-54-3", "Calcium hypochloride", "Hypochlorous acid, calcium salt", "Losantin", "Pittchlor", "Pittcide"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2898453"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/45051604"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_31342"), ("Wikidata", "http://www.wikidata.org/entity/Q407300"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C7778543&Units=SI")],
            element_info: None,
        ),
