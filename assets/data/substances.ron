            references: [("Wikipedia", "https://en.wikipedia.org/?curid=19218592"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/131859292"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_75227"), ("Wikidata", "http://www.wikidata.org/entity/Q3333421"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C7775191&Units=SI")],
