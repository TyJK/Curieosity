    3331: (
            id: 3331,
            name: "Boehmite (Al(OH)O)",
            formula: "γ-AlO(OH)",
            state: Solid,
            molar_mass_g_mol: 59.988,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: Some(3.02),
            heat_capacity_solid_j_g_c: Some(0.9902),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsMetal],
            description: Some("Boehmite or böhmite is an aluminium oxide hydroxide (γ-AlO(OH)) mineral, a component of the aluminium ore bauxite. It is dimorphous with diaspore. It crystallizes in the orthorhombic dipyramidal system and is typically massive in habit. It is white with tints of yellow, green, brown or red due to impurities. It has a vitreous to pearly luster, a Mohs hardness of 3 to 3.5 and a specific gravity of 3.00 to 3.07. It is colorless in thin section, optically biaxial positive with refractive indices of nα = 1.644 – 1.648, nβ = 1.654 – 1.657 and nγ = 1.661 – 1.668.
Boehmite occurs in tropical laterites and bauxites developed on alumino-silicate bedrock. It also occurs as a hydrothermal alteration product of corundum and nepheline. It occurs with kaolinite, gibbsite and diaspore in bauxite deposits; and with nepheline, gibbsite, diaspore, natrolite and analcime in nepheline pegmatites. Industrially, it is used as an inexpensive flame retardant additive for fire-safe polymers.
It was first described by J. de Lapparent in 1927 for an occurrence in the bauxites of Mas Rouge, Les Baux-de-Provence, France, and named for the Bohemian-German chemist Johann Böhm  (1895–1952) who carried out X-ray studies of aluminium oxide hydroxides in 1925 (and not for the German geologist Johannes Böhm (1857–1938) as often stated)."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H413 (10%): May cause long lasting harmful effects to aquatic life [Hazardous to the aquatic environment, long-term hazard]"),
            uses: ["Dispersing agent", "Flame retardants", "Process regulators", "Abrasives", "Adhesives and sealant chemicals", "Adsorbent"],
            logp: Some(-1.057),
            appearance: Some("Dry Powder; Liquid"),
            synonyms: ["OAlOH", "AlO(OH)", "Boehmite", "gamma-AlO(OH)", "AlO(OH) (boehmite type)", "aluminum hydroxide oxide", "aluminum oxide hydroxide", "Aluminium hydroxide oxide"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1089245"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/32524"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_30189"), ("Wikidata", "http://www.wikidata.org/entity/Q4291506"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1318236&Units=SI")],
            element_info: None,
        ),
