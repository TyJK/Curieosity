    8725: (
            id: 8725,
            name: "Opicapone",
            formula: "C15H10Cl2N4O6",
            state: Solid,
            molar_mass_g_mol: 411.9977,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8803),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Opicapone, sold under the brand name Ongentys, is a medication which is administered together with levodopa in people with Parkinson's disease. Opicapone is a catechol-O-methyltransferase (COMT) inhibitor.
The most common side effects are dyskinesia (difficulty controlling movement), constipation, increased blood creatine kinase, hypotension/syncope, and decreased weight.
Opicapone, works to restore the levels of dopamine in the parts of the brain that control movement and coordination. It enhances the effects of levodopa, a precursor of the neurotransmitter dopamine that can be taken by mouth. Opicapone blocks an enzyme that breaks down levodopa in the body called catechol-O-methyltransferase (COMT). It is peripherally selective and does not inhibit COMT in the brain. As a result of its COMT inhibition, levodopa remains active for longer. This helps to improve the symptoms of Parkinson's disease, such as stiffness and slowness of movement.
In June 2016, it was authorised for use in the European Union. It was authorised for use in the United States in April 2020."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.28),
            appearance: None,
            synonyms: ["BIA 9-1067", "923287-50-7", "ongentys", "Opicapona", "BIA-9-1067", "BIA-91067", "DTXSID601026417", "opicaponum"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=52836316"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C923287507&Units=SI")],
            element_info: None,
        ),
