    6300: (
            id: 6300,
            name: "Mefloquine",
            formula: "C17H16F6N2O",
            state: Solid,
            molar_mass_g_mol: 378.1167,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8468),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
