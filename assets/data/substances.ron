    7823: (
            id: 7823,
            name: "Cilostazol",
            formula: "C20H27N5O2",
            state: Solid,
            molar_mass_g_mol: 369.2165,
            color_hex: None,
            melting_point_c: Some(160.0),
            boiling_point_c: None,
