    6362: (
            id: 6362,
            name: "Procaine benzylpenicillin",
            formula: "C29H38N4O6S",
            state: Solid,
            molar_mass_g_mol: 570.2512,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7721),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid, IsBase],
            description: Some("Procaine benzylpenicillin also known as penicillin G procaine, is an antibiotic useful for the treatment of a number of bacterial infections. Specifically it is used for syphilis, anthrax, mouth infections, pneumonia, diphtheria, cellulitis, and animal bites. It is given by injection into a muscle.
Side effects include pain at the site of injection, blood clotting problems, seizures, and allergic reactions including anaphylaxis. When used to treat syphilis a Jarisch–Herxheimer reaction may occur. It is not recommended in those with a history of penicillin allergy or procaine allergy. Use during pregnancy and breastfeeding is relatively safe. Procaine benzylpenicillin is in the penicillin and beta lactam family of medications. It works via benzylpenicillin and results in bacterial death. Procaine makes the combination long acting.
Procaine benzylpenicillin was introduced for medical use in 1948. It is on the World Health Organization's List of Essential Medicines."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(2.628),
            appearance: None,
            synonyms: ["Procaine penicillin G", "Depocillin", "Duphapen", "Hostacillin", "Hydracillin", "Nopcaine", "Retardillin", "Vitablend"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=20846048"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C54353&Units=SI")],
            element_info: None,
