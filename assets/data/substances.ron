            logp: None,
            appearance: Some("Ethylenediamine appears as a clear colorless liquid with an ammonia-like odor. Flash point of 91 °F and a melting point of 47 °F. Corrosive to tissue. Vapors are heavier than air. Produces toxic oxides of nitrogen during combustion. Density 7.5 lb / gal. Used to make other chemicals and as a fungicide."),
            synonyms: ["en", "1,2-diaminoethane", "1,2-ethanediamine", "ethane-1,2-diamine", "107-15-3", "Ethylene diamine", "Ethylendiamine", "edamine"],
