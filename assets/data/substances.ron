            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid, IsBase],
            description: Some("Aminocaproic acid (also known as ε-aminocaproic acid, ε-Ahx, or 6-aminohexanoic acid) is a derivative and analogue of the amino acid lysine, which makes it an effective inhibitor for enzymes that bind that particular residue. Such enzymes include proteolytic enzymes like plasmin, the enzyme responsible for fibrinolysis. For this reason it is effective in treatment of certain bleeding disorders, and it is sold under the brand name Amicar. Aminocaproic acid is also an intermediate in the polymerization of Nylon-6, where it is formed by ring-opening hydrolysis of caprolactam. The crystal structure determination showed that the 6-aminohexanoic acid is present as a salt, at least in the solid state."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H315 (20.6%): Causes skin irritation [Warning Skin corrosion/irritation]"),
            uses: ["All Other Basic Organic Chemical Manufacturing", "MEDICATION", "MEDICATION (VET):"],
            logp: Some(0.59),
            appearance: Some("Water or Solvent Wet Solid"),
            synonyms: ["EACA", "Amicar®", "ε-aminocaproic acid", "6-Aminocaproic acid", "aminocaproic acid", "60-32-2", "Hexanoic acid, 6-amino-", "Epsilcapramin"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2875860"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/564"), ("Wikidata", "http://www.wikidata.org/entity/Q255968"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C60322&Units=SI")],
            element_info: None,
        ),
    6823: (
            id: 6823,
            name: "Linoleic acid",
            formula: "C18H32O2",
            state: Liquid,
            molar_mass_g_mol: 280.4,
            color_hex: None,
            melting_point_c: Some(12.0),
            boiling_point_c: Some(229.0),
            density_g_cm3: Some(0.9),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6006),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Linoleic acid (LA) is an organic compound with the formula CH3(CH2)4CH=CHCH2CH=CH(CH2)7COOH. Both alkene groups (−CH=CH−) are cis. It is a fatty acid sometimes denoted 18:2 (n−6) or 18:2 cis-9,12. A linoleate is a salt or ester of this acid.
Linoleic acid is a polyunsaturated, omega−6 fatty acid. It is a colorless liquid that is virtually insoluble in water but soluble in many organic solvents. It typically occurs in nature as a triglyceride (ester of glycerin) rather than as a free fatty acid. It is one of two essential fatty acids for humans, who must obtain it through their diet, and the most essential, because the body uses it as a base to make the others.
The word \"linoleic\" derives from Latin  linum 'flax' and  oleum 'oil', reflecting the fact that it was first isolated from linseed oil."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H226 (17%): Flammable liquid and vapor [Warning Flammable liquids]"),
            uses: ["All Other Basic Organic Chemical Manufacturing", "CIR ingredient: Linoleic Acid", "Calculated removal (%): 100", "Fuel"],
            logp: Some(5.885),
            appearance: None,
            synonyms: ["LA", "C18:2(n-6)", "linolic acid", "telfairic acid", "acido linoleico", "acide linoleique", "9Z,12Z-linoleic acid", "C18:2, n-6,9 all-cis"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=880497"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/3931"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_17351"), ("Wikidata", "http://www.wikidata.org/entity/Q407426"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C60333&Units=SI")],
            element_info: None,
