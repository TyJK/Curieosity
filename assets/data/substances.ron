    8090: (
            id: 8090,
            name: "Acamprosate",
            formula: "C5H11NO4S",
            state: Liquid,
            molar_mass_g_mol: 181.0409,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.839),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Acamprosate, sold under the brand name Campral, is a medication which reduces cravings in alcoholism. It is thought to stabilize chemical signaling in the brain that would otherwise be disrupted by alcohol withdrawal. When used alone, acamprosate is not an effective therapy for alcohol use disorder in most individuals, as it only addresses withdrawal symptoms and not psychological dependence. It facilitates a reduction in alcohol consumption as well as full abstinence when used in combination with psychosocial support or other drugs that address the addictive behavior.
Serious side effects include allergic reactions, abnormal heart rhythms, and low or high blood pressure, while less serious side effects include headaches, insomnia, and impotence. Diarrhea is the most common side effect. It is unclear if use is safe during pregnancy.
It is on the World Health Organization's List of Essential Medicines."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-1.1),
            appearance: None,
            synonyms: ["N-Acetyl homotaurine, Ca2+ bis-acetyl-homotauri…", "77337-76-9", "3-acetamidopropane-1-sulfonic acid", "N-Acetylhomotaurine", "Acamprosato", "Acamprosatum", "3-Acetamido-1-propanesulfonic acid", "Aotal"],
