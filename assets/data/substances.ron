    3314: (
            id: 3314,
            name: "Disodium sulfide",
            formula: "Na2S",
            state: Solid,
            molar_mass_g_mol: 79.06,
            color_hex: None,
            melting_point_c: Some(175.85),
            boiling_point_c: None,
            density_g_cm3: Some(1.856),
            heat_capacity_solid_j_g_c: Some(0.9436),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsMetal],
            description: Some("Sodium sulfide is a chemical compound with the formula Na2S, or more commonly its hydrate Na2S·9H2O. Both the anhydrous and the hydrated salts are colorless solids, although technical grades of sodium sulfide are generally yellow to brick red owing to the presence of polysulfides. It is commonly supplied as a crystalline mass, in flake form, or as a fused solid. They are water-soluble, giving strongly alkaline solutions.  When exposed to moisture, Na2S immediately hydrates to give sodium hydrosulfide. Sodium sulfide has an unpleasant rotten egg smell due to the hydrolysis to hydrogen sulfide in moist air.
Some commercial samples are described as Na2S·xH2O, where a weight percentage of Na2S is specified. Commonly available grades have around 60% Na2S by weight, which means that x is around 3. These grades of sodium sulfide are often marketed as \"sodium sulfide flakes\".  These samples consist of NaSH, NaOH, and water."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H301+H311 (15.7%): Toxic if swallowed or in contact with skin [Danger Acute toxicity, oral; acute toxicity, dermal]"),
            uses: ["Intermediates", "All Other Basic Inorganic Chemical Manufacturing", "Cleaning agent"],
            logp: Some(-0.113),
            appearance: Some("Sodium sulfide, hydrated, with not less than 30% water appears as yellow-pink or white deliquescent crystals, flakes or lumps. Contains at least 30% water. Alkaline. Burns skin, eyes and mucous membranes. Mildly corrosive to most metals. May be toxic by skin absorption. Releases toxic hydrogen sulfide gas when mixed with an acid."),
            synonyms: ["Na2S", "sodium sulfuret", "sodium sulphide", "sodium monosulfide", "anh. sodium sulfide", "disodium monosulfide", "sodium sulfide (anh.)", "anhydrous sodium sulfide"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2916631"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/237873"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_76208"), ("Wikidata", "http://www.wikidata.org/entity/Q407510"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1313822&Units=SI")],
            element_info: None,
        ),
