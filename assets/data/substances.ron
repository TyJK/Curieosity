    2256: (
            id: 2256,
            name: "Lansoprazole",
            formula: "C16H14F3N3O2S",
            state: Solid,
            molar_mass_g_mol: 369.0759,
            color_hex: None,
            melting_point_c: Some(178.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8508),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid, IsBase],
            description: Some("Lansoprazole, sold under the brand name Prevacid among others, is a medication which reduces stomach acid. It is a proton pump inhibitor (PPI), used to treat peptic ulcer disease, gastroesophageal reflux disease, and Zollinger–Ellison syndrome. Its effectiveness is similar to that of other PPIs. It is taken by mouth. Onset is over a few hours and effects last up to a couple of days.
Common side effects include constipation, abdominal pain, and nausea. Serious side effects may include osteoporosis, low blood magnesium, Clostridioides difficile infection, and pneumonia. Use in pregnancy and breastfeeding is of unclear safety. It works by blocking H+/K+-ATPase in the parietal cells of the stomach.
Lansoprazole was patented in 1984 and came into medical use in 1992. It is available as a generic medication. In 2022, it was the 224th most commonly prescribed medication in the United States, with more than 1 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.9),
            appearance: Some("gas"),
            synonyms: ["AG 1749", "103577-45-3", "Prevacid", "Limpidex", "Agopton", "Lanzor", "Takepron", "Zoton"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1425463"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C103577453&Units=SI")],
            element_info: None,
        ),
