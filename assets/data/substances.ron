    5529: (
            id: 5529,
            name: "Diazoxide",
            formula: "C8H7ClN2O2S",
            state: Solid,
            molar_mass_g_mol: 229.9917,
            color_hex: None,
            melting_point_c: Some(330.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8305),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Diazoxide, sold under the brand name Proglycem among others, is a medication used to treat low blood sugar due to a number of specific causes. This includes islet cell tumors that cannot be removed and leucine sensitivity. It can also be used in refractory cases of sulfonylurea toxicity. It is taken by mouth.
Diazoxide, used as the salt diazoxide choline, and sold under the brand name Vykat XR, is used for the treatment of hyperphagia in people with Prader–Willi syndrome. It was approved for this use in the United States in March 2025.
Common side effects include high blood sugar, fluid retention, low blood platelets, a fast heart rate, increased hair growth, and nausea. Other severe side effects include pulmonary hypertension and heart failure. It is chemically similar to thiazide diuretics. It works by decreasing insulin release from the pancreas and increasing glucose release by the liver.
Diazoxide was approved for medical use in the United States in 1973. It is on the World Health Organization's List of Essential Medicines. It is available as a generic medication."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.2),
            appearance: None,
            synonyms: ["364-98-7", "Proglycem", "Hyperstat", "Hypertonalum", "Mutabase", "Diazossido", "Diazoxido", "Diazoxidum"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1612851"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C364987&Units=SI")],
            element_info: None,
        ),
