            uses: ["Dye", "Intermediate", "Agriculture, Forestry, Fishing and Hunting", "All Other Basic Organic Chemical Manufacturing"],
            logp: Some(1.577),
            appearance: Some("O-toluidine appears as a clear colorless or light yellow liquid. May become reddish brown on exposure to air and light. Flash point 185 °F. Has about the same density as water and is very slightly soluble in water. Vapors are heavier than air. Confirmed carcinogen."),
            synonyms: ["2-Toluidine", "O-Toluidine", "o-Tolylamine", "2-Aminotoluene", "o-Aminotoluene", "2-methylaniline", "o-Methylaniline", "ortho-toluidine"],
