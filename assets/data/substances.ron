            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Azurite or Azure spar is a soft, deep-blue copper mineral produced by weathering of copper ore deposits. During the early 19th century, it was also known as chessylite, after the type locality at Chessy near Lyon, France. The mineral, a basic carbonate with the chemical formula Cu3(CO3)2(OH)2, has been known since ancient times, and was mentioned in Pliny the Elder's Natural History under the Greek name kuanos (κυανός: \"deep blue,\" root of English cyan) and the Latin name caeruleum. Copper (Cu2+) gives it its deep blue color."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-2.626),
            appearance: None,
            synonyms: ["Azurite blue", "Trimethoxyamphetamine", "TMA", "TMA-1", "3,4,5-TMA", "α-Methylmescaline", "alpha-Methylmescaline", "AMM"],
            references: [("Wikipedia", "https://en.wikipedia.org/wiki/3,4,5-Trimethoxyamphetamine"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/14009271"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_52735"), ("Wikidata", "http://www.wikidata.org/entity/Q4161307"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1319455&Units=SI")],
