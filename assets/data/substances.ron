            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Acetonitrile, often abbreviated MeCN (methyl cyanide), is the chemical compound with the formula CH3CN and structure H3C−C≡N. This colourless liquid is the simplest organic nitrile (hydrogen cyanide is a simpler nitrile, but the cyanide anion is not classed as organic). It is produced mainly as a byproduct of acrylonitrile manufacture. It is used as a polar aprotic solvent in organic synthesis and in the purification of butadiene. The N≡C−C skeleton is linear with a short C≡N distance of 1.16 Å.
Acetonitrile was first prepared in 1847 by the French chemist Jean-Baptiste Dumas."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225: Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Intermediate", "Intermediates", "Laboratory chemicals", "Solvent"],
            logp: Some(0.53),
            appearance: Some("Acetonitrile appears as a colorless limpid liquid with an aromatic odor. Flash point 42 °F. Density 0.783 g / cm3. Toxic by skin absorption. Less dense than water. Vapors are denser than air."),
            synonyms: ["ACN", "MeCN", "NCMe", "CH3-C#N", "cyanomethane", "ethanenitrile", "ethyl nitrile", "methyl cyanide"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=64141"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6342"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_38472"), ("Wikidata", "http://www.wikidata.org/entity/Q408047"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C75058&Units=SI")],
