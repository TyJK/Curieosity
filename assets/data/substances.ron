    7932: (
            id: 7932,
            name: "Lovastatin",
            formula: "C24H36O5",
            state: Solid,
            molar_mass_g_mol: 404.2563,
            color_hex: None,
            melting_point_c: Some(174.5),
            boiling_point_c: Some(1113.62),
