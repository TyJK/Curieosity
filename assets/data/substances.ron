    6706: (
            id: 6706,
            name: "Orciprenaline",
            formula: "C11H17NO3",
            state: Solid,
            molar_mass_g_mol: 211.1208,
            color_hex: None,
            melting_point_c: Some(100.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7465),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
