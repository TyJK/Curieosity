    8744: (
            id: 8744,
            name: "cis-3-Hexen-1-ol",
            formula: "C6H12O",
            state: Liquid,
            molar_mass_g_mol: 100.16,
            color_hex: None,
            melting_point_c: Some(-61.15),
            boiling_point_c: Some(156.45),
            density_g_cm3: Some(0.846),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.616),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("cis-3-Hexen-1-ol, also known as (Z)-3-hexen-1-ol and leaf alcohol, is a colorless oily liquid with an intense grassy-green odor of freshly cut green grass and leaves. It is produced in small amounts by most plants and it acts as an attractant to many predatory insects. cis-3-Hexen-1-ol is an important aroma compound that is used in fruit and vegetable flavors and in perfumes. The yearly production is about 30 tonnes.  Its esters are also important flavor and fragrance raw materials.
The related aldehyde cis-3-hexenal (leaf aldehyde) has a similar and even stronger smell but is relatively unstable and isomerizes into the conjugated trans-2-hexenal.
This compound has been recognized as a semiochemical involved in mechanisms and behaviors of attraction in diverse animals such as insects and mammals."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H226 (90.6%): Flammable liquid and vapor [Warning Flammable liquids]"),
            uses: ["Fragrance", "Odor agents", "Processing aids not otherwise specified", "All Other Basic Organic Chemical Manufacturing", "Flavoring and nutrient"],
            logp: Some(1.335),
            appearance: Some("colorless liquid"),
            synonyms: ["1-Hexen-3-ol", "hex-1-en-3-ol", "cis-3-Hexen-1-ol", "928-96-1", "(Z)-Hex-3-en-1-ol", "Leaf alcohol", "cis-3-Hexenol", "(Z)-3-Hexen-1-ol"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1585875"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/10993"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_173346"), ("Wikidata", "http://www.wikidata.org/entity/Q81976379"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C928961&Units=SI")],
            element_info: None,
        ),
    8747: (
            id: 8747,
            name: "Guaifenesin",
            formula: "C10H14O4",
            state: Liquid,
            molar_mass_g_mol: 198.0892,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: Some(215.0),
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.7158),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Guaifenesin, also known as glyceryl guaiacolate, sold under the brand name Mucinex, among others, is an expectorant medication taken by mouth and marketed as an aid to eliminate sputum from the respiratory tract. Chemically, it is an ether of guaiacol and glycerine. It may be used in combination with other medications. A 2014 study found that guaifenesin does not affect sputum volume in upper respiratory infections (the upper respiratory system includes most breathing parts above the lungs). It has been alleged to work in 2023 by making airway secretions more liquid.
Side effects may include dizziness, sleepiness, skin rash, and nausea. While it has not been properly studied in pregnancy, it appears to be safe.
Guaifenesin has been used medically since at least 1933. It is available as a generic medication and over-the-counter (OTC). In 2023, it was the 291st most commonly prescribed medication in the United States, with more than 500,000 prescriptions. In 2023, the combination dextromethorphan/guaifenesin was the 315th most commonly prescribed medication in the United States, with more than 200,000 prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.39),
            appearance: Some("liquid"),
            synonyms: ["93-14-1", "Guaiphenesin", "Guaiacol glyceryl ether", "3-(2-methoxyphenoxy)propane-1,2-diol", "GLYCERYL GUAIACOLATE", "Guaiphenesine", "Methphenoxydiol", "Glycerol guaiacolate"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=916456"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C93141&Units=SI")],
            element_info: None,
        ),
