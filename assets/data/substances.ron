            heat_capacity_liquid_j_g_c: Some(0.6747),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("1,1,1-Trichloroethane, also known as methyl chloroform and chlorothene, is a chloroalkane with the chemical formula CH3CCl3. It is an isomer of 1,1,2-trichloroethane. A colourless and sweet-smelling liquid, it was once produced industrially in large quantities for use as a solvent. It is regulated by the Montreal Protocol as an ozone-depleting substance, and as such, use has declined since 1996. Trichloroethane should not be confused with the similar-sounding trichloroethene which is also commonly used as a solvent."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Industrial Gas Manufacturing", "Plastics Material and Resin Manufacturing"],
            logp: Some(2.377),
            appearance: Some("Colourless liquid"),
            synonyms: ["Methylchloroform", "71-55-6", "Chlorothene", "Cleanite", "Inhibisol", "Chlorothene NU", "Chlorothene VG", "Aerothene TT"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=302493"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C71556&Units=SI")],
