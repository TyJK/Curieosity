            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Dimethyl carbonate (DMC) is an organic compound with the formula OC(OCH3)2.  It is a colourless, flammable liquid.  It is classified as a carbonate ester. This compound has found use as a methylating agent and as a co-solvent in lithium-ion batteries. Notably, dimethyl carbonate is a weak methylating agent, and is not considered as a carcinogen. Instead, dimethyl carbonate is often considered to be a green reagent,
and it is exempt from the restrictions placed on most volatile organic compounds (VOCs) in the United States."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225: Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Adhesives and sealant chemicals", "Conductive agent", "Intermediate", "Intermediates", "Pigments"],
            logp: Some(0.399),
            appearance: Some("Dimethyl carbonate appears as a clear, colorless liquid with a pleasant odor. Denser than water and slightly soluble in water. Vapors are heavier than air. Used to make other chemicals and as a special purpose solvent."),
            synonyms: ["DMC", "methyl carbonate", "carbonic acid, dimethyl ester", "616-38-6", "Methyl carbonate ((MeO)2CO)", "NSC 9371", "KE9J097SPN", "DTXSID9029192"],
