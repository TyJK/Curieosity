            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Methyl benzoate is an organic compound.  It is an ester with the chemical formula C6H5COOCH3, sometimes abbreviated as PhCO2Me, where Ph and Me are phenyl and methyl, respectively. Its structure is C6H5−C(=O)−O−CH3.  It is a colorless liquid that is poorly soluble in water, but miscible with organic solvents.  Methyl benzoate has a pleasant smell, strongly reminiscent of the fruit of the feijoa tree, and it is used in perfumery.  It also finds use as a solvent and as a pesticide used to attract insects such as orchid bees."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H302 (99.7%): Harmful if swallowed [Warning Acute toxicity, oral]"),
            uses: ["Odor agents", "All Other Basic Organic Chemical Manufacturing", "CIR ingredient: Methyl Benzoate", "In perfumes (Peau d'Espagne)"],
            logp: Some(1.473),
            appearance: Some("Methyl benzoate appears as a crystalline solid or a solid dissolved in a liquid. Denser than water. Contact may slightly irritate skin, eyes and mucous membranes. May be slightly toxic by ingestion. Used to make other chemicals."),
            synonyms: ["Methyl benzenecarboxylate", "Benzoic acid, methyl ester", "93-58-3", "Methylbenzoate", "benzoic acid methyl ester", "Clorius", "Essence of niobe", "FEMA No. 2683"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3003267"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7150"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_72775"), ("Wikidata", "http://www.wikidata.org/entity/Q417328"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C93583&Units=SI")],
            element_info: None,
        ),
