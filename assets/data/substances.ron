    8430: (
            id: 8430,
            name: "Diethyl phthalate",
            formula: "C6H4(COOC2H5)2",
            state: Liquid,
            molar_mass_g_mol: 222.24,
            color_hex: None,
            melting_point_c: Some(-3.15),
            boiling_point_c: Some(298.85),
            density_g_cm3: Some(1.12),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.7055),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Diethyl phthalate is a phthalate ester. This synthetic substance is commonly used to make plastics more flexible. Products in which it is found include toothbrushes, automobile parts, tools, toys, and food packaging. Diethyl phthalate can be released fairly easily from these products, as it is not part of the chain of chemicals (polymers) that makes up the plastic. Diethyl phthalate is also used in cosmetics, insecticides, and aspirin. Phthalate esters can cause reproductive and developmental toxicity. (L1900, A2883)"),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H315: Causes skin irritation [Warning Skin corrosion/irritation]"),
            uses: ["Fragrance", "Odor agents", "Plasticizer", "Plasticizers", "Surface active agents"],
            logp: Some(2.04),
            appearance: Some("Diethyl phthalate appears as a clear, colorless liquid without significant odor. More dense than water and insoluble in water. Hence sinks in water. Primary hazard is to the environment. Spread to the environment should be immediately stopped. Easily penetrates soil, contaminates groundwater and nearby waterways. Flash point 325 °F. Severely irritates eyes and mildly irritates skin. Used in the manufacture of perfumes, plastics, mosquito repellents and many other products."),
            synonyms: ["DEP", "Ethyl phthalate", "Diethyl o-phthalate", "1,2-Diethyl phthalate", "Phthalsaeurediaethylester", "Phthalic acid diethyl ester", "o-Bis(ethoxycarbonyl)benzene", "Diethyl ester of phthalic acid"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=21799023"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6781"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_34698"), ("Wikidata", "http://www.wikidata.org/entity/Q419811"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C84662&Units=SI")],
            element_info: None,
        ),
    8431: (
            id: 8431,
            name: "Diisobutyl phthalate",
            formula: "C16H22O4",
            state: Liquid,
            molar_mass_g_mol: 278.34,
            color_hex: None,
            melting_point_c: Some(-37.15),
            boiling_point_c: Some(319.85),
            density_g_cm3: Some(1.038),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6711),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Diisobutyl phthalate (DIBP) is a phthalate ester having the structural formula C6H4(COOCH2CH(CH3)2)2. It is formed by the esterification of isobutanol and phthalic anhydride. This and other phthalates are used as plasticizers due to their flexibility and durability. They are found in many industrial and personal products, such as lacquers, nail polish and cosmetics. DIBP can be absorbed via oral ingestion and dermal exposure. When it comes to excretion, DIBP is first converted into the hydrolytic monoester monoisobutyl phthalate (MIBP). The primary excretory route is urine, with biliary excretion being noted in minor amounts. DIBP has lower density and freezing point than the related compound dibutyl phthalate (DBP)."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H360Df: May damage the unborn child; Suspected of damaging fertility [Danger Reproductive toxicity]"),
            uses: ["Plasticizer"],
            logp: Some(3.312),
            appearance: None,
            synonyms: ["DIBP", "Palatinol IC", "Hexaplas M/1B", "Kodaflex DIBP", "isobutyl phthalate", "di(i-butyl)phthalate", "isobutyl-o-phthalate", "di-iso-butyl phthalate"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=4953420"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6782"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_79053"), ("Wikidata", "http://www.wikidata.org/entity/Q162259"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C84695&Units=SI")],
            element_info: None,
