            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Dabrafenib, sold under the brand name Tafinlar among others, is an anti-cancer medication used for the treatment of cancers associated with a mutated version of the gene BRAF. Dabrafenib acts as an inhibitor of the associated enzyme B-Raf, which plays a role in the regulation of cell growth.
The most common side effects include papilloma (warts), headache, nausea, vomiting, hyperkeratosis (thickening and toughening of the skin), hair loss, rash, joint pain, fever and tiredness. When taken in combination with trametinib, the most common side effects include fever, tiredness, nausea, chills, headache, diarrhea, vomiting, joint pain and rash.
Dabrafenib was approved for medical use in the United States in May 2013, and in the European Union in August 2013."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(5.365),
            appearance: None,
            synonyms: ["GSK-2118436", "1195765-45-7", "GSK2118436A", "QGP4HA4G1B", "GSK-2118436A", "CHEBI:75045", "DTXSID20152499", "dabrafenibum"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=38067798"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1195765457&Units=SI")],
            element_info: None,
