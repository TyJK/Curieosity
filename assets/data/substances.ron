            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1484936"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/2723671"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_45825"), ("Wikidata", "http://www.wikidata.org/entity/Q908825"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C2052495&Units=SI")],
