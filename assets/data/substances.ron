    3834: (
            id: 3834,
            name: "Tolvaptan",
            formula: "C26H25ClN2O3",
            state: Solid,
            molar_mass_g_mol: 448.1554,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7143),
            heat_capacity_liquid_j_g_c: None,
