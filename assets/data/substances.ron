            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("N,N-Diethyl-meta-toluamide, also called diethyltoluamide or DEET (, from DET, the initials of di- + ethyl + toluamide), is the oldest, one of the most effective, and most common active ingredients in commercial insect repellents. It is a colorless to slightly yellow oil intended to be applied to the skin or to clothing and provides protection against mosquitoes, flies, ticks, fleas, chiggers, leeches, and many other biting insects."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H302: Harmful if swallowed [Warning Acute toxicity, oral]"),
