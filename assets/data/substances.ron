            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Magnesium oxide (MgO), or magnesia, is a white hygroscopic solid mineral that occurs naturally as periclase and is a source of magnesium (see also oxide). It has an empirical formula of MgO and consists of a lattice of Mg2+ ions and O2− ions held together by ionic bonding. Magnesium hydroxide forms in the presence of water (MgO + H2O → Mg(OH)2), but it can be reversed by heating it to remove moisture.
Magnesium oxide was historically known as magnesia alba (literally, the white mineral from Magnesia), to differentiate it from magnesia nigra, a black mineral containing what is now known as manganese."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H319: Causes serious eye irritation [Warning Serious eye damage/eye irritation]"),
            uses: ["Absorbent", "Corrosion inhibitors and anti-scaling agents", "Fillers"],
            logp: Some(-0.5),
            appearance: Some("Magnesium oxide appears as a white solid, often found as a powder. When fine particles of magnesium oxide are dispersed in air, whether directly or when generated by the burning or cutting of magnesium metal, the resulting magnesium oxide fume is an inhalation hazard."),
            synonyms: ["MgO", "Magmitt", "magnesia", "magnesia usta", "magnesium monoxide", "Granmag", "Heavy magnesium oxide", "Calcined magnesia"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=162269"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/14792"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_31794"), ("Wikidata", "http://www.wikidata.org/entity/Q214769"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1309484&Units=SI")],
            element_info: None,
        ),
