            references: [("Wikipedia", "https://en.wikipedia.org/?curid=5022827"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/156589062"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_51111"), ("Wikidata", "http://www.wikidata.org/entity/Q412874"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1302814&Units=SI")],
            element_info: None,
