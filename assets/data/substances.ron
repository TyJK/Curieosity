    8395: (
            id: 8395,
            name: "Theobromine",
            formula: "C7H8N4O2",
            state: Solid,
            molar_mass_g_mol: 180.16,
            color_hex: None,
            melting_point_c: Some(357.22),
            boiling_point_c: Some(292.5),
            density_g_cm3: Some(1.522),
            heat_capacity_solid_j_g_c: Some(1.0319),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(82.19),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Theobromine, also known as xantheose, is the principal alkaloid of Theobroma cacao (cacao plant). Theobromine is slightly water-soluble (330 mg/L) with a bitter taste. In industry, theobromine is used as an additive and precursor to some cosmetics. It is found in chocolate and several other foods, including tea (Camellia sinensis), some American hollies (yaupon and guayusa) and the kola nut. It is a white or colourless solid, but commercial samples can appear yellowish.
Theobromine, a metabolite of caffeine, is processed in the liver into xanthine and methyluric acid, peaks in the blood 2–3 hours after ingestion due to its fat solubility, and primarily acts by inhibiting adenosine receptors with minor phosphodiesterase inhibition. It is a mild heart stimulant and bronchodilator in humans with limited central nervous system effects. It can be toxic or fatal to animals like dogs and cats due to their slower metabolism of the compound."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H360: May damage fertility or the unborn child [Danger Reproductive toxicity]"),
            uses: ["CIR ingredient: Theobromine", "Calculated removal (%): 75.1", "MEDICATION", "MEDICATION (VET)", "Reported uses (ppm):"],
            logp: Some(-1.04),
            appearance: Some("Theobromine is an odorless white crystalline powder. Bitter taste. pH (saturated solution in water): 5.5-7. (NTP, 1992)"),
            synonyms: ["Theobromin", "diurobromine", "3,7-Dimethylxanthine", "3,7-dimethyl-xanthine", "3,7-dimethylpurine-2,6-dione", "2,6-dihydroxy-3,7-dimethyl-purine", "3,7-dihydro-3,7-dimethyl-1H-purine-2,6-dione", "3,7-dimethyl-3,7-dihydro-1H-purine-2,6-dione"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=31128"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/5429"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_28946"), ("Wikidata", "http://www.wikidata.org/entity/Q206844"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C83670&Units=SI")],
            element_info: None,
