            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Glycidyl methacrylate (GMA) is an ester of methacrylic acid and glycidol. Containing both an epoxide and an acrylate group, the molecule is bifunctional. It is a common monomer used in the production of epoxy resins. While typical home epoxies contain diglycidyl ether of bisphenol A (DGEBA),  glycidyl methacrylate is instead used to provide epoxy functionalization to polyolefins and other acrylate resins. Glycidyl methacrylate is produced by several companies worldwide, including Dow Chemical.  It is used to prepare a range of composites."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H311: Toxic in contact with skin [Danger Acute toxicity, dermal]"),
            uses: ["In BIS-GMA dental resin.", "In hydrogel lenses.", "Intermediates"],
            logp: Some(0.505),
            appearance: Some("Glycidyl methacrylate is a colorless liquid with a fruity odor. Floats on water. (USCG, 1999)"),
            synonyms: ["Glycidol methacrylate", "2,3-Epoxypropyl methacrylate", "Glycidyl alpha-methylacrylate", "2,3-Epoxypropanol methacrylate", "2-((Methacryloxy)methyl)oxirane", "Methacrylic acid, 2,3-epoxypropyl ester", "(oxiran-2-yl)methyl 2-methylprop-2-enoate", "106-91-2"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=22736343"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7837"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_132844"), ("Wikidata", "http://www.wikidata.org/entity/Q2013175"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C106912&Units=SI")],
