            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Triphenylphosphine (IUPAC name: triphenylphosphane) is a common organophosphorus compound with the formula P(C6H5)3 and often abbreviated to PPh3 or Ph3P. It is versatile compound that is widely used as a reagent in organic synthesis and as a ligand for transition metal complexes, including ones that serve as catalysts in organometallic chemistry. PPh3 exists as relatively air stable, colorless crystals at room temperature. It dissolves in non-polar organic solvents such as benzene and diethyl ether."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H350 (89.1%): May cause cancer [Danger Carcinogenicity]"),
            uses: ["Catalyst", "Dyes", "Processing aids, not otherwise listed", "All Other Basic Organic Chemical Manufacturing", "Binder"],
            logp: Some(3.445),
            appearance: Some("Triphenyl phosphine appears as white crystals. (NTP, 1992)"),
            synonyms: ["TPP", "PPh3", "Ph3P", "PP 360", "Triphenylphosphan", "Triphenylphosphin", "triphenylphosphane", "triphenylphosphide"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1798259"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/11776"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_183318"), ("Wikidata", "http://www.wikidata.org/entity/Q115493"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C603350&Units=SI")],
