    2407: (
            id: 2407,
            name: "Butane",
            formula: "C4H10",
            state: Gas,
            molar_mass_g_mol: 58.12,
            color_hex: None,
            melting_point_c: Some(-137.15),
            boiling_point_c: Some(-0.15),
