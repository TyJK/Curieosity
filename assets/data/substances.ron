            synonyms: ["Leucocrystal Violet", "Ammonium manganese pyrophosphate", "Ammonium manganese(III) pyrophosphate", "4-[bis[4-(dimethylamino)phenyl]methyl]-N,N-dime…", "Ammonium manganese(3+) diphosphate", "72M48QQV8Q", "MINERAL VIOLET", "MANGO VIOLET"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=41467423"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/131864622"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_182175"), ("Wikidata", "http://www.wikidata.org/entity/Q15634059"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C10101663&Units=SI")],
