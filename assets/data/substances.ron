    5977: (
            id: 5977,
            name: "Edoxaban",
            formula: "C24H30ClN7O4S",
            state: Solid,
            molar_mass_g_mol: 547.1769,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8579),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
