    5997: (
            id: 5997,
            name: "Captodiame",
            formula: "C21H29NS2",
            state: Solid,
            molar_mass_g_mol: 359.1741,
            color_hex: None,
            melting_point_c: Some(124.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.634),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Captodiame (INN), also known as captodiamine, is an antihistamine sold under the trade names Covatine, Covatix, and Suvren which is used as a sedative and anxiolytic. The structure is related to diphenhydramine.
A 2004 study suggested captodiame may be helpful in preventing benzodiazepine withdrawal syndrome in people discontinuing benzodiazepine treatment.
In addition to its actions as an antihistamine, captodiamine has been found to act as a 5-HT2C receptor antagonist and σ1 receptor and D3 receptor agonist. It produces antidepressant-like effects in rats. However, captodiamine is unique among antidepressant-like drugs in that it increases brain-derived neurotrophic factor (BDNF) levels in the hypothalamus but not in the frontal cortex or hippocampus. This unique action may be related to its ability to attenuate stress-induced anhedonia and corticotropin-releasing factor (CRF) signaling in the hypothalamus."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(5.963),
            appearance: None,
            synonyms: ["Captodiamine", "486-17-9", "VUFB2350", "H93K9455DD", "DTXSID50862014", "RefChem:123338", "DTXCID70810850", "207-629-1"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=12718693"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C486179&Units=SI")],
            element_info: None,
        ),
