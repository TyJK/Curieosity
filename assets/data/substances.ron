    3686: (
            id: 3686,
            name: "Oleyl alcohol",
            formula: "C18H36O",
            state: Liquid,
            molar_mass_g_mol: 268.5,
            color_hex: None,
            melting_point_c: Some(15.85),
            boiling_point_c: Some(344.85),
            density_g_cm3: Some(0.845),
            heat_capacity_solid_j_g_c: None,
