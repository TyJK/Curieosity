            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("1-Dodecene is an alkene with the formula C10H21CH=CH2, consisting of a chain of twelve carbon atoms ending with a double bond. While there are many isomers of dodecene depending on which carbon the double bond is placed, this isomer is of greater commercial importance. It is classified as an alpha-olefin. Alpha-olefins are distinguished by having a double bond at the primary or alpha (α) position. This location of a double bond enhances the reactivity of the compound and makes it useful for a number of applications, especially for the production of detergents."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H304 (98.9%): May be fatal if swallowed and enters airways [Danger Aspiration hazard]"),
            uses: ["Intermediates", "Lubricants and lubricant additives", "Process regulators", "Viscosity adjustors", "CHEM INT FOR N-DODECYL DIMETHYL AMINE"],
            logp: Some(4.703),
            appearance: Some("1-dodecene appears as a clear colorless liquid with a mild, pleasnat odor. Insoluble in water and floats on water. Harmful or fatal by ingestion. Inhalation of vapors may irritate and damage lungs. High concentrations may have a narcotic effect."),
            synonyms: ["adacene 12", "dodecene-1", "neodene 12", "dodec-1-ene", "n-dodec-1-ene", "alpha-dodecene", "alpha-dodecylene", "112-41-4"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=37386074"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/8183"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_89713"), ("Wikidata", "http://www.wikidata.org/entity/Q161620"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C112414&Units=SI")],
            element_info: None,
        ),
