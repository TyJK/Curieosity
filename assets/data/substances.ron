            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Zingerone, also called vanillylacetone, is a major flavor component of ginger, providing the sweet flavor of cooked ginger. Zingerone is a crystalline solid that is sparingly soluble in water and soluble in ether. 
Zingerone is similar in chemical structure to other flavor chemicals such as vanillin and eugenol. It is used as a flavor additive in spice oils and in perfumery to introduce spicy aromas.
Fresh ginger does not contain zingerone, but it is produced by cooking or drying of the ginger root, which causes a reverse aldol reaction on gingerol."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["FLAVOR INGREDIENT", "Flavoring"],
            logp: Some(1.922),
            appearance: None,
            synonyms: ["Gingerone", "Zingherone", "(0)-Paradol", "Zingiberone", "[0]-Paradol", "Vanillylacetone", "3-Methoxy-4-hydroxybenzylacetone", "4-Hydroxy-3-methoxybenzylacetone"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3399952"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/31211"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_68657"), ("Wikidata", "http://www.wikidata.org/entity/Q1064625"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C122485&Units=SI")],
