    8270: (
            id: 8270,
            name: "Dapsone",
            formula: "C12H12N2O2S",
            state: Solid,
            molar_mass_g_mol: 248.3,
            color_hex: None,
            melting_point_c: Some(175.5),
            boiling_point_c: None,
            density_g_cm3: Some(1.33),
            heat_capacity_solid_j_g_c: Some(0.7894),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Dapsone, also known as 4,4'-sulfonyldianiline (SDA) or diaminodiphenyl sulfone (DDS), is an antibiotic commonly used in combination with rifampicin and clofazimine for the treatment of leprosy. It is a second-line medication for the treatment and prevention of pneumocystis pneumonia and for the prevention of toxoplasmosis in those who have poor immune function. Additionally, it has been used for acne, dermatitis herpetiformis, and various other skin conditions. Dapsone is available both topically and by mouth.
Severe side effects may include a decrease in blood cells, red blood cell breakdown especially in those with glucose-6-phosphate dehydrogenase deficiency (G-6-PD), or hypersensitivity. Common side effects include nausea and loss of appetite. Other side effects include liver inflammation, methemoglobinemia, and a number of types of skin rashes. While the safety of use during pregnancy is not entirely clear some physicians recommend that it be continued in those with leprosy. It is of the sulfone class.
Dapsone was first studied as an antibiotic in 1937. Its use for leprosy began in 1945. It is on the World Health Organization's List of Essential Medicines. The form, which is taken by mouth, is available as a generic drug and not very expensive."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H372: Causes damage to organs through prolonged or repeated exposure [Danger Specific target organ toxicity, repeated exposure]"),
            uses: ["Adhesive Manufacturing", "Calculated removal (%): 22.1"],
            logp: Some(1.684),
            appearance: Some("4,4'-sulfonyldianiline appears as odorless white or creamy white crystalline powder. Slightly bitter taste. (NTP, 1992)"),
            synonyms: ["DDS", "DADPS", "Aczone", "dapsona", "dapsonum", "4,4'-Dapsone", "DIAPHENYLSULFONE", "4,4'-Sulfonyldianilin"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=660116"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/2955"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_4325"), ("Wikidata", "http://www.wikidata.org/entity/Q422226"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C80080&Units=SI")],
            element_info: None,
        ),
