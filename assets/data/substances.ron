    6736: (
            id: 6736,
            name: "Isocarboxazid",
            formula: "C12H13N3O2",
            state: Solid,
            molar_mass_g_mol: 231.1008,
            color_hex: None,
            melting_point_c: Some(105.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8585),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Isocarboxazid, sold under the brand name Marplan among others, is a non-selective irreversible monoamine oxidase inhibitor (MAOI) of the hydrazine class used as an antidepressant. Along with phenelzine and tranylcypromine, it is one of only three classical MAOIs still available for clinical use in the treatment of psychiatric disorders in the United States, though it is not as commonly employed in comparison to the others.
Isocarboxazid is primarily used to treat mood and anxiety disorders. It has also been investigated in the treatment of schizophrenia, Parkinson's disease, and other dementia-related disorders. 
Isocarboxazid, as well as other MAOIs, increase the levels of the monoamine neurotransmitters serotonin, dopamine, norepinephrine, epinephrine, melatonin, and phenethylamine in the brain.
Classical MAOIs, including isocarboxazid, are used only rarely due to prominent food and drug interactions and have been largely superseded by newer antidepressants such as the selective serotonin reuptake inhibitors (SSRIs). The cause of the interactions is because MAOIs inhibit the metabolism of dietary amines (e.g., tyramine) and the monoamine neurotransmitters. In combination with other drugs that increase the levels of the monoamine neurotransmitters such as the SSRIs, or with certain foods high in dietary amines such as aged cheeses, MAOIs can produce dangerous elevations of monoamine neurotransmitters resulting in potentially life-threatening syndromes such as hypertensive crisis and serotonin syndrome."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.49),
            appearance: None,
            synonyms: ["59-63-2", "Isocarboxazide", "Enerzer", "Marplan", "Isocarbonazid", "Isocarbossazide", "N'-benzyl-5-methyl-1,2-oxazole-3-carbohydrazide", "Isocarboxazida"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2171835"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C59632&Units=SI")],
            element_info: None,
        ),
