    4101: (
            id: 4101,
            name: "Tadalafil",
            formula: "C22H19N3O4",
            state: Solid,
            molar_mass_g_mol: 389.1376,
            color_hex: None,
            melting_point_c: Some(301.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7884),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Tadalafil, sold under the brand name Cialis among others, is a medication used to treat erectile dysfunction, benign prostatic hyperplasia, and pulmonary arterial hypertension. It is taken by mouth. Onset is typically within half an hour and the duration is up to 36 hours.
Common side effects include headache, muscle pain, flushing, and nausea. Caution is advised in those with cardiovascular disease. Rare but serious side effects include a prolonged erection that can lead to damage to the penis, vision problems, and hearing loss. Tadalafil is not recommended in people taking nitrovasodilators such as nitroglycerin, as this may result in a serious drop in blood pressure. Tadalafil is a PDE5 inhibitor which increases blood flow to the penis. It also dilates blood vessels in the lungs, which lowers the pulmonary artery pressure.
Tadalafil was approved for medical use in the United States in 2003. It is available as a generic medication. In 2022, it was the 172nd most commonly prescribed medication in the United States, with more than 3 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.7),
            appearance: None,
            synonyms: ["Cialis", "171596-29-5", "Ic351", "ADCIRCA", "IC 351", "IC-351", "Tadalafilo", "Tadalafil mylan"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=382271"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C171596295&Units=SI")],
            element_info: None,
