    6244: (
            id: 6244,
            name: "Flucloxacillin",
            formula: "C19H17ClFN3O5S",
            state: Solid,
            molar_mass_g_mol: 453.0561,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8158),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid, IsBase],
            description: Some("Flucloxacillin, also known as floxacillin, is an antibiotic used to treat skin infections, external ear infections, infections of leg ulcers, diabetic foot infections, and infection of bone. It may be used together with other medications to treat pneumonia, and endocarditis. It may also be used prior to surgery to prevent Staphylococcus infections. It is not effective against methicillin-resistant Staphylococcus aureus (MRSA). It is taken by mouth or given by injection into a vein or muscle.
Common side effects include an upset stomach. Other side effects may include muscle or joint pains, shortness of breath, and liver problems. It appears to be safe during pregnancy and breastfeeding. It should not be used in those who are allergic to penicillin. It is a narrow-spectrum beta-lactam antibiotic of the penicillin class. It is similar in effect to cloxacillin and dicloxacillin, being active against penicillinase forming bacteria.
Flucloxacillin was patented in 1961.
Flucloxacillin is not available in the United States."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(2.58),
            appearance: None,
            synonyms: ["BRL-2039", "FLOXACILLIN", "5250-39-5", "flucloxacilina", "Flucloxacilline", "Flucloxacillinum", "BRL 2039", "CHEBI:5098"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3219247"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C5250395&Units=SI")],
            element_info: None,
        ),
