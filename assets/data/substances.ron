    2831: (
            id: 2831,
            name: "Benzyl salicylate",
            formula: "C14H12O3",
            state: Liquid,
            molar_mass_g_mol: 228.24,
            color_hex: None,
            melting_point_c: Some(24.35),
            boiling_point_c: Some(317.85),
            density_g_cm3: Some(1.17),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6795),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Benzyl salicylate is a salicylic acid benzyl ester, a chemical compound  most frequently used in cosmetics as a fragrance additive or UV light absorber. It appears as an almost colorless liquid with a mild odor described as \"very faint, sweet-floral, slightly balsamic\" by some, while others smell nothing at all. There is debate whether the odour is caused solely by impurities or a genetic predisposition. It occurs naturally in a variety of plants and plant extracts and is widely used in blends of fragrance materials.
There is some evidence that people may become sensitized to this material and as a result, there is a restriction standard concerning the use of this material in fragrances by the International Fragrance Association.
It is used as  a solvent for crystalline synthetic musks and as a component and fixative in floral perfumes such as carnation, jasmine, lilac, and wallflower."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H317: May cause an allergic skin reaction [Warning Sensitization, Skin]"),
