    6520: (
            id: 6520,
            name: "Hexobarbital",
            formula: "C12H16N2O3",
            state: Solid,
            molar_mass_g_mol: 236.1161,
            color_hex: None,
            melting_point_c: Some(146.5),
            boiling_point_c: Some(378.73),
            density_g_cm3: Some(1.1623),
            heat_capacity_solid_j_g_c: Some(0.8051),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Hexobarbital or hexobarbitone, sold both in acid and sodium salt forms as Citopan, Evipan, and Tobinal, is a barbiturate derivative having hypnotic and sedative effects. It was used in the 1940s and 1950s as an agent for inducing anesthesia for surgery, as well as a rapid-acting, short-lasting hypnotic for general use, and has a relatively fast onset of effects and short duration of action. Modern barbiturates (such as Thiopental) have largely supplanted the use of hexobarbital as an anesthetic, as they allow for better control of the depth of anesthesia. Hexobarbital is still used in some scientific research."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.98),
