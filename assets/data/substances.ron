    3317: (
            id: 3317,
            name: "Nickel nitrate",
            formula: "Ni(NO3)2",
            state: Solid,
            molar_mass_g_mol: 121.706,
            color_hex: None,
            melting_point_c: Some(56.65),
            boiling_point_c: Some(144.85),
            density_g_cm3: Some(2.05),
            heat_capacity_solid_j_g_c: Some(0.8307),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Nickel (II) nitrate is the inorganic compound Ni(NO3)2 or any hydrate thereof.   In the hexahydrate, the nitrate anions are not bonded to nickel. Other hydrates have also been reported: Ni(NO3)2.9H2O, Ni(NO3)2.4H2O, and Ni(NO3)2.2H2O.
It is prepared by the reaction of nickel oxide with nitric acid:

NiO  +  2 HNO3  +  5 H2O    →    Ni(NO3)2.6H2O
The anhydrous nickel nitrate is typically not prepared by heating the hydrates.  Rather it is generated by the reaction of hydrates with dinitrogen pentoxide or of nickel carbonyl with dinitrogen tetroxide:

Ni(CO)4  +   2 N2O4   →   Ni(NO3)2  +  2 NO  +  4 CO
The hydrated nitrate is often used as a precursor to supported nickel catalysts."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H272: May intensify fire; oxidizer [Danger Oxidizing liquids; Oxidizing solids]"),
            uses: ["All Other Basic Inorganic Chemical Manufacturing", "COLORANT FOR GLASS", "Catalyst"],
            logp: Some(-0.35),
            appearance: None,
            synonyms: ["NO3", "NO3(-)", "nitrate", "[NO3](-)", "NITRATE ION", "nitrate(1-)", "trioxonitrate(V)", "trioxonitrate(1-)"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=5901542"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/157159085"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_17632"), ("Wikidata", "http://www.wikidata.org/entity/Q425274"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C13138459&Units=SI")],
            element_info: None,
        ),
