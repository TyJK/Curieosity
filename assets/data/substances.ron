            references: [("Wikipedia", "https://en.wikipedia.org/?curid=37948481"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/170839884"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_35607"), ("Wikidata", "http://www.wikidata.org/entity/Q866601"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C14059337&Units=SI")],
