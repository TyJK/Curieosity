            appearance: Some("Other Solid"),
            synonyms: ["WE(16:0/16:0)", "n-hexadecanyl palmitate", "hexadecanyl hexadecanoate", "n-hexadecyl hexadecanoate", "palmitic acid, cetyl ester", "palmitic acid palmityl ester", "hexadecanoic acid, hexadecyl ester", "Palmityl palmitate"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=25399724"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/10889"), ("Wikidata", "http://www.wikidata.org/entity/Q409361"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C540103&Units=SI")],
