            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Cyanamide is an organic compound with the formula CN2H2. This white solid is widely used in agriculture and the production of pharmaceuticals and other organic compounds. It is also used as an alcohol-deterrent drug. The molecule features a nitrile group attached to an amino group. Derivatives of this compound are also referred to as cyanamides, the most common being calcium cyanamide (CaCN2)."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H301: Toxic if swallowed [Danger Acute toxicity, oral]"),
            uses: [],
            logp: Some(-0.574),
            appearance: Some("Cyanamide appears as colorless deliquescent crystals. Mp: 45 °C; bp: 260 °C. Density: 1.282 g cm-3. Quite soluble in water (77 g / 100 g solution at 15 °C). Soluble in butanol, methyl ethyl ketone, ethyl acetate, alcohols, phenols, amines, ethers. Note: The term \"cyanamide\" is also used to refer to the important compound calcium cyanamide, which is a different chemical."),
            synonyms: ["NH2CN", "H2N-C#N", "Carbimide", "cyanoamine", "Carbodiimide", "Amidocyanogen", "carbamonitrile", "Cyanogen nitride"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2926930"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/9864"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_16698"), ("Wikidata", "http://www.wikidata.org/entity/Q414555"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C420042&Units=SI")],
            element_info: None,
