    7284: (
            id: 7284,
            name: "Vitamin D3",
            formula: "C27H44O",
            state: Solid,
            molar_mass_g_mol: 384.6,
            color_hex: None,
            melting_point_c: Some(84.5),
            boiling_point_c: Some(496.4),
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.5699),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Cholecalciferol, also known as vitamin D3, colecalciferol or calciol, is a type of vitamin D that is produced by the skin when exposed to UVB light; it is found in certain foods and can be taken as a dietary supplement.
Cholecalciferol is synthesised in the skin following sunlight exposure. It is then converted in the liver to calcifediol (25-hydroxycholecalciferol D), which is further converted in the kidney to calcitriol (1,25-dihydroxycholecalciferol D). One of calcitriol's most important functions is to promote calcium uptake by the intestines. Cholecalciferol is present in food such as fatty fish, beef liver, eggs, and cheese. In some countries, cholecalciferol is also added to products like plants, cow milk, fruit juice, yogurt, and margarine.
Cholecalciferol can be taken orally as a dietary supplement to prevent vitamin D deficiency or as a medication to treat associated diseases, including rickets. It is also used in the management of familial hypophosphatemia, hypoparathyroidism that is causing low blood calcium, and Fanconi syndrome. Vitamin-D supplements may not be effective in people with severe kidney disease. Excessive doses in humans can result in vomiting, constipation, muscle weakness, and confusion. Other risks include kidney stones. Doses greater than 40000 IU (1000 μg) per day are generally required before high blood calcium occurs. Normal doses, 800–2000 IU per day, are safe in pregnancy.
Cholecalciferol was first described in 1936. It is on the World Health Organization's List of Essential Medicines. In 2023, it was the 68th most commonly prescribed medication in the United States, with more than 9 million prescriptions. Cholecalciferol is available as a generic medication."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(7.619),
            appearance: None,
            synonyms: ["vitamin D", "D vitamins", "vitamin D3", "vitamin Ds", "vitamins D", "vitamin D vitamer", "vitamin D vitamers", "cholecalciferol"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=470084"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/2735"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_27300"), ("Wikidata", "http://www.wikidata.org/entity/Q32039085"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C67970&Units=SI")],
            element_info: None,
        ),
