            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Estragole (p-allylanisole, methyl chavicol) is a phenylpropene, a natural organic compound. Its chemical structure consists of a benzene ring substituted with a methoxy group and an allyl group. It is an isomer of anethole, differing with respect to the location of the double bond. It is a colorless liquid, although impure samples can appear yellow. It is a component of various trees and plants, including turpentine (pine oil), anise, fennel, bay, tarragon, and basil. It is used in the preparation of fragrances.
The compound is named for estragon, the French name of tarragon."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H302 (99.8%): Harmful if swallowed [Warning Acute toxicity, oral]"),
            uses: ["All Other Basic Organic Chemical Manufacturing", "In perfumes and as flavor in foods and liqueurs.", "Intermediates", "MEDICATION"],
            logp: Some(2.424),
            appearance: Some("Estragole is a colorless liquid with odor of anise. Insoluble in water. Isolated from rind of persea gratissima grath. and from oil of estragon. Found in oils of Russian anise, basil, fennel turpentine, tarragon oil, anise bark oil. (NTP, 1992)"),
            synonyms: ["esdragol", "esdragon", "estragol", "FEMA 2411", "esdragole", "isoanethole", "isoanthethole", "4-allylanisole"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3386326"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/8815"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_4867"), ("Wikidata", "http://www.wikidata.org/entity/Q419495"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C140670&Units=SI")],
            element_info: None,
        ),
    3610: (
            id: 3610,
            name: "(-)-Menthone",
            formula: "C10H18O",
            state: Liquid,
            molar_mass_g_mol: 154.25,
            color_hex: None,
            melting_point_c: Some(-6.15),
            boiling_point_c: Some(206.85),
            density_g_cm3: Some(0.895),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.5945),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(-265.59),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Menthone is a chemical compound of the monoterpene class of naturally occurring organic compounds found in a number of essential oils, one that presents with minty flavor. It is a specific pair of stereoisomers of the four possible such isomers for the chemical structure, 2-isopropyl-5-methylcyclohexanone. Of those, the stereoisoomer l-menthone—formally, the (2S,5R)-trans isomer of that structure, as shown at right—is the most abundant in nature. Menthone is structurally related to menthol, which has a secondary alcohol (>C-OH) in place of the carbon-oxygen double bond (carbonyl group) projecting from the cyclohexane ring. 
Menthone is obtained for commercial use after purifying essential oils pressed from Mentha species (peppermint and corn mint). It is used as a flavorant and in perfumes and cosmetics for its characteristic aromatic and minty aroma."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H315 (88.8%): Causes skin irritation [Warning Skin corrosion/irritation]"),
            uses: ["Fragrance", "Calculated removal (%): 82.3", "Use (kg; approx.) in Germany (2009): >10"],
            logp: Some(2.648),
            appearance: Some("colourless slightly oily liquid with a  peppermint odour"),
            synonyms: ["l-Menthone", "p-Menthan-3-one", "(1R,4S)-menthone", "(1R,4S)-p-menthan-3-one", "(2S,5R)-2-isopropyl-5-methylcyclohexanone", "(2S,5R)-5-methyl-2-(propan-2-yl)cyclohexanone", "(2S,5R)-5-methyl-2-(1-methylethyl)cyclohexanone", "(2S-trans)-5-methyl-2-(1-methylethyl)cyclohexan…"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3214194"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6986"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_15410"), ("Wikidata", "http://www.wikidata.org/entity/Q27104381"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C14073973&Units=SI")],
            element_info: None,
