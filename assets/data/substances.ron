            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Dichlorosilane, or DCS as it is commonly known, is a chemical compound with the formula H2SiCl2. In its major use, it is mixed with ammonia (NH3) in LPCVD chambers to grow silicon nitride in semiconductor processing. A higher concentration of DCS·NH3 (i.e. 16:1), usually results in lower stress nitride films."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H220 (100%): Extremely flammable gas [Danger Flammable gases]"),
