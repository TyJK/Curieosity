    3900: (
            id: 3900,
            name: "Tranylcypromine",
            formula: "C9H11N",
            state: Solid,
            molar_mass_g_mol: 133.0891,
            color_hex: None,
            melting_point_c: Some(79.5),
            boiling_point_c: None,
            density_g_cm3: None,
