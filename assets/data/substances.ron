            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Dimethyldiethoxysilane, sometimes abbreviated DMDEOS or DMDES, is an organosilicon compound. DMDEOS is a precursor in the production of the silicone polymer polydimethylsiloxane (PDMS).
DMDEOS is an intermediate silane useful for blocking hydroxyl and amino groups in organic synthesis reactions. This silylating step allows subsequent reactions to be carried out which would be adversely affected by the presence of active hydrogen in the hydroxyl or amine groups. Following the reaction step, hydroxyl or amine groups blocked with DMDEOS may be recovered by a hydrolysis procedure. DMDEOS is also used for preparing hydrophobic and release materials as well as enhancing flow of powders."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225 (98%): Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["All Other Basic Inorganic Chemical Manufacturing", "Intermediate"],
            logp: Some(1.761),
            appearance: Some("Dimethyldiethoxysilane appears as a colorless liquid. Less dense than water and insoluble in water. Vapors heavier than air."),
            synonyms: ["Diethoxydimethylsilane", "Diethoxy(dimethyl)silane", "Silane, diethoxydimethyl-", "Dimethyl-diethoxysilan", "Dimethyl-diethoxysilan [Czech]", "CCRIS 1321", "dimethyl diethoxy silane", "EINECS 201-127-6"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=22635047"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/62322"), ("Wikidata", "http://www.wikidata.org/entity/Q424884"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C78626&Units=SI")],
            element_info: None,
