    8143: (
            id: 8143,
            name: "(-)-α-Pinene",
            formula: "C10H16",
            state: Liquid,
            molar_mass_g_mol: 136.23,
            color_hex: None,
            melting_point_c: Some(-62.8),
            boiling_point_c: Some(154.85),
            density_g_cm3: Some(0.858),
