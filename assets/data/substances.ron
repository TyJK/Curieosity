    2889: (
            id: 2889,
            name: "Benzyl benzoate",
            formula: "C14H12O2",
            state: Liquid,
            molar_mass_g_mol: 212.24,
            color_hex: None,
            melting_point_c: Some(21.0),
            boiling_point_c: Some(324.0),
            density_g_cm3: Some(1.118),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6521),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
