            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Fursultiamine (INN; chemical name thiamine tetrahydrofurfuryl disulfide or TTFD; brand names Adventan, Alinamin-F, Benlipoid, Bevitol Lipophil, Judolor, Lipothiamine) is a medication and vitamin used to treat thiamine deficiency.  Chemically, it is a disulfide derivative of thiamine and is similar in structure to allithiamine.  
It was synthesized in Japan in the 1960s from allithiamine for the purpose of developing forms of thiamine with improved lipophilicity for treating vitamin B1 deficiency (i.e., beriberi), It was subsequently commercialized not only in Japan but also in Spain, Austria, Germany, and the United States."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(2.5),
            appearance: None,
            synonyms: ["804-30-8", "Fursultiamin", "TTFD", "Thiamine tetrahydrofurfuryl disulfide", "Fursultiamina", "Judolor", "Aliaron F", "Fursultiaminum"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=29210138"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C804308&Units=SI")],
            element_info: None,
        ),
