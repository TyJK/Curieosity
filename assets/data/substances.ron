            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("1-Propanol (also propan-1-ol, propanol, n-propyl alcohol) is a primary alcohol with the formula CH3CH2CH2OH and sometimes represented as PrOH or n-PrOH. It is a colourless liquid and an isomer of 2-propanol. 1-Propanol is used as a solvent in the pharmaceutical industry, mainly for resins and cellulose esters, and, sometimes, as a disinfecting agent."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225: Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Cleaning agent", "Defoamer", "Dye", "Pigments", "Processing aids, not otherwise listed"],
            logp: None,
            appearance: Some("N-propanol appears as a clear colorless liquid with a sharp musty odor like rubbing alcohol. Flash point 53-77 °F. Autoignites at 700 °F. Vapors are heavier than air and mildly irritate the eyes, nose, and throat. Density approximately 6.5 lb / gal. Used in making cosmetics, skin and hair preparations, pharmaceuticals, perfumes, lacquer formulations, dye solutions, antifreezes, rubbing alcohols, soaps, window cleaners, acetone and other chemicals and products."),
            synonyms: ["Optal", "UN 1274", "Propanol", "1-proponol", "N-PROPANOL", "propanol-1", "Propan-1-ol", "Propane-1-ol"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3205366"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/1031"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_28831"), ("Wikidata", "http://www.wikidata.org/entity/Q14985"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C71238&Units=SI")],
            element_info: None,
