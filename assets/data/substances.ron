            decay_particle_id: None,
            properties: [],
            description: Some("Terephthaloyl chloride (TCL, 1,4-benzenedicarbonyl chloride) is the acyl chloride of terephthalic acid.  It is a white solid at room temperature. It is one of two precursors used to make Kevlar, the other being p-phenylenediamine. TCL is used as a key component in performance polymers and aramid fibers, where it imparts flame resistance, chemical resistance, temperature stability, light weight, and very high strength. TCL is also an effective water scavenger, used to stabilize isocyanates and urethane prepolymers."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H314 (11.2%): Causes severe skin burns and eye damage [Danger Skin corrosion/irritation]"),
            uses: ["Intermediate", "Intermediates", "Organic Fiber Manufacturing", "Plastics Material and Resin Manufacturing"],
            logp: Some(2.445),
            appearance: Some("Dry Powder; Pellets or Large Crystals"),
            synonyms: ["Cl-", "Cl(-)", "Chloride", "CHLORIDE ION", "Chloride(1-)", "Chlorine anion", "p-Phthaloyl chloride", "1,4-Benzenedicarbonyl chloride"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3001955"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7488"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_17996"), ("Wikidata", "http://www.wikidata.org/entity/Q7702072"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C100209&Units=SI")],
