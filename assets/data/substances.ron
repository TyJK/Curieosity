            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Cumene (isopropylbenzene) is an organic compound that contains a benzene ring with an isopropyl substituent.  It is a constituent of crude oil and refined fuels.  It is a flammable colorless liquid that has a boiling point of 152 °C.  Nearly all the cumene that is produced as a pure compound on an industrial scale is converted to cumene hydroperoxide, which is an intermediate in the synthesis of other industrially important chemicals, primarily phenol and acetone (known as the cumene process)."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H304: May be fatal if swallowed and enters airways [Danger Aspiration hazard]"),
            uses: ["Adhesion/cohesion promoter", "Fuels and fuel additives"],
            logp: Some(2.81),
            appearance: Some("Cumene appears as a clear colorless liquid with an aromatic odor. Less dense than water and insoluble in water. Vapors heavier than air. May be moderately toxic by inhalation, ingestion and skin absorption."),
            synonyms: ["Cumol", "Phenol bottoms", "2-Phenylpropane", "I-Propylbenzene", "Isopropylbenzol", "2-Phenyl propane", "2-Phenyl-Propane", "I-Propyl-Benzene"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3024336"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7406"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_34656"), ("Wikidata", "http://www.wikidata.org/entity/Q410107"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C98828&Units=SI")],
            element_info: None,
