    8173: (
            id: 8173,
            name: "Pentaerythritol, tetranitrate",
            formula: "C5H8N4O12",
            state: Solid,
            molar_mass_g_mol: 316.14,
            color_hex: None,
            melting_point_c: Some(141.25),
            boiling_point_c: Some(179.85),
            density_g_cm3: Some(1.77),
            heat_capacity_solid_j_g_c: Some(1.0688),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Pentaerythritol tetranitrate (PETN), also known as PENT, pentyl, PENTA (ПЕНТА, primarily in Russian), TEN (tetraeritrit nitrate), corpent, or penthrite (or, rarely and primarily in German, as nitropenta), is an explosive material. It is the nitrate ester of pentaerythritol, and is structurally very similar to nitroglycerin. Penta refers to the five carbon atoms of the neopentane skeleton. PETN is a very powerful explosive material with a relative effectiveness factor of 1.66. When mixed with a plasticizer, PETN forms a plastic explosive. Along with RDX it is the main ingredient of Semtex.
PETN is also used as a vasodilator drug to treat certain heart conditions, such as for management of angina."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H200: (Deleted) Unstable Explosive [Danger Explosives]"),
            uses: ["Energy Releasers (explosives, motive propellant)", "Calculated removal (%): 24.1", "Demolition explosive; blasting caps", "Explosives Manufacturing"],
            logp: Some(-1.194),
            appearance: Some("Pentaerythrite tetranitrate appears as white crystals. Density 1.75 g / cm3. Melting point 138-140 °C. Detonates at 210 °C. An extremely dangerous explosive, particularly when dry. Especially sensitive to shock and heat. Primary hazard is blast of an instantaneous explosion, not flying projectiles or fragments."),
            synonyms: ["TEN", "PENT", "PETN", "PENTA", "corpent", "penthrite", "nitropenta", "nitropentaerythrite"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=42451"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6518"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_25879"), ("Wikidata", "http://www.wikidata.org/entity/Q189334"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C78115&Units=SI")],
            element_info: None,
        ),
