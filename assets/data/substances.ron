    7978: (
            id: 7978,
            name: "Secobarbital",
            formula: "C12H18N2O3",
            state: Solid,
            molar_mass_g_mol: 238.1317,
            color_hex: None,
            melting_point_c: Some(100.0),
            boiling_point_c: None,
            density_g_cm3: None,
