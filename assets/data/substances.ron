    8124: (
            id: 8124,
            name: "Potassium perchlorate",
            formula: "KClO4",
            state: Solid,
            molar_mass_g_mol: 139.56,
            color_hex: None,
            melting_point_c: Some(609.85),
            boiling_point_c: None,
            density_g_cm3: Some(2.5239),
            heat_capacity_solid_j_g_c: Some(0.8441),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
