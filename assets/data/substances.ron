    2992: (
            id: 2992,
            name: "RDX",
            formula: "C3H6N6O6",
            state: Solid,
            molar_mass_g_mol: 222.12,
            color_hex: None,
            melting_point_c: Some(205.45),
            boiling_point_c: Some(233.85),
            density_g_cm3: Some(1.806),
            heat_capacity_solid_j_g_c: Some(1.2277),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("RDX (Research Department Explosive or Royal Demolition Explosive), or hexogen, also known by other names, is an organic compound with the formula (CH2N2O2)3. It is white, odorless, tasteless, and widely used as an explosive. Chemically, it is classified as a nitroamine alongside HMX, which is a more energetic explosive than trinitrotoluene (TNT). It was used widely in World War II and remains common in military applications.  It is lower performing and more toxic than modern replacements such as TKX-50.
RDX is often used in mixtures with other explosives and plasticizers or phlegmatizers (desensitizers); it is the explosive agent in C-4 plastic explosive and a key ingredient in Semtex. It is stable in storage and is considered one of the most energetic and brisant of the military high explosives, with a relative effectiveness factor of 1.60."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H201 (97.4%): (Deleted) Explosive; mass explosion hazard [Danger Explosives]"),
            uses: ["Energy Releasers (explosives, motive propellant)", "Explosives Manufacturing", "Fuel", "High explosive", "Propellants and blowing agents"],
            logp: Some(-1.646),
            appearance: Some("Hexolite appears as a mixture of cyclotrimethylenetrinitramine (RDX) and trinitrotoluene (TNT). Also includes \"composition B\". May explode under prolonged exposure to heat. The primary hazard is the blast effect of an instantaneous explosion, and not flying projectiles and fragments. Mixed with up to 15% water. The water is used to deactivate the mixture to lessen the explosion hazard."),
            synonyms: ["T4", "Hexogen", "Cyclonite", "Trimethylenetrinitramine", "trimethyleentrinitramine", "trinitrotrimethylenetriamine", "cyclotrimethylenetrinitramine", "sym-trimethylene trinitramine"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=7499"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/8490"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_24556"), ("Wikidata", "http://www.wikidata.org/entity/Q190020"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C121824&Units=SI")],
            element_info: None,
        ),
