    7260: (
            id: 7260,
            name: "Bisoprolol",
            formula: "C18H31NO4",
            state: Solid,
            molar_mass_g_mol: 325.2253,
            color_hex: None,
            melting_point_c: Some(100.0),
            boiling_point_c: None,
