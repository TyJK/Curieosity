            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("The terpinenes are a group of isomeric hydrocarbons that are classified as monoterpenes.  They each have the same molecular formula and carbon framework, but they differ in the position of carbon-carbon double bonds.  α-Terpinene has been isolated from cardamom and marjoram oils, and from other natural sources.  β-Terpinene has no known natural source but has been prepared from sabinene.  γ-Terpinene and δ-terpinene (also known as terpinolene) have been isolated from a variety of plant sources.  They are all colorless liquids with a turpentine-like odor."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H304 (98%): May be fatal if swallowed and enters airways [Danger Aspiration hazard]"),
            uses: ["Fragrance", "Odor agents", "FRAGRANCE-EG, FOR PERFUMES & SOAPS"],
            logp: Some(3.453),
            appearance: Some("Terpinolene appears as a water-white to light amber colored liquid. Insoluble in water and less dense than water. Used to make plastics and resins."),
            synonyms: ["FEMA 3046", "Terpinolen", "isoterpinene", "1,4(8)-Terpadiene", "alpha-terpinolene", "alpha -Terpinolene", "1,4(8)-p-menthadiene", "p-mentha-1,4(8)-diene"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3412148"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/11463"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_9457"), ("Wikidata", "http://www.wikidata.org/entity/Q2405051"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C586629&Units=SI")],
