    5616: (
            id: 5616,
            name: "Ifosfamide",
            formula: "C7H15Cl2N2O2P",
            state: Solid,
            molar_mass_g_mol: 260.0248,
            color_hex: None,
            melting_point_c: Some(40.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8034),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Ifosfamide, sold under the brand name Ifex among others, is a chemotherapy medication used to treat a number of types of cancer. This includes testicular cancer, soft tissue sarcoma, osteosarcoma, bladder cancer, small cell lung cancer, cervical cancer, and ovarian cancer. It is administered by injection into a vein.
Common side effects include hair loss, vomiting, blood in the urine, infections, and kidney problems. Other severe side effects include bone marrow suppression and decreased level of consciousness. Use during pregnancy will likely result in harm to the baby. Ifosfamide is in the alkylating agent and nitrogen mustard family of medications. It works by disrupting the duplication of DNA and the creation of RNA.
Ifosfamide was approved for medical use in the United States in 1987. It is on the World Health Organization's List of Essential Medicines."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(0.86),
            appearance: None,
            synonyms: ["Isophosphamide", "3778-73-2", "Iphosphamide", "Isofosfamide", "Ifex", "Ifosfamid", "Isoendoxan", "Mitoxana"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=4552453"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C3778732&Units=SI")],
            element_info: None,
        ),
    5622: (
            id: 5622,
            name: "Tenofovir alafenamide",
            formula: "C21H29N6O5P",
            state: Solid,
            molar_mass_g_mol: 476.1937,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8694),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Tenofovir alafenamide, sold under the brand name Vemlidy,Tavin AF is an antiviral medication used against hepatitis B and HIV. It is used for the treatment of chronic hepatitis B virus (HBV) infection in adults with compensated liver disease and is given in combination with other medications for the prevention and treatment of HIV. It is taken by mouth.
Tenofovir alafenamide is a nucleotide reverse transcriptase inhibitor and is a prodrug of tenofovir. It was developed by Gilead Sciences based on the protide technology of Chris McGuigan and is applied in the form of tenofovir alafenamide fumarate (TAF). Closely related to the commonly used reverse-transcriptase inhibitor tenofovir disoproxil fumarate (TDF), TAF has greater antiviral activity and better distribution into lymphoid tissues than that agent. It was approved for use in the US for HIV in 2015, and for hepatitis B in 2016. Although the US Food and Drug Administration (FDA) has approved tenofovir alafenamide for manufacture as a generic medication, it is not available.
A generic combination of Emtricitabine/tenofovir alafenamide (Viatris) received marketing authorization in the European Union in July 2025."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.6),
            appearance: None,
            synonyms: ["GS-7340", "379270-37-8", "GS 7340", "EL9943AG5J", "GS-734003", "CHEBI:90926", "DTXSID50958941", "TFV Alafenamide"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=33774850"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C379270378&Units=SI")],
            element_info: None,
        ),
