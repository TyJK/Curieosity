            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Fluorescein is an organic compound and dye based on the xanthene tricyclic structural motif, formally belonging to triarylmethine dyes family. It is available as a dark orange/red powder slightly soluble in water and alcohol. It is used as a fluorescent tracer in many applications.
The color of its aqueous solutions is green by reflection and orange by transmission (its spectral properties are dependent on pH of the solution), as can be noticed in bubble levels, for example, in which fluorescein is added as a colorant to the alcohol filling the tube in order to increase the visibility of the air bubble contained within. More concentrated solutions of fluorescein can even appear red (because under these conditions nearly all incident emission is re-absorbed by the solution).
It is on the World Health Organization's List of Essential Medicines."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.4),
            appearance: Some("powder"),
            synonyms: ["2321-07-5", "Solvent Yellow 94", "Resorcinolphthalein", "Fluoresceine", "Yellow fluorescein", "3,6-Fluorandiol", "Fluorescein acid", "D&C Yellow No. 7"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=516377"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C2321075&Units=SI")],
            element_info: None,
        ),
    4570: (
            id: 4570,
            name: "Ifenprodil",
            formula: "C21H27NO2",
            state: Solid,
            molar_mass_g_mol: 325.2042,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6639),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
