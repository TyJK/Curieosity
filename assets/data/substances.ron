    7279: (
            id: 7279,
            name: "Dimethyl sulfoxide",
            formula: "(CH3)2SO",
            state: Liquid,
            molar_mass_g_mol: 78.14,
            color_hex: None,
            melting_point_c: Some(18.85),
            boiling_point_c: Some(188.85),
            density_g_cm3: Some(1.1004),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6949),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(-42.74),
