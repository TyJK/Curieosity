    7881: (
            id: 7881,
            name: "Acetaldehyde",
            formula: "C2H4O",
            state: Gas,
            molar_mass_g_mol: 44.05,
            color_hex: None,
            melting_point_c: Some(-123.37),
            boiling_point_c: Some(20.15),
            density_g_cm3: Some(0.784),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: Some(0.7196),
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(-102.49),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Acetaldehyde (IUPAC systematic name ethanal) is an organic chemical compound with the formula CH3CH=O. It is a colorless liquid or gas, boiling near room temperature. It is one of the most important aldehydes, occurring widely in nature and being produced on a large scale in industry. Acetaldehyde occurs naturally in coffee, bread, and ripe fruit, and is produced by plants. It is also produced by the partial oxidation of ethanol by the liver enzyme alcohol dehydrogenase and is a contributing cause of hangover after alcohol consumption. Pathways of exposure include air, water, land, or groundwater, as well as drink and smoke. Consumption of disulfiram inhibits acetaldehyde dehydrogenase, the enzyme responsible for the metabolism of acetaldehyde, thereby causing it to build up in the body.
The International Agency for Research on Cancer (IARC) has listed acetaldehyde as a Group 1 carcinogen. Acetaldehyde is \"one of the most frequently found air toxins with cancer risk greater than one in a million\"."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H224: Extremely flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Intermediate", "Adhesive Manufacturing", "All Other Basic Organic Chemical Manufacturing"],
            logp: Some(0.205),
            appearance: Some("Acetaldehyde appears as a clear colorless liquid with a pungent choking odor. Flash point -36 °F. Boiling point 69 °F. Density 6.5 lb / gal. Vapors are heaver than air and irritate the mucous membranes and especially the eyes. Used to make other chemicals."),
            synonyms: ["Ethanal", "NSC 7594", "aldehyde", "Acetaldehyd", "Azetaldehyd", "acetaldehydes", "ethyl aldehyde", "acetic aldehyde"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=89195"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/177"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_15343"), ("Wikidata", "http://www.wikidata.org/entity/Q61457"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C75070&Units=SI")],
            element_info: None,
        ),
    7882: (
            id: 7882,
