    3027: (
            id: 3027,
            name: "Triethyl phosphite",
            formula: "C6H15O3P",
            state: Liquid,
            molar_mass_g_mol: 166.16,
            color_hex: None,
            melting_point_c: Some(-70.15),
            boiling_point_c: Some(155.85),
            density_g_cm3: Some(0.969),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.7108),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Triethyl phosphite (TEP) is an organophosphorus compound, specifically a phosphite ester, with the formula P(OCH2CH3)3, often abbreviated P(OEt)3.  It is a colorless, malodorous liquid.  It is used as a ligand in organometallic chemistry and as a reagent in organic synthesis.
The molecule features a pyramidal phosphorus(III) center bound to three ethoxide groups. Its 31P NMR spectrum features a signal at around +139 ppm vs phosphoric acid standard.
Triethylphosphite is prepared by treating phosphorus trichloride with ethanol in the presence of a base, typically a tertiary amine:

PCl3 + 3 EtOH + 3 R3N → P(OEt)3 + 3 R3NH + 3 Cl−
In the absence of the base, the reaction of ethanol and phosphorus trichloride affords diethylphosphite ((EtO)2P(O)H). Of the many related compounds can be prepared similarly, triisopropyl phosphite is an example (b.p. 43.5 °C/1.0 mm; CAS# 116-17-6)."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["All Other Basic Organic Chemical Manufacturing", "Intermediate"],
            logp: Some(2.323),
            appearance: Some("colorless liquid"),
            synonyms: ["122-52-1", "Triethoxyphosphine", "Phosphorous acid, triethyl ester", "Ethyl phosphite, (EtO)3P", "Fosforyn trojetylowy", "DTXSID2026991", "6B2R04S55G", "NSC-5284"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=14236637"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C122521&Units=SI")],
            element_info: None,
        ),
