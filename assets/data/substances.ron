    7965: (
            id: 7965,
            name: "Trifluoroacetic acid",
            formula: "C2HF3O2",
            state: Liquid,
            molar_mass_g_mol: 114.02,
            color_hex: None,
            melting_point_c: Some(-15.35),
            boiling_point_c: Some(72.35),
            density_g_cm3: Some(1.489),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.977),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(-865.74),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Trifluoroacetic acid (TFA) is a synthetic organofluorine compound with the chemical formula CF3CO2H. It belongs to the subclass of per- and polyfluoroalkyl substances (PFASs) known as ultrashort-chain perfluoroalkyl acids (PFAAs). TFA is not produced biologically or abiotically and is commonly used in organic chemistry for various purposes. It is the most abundant PFAS found in the environment.
It is a haloacetic acid, with all three of the acetyl group's hydrogen atoms replaced by fluorine atoms. It is a colorless liquid with a vinegar-like odor. TFA is a stronger acid than acetic acid, having an acid ionisation constant, Ka, that is approximately 34,000 times higher, as the highly electronegative fluorine atoms and consequent electron-withdrawing nature of the trifluoromethyl group weakens the oxygen-hydrogen bond (allowing for greater acidity) and stabilises the anionic conjugate base."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H314: Causes severe skin burns and eye damage [Danger Skin corrosion/irritation]"),
            uses: ["All Other Basic Organic Chemical Manufacturing", "Intermediate", "Intermediates", "Pharmaceutical and Medicine Manufacturing"],
            logp: Some(0.633),
            appearance: Some("Trifluoroacetic acid appears as a colorless fuming liquid with a pungent odor. Soluble in water and denser than water. Corrosive to skin, eyes and mucous membranes. Used to make other chemicals and as a solvent."),
            synonyms: ["TFA", "CF3COOH", "Trifluoressigsaeure", "perfluoroacetic acid", "acide trifluoroacetique", "2,2,2-trifluoroacetic acid", "76-05-1", "Trifluoracetic acid"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3019112"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6422"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_45892"), ("Wikidata", "http://www.wikidata.org/entity/Q412033"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C76051&Units=SI")],
            element_info: None,
        ),
