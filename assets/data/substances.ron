            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Methyl acetate, also known as MeOAc, acetic acid methyl ester or methyl ethanoate, is a carboxylate ester with the formula CH3COOCH3. It is a flammable liquid with a characteristically pleasant smell reminiscent of some glues and nail polish removers.   Methyl acetate is occasionally used as a solvent, being weakly polar and lipophilic, but its close relative ethyl acetate is a more common solvent, being less toxic and less soluble in water.   Methyl acetate has a solubility of 25% in water at room temperature.  At elevated temperature its solubility in water is much higher.  Methyl acetate is not stable in the presence of strong aqueous bases or aqueous acids. Methyl acetate is not regulated as a volatile organic compound in the USA."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225: Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Adhesives and Sealants", "Aerosol spray paints", "Cleaning and Furnishing Care Products", "Electrical and Electronic Products", "Hot-melt adhesives"],
            logp: Some(0.179),
            appearance: Some("Methyl acetate appears as a clear colorless liquid with a fragrant odor. Moderately toxic. Flash point 14 °F. Vapors heavier than air."),
            synonyms: ["AcOMe", "MeOAc", "Metile", "Devoton", "HSDB 95", "Tereton", "CH3CO2CH3", "CH3COOCH3"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1303198"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6584"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_77700"), ("Wikidata", "http://www.wikidata.org/entity/Q414189"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C79209&Units=SI")],
            element_info: None,
        ),
