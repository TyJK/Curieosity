    6592: (
            id: 6592,
            name: "Phenytoin",
            formula: "C15H12N2O2",
            state: Solid,
            molar_mass_g_mol: 252.0899,
            color_hex: None,
            melting_point_c: Some(286.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7771),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Phenytoin (PHT), sold under the brand name Dilantin among others, is an anti-seizure medication. It is useful for the prevention of tonic-clonic seizures (also known as grand mal seizures) and focal seizures, but not absence seizures. The intravenous form, fosphenytoin, is used for status epilepticus that does not improve with benzodiazepines.  It may also be used for certain heart arrhythmias or neuropathic pain. It can be taken intravenously or by mouth. The intravenous form generally begins working within 30 minutes and is effective for roughly 24 hours. Blood levels can be measured to determine the proper dose.
Common side effects include nausea, stomach pain, loss of appetite, poor coordination, increased hair growth, and enlargement of the gums. Potentially serious side effects include sleepiness, self harm, liver problems, bone marrow suppression, low blood pressure, toxic epidermal necrolysis, and atrophy of the cerebellum. There is evidence that use during pregnancy results in abnormalities in the baby.  It appears to be safe to use when breastfeeding. Alcohol may interfere with the medication's effects.
Phenytoin was first made in 1908 by the German chemist Heinrich Biltz and found useful for seizures in 1936. It is on the World Health Organization's List of Essential Medicines. Phenytoin is available as a generic medication.  In 2020, it was the 260th most commonly prescribed medication in the United States, with more than 1 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(2.47),
            appearance: None,
            synonyms: ["5,5-DIPHENYLHYDANTOIN", "57-41-0", "Diphenylhydantoin", "5,5-diphenylimidazolidine-2,4-dione", "Phenytoine", "Zentropil", "Lepitoin", "Diphantoin"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=48392"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C57410&Units=SI")],
            element_info: None,
        ),
