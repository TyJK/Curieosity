            element_info: Some((
                atomic_number: 59,
                atomic_weight: 140.90766,
                group: None,
                period: Some(6),
                block: Some("f"),
                electron_config: Some("[Xe] 4f3 6s2"),
                electronegativity_pauling: Some(1.13),
                first_ionization_kj_mol: Some(527.792247),
                electron_affinity_kj_mol: Some(92.81857000000001),
                atomic_radius_pm: Some(185.0),
                discoverer: Some("C.F. Aver von Welsbach"),
                discovery_year: Some(1885),
                overview: Some("Praseodymium is a chemical element; it has symbol Pr and atomic number 59. It is the third member of the lanthanide series and is considered one of the rare-earth metals. It is a soft, silvery, malleable and ductile metal, valued for its magnetic, electrical, chemical, and optical properties. It is too reactive to be found in native form, and pure praseodymium metal slowly develops a green oxide coating when exposed to air.

Praseodymium always occurs naturally together with the other rare-earth metals. It is the sixth-most abundant rare-earth element and fourth-most abundant lanthanide, making up 9.1 parts per million of the Earth's crust, an abundance similar to that of boron. In 1841, Swedish chemist Carl Gustav Mosander extracted a rare-earth oxide residue he called didymium from a residue he called \"lanthana\", in turn separated from cerium salts. In 1885, the Austrian chemist Carl Auer von Welsbach separated didymium into two elements that gave salts of different colours, which he named praseodymium and neodymium. The name praseodymium comes from the Ancient Greek πράσινος (prasinos), meaning 'leek-green', and δίδυμος (didymos) 'twin'."),
                discovery_story: None,
                isotopes_summary: Some("41 known isotopes; stable: 141Pr (100.0%), 122Pr, 123Pr, 161Pr; 37 radioactive"),
                magnetic_ordering: None,
            )),
        ),
    1060: (
            id: 1060,
            name: "Neodymium",
            formula: "Nd",
