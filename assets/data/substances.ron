            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Isobornyl cyclohexanol (IBCH, Sandenol) is an organic compound used primarily as a fragrance because of its aroma which is similar to sandalwood oil.  Its chemical structure is closely related to that of both α-santalol and β-santalol, which are the primary constituents of sandalwood oil.
Sandalwood trees are endangered due to overharvesting, leading to a high cost for the natural oil.  IBCH is therefore produced as an economical alternative to the natural product."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Fragrance", "All Other Basic Organic Chemical Manufacturing", "Miscellaneous Manufacturing", "Odor agents"],
            logp: Some(3.856),
            appearance: Some("Colorless to pale yellow clear viscous liquid"),
            synonyms: ["isobornyl cyclohexanol", "DTXSID5044817", "DTXCID3024817", "RefChem:791572", "3407-42-9", "Sandenol", "3-(5,5,6-Trimethyl-2-norbornyl)cyclohexanol", "3-Isocamphylcyclohexanol, trans-"],
