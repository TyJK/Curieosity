            references: [("Wikipedia", "https://en.wikipedia.org/?curid=54626167"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/114481"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_143205"), ("Wikidata", "http://www.wikidata.org/entity/Q29387971"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C13252136&Units=SI")],
