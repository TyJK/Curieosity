    3962: (
            id: 3962,
            name: "Montelukast",
            formula: "C35H36ClNO3S",
            state: Solid,
            molar_mass_g_mol: 585.2104,
            color_hex: None,
            melting_point_c: Some(146.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6582),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid, IsBase],
            description: Some("Montelukast, sold under the brand name Singulair among others, is a medication used in the maintenance treatment of asthma. It is generally less preferred for this use than inhaled corticosteroids. It is not useful for acute asthma attacks. Other uses include allergic rhinitis and hives of long duration. For allergic rhinitis it is a second-line treatment.
Common side effects include abdominal pain, cough, and headache. Severe side effects may include allergic reactions, such as anaphylaxis and eosinophilia. Use in pregnancy appears to be safe. Montelukast is in the leukotriene receptor antagonist family of medications. It works by blocking the action of leukotriene D4 in the lungs resulting in decreased inflammation and relaxation of smooth muscle.
Montelukast was approved for medical use in the United States in 1998. It is available as a generic medication. In 2023, it was the 20th most commonly prescribed medication in the United States, with more than 25 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(7.9),
            appearance: None,
            synonyms: ["158966-92-8", "Brondilat", "MHM278SD3E", "DTXSID9023334", "CHEBI:50730", "Montelukastum", "RefChem:6040", "DTXCID403334"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1412286"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C158966928&Units=SI")],
            element_info: None,
        ),
    3963: (
            id: 3963,
            name: "Disilane",
            formula: "Si2H6",
            state: Liquid,
            molar_mass_g_mol: 62.22,
            color_hex: None,
            melting_point_c: Some(-132.15),
            boiling_point_c: Some(-14.15),
            density_g_cm3: Some(2.7),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.5111),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Disilane is a chemical compound with general chemical formula Si2R6 that was first identified in 1902 by Henri Moissan and Samuel Smiles (1877–1953) where R = H. Moissan and Smiles reported disilane as being among the products formed by the action of dilute acids on metal silicides. Although these reactions had been previously investigated by Friedrich Woehler and Heinrich Buff between 1857 and 1858, Moissan and Smiles were the first to explicitly identify disilane. They referred to disilane as silicoethane. Higher members of the homologous series SinH2n+2 formed in these reactions were subsequently identified by Carl Somiesky (sometimes spelled \"Karl Somieski\") and Alfred Stock.
At standard temperature and pressure, disilane is a colourless, acrid gas. Disilane and ethane have similar structures, although disilane is much more reactive. Other compounds of the general formula Si2X6 (X = hydrogen, halogen, alkyl, aryl, and mixtures of these groups) are called disilanes. Disilane is a group 14 hydride."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H220 (100%): Extremely flammable gas [Danger Flammable gases]"),
            uses: ["Computer and Electronic Product Manufacturing", "Industrial Gas Manufacturing"],
            logp: Some(-2.368),
            appearance: None,
            synonyms: ["Si2H6", "CHEBI:30597", "RefChem:589172", "DTXCID7089049", "216-466-5", "1590-87-0", "Disilicane", "Disilicoethane"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=4731435"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/74123"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_30597"), ("Wikidata", "http://www.wikidata.org/entity/Q116073"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1590870&Units=SI")],
            element_info: None,
        ),
