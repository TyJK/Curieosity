    8429: (
            id: 8429,
            name: "Anthraquinone",
            formula: "C14H8O2",
            state: Solid,
            molar_mass_g_mol: 208.21,
            color_hex: None,
            melting_point_c: Some(284.85),
            boiling_point_c: Some(376.85),
            density_g_cm3: Some(1.438),
            heat_capacity_solid_j_g_c: Some(0.6647),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(192.01),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Anthraquinone, also called anthracenedione or dioxoanthracene, is an aromatic organic compound with formula C14H8O2. Several isomers exist but these terms usually refer to 9,10-anthraquinone (IUPAC: 9,10-dioxoanthracene) wherein the keto groups are located on the central ring. It is used as a digester additive to wood pulp for papermaking. Many anthraquinone derivatives are generated by organisms or synthesised industrially for use as dyes, pharmaceuticals, and catalysts. Anthraquinone is a yellow, highly crystalline solid, poorly soluble in water but soluble in hot organic solvents. It is almost completely insoluble in ethanol near room temperature but 2.25 g will dissolve in 100 g of boiling ethanol. It is found in nature as the rare mineral hoelite."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H350: May cause cancer [Danger Carcinogenicity]"),
            uses: ["Oxidizing/reducing agents"],
            logp: Some(2.462),
            appearance: Some("Anthraquinone appears as yellow crystals or powder. (NTP, 1992)"),
            synonyms: ["Az-Q", "anthradione", "9,10-quinone", "anthraquinones", "9,10-anthraquinone", "anthracenequinones", "84-65-1", "anthracene-9,10-dione"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=658579"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6780"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_22580"), ("Wikidata", "http://www.wikidata.org/entity/Q423174"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C84651&Units=SI")],
            element_info: None,
