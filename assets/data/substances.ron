            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("2-Ethylhexyl salicylate, also known as ethylhexyl salicylate (INCI name), octisalate, or octyl salicylate, is an organic compound used as an ingredient in sunscreens and cosmetics to absorb UVB (ultraviolet) rays from the sun. It is an ester formed by the condensation of salicylic acid with 2-ethylhexanol.  It is a colorless oily liquid with a slight floral odor.
The salicylate portion of the molecule absorbs ultraviolet light, protecting skin from the harmful effects of exposure to sunlight.  The ethylhexanol portion is a fatty alcohol, adding emollient and oil-like (water resistant) properties."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H315 (84.7%): Causes skin irritation [Warning Skin corrosion/irritation]"),
            uses: ["Odor agents", "Photosensitive chemicals", "All Other Basic Organic Chemical Manufacturing", "CIR ingredient: Ethylhexyl Salicylate", "Other (requires additional information)"],
            logp: Some(3.765),
            appearance: Some("Liquid"),
            synonyms: ["octisalate", "octyl salicylate", "Ethylhexyl salicylate", "Ethylhexyl salicylic acid", "2-ethylhexyl 2-hydroxybenzoate", "118-60-5", "Benzoic acid, 2-hydroxy-, 2-ethylhexyl ester", "Escalol"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=4345823"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/8364"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_88639"), ("Wikidata", "http://www.wikidata.org/entity/Q27160526"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C118605&Units=SI")],
