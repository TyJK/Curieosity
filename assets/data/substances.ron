    3764: (
            id: 3764,
            name: "L-Proline",
            formula: "C5H9NO2",
            state: Liquid,
            molar_mass_g_mol: 115.13,
            color_hex: None,
            melting_point_c: Some(216.35),
            boiling_point_c: Some(282.38),
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: None,
