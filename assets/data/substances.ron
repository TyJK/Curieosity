    2645: (
            id: 2645,
            name: "Glutaraldehyde",
            formula: "C5H8O2",
            state: Liquid,
            molar_mass_g_mol: 100.12,
            color_hex: None,
            melting_point_c: Some(-14.15),
            boiling_point_c: Some(186.85),
            density_g_cm3: Some(1.06),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.7082),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Glutaraldehyde is an organic compound with the formula (CH2)3(CHO)2.  The molecule consists of a five carbon chain doubly terminated with formyl (CHO) groups.  It is usually used as a solution in water, and such solutions exists as a collection of hydrates, cyclic derivatives, and condensation products, several of which interconvert. Because the molecule has two aldehyde functional groups, glutaraldehyde (and its hydrates) can crosslink substances with primary amine groups, through condensation. Crosslinking can rigidify and deactivate proteins and other molecules that are critical for normal biological function, such as DNA, and so glutaraldehyde solutions are effective biocides and fixatives.  It is sold under the brandnames Cidex and Glutaral. As a disinfectant, it is used to sterilize surgical instruments."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H301: Toxic if swallowed [Danger Acute toxicity, oral]"),
            uses: ["Brightener", "Pigment", "Preservative", "Processing aids, not otherwise listed", "All Other Basic Organic Chemical Manufacturing"],
            logp: Some(0.554),
            appearance: Some("Glutaraldehyde solution is a light yellow liquid. Mixes with water. (USCG, 1999)"),
            synonyms: ["Glutaral", "glutaralum", "PENTANEDIAL", "1,5-Pentanedial", "1,5-Pentanedione", "Glutardialdehyde", "1,3-Diformylpropane", "Glutaric dialdehyde"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=192070"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/3485"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_64276"), ("Wikidata", "http://www.wikidata.org/entity/Q416475"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C111308&Units=SI")],
