            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Allyl bromide (3-bromopropene) is an organic halide. It is an alkylating agent used in synthesis of polymers, pharmaceuticals, perfumes and other organic compounds. Allyl bromide is a colorless liquid, although commercial samples appear yellow or brown. It is an irritant and a potentially dangerous alkylating agent. Allyl bromide is more reactive but more expensive than allyl chloride, and these considerations guide its use."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225 (92.6%): Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Insecticidal fumigant"],
            logp: Some(1.567),
            appearance: Some("Allyl bromide appears as a clear colorless to light yellow liquid with an irritating unpleasant odor. Flash point 30 °F. Irritates eyes, skin, and respiratory system. Toxic by skin absorption. Denser than water and slightly soluble in water."),
            synonyms: ["rocuronium bromide", "17beta-acetoxy-16beta-(1-allylpyrrolidinium-1-y…", "1-Allyl-1-(3alpha,17beta-dihydroxy-2beta-morpho…", "17beta-(acetyloxy)-3alpha-hydroxy-2beta-(morpho…", "106-95-6", "3-bromoprop-1-ene", "3-Bromopropene", "3-Bromo-1-propene"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=7094325"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7841"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_8885"), ("Wikidata", "http://www.wikidata.org/entity/Q223062"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C106956&Units=SI")],
            element_info: None,
