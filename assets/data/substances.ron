    8334: (
            id: 8334,
            name: "1,1,1,2-Tetrafluoroethane",
            formula: "C2HClF4",
            state: Gas,
            molar_mass_g_mol: 102.03,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: Some(-11.96),
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: Some(0.9703),
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("1,1,1,2-Tetrafluoroethane (also known as norflurane (INN), R-134a, Klea 134a, Freon 134a, Forane 134a, Genetron 134a, Green Gas, Florasol 134a, Suva 134a, HFA-134a, or HFC-134a) is a hydrofluorocarbon (HFC) and haloalkane refrigerant with thermodynamic properties similar to R-12 (dichlorodifluoromethane) but with insignificant ozone depletion potential and a lower 100-year global warming potential (1,430, compared to R-12's GWP of 10,900). It has the formula CF3CH2F and a boiling point of −26.3 °C (−15.34 °F) at atmospheric pressure.  R-134a cylinders are colored light blue.  A phaseout and transition to HFO-1234yf and other refrigerants, with GWPs similar to CO2, began in 2012 within the automotive market."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Automotive Care Products", "Electrical and Electronic Products", "Non-TSCA Use"],
            logp: Some(1.518),
            appearance: Some("oil, gas"),
            synonyms: ["Norflurane", "811-97-2", "HFC-134a", "Tetrafluoroethane", "1,2,2,2-Tetrafluoroethane", "Refrigerant R134a", "HFA 134a", "HFA-134a"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1735557"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C811972&Units=SI")],
            element_info: None,
        ),
    8335: (
            id: 8335,
            name: "Clarithromycin",
            formula: "C38H69NO13",
            state: Solid,
            molar_mass_g_mol: 748.0,
            color_hex: None,
            melting_point_c: Some(-53.15),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7047),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Clarithromycin, sold under the brand name Biaxin among others, is an antibiotic used to treat various bacterial infections. This includes strep throat, pneumonia, skin infections, H. pylori infection, and Lyme disease, among others. Clarithromycin can be taken by mouth as a tablet or liquid or can be infused intravenously.
Common side effects include nausea, vomiting, headaches, and diarrhea. Severe allergic reactions are rare. Liver problems have been reported. It may cause harm if taken during pregnancy. It is in the macrolide class and works by slowing down bacterial protein synthesis. Clarithromycin resistance is already a major challenge to healthcare systems and such resistance is spreading, leading to recommendations to test the susceptibility of pathogenic organisms to the antibiotic before commencing clarithromycin therapy.
Clarithromycin was developed in 1980 and approved for medical use in 1990. It is on the World Health Organization's List of Essential Medicines. Clarithromycin is available as a generic medication. It is made from erythromycin and is chemically known as 6-O-methylerythromycin."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H370: Causes damage to organs [Danger Specific target organ toxicity, single exposure]"),
            uses: ["Calculated removal (%): 7.3"],
            logp: Some(2.44),
            appearance: Some("Solid"),
            synonyms: ["CLA", "clarithromycina", "clarithromycine", "clarithromycinum", "6-O-methylerythromycin", "O(6)-methylerythromycin", "6-O-methylerythromycin A", "81103-11-9"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=186383"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/4663848"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_3732"), ("Wikidata", "http://www.wikidata.org/entity/Q126610804"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C81103119&Units=SI")],
            element_info: None,
        ),
    8336: (
            id: 8336,
            name: "Esmolol",
            formula: "C16H25NO4",
            state: Solid,
            molar_mass_g_mol: 295.1784,
