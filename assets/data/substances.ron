    4337: (
            id: 4337,
            name: "Atazanavir",
            formula: "C38H52N6O7",
            state: Solid,
            molar_mass_g_mol: 704.3897,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7835),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Atazanavir, sold under the brand name Reyataz among others, is an antiretroviral medication used to treat HIV/AIDS. It is generally recommended for use with other antiretrovirals. It may be used for post-exposure prophylaxis after a needlestick injury or other potential exposure. It is taken by mouth.
Common side effects include headache, nausea, yellowish skin, abdominal pain, trouble sleeping, and fever. Severe side effects include rashes such as erythema multiforme and high blood sugar. Atazanavir appears to be safe to use during pregnancy. It is of the protease inhibitor (PI) class and works by blocking HIV protease.
Atazanavir was approved for medical use in the United States in 2003. The combination atazanavir/ritonavir is on the World Health Organization's List of Essential Medicines. Atazanavir is available as a generic medication."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(4.5),
            appearance: Some("yellow, needles"),
            synonyms: ["198904-31-3", "Latazanavir", "Zrivada", "BMS-232632", "atazanavirum", "QZU4H47A3S", "DTXSID9048691", "DTXCID5028617"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=850047"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C198904313&Units=SI")],
            element_info: None,
        ),
    4339: (
            id: 4339,
            name: "Memantine",
            formula: "C12H21N",
            state: Solid,
            molar_mass_g_mol: 179.1674,
            color_hex: None,
            melting_point_c: Some(258.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6419),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
