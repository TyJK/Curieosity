    2387: (
            id: 2387,
            name: "p-Xylene",
            formula: "C8H10",
            state: Liquid,
            molar_mass_g_mol: 106.16,
            color_hex: None,
            melting_point_c: Some(13.15),
            boiling_point_c: Some(138.35),
            density_g_cm3: Some(0.861),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.5652),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("p-Xylene (para-xylene) is an aromatic hydrocarbon. It is one of the three isomers of dimethylbenzene known collectively as xylenes. The p- stands for para-, indicating that the two methyl groups in p-xylene occupy the diametrically opposite substituent positions 1 and 4. It is in the positions of the two methyl groups, their arene substitution pattern, that it differs from the other isomers, o-xylene and m-xylene. All have the same chemical formula C6H4(CH3)2. All xylene isomers are colorless and highly flammable. The odor threshold of p-xylene is 0.62 parts per million (ppm)."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H304 (20.8%): May be fatal if swallowed and enters airways [Danger Aspiration hazard]"),
            uses: ["Fuels and fuel additives", "Both", "Commercial"],
            logp: Some(2.303),
            appearance: Some("P-xylene appears as a colorless watery liquid with a sweet odor. Less dense than water. Insoluble in water. Irritating vapor. Freezing point is 56 °F. (USCG, 1999)"),
            synonyms: ["p-Xylol", "4-xylene", "p-Xylene", "1,4-xylene", "paraxylene", "PARA-XYLENE", "4-methyltoluene", "p-Methyltoluene"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1999126"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7809"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_27417"), ("Wikidata", "http://www.wikidata.org/entity/Q3314420"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C106423&Units=SI")],
            element_info: None,
        ),
