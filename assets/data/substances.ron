    8681: (
            id: 8681,
            name: "Mepyramine",
            formula: "C17H23N3O",
            state: Solid,
            molar_mass_g_mol: 285.1841,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7686),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Mepyramine, also known as pyrilamine, is a first-generation antihistamine, targeting the H1 receptor as an inverse agonist. Mepyramine rapidly permeates the brain, often causing drowsiness. It is often sold as a maleate salt, pyrilamine maleate. 
The medication has negligible anticholinergic activity, with 130,000-fold selectivity for the histamine H1 receptor over the muscarinic acetylcholine receptors (for comparison, diphenhydramine had 20-fold selectivity for the H1 receptor). 
It was patented in 1943 and came into medical use in 1949.
It was marketed under the names Histadyl, Histalon, Neo-Antergan, Neo-Pyramine, and Nisaval.  In the 1960s and 70s it was a very common component in over-the-counter sleep aids such as Alva-Tranquil, Dormin, Sedacaps, Sominex, Nytol, and many others. The US Food and Drug Administration (FDA) included it in the list of chemicals and compounds barred from use in over-the-counter (OTC) nighttime sleep aid products in 1989.
It is used in over-the-counter combination products to treat the common cold and menstrual symptoms such as Midol Complete. It is also the active ingredient of the topical antihistamine creams Anthisan and Neoantergan sold for the treatment of insect bites, stings, and nettle rash."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.27),
            appearance: None,
            synonyms: ["pyrilamine", "91-84-9", "Pyranisamine", "Dorantamin", "Mepiramine", "Neoantergan", "Anhistabs", "Anhistol"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=10383041"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C91849&Units=SI")],
            element_info: None,
        ),
