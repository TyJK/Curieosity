    8264: (
            id: 8264,
            name: "Loratadine",
            formula: "C22H23ClN2O2",
            state: Solid,
            molar_mass_g_mol: 382.1448,
            color_hex: None,
            melting_point_c: Some(135.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7154),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
