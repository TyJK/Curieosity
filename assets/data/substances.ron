    8005: (
            id: 8005,
            name: "Sodium nitrate",
            formula: "NaNO3",
            state: Solid,
            molar_mass_g_mol: 86.003,
            color_hex: None,
            melting_point_c: Some(307.85),
            boiling_point_c: Some(379.85),
            density_g_cm3: Some(2.257),
            heat_capacity_solid_j_g_c: Some(1.1755),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsMetal],
            description: Some("Sodium nitrate is the chemical compound with the formula NaNO3. This alkali metal nitrate salt is also known as Chile saltpeter (large deposits of which were historically mined in Chile) to distinguish it from ordinary saltpeter, potassium nitrate. The mineral form is also known as nitratine, nitratite or soda niter.
Sodium nitrate is a white deliquescent solid very soluble in water. It is a readily available source of the nitrate anion (NO3−), which is useful in several reactions carried out on industrial scales for the production of fertilizers, pyrotechnics, smoke bombs and other explosives, glass and pottery enamels, food preservatives (esp. meats), and solid rocket propellant. It has been mined extensively for these purposes."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H272 (56.9%): May intensify fire; oxidizer [Danger Oxidizing liquids; Oxidizing solids]"),
            uses: ["Agricultural chemicals (non-pesticidal)", "Drier", "Finishing agents", "Hardener", "Intermediates", "Odor agents"],
            logp: Some(-0.729),
            appearance: Some("Sodium nitrate appears as a white crystalline solid. Noncombustible but accelerates the burning of combustible materials. If large quantities are involved in fire or the combustible material is finely divided an explosion may result. May explode under prolonged exposure to heat or fire. Toxic oxides of nitrogen are produced in fires. Used in solid propellants, explosives, fertilizers, and for many other uses."),
            synonyms: ["Niter", "Cubic niter", "Chile saltpeter", "Nitrate of soda", "Sodium saltpeter", "Nitrate de sodium", "Sodium(I) nitrate (1:1)", "Nitric acid, sodium salt"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=200310"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/24188563"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_63005"), ("Wikidata", "http://www.wikidata.org/entity/Q184373"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C7631994&Units=SI")],
            element_info: None,
        ),
