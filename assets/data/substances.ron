    6367: (
            id: 6367,
            name: "Isoniazid",
            formula: "C6H7N3O",
            state: Solid,
            molar_mass_g_mol: 137.14,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.9968),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Isoniazid, also known as isonicotinic acid hydrazide (INH), is an antibiotic used for the treatment of tuberculosis. For active tuberculosis, it is often used together with rifampicin, pyrazinamide, and either streptomycin or ethambutol. It may also be used for atypical types of mycobacteria, such as M. avium, M. kansasii, and M. xenopi. It is usually taken by mouth, but may be used by injection into muscle.
Isoniazid is a prodrug that, when activated by catalase-peroxidase KatG, generates adducts and radicals that inhibits the formation of the mycobacterial cell wall. Side effects in those treated with isoniazid include vitamin B6 deficiency, liver toxicity, peripheral neuropathy, and a reduction in blood cell production. Mutations in the ahpC, inhA, kasA, katG, genes of M. tuberculosis may result in isoniazid resistance.
Although first synthesized in 1912, the anti-tuberculosis activity of isoniazid was not discovered until the 1940s. It is on the World Health Organization's List of Essential Medicines and is available as a generic medication."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-0.315),
            appearance: None,
            synonyms: ["54-85-3", "Isonicotinic acid hydrazide", "Isonicotinohydrazide", "pyridine-4-carbohydrazide", "Isoniazide", "Rimifon", "Nydrazid", "Cotinazin"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=599463"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C54853&Units=SI")],
            element_info: None,
        ),
