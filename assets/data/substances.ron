    2819: (
            id: 2819,
            name: "Diatrizoate",
            formula: "C11H9I3N2O4",
            state: Solid,
            molar_mass_g_mol: 613.7697,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
