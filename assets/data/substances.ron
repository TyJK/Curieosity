    6068: (
            id: 6068,
            name: "Benzyl chloroformate",
            formula: "C8H7ClO2",
            state: Liquid,
            molar_mass_g_mol: 170.59,
            color_hex: None,
            melting_point_c: Some(0.0),
            boiling_point_c: Some(102.85),
            density_g_cm3: Some(1.195),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6941),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Benzyl chloroformate, also known as benzyl chlorocarbonate or Z-chloride, is the benzyl ester of chloroformic acid. It can be also described as the chloride of the benzyloxycarbonyl (Cbz or Z) group. In its pure form it is a water-sensitive oily colorless liquid, although impure samples usually appear yellow. It possesses a characteristic pungent odor and degrades in contact with water. 
The compound was first prepared by Leonidas Zervas in the early 1930s who used it for the introduction of the benzyloxycarbonyl protecting group, which became the basis of the Bergmann-Zervas carboxybenzyl method of peptide synthesis he developed with Max Bergmann. This was the first successful method of controlled peptide chemical synthesis and for twenty years it was the dominant procedure used worldwide until the 1950s. To this day, benzyl chloroformate is often used for amine group protection."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H314: Causes severe skin burns and eye damage [Danger Skin corrosion/irritation]"),
            uses: ["Intermediates", "All Other Basic Organic Chemical Manufacturing", "In peptide synthesis to block the amino group.", "Pharmaceutical and Medicine Manufacturing"],
            logp: Some(2.562),
            appearance: Some("Benzyl chloroformate appears as a colorless liquid with an acrid odor. Vapors irritate eyes and mucous membranes. Corrosive to metals and tissue. Long-term inhalation of low concentrations or short-term inhalation of high concentrations can result in adverse health effects."),
            synonyms: ["BisPhenol A bis(chloroformate)", "2,2-Bis[p-(chloroformyloxy)phenyl]propane", "501-53-1", "Benzyl carbonochloridate", "Carbobenzoxy chloride", "Benzyl chlorocarbonate", "Benzylcarbonyl chloride", "Benzyloxycarbonyl chloride"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1884720"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/10387"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_34576"), ("Wikidata", "http://www.wikidata.org/entity/Q419534"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C501531&Units=SI")],
            element_info: None,
        ),
