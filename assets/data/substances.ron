    5684: (
            id: 5684,
            name: "Sotalol",
            formula: "C12H20N2O3S",
            state: Solid,
            molar_mass_g_mol: 272.1195,
            color_hex: None,
            melting_point_c: Some(206.75),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7816),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Sotalol, sold under the brand name Betapace among others, is a medication used to treat and prevent abnormal heart rhythms. Evidence does not support a decreased risk of death with long term use. It is taken by mouth or given by injection into a vein.
Common side effects include a slow heart rate, chest pain, low blood pressure, feeling tired, dizziness, shortness of breath, problems seeing, vomiting, and swelling. Other serious side effects may include QT prolongation, heart failure, or bronchospasm. Sotalol is a non-selective β-adrenergic receptor blocker which has both class II and class III antiarrhythmic properties.
Sotalol was first described in 1964 and came into medical use in 1974. It is available as a generic medication. In 2020, it was the 296th most commonly prescribed medication in the United States, with more than 1 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(0.24),
            appearance: None,
            synonyms: ["3930-20-9", "beta-Cardone", "DL-Sotalol", "Sotalolum", "Darob mite", "DTXSID0023589", "C07AA07", "A6D97U294I"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=936343"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C3930209&Units=SI")],
            element_info: None,
