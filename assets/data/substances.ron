    8703: (
            id: 8703,
            name: "Cefdinir",
            formula: "C14H13N5O5S2",
            state: Solid,
            molar_mass_g_mol: 395.0358,
            color_hex: None,
            melting_point_c: Some(170.0),
            boiling_point_c: None,
            density_g_cm3: None,
