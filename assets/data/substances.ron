            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Ammonium perchlorate (\"AP\") is an inorganic compound with the formula NH4ClO4.  It is a colorless or white solid that is soluble in water. It is a powerful oxidizer and a major component of ammonium perchlorate composite propellant. Its instability has involved it in accidents such as the PEPCON disaster, and has been suspected as the cause of the Port of Shahid Rajaee explosion."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H201: (Deleted) Explosive; mass explosion hazard [Danger Explosives]"),
            uses: ["Energy Releasers (explosives, motive propellant)", "Oxidizing/reducing agents", "All Other Basic Inorganic Chemical Manufacturing"],
            logp: Some(-3.962),
            appearance: Some("Ammonium perchlorate appears as a white, crystalline solid or powder. Classified as a division 1.1 explosive if powdered into particles smaller than 15 microns in diameter or if powdered into larger particles but thoroughly dried. Does not readily burn, but will burn if contaminated by combustible material. May explode under prolonged exposure to heat or fire. Used to make rocket propellants, explosives, pyrotechnics, as an etching and engraving agent, and in analytical chemistry."),
            synonyms: ["AP", "ClO4(-)", "[ClO4](-)", "Perchlorat", "perchlorate", "Chlorat(VII)", "PERCHLORATE ION", "tetraoxochlorate"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=56637"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/16211169"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_49706"), ("Wikidata", "http://www.wikidata.org/entity/Q410203"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C7790989&Units=SI")],
            element_info: None,
        ),
