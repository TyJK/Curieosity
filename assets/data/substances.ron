    5845: (
            id: 5845,
            name: "Dacarbazine",
            formula: "C6H10N6O",
            state: Solid,
            molar_mass_g_mol: 182.0916,
            color_hex: None,
            melting_point_c: Some(205.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(1.1626),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
