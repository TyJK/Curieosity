    2095: (
            id: 2095,
            name: "Lead nitrate",
            formula: "Pb(NO3)2",
            state: Solid,
            molar_mass_g_mol: 270.0,
            color_hex: None,
            melting_point_c: Some(469.85),
            boiling_point_c: None,
            density_g_cm3: Some(4.53),
            heat_capacity_solid_j_g_c: Some(0.3744),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
