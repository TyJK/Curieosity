            state: Solid,
            molar_mass_g_mol: 324.1029,
            color_hex: None,
            melting_point_c: Some(145.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7226),
            heat_capacity_liquid_j_g_c: None,
