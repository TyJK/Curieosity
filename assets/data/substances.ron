    5123: (
            id: 5123,
            name: "Fenoprofen",
            formula: "C15H14O3",
            state: Solid,
            molar_mass_g_mol: 242.0943,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6716),
