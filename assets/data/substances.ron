            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Prazepam is a benzodiazepine derivative drug developed by Warner-Lambert in the 1960s. It possesses anxiolytic, anticonvulsant, sedative and skeletal muscle relaxant properties. Prazepam, (Elimination half-life 29-224h), is a prodrug for desmethyldiazepam, (Elimination half-life 36-200h), which is responsible for the therapeutic effects of prazepam."),
            text_source: Some("Wikipedia"),
