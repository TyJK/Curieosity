            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1872657"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7071"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_90994"), ("Wikidata", "http://www.wikidata.org/entity/Q4030650"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C91952&Units=SI")],
