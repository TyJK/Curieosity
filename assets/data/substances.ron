    7929: (
            id: 7929,
            name: "N-Acetylglucosamine",
            formula: "C8H15NO6",
            state: Solid,
            molar_mass_g_mol: 221.0899,
            color_hex: None,
            melting_point_c: Some(205.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8377),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("N-Acetylglucosamine (GlcNAc) is an amide derivative of the monosaccharide glucose.  It is a secondary amide between glucosamine and acetic acid. It is significant in several biological systems.
It is part of a biopolymer in the bacterial cell wall, which is built from alternating units of GlcNAc and N-acetylmuramic acid (MurNAc), cross-linked with oligopeptides at the lactic acid residue of MurNAc. This layered structure is called peptidoglycan (formerly called murein).
GlcNAc is the monomeric unit of the polymer chitin, which forms the exoskeletons of arthropods like insects and crustaceans. It is the main component of the radulas of mollusks, the beaks of cephalopods, and a major component of the cell walls of most fungi.
Polymerized with glucuronic acid, it forms hyaluronan.
GlcNAc has been reported to be an inhibitor of elastase release from human polymorphonuclear leukocytes (range 8–17% inhibition), however this is much weaker than the inhibition seen with N-acetylgalactosamine (range 92–100%)."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-2.1),
            appearance: None,
            synonyms: ["2-Acetamido-2-deoxy-D-glucose", "7512-17-6", "Marine Sweet", "GreenNAG", "Bio-NAG", "acetyl glucosamine", "2-Acetamido-2-deoxyglucose", "DTXSID3045855"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2853534"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C7512176&Units=SI")],
            element_info: None,
        ),
    7932: (
            id: 7932,
            name: "Lovastatin",
            formula: "C24H36O5",
            state: Solid,
            molar_mass_g_mol: 404.2563,
            color_hex: None,
            melting_point_c: Some(174.5),
            boiling_point_c: None,
            density_g_cm3: None,
