    8195: (
            id: 8195,
            name: "Methacrolein",
            formula: "C4H6O",
            state: Liquid,
            molar_mass_g_mol: 70.09,
            color_hex: None,
            melting_point_c: Some(-81.15),
            boiling_point_c: Some(68.85),
            density_g_cm3: Some(0.847),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6663),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Methacrolein, or methacrylaldehyde, is an unsaturated aldehyde.  It is a clear, colorless, flammable liquid.
Methacrolein is one of two major products resulting from the reaction of isoprene with OH in the atmosphere, the other product being methyl vinyl ketone (MVK, also known as butenone). These compounds are important components of the atmospheric oxidation chemistry of biogenic chemicals, which can result in the formation of ozone and/or particulates. Methacrylaldehyde is also present in cigarette smoke. It can  be found in the essential oil of the plant Big Sagebrush (Artemisia tridentata) which contains 5% methacrolein. 
Industrially, the primary use of methacrolein is in the manufacture of polymers and synthetic resins.
Exposure to methacrolein is highly irritating to the eyes, nose, throat and lungs."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225 (93.5%): Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["CHEMICAL INTERMEDIATE; COMONOMER IN RESIN PRODN", "Copolymers, resins.", "Intermediates"],
            logp: Some(0.761),
            appearance: Some("Methacrylaldehyde appears as a colorless liquid. Less dense than water. May be toxic by ingestion, inhalation and skin absorption. Severely irritating to skin and eyes. Used to make plastics."),
            synonyms: ["2-methylprop-2-enal", "78-85-3", "Methacrylaldehyde", "2-Methyl-2-propenal", "2-Methylacrolein", "Isobutenal", "2-Propenal, 2-methyl-", "2-Methylpropenal"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=5684046"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6562"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_88384"), ("Wikidata", "http://www.wikidata.org/entity/Q420234"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C78853&Units=SI")],
            element_info: None,
        ),
