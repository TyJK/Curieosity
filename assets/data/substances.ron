    7643: (
            id: 7643,
            name: "Hexachlorophene",
            formula: "C13H6Cl6O2",
            state: Solid,
            molar_mass_g_mol: 403.8499,
            color_hex: None,
            melting_point_c: Some(164.0),
            boiling_point_c: Some(471.0),
            density_g_cm3: Some(1.71),
            heat_capacity_solid_j_g_c: Some(0.6956),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Hexachlorophene, also known as Nabac, is an organochlorine compound that was once widely used as a disinfectant. The compound occurs as a white odorless solid, although commercial samples can be off-white and possess a slightly phenolic odor. It is insoluble in water but dissolves in acetone, ethanol, diethyl ether, and chloroform. In medicine, hexachlorophene is useful as a topical anti-infective and anti-bacterial agent. It is also used in agriculture as a soil fungicide, plant bactericide, and acaricide. It has also been reported to bind tubulin, blocking its polymerization."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(7.54),
            appearance: Some("white, oil, solid"),
            synonyms: ["70-30-4", "Hexachlorofen", "Hexachlorophen", "Nabac", "pHisoHex", "Exofene", "Gamophen", "Almederm"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1918941"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C70304&Units=SI")],
            element_info: None,
        ),
    7644: (
            id: 7644,
            name: "Deferoxamine",
            formula: "C25H48N6O8",
            state: Solid,
            molar_mass_g_mol: 560.3534,
            color_hex: None,
            melting_point_c: Some(140.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8407),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Deferoxamine (DFOA), also known as desferrioxamine and sold under the brand name Desferal, is a medication that binds iron and aluminium. It is specifically used in iron overdose, hemochromatosis either due to multiple blood transfusions or an underlying genetic condition, and aluminium toxicity in people on dialysis. It is used by injection into a muscle, vein, or under the skin.
Common side effects include pain at the site of injection, diarrhea, vomiting, fever, hearing loss, and eye problems. Severe allergic reactions including anaphylaxis and low blood pressure may occur. It is unclear if use during pregnancy or breastfeeding is safe for the baby. Deferoxamine is a siderophore from the bacteria Streptomyces pilosus.
Deferoxamine was approved for medical use in the United States in 1968. It is on the World Health Organization's List of Essential Medicines."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-2.2),
            appearance: None,
            synonyms: ["70-51-9", "Desferrioxamine B", "DESFERRIOXAMINE", "Deferrioxamine", "Deferrioxamine B", "Deferoxamin", "Deferoxamine B", "Deferoxaminum"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2525165"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C70519&Units=SI")],
            element_info: None,
        ),
    7649: (
            id: 7649,
            name: "Eflornithine",
            formula: "C6H12F2N2O2",
            state: Solid,
            molar_mass_g_mol: 182.0867,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.9358),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid, IsBase],
            description: Some("Eflornithine, sold under the brand name Ornidyl among others, is a medication used to treat African trypanosomiasis (sleeping sickness) and excessive hair growth on the face in women. Specifically it is used for the second stage of sleeping sickness caused by T. b. gambiense and may be used with nifurtimox. It is taken intravenously (injection into a vein) or topically. It is an ornithine decarboxylase inhibitor.
Common side effects when applied as a cream include rash, redness, and burning. Side effects of the injectable form include bone marrow suppression, vomiting, and seizures. It is unclear if it is safe to use during pregnancy or breastfeeding. It is recommended typically for children over the age of 12.
Eflornithine was developed in the 1970s and came into medical use in 1990. It is on the World Health Organization's List of Essential Medicines. In the United States the injectable form can be obtained from the US Centers for Disease Control and Prevention. In regions of the world where sleeping sickness is common, eflornithine is provided for free by the World Health Organization."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-0.227),
            appearance: None,
            synonyms: ["70052-12-9", "dfmo", "2,5-diamino-2-(difluoromethyl)pentanoic acid", "2-(Difluoromethyl)ornithine", "Eflornitina", "Eflornithinum", "2-(Difluoromethyl)-DL-ornithine", "alpha-(Difluoromethyl)-DL-ornithine"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1453225"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C70052129&Units=SI")],
            element_info: None,
