            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Para-Toluenesulfonic acid (PTSA, pTSA, or pTsOH) or tosylic acid (TsOH) is an organic compound with the formula CH3C6H4SO3H. It is a white extremely hygroscopic solid that is soluble in water, alcohols, and other polar organic solvents. The CH3C6H4SO2 group is known as the tosyl group and is often abbreviated as Ts or Tos. Most often, TsOH refers to the monohydrate, TsOH.H2O.
As with other aryl sulfonic acids, TsOH is a strong organic acid.  It is about one million times stronger than benzoic acid.  It is one of the few strong acids that is solid and therefore is conveniently weighed and stored."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H314 (42.3%): Causes severe skin burns and eye damage [Danger Skin corrosion/irritation]"),
            uses: ["Catalyst", "Intermediate", "Processing aids not otherwise specified", "Surfactant (surface active agent)"],
            logp: Some(1.242),
            appearance: Some("Toluene sulfonic acid, liquid, with more than 5% free sulfuric acid appears as colorless to black solid. Odorless or nearly odorless. (USCG, 1999)"),
            synonyms: ["Tosylate", "tosic acid", "tosylic acid", "Toluene-4-sulfonate", "p-tolylsulfonic acid", "Toluen-4-sulfonsaeure", "4-toluenesulfonic acid", "PARA-TOLUENE SULFONATE"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=5207969"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6101"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_27849"), ("Wikidata", "http://www.wikidata.org/entity/Q285878"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C104154&Units=SI")],
