            logp: Some(2.066),
            appearance: Some("Benzoyl chloride appears as a colorless fuming liquid with a pungent odor. Flash point 162 °F. Lachrymator, irritating to skin and eyes. Corrosive to metals and tissue. Density 10.2 lb / gal. Used in medicine and in the manufacture of other chemicals."),
            synonyms: ["benzoic acid chloride", "alpha-chlorobenzaldehyde", "benzenecarbonyl chloride", "98-88-4", "Benzoic acid, chloride", "Benzaldehyde, alpha-chloro-", "DTXSID9026631", "VTY8706W36"],
