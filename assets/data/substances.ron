            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Teriflunomide, sold under the brand name Aubagio, is the active metabolite of leflunomide. Teriflunomide was investigated in the Phase III clinical trial TEMSO as a medication for multiple sclerosis (MS). The study was completed in July 2010. 2-year results were positive.  However, the subsequent    TENERE head-to-head comparison trial reported that \"although permanent discontinuations [of therapy] were substantially less common among MS patients who received teriflunomide compared with interferon beta-1a, relapses were more common with teriflunomide.\" The drug was approved for use in the United States in September 2012 and for use in the European Union in August 2013."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(2.999),
            appearance: None,
            synonyms: ["A77 1726", "163451-81-8", "Aubagio", "Flucyamide", "HMR1726", "HMR-1726", "HMR 1726", "teriflunomida"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=19263521"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C163451818&Units=SI")],
