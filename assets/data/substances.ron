    8530: (
            id: 8530,
            name: "Xylitol",
            formula: "C5H12O5",
            state: Liquid,
            molar_mass_g_mol: 152.0685,
            color_hex: None,
            melting_point_c: Some(93.85),
            boiling_point_c: Some(345.39),
