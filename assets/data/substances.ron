    5778: (
            id: 5778,
            name: "Crotonaldehyde",
            formula: "C4H6O",
            state: Liquid,
            molar_mass_g_mol: 70.09,
            color_hex: None,
            melting_point_c: Some(-76.45),
            boiling_point_c: Some(103.95),
            density_g_cm3: Some(0.846),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6663),
