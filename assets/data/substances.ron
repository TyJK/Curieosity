    7224: (
            id: 7224,
            name: "Uracil mustard",
            formula: "C8H11Cl2N3O2",
            state: Liquid,
            molar_mass_g_mol: 251.0228,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.87),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
