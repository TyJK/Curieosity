            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Aluminum sulfide is a chemical compound with the formula Al2S3. This colorless species has an interesting structural chemistry, existing in several forms. The material is sensitive to moisture, hydrolyzing to hydrated aluminum oxides/hydroxides. This can begin when the sulfide is exposed to the atmosphere. The hydrolysis reaction generates gaseous hydrogen sulfide (H2S)."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Catalyst", "All Other Basic Inorganic Chemical Manufacturing", "Petroleum Refineries"],
            logp: Some(0.267),
            appearance: Some("gray solid"),
