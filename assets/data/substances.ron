    3400: (
            id: 3400,
            name: "Methyl ethyl ketone peroxide",
            formula: "C8H18O6",
            state: Liquid,
            molar_mass_g_mol: 210.22,
            color_hex: None,
            melting_point_c: Some(24.85),
            boiling_point_c: Some(80.0),
            density_g_cm3: Some(1.17),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.7621),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Methyl ethyl ketone peroxide (MEKP) is an organic peroxide with the formula [(CH3)(C2H5)C(O2H)]2O2. MEKP is a colorless oily liquid.  It is widely used in vulcanization (crosslinking) of polymers.
It is derived from the reaction of methyl ethyl ketone and hydrogen peroxide under acidic conditions. Several products result from this reaction including a cyclic dimer. The linear dimer, the topic of this article, is the most prevalent. and this is the form that is typically quoted in the commercially available material.
Solutions of 30 to 40% MEKP are used in industry and by hobbyists as catalyst to initiate the crosslinking of unsaturated polyester resins used in fiberglass, and casting. For this application, MEKP often is dissolved in a phlegmatizer such as dimethyl phthalate, cyclohexane peroxide, or diallyl phthalate to reduce sensitivity to shock. Benzoyl peroxide can be used for the same purpose."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H242 (90%): Heating may cause a fire [Danger Self-reactive substances and mixtures; Organic peroxides]"),
            uses: ["Hardener", "All Other Basic Organic Chemical Manufacturing", "Catalyst", "Chemical reaction regulator", "Intermediate"],
            logp: Some(2.166),
            appearance: None,
            synonyms: ["MEKP", "MEK peroxide", "Iso-C3H7COC2H5", "2-Methyl-3-pentanal", "2-butanone peroxide", "2-Methyl-3-pentanone", "2-Methylpentan-3-one", "4-Methyl-3-pentanone"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=653060"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/3672772"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_89215"), ("Wikidata", "http://www.wikidata.org/entity/Q2914590"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1338234&Units=SI")],
