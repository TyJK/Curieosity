    3015: (
            id: 3015,
            name: "Cuminaldehyde",
            formula: "C10H12O",
            state: Liquid,
            molar_mass_g_mol: 148.2,
            color_hex: None,
            melting_point_c: Some(-126.84),
            boiling_point_c: Some(235.45),
            density_g_cm3: Some(0.978),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6188),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(13.14),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Cuminaldehyde (4-isopropylbenzaldehyde) is a natural organic compound with the molecular formula C10H12O.  It is a benzaldehyde with an isopropyl group substituted in the 4-position.
Cuminaldehyde is a constituent of the essential oils of eucalyptus, myrrh, cassia, cumin, and others.  It has a pleasant smell and contributes to the aroma of these oils.  It is used commercially in perfumes and other cosmetics.
It has been shown that cuminaldehyde, as a small molecule, inhibits the fibrillation of alpha-synuclein, which, if aggregated, forms insoluble fibrils in pathological conditions characterized by Lewy bodies, such as Parkinson's disease, dementia with Lewy bodies and multiple system atrophy.
Cuminaldehyde can be prepared synthetically by the reduction of 4-isopropylbenzoyl chloride or by the formylation of cumene.
The thiosemicarbazone of cuminaldehyde has antiviral properties."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H302 (99.9%): Harmful if swallowed [Warning Acute toxicity, oral]"),
            uses: ["Intermediates", "All Other Basic Organic Chemical Manufacturing"],
            logp: Some(2.623),
            appearance: Some("Liquid"),
            synonyms: ["cuminal", "Cumaldehyde", "Cumic aldehyde", "Cuminic aldehyde", "Cuminyl aldehyde", "p-Cumic aldehyde", "p-cuminic aldehyde", "4-Isopropylbenzaldehyde"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3212264"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/326"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_28671"), ("Wikidata", "http://www.wikidata.org/entity/Q419952"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C122032&Units=SI")],
            element_info: None,
