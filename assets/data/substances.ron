    7970: (
            id: 7970,
            name: "Methoxyflurane",
            formula: "C3H4Cl2F2O",
            state: Liquid,
            molar_mass_g_mol: 163.9607,
            color_hex: None,
            melting_point_c: Some(-35.0),
            boiling_point_c: Some(105.0),
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.8002),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
