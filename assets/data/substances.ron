            decay_particle_id: None,
            properties: [],
            description: Some("ortho-Cresol (IUPAC name: 2-methylphenol, also known as 2-hydroxytoluene or ortho-toluenol) is an organic compound with the formula CH3C6H4(OH). It is a colourless solid that is widely used intermediate in the production of other chemicals. It is a derivative of phenol and is an isomer of p-cresol and m-cresol."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H301: Toxic if swallowed [Danger Acute toxicity, oral]"),
            uses: ["Catalyst", "Solvent", "All Other Basic Organic Chemical Manufacturing"],
            logp: Some(1.701),
            appearance: Some("O-cresol appears as colorless or yellow to brown-yellow or pinkish colored liquid with a phenol-like odor. Toxic by ingestion and/or skin absorption. May have a flash point between 100 and 199 °F. Causes burns to skin, eyes and mucous membranes. Insoluble in water."),
            synonyms: ["2-Cresol", "O-Toluol", "o-Cresol", "o-Kresol", "orthocresol", "O-Oxytoluene", "ortho-Cresol", "2-methylphenol"],
