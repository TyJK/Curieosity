    5915: (
            id: 5915,
            name: "Linolenic acid",
            formula: "C18H30O2",
            state: Liquid,
            molar_mass_g_mol: 278.4,
            color_hex: None,
            melting_point_c: Some(-11.15),
            boiling_point_c: Some(231.85),
            density_g_cm3: Some(0.9164),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6049),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("α-Linolenic acid, also known as  alpha-linolenic acid (ALA) (from Greek alpha denoting \"first\" and linon meaning flax), is an n−3, or omega-3, essential fatty acid. ALA is found in many seeds and oils, including flaxseed, walnuts, chia, hemp, and many common vegetable oils.
In terms of its structure, it is named all-cis-9,12,15-octadecatrienoic acid. In physiological literature, it is listed by its lipid number, 18:3 (n−3). It is a carboxylic acid with an 18-carbon chain and three cis double bonds. The first double bond is located at the third carbon from the methyl end of the fatty acid chain, known as the n end. Thus, α-linolenic acid is a polyunsaturated n−3 (omega-3) fatty acid. It is a regioisomer of gamma-linolenic acid (GLA), an 18:3 (n−6) fatty acid (i.e., a polyunsaturated omega-6 fatty acid with three double bonds)."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H317 (10.4%): May cause an allergic skin reaction [Warning Sensitization, Skin]"),
            uses: ["Adhesives and sealant chemicals", "Agricultural chemicals (non-pesticidal)", "All Other Basic Organic Chemical Manufacturing", "CIR ingredient: Linolenic Acid", "CIR ingredient: Linseed Acid"],
            logp: Some(5.661),
            appearance: Some("Linolenic acid is a clear colorless liquid. (NTP, 1992)"),
            synonyms: ["ALA", "α-LA", "C18:3", "C18:3(n-3)", "linolenate", "a-Linolenate", "Linolensaeure", "Industrene 120"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=153316"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/860"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_25048"), ("Wikidata", "http://www.wikidata.org/entity/Q256502"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C463401&Units=SI")],
            element_info: None,
        ),
