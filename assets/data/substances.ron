    4350: (
            id: 4350,
            name: "Flucytosine",
            formula: "C4H4FN3O",
            state: Solid,
            molar_mass_g_mol: 129.0338,
            color_hex: None,
            melting_point_c: Some(296.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(1.1059),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Flucytosine, also known as 5-fluorocytosine (5-FC), is an antifungal medication. It is specifically used, together with amphotericin B, for serious Candida infections and cryptococcosis. It may be used by itself or with other antifungals for chromomycosis. Flucytosine is used by mouth and by injection into a vein.
Common side effects include bone marrow suppression, loss of appetite, diarrhea, vomiting, and psychosis. Anaphylaxis and other allergic reactions occasionally occur. It is unclear if use in pregnancy is safe for the baby. Flucytosine is in the fluorinated pyrimidine analogue family of medications. It works by being converted into fluorouracil inside the fungus, which impairs its ability to make protein.
Flucytosine was first made in 1957. It is on the World Health Organization's List of Essential Medicines.  It is not available in much of the developing world."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-1.1),
            appearance: None,
            synonyms: ["5-Fluorocytosine", "2022-85-7", "Fluorocytosine", "Ancobon", "Ancotil", "Fluocytosine", "5-Fluorocystosine", "Flucytosin"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3368767"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C2022857&Units=SI")],
            element_info: None,
