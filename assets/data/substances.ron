    6205: (
            id: 6205,
            name: "Bronopol",
            formula: "C3H6BrNO4",
            state: Solid,
            molar_mass_g_mol: 199.99,
            color_hex: None,
            melting_point_c: Some(129.85),
            boiling_point_c: Some(139.85),
            density_g_cm3: Some(1.1),
            heat_capacity_solid_j_g_c: Some(0.7015),
