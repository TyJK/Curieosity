            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Potassium hypochlorite is a chemical compound with the chemical formula KOCl, also written as KClO. It is the potassium salt of hypochlorous acid. It consists of potassium cations (K+) and hypochlorite anions (−OCl). It is used in variable concentrations, often diluted in water solution. Its aqueous solutions are colorless liquids (light yellow when impure) that have a strong chlorine smell. It is used as a biocide and disinfectant."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Intermediates"],
            logp: Some(-0.248),
            appearance: Some("Colorless liquid (light yellow when impure) ( aqueous solution )"),
            synonyms: ["ClO(-)", "[ClO](-)", "Hypochlorit", "hypochlorite", "oxidochlorate(1-)", "Hypochlorous acid, potassium salt", "Potassium chloride oxide", "Javel water"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=43571955"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/131859308"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_29222"), ("Wikidata", "http://www.wikidata.org/entity/Q1722304"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C7778667&Units=SI")],
            element_info: None,
