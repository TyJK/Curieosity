            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Fenchol or 1,3,3-trimethyl-2-norbornanol is a monoterpenoid and an isomer of borneol. It is a colorless or white solid.  It occurs widely in nature.
The naturally occurring enantiomere (1R)-endo-(+)-fenchol is used extensively in perfumery. Fenchol gives basil its characteristic scent, and comprises 15.9% of the volatile oils of some species of Aster.
It is biosynthesized from geranyl pyrophosphate via isomerization to linalyl pyrophosphate.
Oxidation of fenchol gives fenchone."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Laundry detergent (liquid)"],
            logp: Some(2.194),
            appearance: Some("colorless, white, oil, solid"),
            synonyms: ["FENCHYL ALCOHOL", "1632-73-1", "1,3,3-Trimethylbicyclo[2.2.1]heptan-2-ol", "2-Fenchanol", "1,3,3-TRIMETHYL-2-NORBORNANOL", "Bicyclo[2.2.1]heptan-2-ol, 1,3,3-trimethyl-", "FEMA No. 2480", "1,3,3-Trimethylbicyclo(2.2.1)heptan-2-ol"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=4592666"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1632731&Units=SI")],
