            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Isoquinoline is an individual chemical specimen - a heterocyclic aromatic organic compound - as well as the name of a family of many thousands of natural plant alkaloids, any one of which might be referred to as \"an isoquinoline\". It is a structural isomer of quinoline. Isoquinoline and quinoline are benzopyridines, which are composed of a benzene ring fused to a pyridine ring. In a broader sense, the term isoquinoline is used to make reference to isoquinoline derivatives. 1-Benzylisoquinoline is the structural backbone in many naturally occurring alkaloids such as papaverine. The isoquinoline ring in these natural compound derives from the aromatic amino acid tyrosine."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H311 (99.6%): Toxic in contact with skin [Danger Acute toxicity, dermal]"),
            uses: ["Catalyst", "Plastics Material and Resin Manufacturing", "Surface active agents"],
            logp: Some(2.235),
            appearance: None,
            synonyms: ["2-Benzazine", "Isochinolin", "Benzo[c]pyridine", "119-65-3", "2-Azanaphthalene", "Leucoline", "beta-Quinoline", "3,4-Benzopyridine"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1385625"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/8405"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_16092"), ("Wikidata", "http://www.wikidata.org/entity/Q412316"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C119653&Units=SI")],
