    2409: (
            id: 2409,
            name: "1,3-Butadiene",
            formula: "C4H6CH2=CH-CH=CH2",
            state: Gas,
            molar_mass_g_mol: 54.09,
            color_hex: None,
            melting_point_c: Some(-108.91),
