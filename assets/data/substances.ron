            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("1,4-Dihydroxyanthraquinone, also called quinizarin or Solvent Orange 86, is an organic compound derived from anthroquinone. Quinizarin is an orange or red-brown crystalline powder. It is formally derived from anthraquinone by replacement of two hydrogen atoms by hydroxyl (OH) groups. It is one of ten dihydroxyanthraquinone isomers and occurs in small amounts (as a glycoside) in the root of the madder plant, Rubia tinctorum."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H315 (90.9%): Causes skin irritation [Warning Skin corrosion/irritation]"),
