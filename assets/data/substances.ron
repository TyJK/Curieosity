    3726: (
            id: 3726,
            name: "Telmisartan",
            formula: "C33H30N4O2",
            state: Solid,
            molar_mass_g_mol: 514.2369,
            color_hex: None,
            melting_point_c: Some(262.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7407),
            heat_capacity_liquid_j_g_c: None,
