            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Pentolinium, also known as pentapyrrolidinium, is a ganglionic blocking agent which acts as a nicotinic acetylcholine receptor antagonist. Formulated as the pentolinium tartrate salt, it was marketed under the trade name Ansolysen. It can be used as an antihypertensive drug during surgery or to control hypertensive crises. It works by binding to the acetylcholine receptor of adrenergic nerves and thereby inhibiting the release of noradrenaline and adrenaline. Blocking this receptor leads to smooth muscle relaxation and vasodilation."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(2.638),
            appearance: None,
