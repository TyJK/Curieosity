    8064: (
            id: 8064,
            name: "Dicyclopentadiene",
            formula: "C10H12",
            state: Solid,
            molar_mass_g_mol: 132.2,
            color_hex: None,
            melting_point_c: Some(32.45),
            boiling_point_c: Some(169.85),
            density_g_cm3: Some(0.978),
            heat_capacity_solid_j_g_c: Some(0.5673),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(164.17),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Dicyclopentadiene, abbreviated DCPD, is a chemical compound with formula C10H12.  At room temperature, it is a white brittle wax, although lower purity samples can be straw coloured liquids. The pure material smells somewhat of soy wax or camphor, with less pure samples possessing a stronger acrid odor. Its energy density is 10,975 Wh/l.
Dicyclopentadiene is a co-produced in large quantities in the steam cracking of naphtha and gas oils to ethylene. The major use is in resins, particularly, unsaturated polyester resins.  It is also used in inks, adhesives, and paints.
The top seven suppliers worldwide together had an annual capacity in 2001 of 179 kilotonnes (395 million pounds).
DCPD was discovered in 1885 as a C10H12 hydrocarbon among the products of pyrolysis of phenol by Henry Roscoe, who didn't identify the structure (that was made during the following decade) but accurately assumed that it was a dimer of some C5H6 hydrocarbon."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225: Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Adhesives and sealant chemicals", "Intermediate", "Intermediates", "Monomers", "Plasticizer", "Plasticizers"],
            logp: Some(2.385),
            appearance: Some("Dicyclopentadiene appears as a liquid with an acrid odor. Flash point 90 °F. The vapors are irritating to the eyes and respiratory system. Subject to polymerization if subjected to heat for prolonged periods or if contaminated. If the polymerization takes place inside a container, the container may violently rupture. Insoluble in water. Density 8.2 lb / gal. Used in paints, varnishes, as an intermediate in insecticides, as a flame retardant in plastics."),
            synonyms: ["DCPD", "bicyclopentadiene", "3a,4,7,7a-tetrahydro-4,7-methanoindene", "77-73-6", "Cyclopentadiene dimer", "Biscyclopentadiene", "Dicyklopentadien", "Dimer cyklopentadienu"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1742660"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6492"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_34695"), ("Wikidata", "http://www.wikidata.org/entity/Q419053"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C77736&Units=SI")],
            element_info: None,
        ),
