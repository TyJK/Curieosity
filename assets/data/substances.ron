            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("1-Octene is an organic compound with a formula CH2CHC6H13. The alkene is classified as a higher olefin and alpha-olefin, meaning that the double bond is located at the alpha (primary) position, endowing this compound with higher reactivity and thus useful chemical properties. 1-Octene is one of the important linear alpha olefins in industry. It is a colourless liquid."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225 (94.9%): Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Lubricants and Greases", "Monomers", "Organic synthesis, plasticizer, surfactants", "Process regulators"],
            logp: Some(3.143),
            appearance: Some("1-octene appears as a colorless liquid. Flash point 70 °F. Insoluble in water and less dense (at about 6 lb / gal) than water. Hence floats on water. Vapors are heavier than air and may settle in depressions. Reported to biodegrade very slowly. Used in organic synthesis, surfactants, and plasticizers."),
            synonyms: ["octene", "1-C8H16", "octylene", "caprylene", "oct-1-ene", "1-n-octene", "n-1-octene", "1-caprylene"],
