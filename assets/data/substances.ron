    8486: (
            id: 8486,
            name: "Hydralazine",
            formula: "C8H8N4",
            state: Solid,
            molar_mass_g_mol: 160.0749,
            color_hex: None,
            melting_point_c: Some(172.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.9995),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Hydralazine, sold under the brand name Apresoline among others, is a medication used to treat high blood pressure and heart failure. This includes high blood pressure in pregnancy and very high blood pressure resulting in symptoms. It has been found to be particularly useful in heart failure, together with isosorbide dinitrate, for treatment of people of African descent. It is given by mouth or by injection into a vein. Effects usually begin around 15 minutes and last up to six hours.
Common side effects include headache and fast heart rate. It is not recommended in people with coronary artery disease or in those with rheumatic heart disease that affects the mitral valve. In those with kidney disease a low dose is recommended. Hydralazine is in the vasodilator family of medications, so it is believed to work by causing the dilation of blood vessels.
Hydralazine was discovered while scientists at Ciba were looking for a treatment for malaria. It was patented in 1949. It is on the World Health Organization's List of Essential Medicines. In 2023, it was the 109th most commonly prescribed medication in the United States, with more than 6 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.0),
            appearance: None,
            synonyms: ["1-Hydrazinophthalazine", "86-54-4", "1-Hydrazinylphthalazine", "Hypophthalin", "Hydralazin", "phthalazin-1-ylhydrazine", "Aprezolin", "Hydrazinophthalazine"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2504494"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C86544&Units=SI")],
            element_info: None,
        ),
    8487: (
            id: 8487,
            name: "Indigo carmine",
            formula: "C16H8N2Na2O8S2",
            state: Solid,
            molar_mass_g_mol: 445.4,
            color_hex: None,
            melting_point_c: Some(300.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8415),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsMetal, IsAcid, IsBase],
            description: Some("Indigo carmine, or 5,5′-indigodisulfonic acid sodium salt, is an organic salt derived from indigo by aromatic sulfonation, which renders the compound soluble in water. Like indigo, it produces a blue color, and is used in food and other consumables, cosmetics, and as a medical contrast agent and staining agent; it also acts as a pH indicator. It is approved for human consumption in the United States and European Union. It has the E number E132, and is named Blue No. 2 by the US Federal Food, Drug, and Cosmetic Act."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Dyes", "Synthetic Dye and Pigment Manufacturing"],
            logp: Some(0.927),
            appearance: Some("purple solid"),
            synonyms: ["E 132", "C.I. 73015", "C.I. 75781", "indigotine", "Acid blue 74", "Indigocarmine", "Natural blue 2", "FD&C Blue No. 2"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=5854119"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/156588357"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_31695"), ("Wikidata", "http://www.wikidata.org/entity/Q410120"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C860220&Units=SI")],
            element_info: None,
        ),
    8488: (
            id: 8488,
            name: "Latanoprostene Bunod",
            formula: "C27H41NO8",
            state: Solid,
            molar_mass_g_mol: 507.2832,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7118),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Latanoprostene bunod, sold under the brand name Vyzulta, is an ophthalmic medication used for the reduction of intraocular pressure in people with open-angle glaucoma or ocular hypertension. It is a prostaglandin analog which, when broken down by esterases and other metabolism, produces latanoprost acid and eventually nitrous oxide. Latanoprost increases uveoscleral outflow while the nitrous oxide increases outflow via the trabecular meshwork. 
The most common side effects include conjunctival (eye) redness, eye irritation, and eye discomfort (pain). Latanoprostene bunod may cause the iris (colored part of the eye) to become darker in color.
Latanoprostene bunod was approved for medical use in the United States in November 2017."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.767),
            appearance: None,
            synonyms: ["BOL-303259-X", "860005-21-6", "Vyzulta", "PF-3187207", "NCX-116", "Vesneo", "latanoprosteno bunod", "I6393O0922"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=56137798"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C860005216&Units=SI")],
            element_info: None,
        ),
    8491: (
            id: 8491,
            name: "Icosapent ethyl",
            formula: "C22H34O2",
            state: Solid,
            molar_mass_g_mol: 330.2559,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6007),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Icosapent ethyl (USAN, EMA), also known by its chemical name ethyl eicosapentaenoate and incorrect chemical name ethyl eicosapentaenoic acid (E-EPA), sold under the brand name Vascepa among others, is a medication used to treat dyslipidemia and hypertriglyceridemia. It is used in combination with changes in diet in adults with hypertriglyceridemia ≥ 150 mg/dL. Further, it is often required to be used with a statin (maximally-tolerated dose).
The most common side effects are musculoskeletal pain, peripheral edema (swelling of legs and hands), atrial fibrillation, and arthralgia (joint pain). Other common side effects include bleeding, constipation, gout, and rash.
It is made from the omega−3 fatty acid eicosapentaenoic acid (EPA). The US Food and Drug Administration (FDA) granted the approval of icosapent ethyl in 2012, to Amarin Corporation, and it became the second fish oil-based medication after omega-3-acid ethyl esters (brand named Lovaza, itself approved in 2004). In December 2019, the FDA also approved Vascepa as the first drug specifically \"to reduce cardiovascular risk among people with elevated triglyceride levels\". It is available as a generic medication. Vazkepa was approved in Europe in 2021. In 2023, it was the 244th most commonly prescribed medication in the United States, with more than 1 million prescriptions.<"),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(6.471),
            appearance: Some("oil"),
            synonyms: ["Eicosapentaenoic acid ethyl ester", "EPA ethyl ester", "Ethyl eicosapentaenoic acid", "E-EPA", "Eicosapent, Icosapent ethyl (USAN US)", "ethyl icosapentate", "Epadel", "ethyl eicosapentaenoate"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=20949899"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C86227476&Units=SI")],
            element_info: None,
        ),
