            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Zucapsaicin (Civanex) is a medication used to treat osteoarthritis of the knee and other neuropathic pain. Zucapsaicin is a member of phenols and a member of methoxybenzenes. It is a modulator of transient receptor potential cation channel subfamily V member 1 (TRPV-1), also known as the vanilloid or capsaicin receptor 1 that reduces pain, and improves articular functions. It is the cis-isomer of capsaicin. Civamide, manufactured by Winston Pharmaceuticals, is produced in formulations for oral, nasal, and topical use (patch and cream).
Zucapsaicin has been tested for treatment of a variety of conditions associated with ongoing nerve pain. This includes herpes simplex infections; cluster headaches and migraine; and knee osteoarthritis. It was approved by the Health Canada in 2010 as topical cream sold under the brand name Zuacta. It has a melting point of 71.5–74.5 °C."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.79),
            appearance: None,
            synonyms: ["25775-90-0", "cis-Capsaicin", "Civamide", "Civanex", "Zucapsaicina", "Zucapsaicine", "15OX67P384", "DTXSID101014453"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=33004989"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C25775900&Units=SI")],
            element_info: None,
