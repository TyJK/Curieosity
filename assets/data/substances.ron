    5375: (
            id: 5375,
            name: "Perfluoro-2-butyltetrahydrofuran",
            formula: "C8F16O",
            state: Liquid,
            molar_mass_g_mol: 415.9694,
            color_hex: None,
            melting_point_c: Some(-88.15),
            boiling_point_c: Some(101.85),
