    8669: (
            id: 8669,
            name: "Naphthalene",
            formula: "C10H8",
            state: Solid,
            molar_mass_g_mol: 128.17,
            color_hex: None,
            melting_point_c: Some(78.15),
            boiling_point_c: Some(217.97),
