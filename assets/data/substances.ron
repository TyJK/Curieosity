            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Tenoxicam, sold under the brand name Mobiflex among others, is a nonsteroidal anti-inflammatory drug (NSAID). It is used to relieve inflammation, swelling, stiffness, and pain associated with rheumatoid arthritis, osteoarthritis, ankylosing spondylitis (a type of arthritis involving the spine), tendinitis (inflammation of a tendon), bursitis (inflammation of a bursa, a fluid-filled sac located around joints and near the bones), and periarthritis of the shoulders or hips (inflammation of tissues surrounding these joints).
Tenoxicam belongs to the class of NSAIDs known as oxicams.
It was patented in 1974 by Roche and approved for medical use in 1987. It is available as a prescription-only drug in the United Kingdom and other countries, but not in the US.  Outside the United Kingdom, tenoxicam is also marketed under brand names including Tilatil, Tilcitin, and Alganex."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.9),
            appearance: None,
            synonyms: ["59804-37-4", "Mobiflex", "Tilcotil", "Tenoxicamum", "Ro 12-0068", "Ro 12-0068/000", "Ro-12-0068", "DTXSID8045486"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=13590762"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C59804374&Units=SI")],
            element_info: None,
