            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Trifluoroacetyl chloride (also known as TFAC) is a toxic gaseous chemical compound with the chemical formula C2ClF3O. TFAC is the perfluorinated version of acetyl chloride. The compound is a gas, but it is usually shipped as a liquid under high pressure."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H314 (100%): Causes severe skin burns and eye damage [Danger Skin corrosion/irritation]"),
            uses: ["All Other Basic Organic Chemical Manufacturing", "Intermediate", "Soil amendments (fertilizers)"],
            logp: Some(1.314),
            appearance: Some("Trifluoroacetyl chloride appears as a colorless gas. Shipped as a liquid under own vapor pressure. Contact with the unconfined liquid may frostbite unprotected skin. Very toxic by inhalation and may severely irritate skin, eyes, and mucous membranes. Under prolonged exposure to fire or heat the containers may rupture violently and rocket."),
            synonyms: ["CF3COCl", "perfluoroacetyl chloride", "2,2,2-trifluoroacetyl chloride", "354-32-5", "ACETYL CHLORIDE, TRIFLUORO-", "A23U71SY9G", "DTXSID1029176", "CHEBI:29138"],
