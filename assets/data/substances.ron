    5089: (
            id: 5089,
            name: "Guanfacine",
            formula: "C9H9Cl2N3O",
            state: Solid,
            molar_mass_g_mol: 245.0123,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8538),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
