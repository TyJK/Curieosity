    8506: (
            id: 8506,
            name: "Benazepril",
            formula: "C24H28N2O5",
            state: Solid,
            molar_mass_g_mol: 424.1998,
            color_hex: None,
            melting_point_c: Some(148.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.739),
