    3655: (
            id: 3655,
            name: "Hexanoic acid",
            formula: "C6H12O2",
            state: Liquid,
            molar_mass_g_mol: 116.16,
            color_hex: None,
            melting_point_c: Some(-3.35),
            boiling_point_c: Some(205.75),
            density_g_cm3: Some(0.929),
