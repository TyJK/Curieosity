            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Naldemedine, sold under the brand name Symproic in the US and Rizmoic in the European Union, is a medication that is used for the treatment of opioid-induced constipation in adults who have previously been treated with a laxative in the European Union, or to treat opioid induced constipation in adults with chronic non-cancer pain in the US. It is a peripherally acting μ-opioid receptor antagonist and was developed by Shionogi. Clinical studies have found it to possess statistically significant effectiveness for these indications and to be generally well tolerated, with predominantly mild to moderate gastrointestinal side effects. Effects indicative of central opioid withdrawal or impact on the analgesic or miotic effects of co-administered opioids have only been observed in a small number of patients."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.48),
