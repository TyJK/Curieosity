    3807: (
            id: 3807,
            name: "Menthol",
            formula: "C10H20O",
            state: Solid,
            molar_mass_g_mol: 156.26,
            color_hex: None,
            melting_point_c: Some(36.85),
            boiling_point_c: Some(214.65),
            density_g_cm3: Some(0.89),
            heat_capacity_solid_j_g_c: Some(0.5868),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
