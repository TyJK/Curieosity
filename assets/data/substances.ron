            references: [("Wikipedia", "https://en.wikipedia.org/?curid=12328746"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_34024"), ("Wikidata", "http://www.wikidata.org/entity/Q81982617"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C421738&Units=SI")],
