    7219: (
            id: 7219,
            name: "Dienogest",
            formula: "C20H25NO2",
            state: Solid,
            molar_mass_g_mol: 311.1885,
            color_hex: None,
            melting_point_c: Some(214.0),
            boiling_point_c: Some(549.0),
            density_g_cm3: Some(1.2),
            heat_capacity_solid_j_g_c: Some(0.6697),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
