            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Tin(II) sulfate (SnSO4) is a chemical compound. It is a white solid that can absorb enough moisture from the air to become fully dissolved, forming an aqueous solution; this property is known as deliquescence. It can be prepared by a displacement reaction between metallic tin and copper(II) sulfate:

Sn (s) + CuSO4 (aq)  →  Cu (s) + SnSO4 (aq)
Tin(II) sulfate is a convenient source of tin(II) ions uncontaminated by tin(IV) species."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["All Other Basic Inorganic Chemical Manufacturing", "Bleaching agent", "Fabricated Metal Product Manufacturing", "Miscellaneous Manufacturing", "Plating agents and surface treating agents"],
            logp: Some(-1.034),
            appearance: Some("white-yellowish crystalline solid deliquescent"),
            synonyms: ["SnSO4", "GingiMed", "fluoristan", "tin bifluoride", "tin difluoride", "tin(II) fluoride", "stannous fluoride", "difluorostannylene"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=5302143"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/16211682"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_135933"), ("Wikidata", "http://www.wikidata.org/entity/Q204981"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C7488553&Units=SI")],
