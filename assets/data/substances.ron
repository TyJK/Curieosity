            synonyms: ["HCBD", "Hexachlorobutadiene", "Hexachloro-1,3-butadiene", "2,3-bis(chloranyl)buta-1,3-diene", "2,3-Dichlorobutadiene", "1653-19-6", "1,3-Butadiene, 2,3-dichloro-", "2,3-Dichlor-1,3-butadien"],
