    6809: (
            id: 6809,
            name: "Tenoxicam",
            formula: "C13H11N3O4S2",
            state: Solid,
            molar_mass_g_mol: 337.0191,
            color_hex: None,
            melting_point_c: Some(211.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8442),
            heat_capacity_liquid_j_g_c: None,
