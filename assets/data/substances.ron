    3947: (
            id: 3947,
            name: "Olsalazine",
            formula: "C14H10N2O6",
            state: Solid,
            molar_mass_g_mol: 302.0539,
            color_hex: None,
            melting_point_c: Some(240.0),
            boiling_point_c: None,
            density_g_cm3: None,
