            synonyms: ["C.I. 58050", "Chinizarin", "quinizarine", "Solvent Orange 86", "1,4-Dihydroxyanthrachinon", "1,4-Dihydroxyanthraquinone", "1,4-dihydroxy-9,10-anthraquinone", "1,4-dihydroxyanthra-9,10-quinone"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=26001706"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6688"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_37487"), ("Wikidata", "http://www.wikidata.org/entity/Q906609"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C81641&Units=SI")],
