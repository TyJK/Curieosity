    2411: (
            id: 2411,
            name: "Tamsulosin",
            formula: "C20H28N2O5S",
            state: Solid,
            molar_mass_g_mol: 408.1719,
            color_hex: None,
            melting_point_c: Some(227.0),
            boiling_point_c: None,
            density_g_cm3: None,
