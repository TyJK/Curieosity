    8324: (
            id: 8324,
            name: "Cholic Acid",
            formula: "C24H40O5",
            state: Solid,
            molar_mass_g_mol: 408.2876,
            color_hex: None,
            melting_point_c: Some(200.35),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6454),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Cholic acid, also known as 3α,7α,12α-trihydroxy-5β-cholan-24-oic acid is a primary bile acid that is insoluble in water (soluble in alcohol and acetic acid),  it is a white crystalline substance.  Salts of cholic acid are called cholates.  Cholic acid, along with chenodeoxycholic acid, is one of the two major bile acids produced by the liver, where it is synthesized from cholesterol.  These two major bile acids are roughly equal in concentration in humans. Derivatives are made from cholyl-CoA, which exchanges its CoA with either glycine, or taurine, yielding glycocholic and taurocholic acid, respectively.
Cholic acid downregulates cholesterol-7-α-hydroxylase (rate-limiting step in bile acid synthesis), and cholesterol does the opposite.  This is why chenodeoxycholic acid, and not cholic acid, can be used to treat gallstones (because decreasing bile acid synthesis would supersaturate the stones even more).
Cholic acid and chenodeoxycholic acid are the most important human bile acids.  Other species may synthesize different bile acids as their predominant primary bile acids."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(2.02),
            appearance: Some("white, crystalline"),
            synonyms: ["81-25-4", "Cholalic acid", "Colalin", "Cholalin", "Cholbam", "Cholsaeure", "cholicacid", "NSC-6135"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2984470"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C81254&Units=SI")],
            element_info: None,
        ),
    8325: (
