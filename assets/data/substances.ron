    2066: (
            id: 2066,
            name: "Aluminum sulfate",
            formula: "Al2(SO4)3",
            state: Liquid,
            molar_mass_g_mol: 125.06,
            color_hex: None,
            melting_point_c: Some(-233.15),
            boiling_point_c: Some(101.11),
            density_g_cm3: Some(2.672),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.9228),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Aluminium sulfate is a salt with the formula Al2(SO4)3. It is soluble in water and is mainly used as a coagulating agent (promoting particle collision by neutralizing charge) in the purification of drinking water and wastewater treatment plants, and also in paper manufacturing.
The anhydrous form occurs naturally as a rare mineral millosevichite, found for example in volcanic environments and on burning coal-mining waste dumps. Aluminium sulfate is rarely, if ever, encountered as the anhydrous salt. It forms a number of different hydrates, of which the hexadecahydrate Al2(SO4)3·16H2O and octadecahydrate Al2(SO4)3·18H2O are the most common. The heptadecahydrate, whose formula can be written as [Al(H2O)6]2(SO4)3·5H2O, occurs naturally as the mineral alunogen.
Aluminium sulfate is sometimes called alum or papermaker's alum in certain industries. However, the name \"alum\" is more commonly and properly used for any double sulfate salt with the generic formula XAl(SO4)2·12H2O, where X is a monovalent cation such as potassium or ammonium."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H318 (91.5%): Causes serious eye damage [Danger Serious eye damage/eye irritation]"),
            uses: ["Agricultural chemicals (non-pesticidal)", "Fillers", "Flocculating agent"],
            logp: Some(-1.034),
            appearance: None,
            synonyms: ["alum", "Al2(SO4)3", "papermaker's alum", "aluminium sulphate", "dialuminum sulfate", "aluminum(III) sulfate", "dialuminum trisulfate", "aluminium(III) sulfate"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2035853"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/54605280"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_74768"), ("Wikidata", "http://www.wikidata.org/entity/Q421857"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C10043013&Units=SI")],
            element_info: None,
        ),
    2067: (
            id: 2067,
            name: "Boron nitride",
            formula: "BN",
            state: Liquid,
            molar_mass_g_mol: 24.82,
            color_hex: None,
            melting_point_c: Some(-27.15),
            boiling_point_c: None,
            density_g_cm3: Some(2.1),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(1.4504),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
