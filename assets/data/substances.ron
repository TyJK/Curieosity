            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Aluminium hydroxide, Al(OH)3, is found as the mineral gibbsite (also known as hydrargillite) and its three much rarer polymorphs: bayerite, doyleite, and nordstrandite. Aluminium hydroxide is amphoteric, i.e., it has both basic and acidic properties. Closely related are aluminium oxide hydroxide, AlO(OH), and aluminium oxide or alumina (Al2O3), the latter of which is also amphoteric. These compounds together are the major components of the aluminium ore bauxite. Aluminium hydroxide also forms a gelatinous precipitate in water."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H315 (19.7%): Causes skin irritation [Warning Skin corrosion/irritation]"),
            uses: ["Absorbent", "Antacid /Aluminum Hydroxide gel/", "CIR ingredient: Aluminum Hydroxide", "Desiccant powder"],
            logp: Some(-2.052),
            appearance: None,
            synonyms: ["Al(OH)3", "Aluminiumhydroxid", "aluminium hydroxide", "trihydroxidoaluminium", "aluminium(3+) hydroxide", "aluminium(III) hydroxide", "Hydrated alumina", "Amphojel"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=193294"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6328211"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_33130"), ("Wikidata", "http://www.wikidata.org/entity/Q407125"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C21645512&Units=SI")],
            element_info: None,
