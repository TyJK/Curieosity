            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Bis(2-ethylhexyl) terephthalate commonly abbreviated DEHT (Dioctyl terephthalate or DOTP), is an organic compound with the formula C6H4(CO2C8H17)2. It is a diester of terephthalic acid and the branched-chain 2-ethylhexanol, which is often generically referred to as octyl.  This colorless viscous liquid is used for softening PVC plastics and is known for chemical similarity to general purpose phthalates such as DEHP and DINP, but without any negative regulatory pressure. It possesses very good plasticizing properties and may be used as a direct replacement for DEHP and DINP in many applications."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Plasticizer", "Plasticizers", "All Other Basic Organic Chemical Manufacturing", "Custom Compounding of Purchased Resins", "Other (requires additional information)"],
            logp: Some(6.433),
            appearance: Some("NKRA; Pellets or Large Crystals; Liquid"),
            synonyms: ["Dioctyl hexanedioate", "bis(2-ethylhexyl)terephthalate", "Di-(2-ethylhexyl) terephthalate", "1,4-DEHT", "RefChem:568745", "Eastman DOTP Plasticizer", "6422-86-2", "BIS(2-ETHYLHEXYL) TEREPHTHALATE"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=31464006"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/22932"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_168986"), ("Wikidata", "http://www.wikidata.org/entity/Q5279087"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C6422862&Units=SI")],
