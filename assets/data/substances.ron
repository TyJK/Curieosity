    7266: (
            id: 7266,
            name: "Linagliptin",
            formula: "C25H28N8O2",
            state: Solid,
            molar_mass_g_mol: 472.2335,
            color_hex: None,
            melting_point_c: Some(202.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8913),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Linagliptin, sold under the brand name Tradjenta among others, is a medication used to treat type 2 diabetes (but not type 1) in conjunction with exercise and diet. Linagliptin is a dipeptidyl peptidase-4 inhibitor that works by increasing the production of insulin and decreasing the production of glucagon by the pancreas. It is generally less preferred than metformin and sulfonylureas as an initial treatment. It is taken by mouth.
Common side effects include inflammation of the nose and throat. Serious side effects may include angioedema, pancreatitis, joint pain. Use in pregnancy and breastfeeding is not recommended.
Linagliptin was approved for medical use in the United States, Japan, the European Union, Canada, and Australia in 2011. In 2023, it was the 254th most commonly prescribed medication in the United States, with more than 1 million prescriptions. From August 2021, linagliptin became available as a generic medicine in the US."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.147),
            appearance: None,
            synonyms: ["BI-1356", "668270-12-0", "Tradjenta", "BI 1356", "Trazenta", "Trajenta", "BI-1356-BS", "linagliptine"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=18475687"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C668270120&Units=SI")],
            element_info: None,
