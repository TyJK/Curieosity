            synonyms: ["DBDPE", "84852-53-9", "decabromodiphenyl ethane", "DeBDethane", "FIREMASTER 2100", "1,2-bis(pentabromophenyl)ethane", "WZ2532TA0A", "284-366-9"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=72692264"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/10985889"), ("Wikidata", "http://www.wikidata.org/entity/Q3410491"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C84852539&Units=SI")],
