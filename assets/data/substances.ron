    7829: (
            id: 7829,
            name: "L-Arginine",
            formula: "C6H14N4O2",
            state: Solid,
            molar_mass_g_mol: 174.2,
            color_hex: None,
            melting_point_c: Some(259.85),
            boiling_point_c: Some(367.85),
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(1.0241),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid, IsBase],
            description: Some("Arginine is the amino acid with the formula (H2N)(HN)CN(H)(CH2)3CH(NH2)CO2H.  The molecule features a guanidino group appended to a standard amino acid framework. At physiological pH, the carboxylic acid is deprotonated (−CO2−) and both the amino and guanidino groups are protonated, resulting in a cation. Only the l-arginine (symbol Arg or R) enantiomer is found naturally. Arg residues are common components of proteins. It is encoded by the codons CGU, CGC, CGA, CGG, AGA, and AGG. The guanidine group in arginine is the precursor for the biosynthesis of nitric oxide. Like all amino acids, it is a white, water-soluble solid.
The one-letter symbol R was assigned to arginine for its phonetic similarity in English."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H315 (70.7%): Causes skin irritation [Warning Skin corrosion/irritation]"),
            uses: ["Pharmaceutical and Medicine Manufacturing"],
            logp: Some(-1.338),
            appearance: Some("White crystals"),
            synonyms: ["Harg", "Arginin", "2-amino-5-guanidinopentanoic acid", "2-amino-5-(carbamimidamido)pentanoic acid", "L-arginine", "arginine", "74-79-3", "L-(+)-Arginine"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=63550"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/232"), ("Wikidata", "http://www.wikidata.org/entity/Q27104032"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C74793&Units=SI")],
            element_info: None,
        ),
    7830: (
            id: 7830,
            name: "Methyl bromide",
            formula: "CH3Br",
            state: Gas,
            molar_mass_g_mol: 279.21,
            color_hex: None,
            melting_point_c: Some(-93.66),
            boiling_point_c: Some(3.95),
