            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: Some(2.97),
            heat_capacity_solid_j_g_c: Some(0.5129),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Ammonium dimolybdate (ADM) is the inorganic compound with the formula (NH4)2Mo2O7. It is a white, water-soluble solid. ADM is an intermediate in the production of molybdenum compounds from its ores.  Roasting typical ore produces crude molybdenum(VI) oxides, which can be extracted into aqueous ammonia, affording ammonium molybdate.  Heating solutions of ammonium molybdate gives ADM.  Upon heating, solid ammonium dimolybdate decomposes to molybdenum trioxide:

(NH4)2Mo2O7   →   2 MoO3  +  2 NH3  +  H2O
In terms of its chemical structure, the anion is a polymeric consisting of distorted octahedral Mo centers linked by tetrahedral molybdate centers.  When prepared in the absence of water as its tetrabutylammonium salt, dimolybdate adopts the centrosymmetric structure observed for dichromate."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Corrosion inhibitors and anti-scaling agents", "Process regulators", "Agricultural chemicals (non-pesticidal)", "All Other Basic Inorganic Chemical Manufacturing", "Flame retardant", "Intermediates"],
            logp: Some(0.255),
            appearance: Some("white solid"),
            synonyms: ["HMo2O7(-)", "hydrogen dimolybdate", "[(HO)Mo(O)2OMo(O)3](-)", "hydrogen(heptaoxidodimolybdate)(1-)", "Ammonium molybdenum oxide", "azanium;molybdenum;oxygen(2-);hydrate", "11098-84-3", "Ammonium molibdate"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=46721957"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/11557287"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_36268"), ("Wikidata", "http://www.wikidata.org/entity/Q20658352"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C27546072&Units=SI")],
