            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Hexadecyl hexadecanoate, also known as cetyl palmitate, is the ester derived from hexadecanoic acid and 1-hexadecanol. This white waxy solid is the primary constituent of spermaceti, the once highly prized wax found in the skull of sperm whales. Cetyl palmitate is a component of some solid lipid nanoparticles.
Stony corals, which build the coral reefs, contain large amounts of cetyl palmitate wax in their tissues, which may function in part as an antifeedant."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Emulsifier", "Agricultural chemicals (non-pesticidal)", "CIR ingredient: Cetyl Palmitate", "Density modifier", "Lubricants and lubricant additives", "Miscellaneous Manufacturing"],
