    8600: (
            id: 8600,
            name: "Mesalazine",
            formula: "C7H7NO3",
            state: Solid,
            molar_mass_g_mol: 153.0426,
            color_hex: None,
            melting_point_c: Some(283.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8338),
            heat_capacity_liquid_j_g_c: None,
