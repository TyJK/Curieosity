    2508: (
            id: 2508,
            name: "Isopropyl acetate",
            formula: "C5H10O2",
            state: Liquid,
            molar_mass_g_mol: 102.13,
            color_hex: None,
            melting_point_c: Some(-73.15),
            boiling_point_c: Some(88.85),
            density_g_cm3: Some(0.87),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6942),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(-435.09),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Isopropyl acetate (commonly abbreviated IPAc or iPrOAc) is an ester, an organic compound which is the product of esterification of acetic acid and isopropanol.  It is a clear, colorless liquid with a characteristic fruity odor.
Isopropyl acetate is a solvent with a wide variety of manufacturing uses that is miscible with most other organic solvents and is slightly soluble in water (2.9 wt% at 20 °C), though less so than ethyl acetate. Inversely, water is also slightly soluble in isopropyl acetate (1.8 wt% at 20 °C). Isopropyl acetate forms an azeotrope with water, allowing for anhydrous solutions to be easily achieved through evaporation with an azeotrope composition of 88.9 wt% isopropyl acetate. It is used as a solvent for cellulose, plastics, oil and fats.  It is a component of some printing inks and perfumes.
Isopropyl acetate decomposes slowly on contact with steel in the presence of air, producing acetic acid and isopropanol. It reacts violently with oxidizing materials and it attacks many plastics.
Isopropyl acetate is quite flammable in both its liquid and vapor forms, and it may be harmful if swallowed or inhaled.
The Occupational Safety and Health Administration has set a permissible exposure limit (PEL) of 250 ppm (950 mg/m3) over an eight-hour time-weighted average for workers handling isopropyl acetate."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225: Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Pigments", "Solvent", "All Other Basic Organic Chemical Manufacturing", "CIR ingredient: Isopropyl Acetate", "Intermediate"],
            logp: Some(0.958),
            appearance: Some("Isopropyl acetate appears as a clear colorless liquid. Flash point 40 °F. Vapors are heavier than air. Contact with the material may irritate skin, eyes or mucous membranes. May be toxic by ingestion, inhalation and skin absorption. Used as a solvent."),
            synonyms: ["2-propyl acetate", "propan-2-yl acetate", "isopropyl ester of acetic acid", "1-methylethyl ester of acetic acid", "108-21-4", "2-Acetoxypropane", "Acetic acid, 1-methylethyl ester", "Isopropyl ethanoate"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3755309"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7915"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_230546"), ("Wikidata", "http://www.wikidata.org/entity/Q419799"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C108214&Units=SI")],
            element_info: None,
        ),
