            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("α-Pinene is an organic compound of the terpene class.  It is one of the two isomers of pinene, the other being β-pinene. An alkene, it contains a strained four-membered ring. It is found in the oils of many species of coniferous trees, notably Pinus and Picea species. It is also found in the essential oil of rosemary (Rosmarinus officinalis) and Satureja myrtifolia (also known as Zoufa in some regions). Both enantiomers are known in nature; (1S,5S)- or (−)-α-pinene is more common in European pines, whereas the (1R,5R)- or (+)-α-isomer is more common in North America. The enantiomers' racemic mixture is present in some oils such as eucalyptus oil and orange peel oil."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H304 (74.1%): May be fatal if swallowed and enters airways [Danger Aspiration hazard]"),
            uses: ["Fragrance", "Cosmetics,food/foodstuff additive,odor agents", "Flavor ingredient", "Flavoring and nutrient"],
            logp: Some(2.999),
            appearance: Some("Alpha-pinene appears as a clear colorless liquid with a turpentine odor. Flash point 91 °F. Less dense than water and insoluble in water. Vapors are heavier than air. Used as a solvent."),
            synonyms: ["Pinene", "2-pinene", "α-pinene", "acintene A", "(±)-α-pinene", "alpha-Pinene", "pin-2(3)-ene", "(-)-alpha-Pinene"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3769810"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6654"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_17187"), ("Wikidata", "http://www.wikidata.org/entity/Q27104380"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C7785264&Units=SI")],
