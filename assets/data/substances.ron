    8972: (
            id: 8972,
            name: "Trimethylsilane",
            formula: "C3H10Si",
            state: Gas,
            molar_mass_g_mol: 74.2,
            color_hex: None,
            melting_point_c: Some(-135.95),
            boiling_point_c: Some(6.65),
            density_g_cm3: Some(0.638),
