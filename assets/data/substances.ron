    6705: (
            id: 6705,
            name: "Azelastine",
            formula: "C22H24ClN3O",
            state: Solid,
            molar_mass_g_mol: 381.1608,
            color_hex: None,
            melting_point_c: Some(225.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7391),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Azelastine, sold under the brand name Astelin among others, is a H1 receptor-blocking medication primarily used as a nasal spray to treat allergic rhinitis (hay fever) and as eye drops for allergic conjunctivitis. Other uses may include asthma and skin rashes for which it is taken by mouth. Onset of effects is within minutes when used in the eyes and within an hour when used in the nose. Effects last for up to 12 hours.
Common side effects include headache, sleepiness, change in taste, and sore throat. It is unclear if use is safe during pregnancy or breastfeeding. It is a second-generation antihistamine and works by blocking the release of a number of inflammatory mediators including histamine.
Azelastine was patented in 1971 and came into medical use in 1986. It is available as a generic medication. In 2023, it was the 142nd most commonly prescribed medication in the United States, with more than 3 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(4.9),
            appearance: None,
            synonyms: ["58581-89-8", "Azelastina", "Azelastinum", "ZQI909440X", "NSC-758971", "CHEBI:2950", "DTXSID6022638", "A-5610"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=5143313"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C58581898&Units=SI")],
            element_info: None,
