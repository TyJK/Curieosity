            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Methyl salicylate (oil of wintergreen or wintergreen oil) is an organic compound with the formula C8H8O3.  It is the methyl ester of salicylic acid. It is a colorless, viscous liquid with a sweet, fruity odor reminiscent of root beer (in which it is used as a flavoring), but often associatively called \"minty\", as it is an ingredient in mint candies. It is produced by many species of plants, particularly wintergreens. It is also produced synthetically, used as a fragrance and as a flavoring agent."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H314: Causes severe skin burns and eye damage [Danger Skin corrosion/irritation]"),
            uses: ["Fragrance", "Odor agents", "All Other Basic Organic Chemical Manufacturing", "CIR ingredient: Methyl Salicylate", "Flavoring and nutrient"],
            logp: Some(1.179),
