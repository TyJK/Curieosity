            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsMetal, IsAcid],
            description: Some("Potassium metabisulfite, K2S2O5, also known as potassium pyrosulfite, is a white crystalline powder with a pungent odour. It is mainly used as an antioxidant or chemical sterilant.  As a disulfite, it is chemically very similar to sodium metabisulfite, with which it is sometimes used interchangeably.  Potassium metabisulfite has a monoclinic crystal structure."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H318 (13.7%): Causes serious eye damage [Danger Serious eye damage/eye irritation]"),
            uses: ["Stabilizing agent", "Antimicrobial preservative; antioxidant.", "Bleaching agents"],
            logp: Some(-1.37),
            appearance: Some("Potassium metabisulfite appears as a white granular or powdery solid with a sharp odor of sulfur dioxide. Decomposes at 150 to 190 °C. Density 2.3 g / cm3. Contact severely irritates skin, eyes, and mucous membranes. Low toxicity. Used as a food preservative and an antioxidant."),
            synonyms: ["Fremy's salt", "dipotassium disulfite", "dipotassium disulphite", "potassium metabisulphite", "potassium nitrosodisulfonate", "dipotassium nitrosodisulfonate", "dipotassium nitrosodisulphonate", "Dikalium-(disulfonatoamino)oxidanyl"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2883343"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/16211240"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_184372"), ("Wikidata", "http://www.wikidata.org/entity/Q417881"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C16731558&Units=SI")],
            element_info: None,
