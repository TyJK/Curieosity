    5088: (
            id: 5088,
            name: "Glipizide",
            formula: "C21H27N5O4S",
            state: Solid,
            molar_mass_g_mol: 445.1784,
            color_hex: None,
            melting_point_c: Some(208.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8354),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
