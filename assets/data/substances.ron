    8072: (
            id: 8072,
            name: "Citric acid",
            formula: "C6H8O7",
            state: Solid,
            molar_mass_g_mol: 192.12,
            color_hex: None,
            melting_point_c: Some(155.85),
            boiling_point_c: Some(309.85),
            density_g_cm3: Some(1.665),
            heat_capacity_solid_j_g_c: Some(0.8427),
            heat_capacity_liquid_j_g_c: None,
