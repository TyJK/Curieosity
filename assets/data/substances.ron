            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Propyl acetate, also known as propyl ethanoate, is an organic compound. Nearly 20,000 tons are produced annually for use as a solvent. This colorless liquid is known by its characteristic odor of pears and some apples. Due to this fact, it is commonly used in fragrances and as a flavor additive. It is formed by the esterification of acetic acid and propan-1-ol, often via Fischer–Speier esterification, with sulfuric acid as a catalyst and water produced as a byproduct."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225: Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Pigments", "Solvent", "All Other Basic Organic Chemical Manufacturing", "CIR ingredient: Propyl Acetate"],
            logp: Some(0.96),
            appearance: Some("N-propyl acetate appears as a clear colorless liquid with a pleasant odor. Flash point 58 °F. Less dense than water, Vapors are heavier than air."),
            synonyms: ["propylacetate", "1-Propyl acetate", "1-acetoxypropane", "n-Propyl acetate", "propyl ethanoate", "N-Propyl ethanoate", "Acetic acid,propyl ester", "Acetic acid, propyl ester"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2998111"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7997"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_40116"), ("Wikidata", "http://www.wikidata.org/entity/Q415750"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C109604&Units=SI")],
