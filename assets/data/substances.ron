    5202: (
            id: 5202,
            name: "Chlorambucil",
            formula: "C14H19Cl2NO2",
            state: Solid,
            molar_mass_g_mol: 303.0793,
            color_hex: None,
            melting_point_c: Some(65.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7041),
