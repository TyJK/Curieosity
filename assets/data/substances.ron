    2813: (
            id: 2813,
            name: "Duloxetine",
            formula: "C18H19NOS",
            state: Liquid,
            molar_mass_g_mol: 297.1187,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
