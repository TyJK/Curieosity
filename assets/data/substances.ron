            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Decabromodiphenyl ethane is a chemical compound used as a brominated flame retardant. It was commercialised in the 1990s as an alternative for decabromodiphenyl ether, following safety concern over that compound. The two molecules are chemically very similar, which gives them a similar application profile. Decabromodiphenyl ethane is now also coming under regulatory pressure."),
            text_source: Some("Wikipedia"),
