    7894: (
            id: 7894,
            name: "1,1-Dichloroethane",
            formula: "C2H4Cl2",
            state: Liquid,
            molar_mass_g_mol: 98.96,
            color_hex: None,
            melting_point_c: Some(-97.15),
            boiling_point_c: Some(57.15),
            density_g_cm3: Some(1.2),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6568),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
