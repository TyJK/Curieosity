            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Allyl alcohol (IUPAC name: prop-2-en-1-ol) is an organic compound with the structural formula CH2=CHCH2OH.  Like many alcohols, it is a water-soluble, colourless liquid.  It is more toxic than typical small alcohols. Allyl alcohol is used as a precursor to many specialized compounds such as flame-resistant materials, drying oils, and plasticizers.  Allyl alcohol is the smallest representative of the allylic alcohols."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225: Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Computer and Electronic Product Manufacturing", "Fillers"],
            logp: Some(0.165),
            appearance: Some("Allyl alcohol appears as a clear colorless liquid with a mustard-like odor. Flash point 70 °F. Very toxic by inhalation and ingestion. Less dense than water (7.1 lb / gal). Vapors are heavier than air. Prolonged exposure to low concentrations or short exposure to high concentrations may have adverse health effects from inhalation."),
            synonyms: ["AA", "propenol", "2-Propenol", "1-propen-3-ol", "2-Propen-1-ol", "Vinylcarbinol", "Vinyl carbinol", "prop-2-en-1-ol"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2997124"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7858"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_16605"), ("Wikidata", "http://www.wikidata.org/entity/Q414553"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C107186&Units=SI")],
            element_info: None,
