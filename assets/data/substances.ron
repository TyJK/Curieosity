    5746: (
            id: 5746,
            name: "Isophorone diisocyanate",
            formula: "C12H18N2O2",
            state: Liquid,
            molar_mass_g_mol: 222.28,
            color_hex: None,
            melting_point_c: Some(-60.15),
            boiling_point_c: Some(157.85),
            density_g_cm3: Some(1.062),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.7801),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Isophorone diisocyanate (IPDI) is an organic compound in the class known as isocyanates. More specifically, it is an aliphatic diisocyanate. It is produced in relatively small quantities, accounting for (with hexamethylene diisocyanate) only 3.4% of the global diisocyanate market in the year 2000. Aliphatic diisocyanates are used, not in the production of polyurethane foam, but in special applications, such as enamel coatings which are resistant to abrasion and degradation from ultraviolet light. These properties are particularly desirable in, for instance, the exterior paint applied to aircraft."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H331: Toxic if inhaled [Danger Acute toxicity, inhalation]"),
            uses: ["Monomers", "Adhesives and sealant chemicals", "All Other Basic Organic Chemical Manufacturing"],
            logp: Some(2.243),
            appearance: Some("Isophorone diisocyanate appears as a clear to light-yellow liquid. Slightly denser than water and insoluble in water. Toxic by inhalation and skin absorption. Very irritating to skin. Used to make polyurethane coatings."),
            synonyms: ["IPDI", "Isophorone diamine diisocyanate", "3-Isocyanatomethyl-3,5,5-trimethylcyclohexyliso…", "3-Isocyanatomethyl-3,5,5-trimethylcyclohexyl-is…", "5-isocyanato-1-(isocyanatomethyl)-1,3,3-trimeth…", "Isocyanic acid, methylene(3,5,5-trimethyl-3,1-c…", "4098-71-9", "DTXSID0023826"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=4183474"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/169132"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_53214"), ("Wikidata", "http://www.wikidata.org/entity/Q415415"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C4098719&Units=SI")],
            element_info: None,
        ),
