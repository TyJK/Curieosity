            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Tetraethylammonium (TEA) is a quaternary ammonium cation with the chemical formula [Et4N]+, consisting of four ethyl groups (−C2H5, denoted Et) attached to a central nitrogen atom. It is a counterion used in the research laboratory to prepare lipophilic salts of inorganic anions. It is used similarly to tetrabutylammonium, the difference being that its salts are less lipophilic, more easily crystallized and more toxic."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H302 (95%): Harmful if swallowed [Warning Acute toxicity, oral]"),
            uses: ["All Other Basic Organic Chemical Manufacturing", "Intermediates"],
            logp: Some(-1.113),
            appearance: Some("Liquid"),
            synonyms: ["NEt4(+)", "[NEt4](+)", "tetraethylazanium", "Tetraethylammonium", "TETRAETHYLAMMONIUM ION", "N,N,N-triethylethanaminium", "Ethanaminium, N,N,N-triethyl-, fluoride", "EINECS 211-559-7"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=902918"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/69582"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_44296"), ("Wikidata", "http://www.wikidata.org/entity/Q72504970"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C665463&Units=SI")],
