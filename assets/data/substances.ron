    6859: (
            id: 6859,
            name: "Bifonazole",
            formula: "C22H18N2",
            state: Solid,
            molar_mass_g_mol: 310.147,
            color_hex: None,
            melting_point_c: Some(142.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6932),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Bifonazole works by inhibiting the production of a substance called ergosterol, which is an essential component of fungal cell membranes.It acts to destabilize the fungal cyctochrome p450 51 enzyme (also known as Lanosterol 14-alpha demethylase). This is vital in the cell membrance structure of the fungus. Its inhibition leads to cell lysis. The disruption in production of ergosterol disrupts the cell membrane and causes holes to appear. The cell membranes of fungi are vital for their survival. They keep unwanted substances from entering the cells and stop the contents of the cells from leaking out. As bifonazole causes holes to appear in the cell membranes, essential constituents of the fungal cells can leak out. This kills the fungi."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(4.77),
            appearance: None,
            synonyms: ["60628-96-8", "Mycospor", "Trifonazole", "Bifonazol", "BAY H 4502", "Bifonazolum", "1-((4-Biphenylyl)phenylmethyl)-1H-imidazole", "1-(alpha-(4-Biphenylyl)benzyl)imidazole"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=12932135"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C60628968&Units=SI")],
            element_info: None,
