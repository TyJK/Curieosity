            references: [("Wikipedia", "https://en.wikipedia.org/?curid=15978248"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6625"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_65786"), ("Wikidata", "http://www.wikidata.org/entity/Q4637049"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C80079&Units=SI")],
