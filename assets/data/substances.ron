    2751: (
            id: 2751,
            name: "Ergotamine",
            formula: "C33H35N5O5",
            state: Solid,
            molar_mass_g_mol: 581.2638,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
