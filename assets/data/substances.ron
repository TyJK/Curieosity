    3809: (
            id: 3809,
            name: "Oxymetazoline",
            formula: "C16H24N2O",
            state: Solid,
            molar_mass_g_mol: 260.1889,
            color_hex: None,
            melting_point_c: Some(182.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7176),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Oxymetazoline, sold under the brand name Afrin among others, is a topical decongestant and vasoconstrictor medication. It is available over-the-counter as a nasal spray to treat nasal congestion and nosebleeds, as eye drops to treat eye redness due to minor irritation, and (in the United States) as a prescription topical cream to treat persistent facial redness due to rosacea in adults. Its effects begin within minutes and last for up to six hours. Intranasal use for longer than three to five days may cause congestion to recur or worsen, resulting in physical dependence. Fluticasone (Flonase) and other intransal glucocorticoids are known to treat oxymetazoline dependence.
Oxymetazoline is a derivative of imidazole. It was developed from xylometazoline at Merck by Wolfgang Fruhstorfer and Helmut Müller-Calgan in 1961. A direct sympathomimetic, oxymetazoline binds to and activates α1 adrenergic receptors and α2 adrenergic receptors, most notably. One study classified it in the following order: α(2A) > α(1A) ≥ α(2B) > α(1D) ≥ α(2C) >> α(1B), but this is not universally agreed upon.
Another study classified it with selectivity ratios in alpha 2 adrenergic receptors of 200 for a2A vs a2B, 7.1 a2A vs a2C, and 28.2 a2B vs a2C.
In 2022, it was the 305th most commonly prescribed medication in the United States, with more than 300,000 prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.4),
            appearance: None,
            synonyms: ["1491-59-4", "Oxymethazoline", "Hazol", "Oximetazolinum", "Oxylazine", "Rhinofrenol", "Sinerol", "Iliadin"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1526132"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C1491594&Units=SI")],
            element_info: None,
        ),
