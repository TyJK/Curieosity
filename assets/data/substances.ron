            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Benzothiazole, or more specifically 1,3-benzothiazole, is an aromatic heterocyclic compound with the chemical formula C7H5NS. It is colorless, slightly viscous liquid. Although the parent compound, benzothiazole is not widely used, many of its derivatives are found in commercial products or in nature. Firefly luciferin can be considered a derivative of benzothiazole. It has a sulfurous odor and meaty flavor. 
The three structural isomers of benzothizaole are 1,3-benzothiazole, 1,2-benzothiazole and 2,1-benzothiazole."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H301+H311 (10.2%): Toxic if swallowed or in contact with skin [Danger Acute toxicity, oral; acute toxicity, dermal]"),
            uses: ["ANTIMICROBIAL AGENT", "All Other Basic Organic Chemical Manufacturing", "Component of cyanine dyes", "FLAVORING SUBSTANCE OR ADJUVANT", "Intermediate", "RUBBER ACCELERATOR /THIAZOLES/"],
            logp: Some(2.296),
            appearance: None,
            synonyms: ["BT", "Benzothiazol", "Benzosulfonazole", "1,3-benzothiazole", "1-Thia-3-azaindene", "95-16-9", "Vangard BT", "USAF EK-4812"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2022329"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7222"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_45993"), ("Wikidata", "http://www.wikidata.org/entity/Q419096"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C95169&Units=SI")],
            element_info: None,
