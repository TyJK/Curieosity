    8457: (
            id: 8457,
            name: "Phenanthrene",
            formula: "C14H10",
            state: Solid,
            molar_mass_g_mol: 178.23,
            color_hex: None,
            melting_point_c: Some(100.85),
            boiling_point_c: Some(331.85),
            density_g_cm3: Some(1.18),
            heat_capacity_solid_j_g_c: Some(0.5891),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
