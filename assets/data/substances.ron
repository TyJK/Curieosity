    7446: (
            id: 7446,
            name: "Hexafluoroacetone",
            formula: "C3F6O",
            state: Gas,
            molar_mass_g_mol: 166.02,
            color_hex: None,
            melting_point_c: Some(-129.15),
            boiling_point_c: Some(-28.15),
            density_g_cm3: Some(1.32),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: Some(0.9951),
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Hexafluoroacetone (HFA) is a chemical compound with the formula (CF3)2CO. It is structurally similar to acetone; however, its reactivity is markedly different. It is a colourless, hygroscopic, nonflammable, highly reactive gas characterized by a musty odour.  According to electron diffraction, HFA and acetone adopt very similar structures, the C-O distance being only longer in the fluorinated compound (124.6 vs 121.0 pm), possibly due to steric effects.
The term \"hexafluoroacetone\" can refer to the sesquihydrate (1.5 H2O), which is a hemihydrate of hexafluoropropane-2,2-diol (F3C)2C(OH)2, a geminal diol.  Hydrated HFA behaves differently from the anhydrous material."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H301+H311 (15%): Toxic if swallowed or in contact with skin [Danger Acute toxicity, oral; acute toxicity, dermal]"),
            uses: ["All Other Basic Organic Chemical Manufacturing", "Intermediate"],
            logp: Some(1.68),
            appearance: None,
            synonyms: ["6FK", "HFA", "(CF3)2CO", "perfluoroacetone", "hexafluoropropanone", "perfluoro-2-propanone", "perfluoropropan-2-one", "hexafluoro-2-propanone"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3939550"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/12695"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_39429"), ("Wikidata", "http://www.wikidata.org/entity/Q416322"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C684162&Units=SI")],
