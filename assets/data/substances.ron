    8859: (
            id: 8859,
            name: "Methyl ethyl ketoxime",
            formula: "C4H9NO",
            state: Liquid,
            molar_mass_g_mol: 87.12,
            color_hex: None,
            melting_point_c: Some(-15.15),
            boiling_point_c: Some(151.85),
