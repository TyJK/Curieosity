            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Bis(2-ethylhexyl) maleate is the chemical compound with the structural formula (H3C(−CH2)3−CH(−CH2−CH3)−CH2−O−C(=O)−CH=)2, where the two carboxylate groups are mutually cis. It can be described as the double ester of maleic acid with the alcohol 2-ethylhexanol.  It is commonly called dioctyl maleate (DOM), reflecting the older usage of \"octane\" to refer to any 8-carbon alkane, straight-chained or branched. 
The compound is manufactured by treating 2-ethylhexanol with maleic anhydride and an esterification catalyst. It is a key intermediate raw material in the production of dioctyl sulfosuccinate (DOSS, docusate) salts, used medically as laxatives and stool softeners, and in many other applications as versatile surfactants."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H315 (22.5%): Causes skin irritation [Warning Skin corrosion/irritation]"),
            uses: ["Plasticizer", "Agricultural chemicals (non-pesticidal)", "All Other Basic Organic Chemical Manufacturing", "CHEM INT FOR SULFOSUCCINATE ANIONIC SURFACTANTS", "CIR ingredient: Diethylhexyl Malate"],
            logp: Some(5.062),
            appearance: Some("Liquid"),
            synonyms: ["dioctyl maleate", "Bis(2-ethylhexyl) amine", "di-2-ethylhexyl maleate", "2-ethyl-N-(2-ethylhexyl)hexan-1-amine", "142-16-5", "Bis(2-ethylhexyl)maleate", "RC Comonomer DOM", "diethylhexyl maleate"],
