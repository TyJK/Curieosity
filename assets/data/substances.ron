            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("2,4,6-Tri-tert-butylphenol (2,4,6-TTBP) is a phenol symmetrically substituted with three tert-butyl groups and thus strongly sterically hindered. 2,4,6-TTBP is a readily oxidizable aromatic compound and a weak acid. It oxidizes to give the deep-blue 2,4,6-tri-tert-butylphenoxy radical.  2,4,6-TTBP is related to 2,6-di-tert-butylphenol, which is widely used as an antioxidant in industrial applications.  These compounds are colorless solids."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H360D: May damage the unborn child [Danger Reproductive toxicity]"),
            uses: ["All Other Basic Organic Chemical Manufacturing", "Fuels and fuel additives", "Intermediates"],
            logp: Some(5.285),
