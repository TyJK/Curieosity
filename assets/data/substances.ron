    4289: (
            id: 4289,
            name: "Telithromycin",
            formula: "C43H65N5O10",
            state: Solid,
            molar_mass_g_mol: 811.4731,
            color_hex: None,
            melting_point_c: Some(177.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7573),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Telithromycin is the first ketolide antibiotic to enter clinical use and is sold under the brand name of Ketek. It is used to treat community acquired pneumonia of mild to moderate severity. After significant safety concerns, the US Food and Drug Administration sharply curtailed the approved uses of the drug in early 2007.
Telithromycin is a semi-synthetic erythromycin derivative. It is created by substituting a ketogroup for the cladinose sugar and adding a carbamate ring in the lactone ring. An alkyl-aryl moiety is attached to this carbamate ring. Furthermore, the oxygen at the 6 position is methylated, as is the case with clarithromycin, to achieve better acid-stability.
It was patented in 1994 and approved for medical use in 2001."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.0),
            appearance: None,
            synonyms: ["191114-48-4", "Ketek", "HMR-3647", "HMR3647", "Levviax", "RU-66647", "telithromycine", "telitromicina"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=722620"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C191114484&Units=SI")],
            element_info: None,
        ),
    4291: (
