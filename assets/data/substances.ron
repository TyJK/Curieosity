    3462: (
            id: 3462,
            name: "Aluminum dihydrogen phosphate",
            formula: "AlH6O12P3",
            state: Solid,
            molar_mass_g_mol: 124.977,
            color_hex: None,
            melting_point_c: Some(1500.0),
            boiling_point_c: None,
            density_g_cm3: Some(2.56),
            heat_capacity_solid_j_g_c: Some(0.9266),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
