            appearance: Some("Cobalt acetate is a red-violet crystalline solid. Vinegar-like odor. (USCG, 1999)"),
            synonyms: ["Cobaltous acetate", "Bis(acetato)cobalt", "Cobalt(2+) acetate", "cobalt(II) acetate", "Cobaltous diacetate", "cobalt(2+) diacetate", "Acetic acid, cobalt(2+) salt", "Acetic acid, cobalt(2+) salt (2:1)"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=19624360"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/54602348"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_85138"), ("Wikidata", "http://www.wikidata.org/entity/Q421198"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C71487&Units=SI")],
