            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Carbohydrazide is the chemical compound with the formula OC(N2H3)2.  It appears as a white solid that is soluble in water, but not in many organic solvents, such as ethanol, ether or benzene. It decomposes upon melting.  A number of carbazides are known where one or more N-H groups are replaced by other substituents.  They occur widely in the drugs, herbicides, plant growth regulators, and dyestuffs."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H302 (59.1%): Harmful if swallowed [Warning Acute toxicity, oral]"),
            uses: ["Antioxidant"],
            logp: Some(-1.967),
