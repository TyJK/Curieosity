    3835: (
            id: 3835,
            name: "Tropicamide",
            formula: "C17H20N2O2",
            state: Solid,
            molar_mass_g_mol: 284.1525,
            color_hex: None,
            melting_point_c: Some(96.5),
            boiling_point_c: Some(233.37),
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7422),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(40.12),
