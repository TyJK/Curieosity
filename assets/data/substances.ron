    8104: (
            id: 8104,
            name: "Copper sulfate",
            formula: "CuSO4(anhydrous)CuSO4·5H2O(pentahydrate)",
            state: Solid,
            molar_mass_g_mol: 161.63,
            color_hex: None,
            melting_point_c: Some(109.85),
            boiling_point_c: Some(650.0),
            density_g_cm3: Some(3.6),
            heat_capacity_solid_j_g_c: Some(0.714),
            heat_capacity_liquid_j_g_c: None,
