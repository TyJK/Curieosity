    8180: (
            id: 8180,
            name: "Carisoprodol",
            formula: "C12H24N2O4",
            state: Solid,
            molar_mass_g_mol: 260.1736,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7949),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
