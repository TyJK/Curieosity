    2379: (
            id: 2379,
            name: "Nerol",
            formula: "C10H18O",
            state: Liquid,
            molar_mass_g_mol: 154.25,
            color_hex: None,
            melting_point_c: Some(-15.0),
            boiling_point_c: Some(224.35),
            density_g_cm3: Some(0.881),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.5945),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Nerol is a monoterpenoid alcohol found in many essential oils such as lemongrass and hops. It was originally isolated from neroli oil, hence its name. This colourless liquid is used in perfumery. Like geraniol, nerol has a sweet rose odor but it is considered to be fresher.  Esters and related derivatives of nerol are referred to as neryl, e.g., neryl acetate.
Isomeric with nerol is geraniol, which is its trans- or E-isomer. Nerol readily loses water to form a set of C10 compounds called dipentene. Nerol can be synthesized by pyrolysis of beta-pinene, which also affords myrcene. Hydrochlorination of myrcene gives a series of isomeric chlorides."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H318: Causes serious eye damage [Danger Serious eye damage/eye irritation]"),
            uses: ["Intermediates", "Odor agents", "All Other Basic Organic Chemical Manufacturing", "Base for manufacture of perfumes."],
            logp: Some(2.671),
            appearance: Some("Liquid"),
            synonyms: ["(Z)-geraniol", "cis-geraniol", "neryl alcohol", "3,7-dimethyl-2,6-octadien-1-ol", "(Z)-3,7-Dimethylocta-2,6-dien-1-ol", "(Z)-3,7-dimethyl-2,6-octadien-1-ol", "cis-3,7-dimethyl-2,6-octadien-1-ol", "(2Z)-3,7-dimethyl-2,6-octadien-1-ol"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3232750"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/4458"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_29452"), ("Wikidata", "http://www.wikidata.org/entity/Q27109834"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C106252&Units=SI")],
            element_info: None,
