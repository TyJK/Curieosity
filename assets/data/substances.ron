            state: Liquid,
            molar_mass_g_mol: 96.08,
            color_hex: None,
            melting_point_c: Some(-37.15),
            boiling_point_c: Some(161.85),
            density_g_cm3: Some(1.1601),
            heat_capacity_solid_j_g_c: None,
