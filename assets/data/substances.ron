    5547: (
            id: 5547,
            name: "Quazepam",
            formula: "C17H11ClF4N2S",
            state: Solid,
            molar_mass_g_mol: 386.0268,
            color_hex: None,
            melting_point_c: Some(138.25),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8007),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Quazepam, sold under the brand name Doral among others, is a relatively long-acting benzodiazepine derivative drug developed by the Schering Corporation in the 1970s. Quazepam is used for the treatment of insomnia, including sleep induction and sleep maintenance. Quazepam induces impairment of motor function and has relatively (and uniquely) selective hypnotic and anticonvulsant properties with considerably less overdose potential than other benzodiazepines (due to its novel receptor-subtype selectivity). Quazepam is an effective hypnotic which induces and maintains sleep without disruption of the sleep architecture.
It was patented in 1970 and came into medical use in 1985."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(4.03),
            appearance: None,
            synonyms: ["Doral", "Selepam", "Dormalin", "36735-22-5", "Sch 16134", "Quazepamum", "Sch-16134", "Quazepam civ"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2393371"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C36735225&Units=SI")],
            element_info: None,
        ),
    5548: (
            id: 5548,
            name: "Lurasidone",
            formula: "C28H36N4O2S",
            state: Solid,
            molar_mass_g_mol: 492.2559,
            color_hex: None,
            melting_point_c: Some(177.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7435),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Lurasidone, sold under the brand name Latuda among others, is an atypical antipsychotic medication used to treat schizophrenia and bipolar depression. It is taken by mouth.
Common side effects include sedation, indigestion, nausea, and insomnia. At higher dosages, there is an increased risk for restlessness and movement problems. Serious side effects are valid for all atypical antipsychotics and may include the potentially permanent movement disorder tardive dyskinesia, as well as neuroleptic malignant syndrome, an increased risk of suicide, angioedema, and high blood sugar levels. Although lurasidone is less likely to cause high blood sugar levels in most patients, hyperosmolar hyperglycemic syndrome may occur. In older people with psychosis as a result of dementia, it may increase the risk of dying. Use during pregnancy is of unclear safety. 
Lurasidone was first approved for medical use in the United States in 2010. In 2013, it was approved in Canada and by the U.S. Food and Drug Administration (FDA) to treat bipolar depression, either as monotherapy or adjunctively with lithium or valproate. It has no effect on manic symptoms and is more potent for treating major depressive disorder or depressive episodes associated with bipolar disorder. Generic versions were approved in the United States in 2019, and became available in 2023. In 2021, it was the 193rd most commonly prescribed medication in the United States, with more than 2 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(4.256),
            appearance: None,
            synonyms: ["SM-13496", "367514-87-2", "lurasidona", "lurasidonum", "SM-13496 FREE BASE", "22IC88528T", "CHEBI:70735", "DTXSID40870340"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=18920589"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C367514872&Units=SI")],
            element_info: None,
        ),
    5549: (
            id: 5549,
            name: "4-Amino-2,2,6,6-tetramethylpiperidine",
            formula: "C9H20N2",
            state: Liquid,
            molar_mass_g_mol: 156.1626,
            color_hex: None,
            melting_point_c: Some(16.85),
            boiling_point_c: Some(188.45),
            density_g_cm3: Some(0.8966),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.7524),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("4-Amino-2,2,6,6-tetramethyl-4-piperidine is an organic compound with the formula H2NCH(CH2CMe2)2NH (where Me = CH3).  Classified as a diamine, it is a colorless oily liquid.
The compound is an intermediate in the preparation of Bobbitt's salt, an oxidant used in organic synthesis.  It is prepared by the reductive amination of the corresponding ketone:

OC(CH2CMe2)2NH  +  NH3  +  H2  →   H2NCH(CH2CMe2)2NH  +   H2O"),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["All Other Basic Organic Chemical Manufacturing", "Process regulators"],
            logp: Some(1.254),
            appearance: Some("colorless liquid"),
            synonyms: ["1-(2-hydroxyethyl)-2,2,6,6-tetramethylpiperidin…", "4-Hydroxy-1-(2-hydroxyethyl)-2,2,6,6-tetramethy…", "36768-62-4", "2,2,6,6-tetramethylpiperidin-4-amine", "ETF220Q65R", "DTXSID3044388", "NSC-102510", "DTXCID1024388"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=60522578"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_182655"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C36768624&Units=SI")],
            element_info: None,
        ),
    5550: (
            id: 5550,
            name: "Ribavirin",
            formula: "C8H12N4O5",
            state: Solid,
            molar_mass_g_mol: 244.0808,
            color_hex: None,
            melting_point_c: Some(167.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.9976),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Ribavirin, also known as tribavirin, is an antiviral medication used to treat illness caused by respiratory syncytial virus (RSV) and hepatitis C virus (HCV) infections, as well as some viral hemorrhagic fevers. For HCV, it is used in combination with other medications, such as simeprevir, sofosbuvir, peginterferon alfa-2b or peginterferon alfa-2a. It can also be used for viral hemorrhagic fevers—specifically, for Lassa fever, Crimean–Congo hemorrhagic fever, and Hantavirus infections (with exceptions for Ebola or Marburg virus diseases). Ribavirin is usually taken orally (by mouth) or inhaled. Despite widespread usage, it has faced scrutiny in the 21st century because of lack of proven efficacy in treating viral infections for which it has been prescribed in the past.
Its common side effects include fatigue, headache, nausea, fever, muscle pains, and an irritable mood. Serious side effects include red blood cell breakdown, liver problems, and allergic reactions. Its use during pregnancy can bring harm to the developing fetus. Effective birth control is recommended for both males and females for at least seven months during and after use. The mechanism of action of ribavirin is not entirely clear.
Ribavirin was patented in 1971 and approved for medical use in 1986. It is on the World Health Organization's List of Essential Medicines. It is available as a generic medication."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-1.85),
