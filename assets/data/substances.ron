    8530: (
            id: 8530,
            name: "Xylitol",
            formula: "C5H12O5",
            state: Liquid,
            molar_mass_g_mol: 152.0685,
            color_hex: None,
            melting_point_c: Some(93.85),
            boiling_point_c: Some(345.39),
            density_g_cm3: Some(1.52),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.7957),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Xylitol is a chemical compound with the formula C5H12O5, or HO(CH2)(CHOH)3(CH2)OH; specifically, one particular stereoisomer with that structural formula. It is a colorless or white crystalline solid.  It is classified as a polyalcohol  and a sugar alcohol, specifically an alditol. Of the common sugar alcohols, only sorbitol is more soluble in water.
The name derives from Ancient Greek: ξύλον, xyl[on] 'wood', with the suffix -itol used to denote it being a sugar alcohol.
Xylitol is used as a food additive and sugar substitute.  Its European Union code number is E967. Replacing sugar with xylitol in food products may promote better dental health, but evidence is lacking on whether xylitol itself prevents dental cavities. In the United States, xylitol is used as a common sugar substitute, and is considered to be safe for humans.
Xylitol can be toxic to dogs and ferrets."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-2.946),
            appearance: Some("colorless, white, crystalline, solid"),
            synonyms: ["Kylit", "Xylit", "Eutrit", "Klinit", "xylite", "Xyliton", "Xylisorb", "D-XYLITOL"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=220432"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_17151"), ("Wikidata", "http://www.wikidata.org/entity/Q212093"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C87990&Units=SI")],
            element_info: None,
        ),
