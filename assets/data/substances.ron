            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Pigment Violet 29 (C.I. 71129) is an organic compound that is used as a pigment and vat dye. Its colour is dark red purple, or bordeaux.
Structurally, it is a derivative of perylene, although it is produced from acenaphthene. It is a less common dye compared to related derivatives such as pigment red 190 (Vat Red 29).

Violet 29 is used in watercolors, acrylic paints, automotive paints, inks for printing and packaging, cleaning and washing agents, pharmaceuticals, solar cells, paper, sporting goods, industrial carpeting, and food packaging."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H373 (63.7%): May causes damage to organs through prolonged or repeated exposure [Warning Specific target organ toxicity, repeated exposure]"),
            uses: ["Pigment", "Pigments", "Paint and Coating Manufacturing", "Plastics Material and Resin Manufacturing"],
            logp: Some(3.504),
            appearance: Some("Liquid, Other Solid"),
            synonyms: ["PV29", "Perylimid", "C.I. 42530", "Hofman's Violet", "Hoffman's violet", "Perylene-3,4:9,10-tetracarboxydiimide", "3,4,9,10-Perylenetetracarboxylic acid diimide", "Anthra(2,1,9-def:6,5,10-d'e'f')diisoquinoline-1…"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=42208810"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/66475"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_88205"), ("Wikidata", "http://www.wikidata.org/entity/Q16948010"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C81334&Units=SI")],
