            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Crotonaldehyde is a chemical compound with the formula CH3CH=CHCHO. The compound is usually sold as a mixture of the E- and Z-isomers, which differ with respect to the relative position of the methyl and formyl groups.  The E-isomer is more common.  This lachrymatory liquid is moderately soluble in water and miscible in organic solvents.  As an unsaturated aldehyde, crotonaldehyde is a versatile intermediate in organic synthesis.  It occurs in a variety of foodstuffs, e.g. soybean oils."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H301: Toxic if swallowed [Danger Acute toxicity, oral]"),
            uses: ["Soil amendments (fertilizers)"],
            logp: Some(0.761),
            appearance: Some("Crotonaldehyde, stabilized appears as a clear colorless to straw colored liquid with a penetrating pungent odor. Flash point 55 °F. Density 7.1 lb / gal. Very toxic by inhalation. May polymerize with the release of heat under exposure to heat or contamination. If polymerization takes place inside a container, the container may rupture violently. Less dense than water. Vapors heavier than air."),
            synonyms: ["crotonal", "2-Butenal", "crotylaldehyde", "methylpropenal", "(2E)-BUT-2-ENAL", "(2EZ)-2-Butenal", "1-formylpropene", "trans-2-butenal"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=5679472"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/20138"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_41607"), ("Wikidata", "http://www.wikidata.org/entity/Q60193372"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C4170303&Units=SI")],
            element_info: None,
        ),
