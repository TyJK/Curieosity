            references: [("Wikipedia", "https://en.wikipedia.org/?curid=37108522"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/5946"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_78161"), ("Wikidata", "http://www.wikidata.org/entity/Q7706336"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C56348&Units=SI")],
