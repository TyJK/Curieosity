    8301: (
            id: 8301,
            name: "Roxithromycin",
            formula: "C41H76N2O15",
            state: Solid,
            molar_mass_g_mol: 836.5246,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
