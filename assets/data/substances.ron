    8629: (
            id: 8629,
            name: "δ-Gluconolactone",
            formula: "C6H10O6",
            state: Solid,
            molar_mass_g_mol: 178.14,
            color_hex: None,
            melting_point_c: Some(152.85),
            boiling_point_c: None,
