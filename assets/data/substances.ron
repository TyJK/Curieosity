            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Acrolein (systematic name: propenal) is the simplest unsaturated aldehyde. It is a colorless liquid with a foul and acrid aroma. The smell of burnt fat (as when cooking oil is heated to its smoke point) is caused by glycerol in the burning fat breaking down into acrolein. It is produced industrially from propene and mainly used as a biocide and a building block to other chemical compounds, such as the amino acid methionine."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225: Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["All Other Basic Organic Chemical Manufacturing"],
            logp: Some(0.371),
            appearance: Some("Acrolein, stabilized appears as a colorless to yellow volatile liquid with a disagreeable choking odor. Flash point below 0 °F. Initially irritating to the eyes and mucous membranes. Very toxic by inhalation. Less dense than water (7.0 lb / gal). Vapors heavier than air. Used to make other chemicals, plastics, and as a herbicide.   Rate of onset: Immediate  Persistence: Minutes to hour  Odor threshold: 1 ppm  Source/use/other hazard: Herbicide; tox and corrosive fumes."),
            synonyms: ["Papite", "Aqualin", "Biocide", "Crolean", "Aqualine", "Propenal", "Acquinite", "Acroleina"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1287524"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7847"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_15368"), ("Wikidata", "http://www.wikidata.org/entity/Q342790"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C107028&Units=SI")],
            element_info: None,
        ),
