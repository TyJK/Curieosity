    8522: (
            id: 8522,
            name: "Phenoxymethylpenicillin",
            formula: "C16H18N2O5S",
            state: Solid,
            molar_mass_g_mol: 350.0936,
            color_hex: None,
            melting_point_c: Some(80.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7886),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Phenoxymethylpenicillin, also known as penicillin V (PcV) and penicillin VK, is an antibiotic useful for the treatment of a number of bacterial infections. Specifically it is used for the treatment of strep throat, otitis media, and cellulitis. It is also used to prevent rheumatic fever and to prevent infections following removal of the spleen. It is given by mouth.
Side effects include diarrhea, nausea, and allergic reactions including anaphylaxis. It is not recommended in those with a history of penicillin allergy. It is relatively safe for use during pregnancy. It is in the penicillin and beta lactam family of medications. It usually results in bacterial death.
Phenoxymethylpenicillin was first made in 1948 by Eli Lilly. It is on the World Health Organization's List of Essential Medicines. It is available as a generic medication. In 2023, it was the 248th most commonly prescribed medication in the United States, with more than 1 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(2.09),
            appearance: None,
            synonyms: ["penicillin v", "87-08-1", "Oracillin", "Penicillin phenoxymethyl", "Vebecillin", "Phenopenicillin", "Fenospen", "V-Cillin"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=12941797"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C87081&Units=SI")],
            element_info: None,
        ),
