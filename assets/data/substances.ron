    6457: (
            id: 6457,
            name: "Acitretin",
            formula: "C21H26O3",
            state: Solid,
            molar_mass_g_mol: 326.1882,
            color_hex: None,
            melting_point_c: Some(229.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6364),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Acitretin, sold under the brand names Neotigason and Soriatane, is a second-generation retinoid. It is taken orally, and is typically used for psoriasis. It was approved for medical use in the United States in 1996.
Acitretin is an oral retinoid used in the treatment of severe resistant psoriasis. Because of the potential for problems and severe side effects it is generally used in only very severe cases of psoriasis that have been unresponsive to other treatments.  It binds to nuclear receptors that regulates gene transcription.  They induce keratinocyte differentiation and reduce epidermal hyperplasia, leading to the slowing of cell reproduction.  Acitretin is readily absorbed and widely distributed after oral administration.  A therapeutic effect occurs after two to four weeks or longer.
Patients who have received the medication are advised against giving blood for at least three years due to the risk of birth defects."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(6.4),
            appearance: Some("gas"),
            synonyms: ["55079-83-9", "Etretin", "Soriatane", "Neotigason", "Acitretine", "Acitretina", "Ro 10-1670", "Ro 10-1670/000"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1300834"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C55079839&Units=SI")],
            element_info: None,
        ),
    6459: (
            id: 6459,
            name: "Ticlopidine",
