    2758: (
            id: 2758,
            name: "Debrisoquin",
            formula: "C10H13N3",
            state: Solid,
            molar_mass_g_mol: 175.1109,
            color_hex: None,
            melting_point_c: Some(279.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8566),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
