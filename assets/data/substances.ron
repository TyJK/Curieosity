            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Sulfolane (also tetramethylene sulfone, systematic name: 1λ6-thiolane-1,1-dione) is an organosulfur compound, formally a cyclic sulfone, with the formula (CH2)4SO2. It is a colorless liquid commonly used in the chemical industry as a solvent for extractive distillation and chemical reactions. Sulfolane was originally developed by the Shell Oil Company in the 1960s as a solvent to purify butadiene. Sulfolane is a polar aprotic solvent, and it is miscible with water."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H360 (22.7%): May damage fertility or the unborn child [Danger Reproductive toxicity]"),
            uses: ["Fuels and fuel additives", "Intermediate", "Intermediates", "Solvent", "All Other Basic Inorganic Chemical Manufacturing"],
            logp: Some(0.195),
            appearance: Some("Sulfolane is a colorless oily liquid with a weak oily odor. Solidifies (freezing point is 79 °F) and sinks on first contact with water, then mixes with water. (USCG, 1999)"),
            synonyms: ["sulfolan", "(CH2)4SO2", "dioxothiolan", "1,1-dioxothiolan", "thiophan sulfone", "thiophane dioxide", "thiolane-1,1-dioxide", "tetramethylene sulfone"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3835271"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/31347"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_74794"), ("Wikidata", "http://www.wikidata.org/entity/Q416239"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C126330&Units=SI")],
