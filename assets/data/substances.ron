    2140: (
            id: 2140,
            name: "Minocycline",
            formula: "C23H27N3O7",
            state: Solid,
            molar_mass_g_mol: 457.1849,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7971),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Minocycline, sold under the brand name Minocin among others, is a tetracycline antibiotic medication used to treat a number of bacterial infections such as some occurring in certain forms of pneumonia. It is generally (but not always) less preferred than the tetracycline doxycycline. Minocycline is also used for the treatment of acne and rheumatoid arthritis. It is taken by mouth or applied to the skin.
Common side effects include nausea, diarrhea, dizziness, allergic reactions, and kidney problems. Serious side effects may include anaphylaxis, a lupus-like syndrome, and easy sunburning. Use in the later part of pregnancy may harm the baby and safety during breastfeeding is unclear. It works by decreasing a bacterium's ability to make protein thus stopping its growth.
Minocycline was patented in 1961 and came into commercial use in 1971. It is available as a generic medication. In 2022, it was the 269th most commonly prescribed medication in the United States, with more than 900,000 prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(0.05),
            appearance: None,
            synonyms: ["10118-90-8", "Minocyclin", "Minociclina", "Minomycin", "Dynacin", "Minocin", "Minocyn", "7-Dimethylamino-6-demethyl-6-deoxytetracycline"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=249270"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C10118908&Units=SI")],
            element_info: None,
        ),
    2141: (
