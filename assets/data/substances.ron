            logp: Some(2.34),
            appearance: Some("Chlorobenzene appears as a colorless to clear, yellowish liquid with a sweet almond-like odor. Flash point 84 °F. Practically insoluble in water and somewhat denser than water (9.2 lb / gal). Vapors heavier than air. Used to make pesticides, dyes, and other chemicals."),
            synonyms: ["MCB", "PhCl", "Monochlorbenzol", "Phenyl chloride", "Benzene chloride", "chloranylbenzene", "Monochlorobenzene", "108-90-7"],
