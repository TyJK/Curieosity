    3711: (
            id: 3711,
            name: "Sulfapyridine",
            formula: "C11H11N3O2S",
            state: Solid,
            molar_mass_g_mol: 249.0572,
            color_hex: None,
            melting_point_c: Some(192.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8572),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Sulfapyridine (INN; also known as sulphapyridine) is a sulfanilamide antibacterial medication. At one time, it was commonly referred to as M&B 693.  Sulfapyridine is no longer prescribed for treatment of infections in humans.  However, it may be used to treat linear IgA disease and has use in veterinary medicine. It is a good antibacterial drug, but its water solubility is very pH dependent.  Thus there is a risk of crystallization within the bladder or urethra, which could lead to pain or blockage. As with other sulfonamides, there is a significant risk of agranulocytosis, and this, rather than the development of resistance by bacteria, is the main reason for its decline in use."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(0.35),
            appearance: None,
            synonyms: ["144-83-2", "Sulphapyridine", "2-Sulfapyridine", "2-Sulfanilamidopyridine", "Coccoclase", "Dagenan", "Eubasin", "Piridazol"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=12965750"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C144832&Units=SI")],
            element_info: None,
