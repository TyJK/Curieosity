    6058: (
            id: 6058,
            name: "Niclosamide",
            formula: "C13H8Cl2N2O4",
            state: Solid,
            molar_mass_g_mol: 325.9861,
            color_hex: None,
            melting_point_c: Some(227.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8108),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Niclosamide, sold under the brand name Niclocide among others, is an anthelmintic medication used to treat tapeworm infestations, including diphyllobothriasis, hymenolepiasis, and taeniasis. It is not effective against other worms such as flukes or roundworms. It is taken by mouth.
Side effects include nausea, vomiting, abdominal pain, and itchiness. It may be used during pregnancy. It works by blocking glucose uptake and oxidative phosphorylation by the worm.
Niclosamide was first synthesized in 1958. It is on the World Health Organization's List of Essential Medicines. Niclosamide is not available for human use in the United States."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.86),
            appearance: None,
            synonyms: ["50-65-7", "Niclocide", "Cestocid", "Mansonil", "Phenasal", "Tredemine", "Vermitid", "Fenasal"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2921691"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C50657&Units=SI")],
            element_info: None,
        ),
    6060: (
            id: 6060,
            name: "L-Ascorbic acid",
            formula: "C6H8O6",
            state: Liquid,
            molar_mass_g_mol: 176.12,
            color_hex: None,
            melting_point_c: Some(191.0),
            boiling_point_c: Some(552.7),
            density_g_cm3: Some(1.694),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.8244),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Vitamin C (also known as ascorbic acid and ascorbate) is a water-soluble vitamin found in citrus and other fruits, berries and vegetables. It is also a generic prescription medication and in some countries is sold as a non-prescription dietary supplement. As a therapy, it is used to prevent and treat scurvy, a disease caused by vitamin C deficiency.
Vitamin C is an essential nutrient involved in the repair of tissue, the formation of collagen, and the enzymatic production of certain neurotransmitters. It is required for the functioning of several enzymes and is important for immune system function. It also functions as an antioxidant. Vitamin C may be taken by mouth or by intramuscular, subcutaneous or intravenous injection. Various health claims exist on the supposition that moderate vitamin C deficiency increases disease risk, such as for the common cold, cancer or COVID-19. There are also claims of benefits from vitamin C supplementation in excess of the recommended dietary intake for people who are not considered vitamin C deficient. Vitamin C is generally well tolerated. Large doses may cause gastrointestinal discomfort, headache, trouble sleeping, and flushing of the skin. The United States National Academy of Medicine recommends against consuming large amounts.
Most animals are able to synthesize their own vitamin C. However, higher primates (including humans), most bats, guinea pigs, some fish species, and some bird species must acquire it from dietary sources because a gene for a synthesis enzyme has mutations that render it dysfunctional.
Vitamin C was discovered in 1912, isolated in 1928, and in 1933, was the first vitamin to be chemically produced. Partly for its discovery, Albert Szent-Györgyi was awarded the 1937 Nobel Prize in Physiology or Medicine."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Miscellaneous Manufacturing", "Plating agents and surface treating agents"],
            logp: Some(-1.407),
            appearance: Some("Other Solid; Dry Powder"),
            synonyms: ["Cecon", "Cevex", "Cetane", "OVC307", "Cebione", "Cevalin", "Ascoltin", "Cenolate"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=32509"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/54676860"), ("Wikidata", "http://www.wikidata.org/entity/Q199678"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C50817&Units=SI")],
            element_info: None,
        ),
