    6248: (
            id: 6248,
            name: "1,2,3-Trimethylbenzene",
            formula: "C9H12",
            state: Liquid,
            molar_mass_g_mol: 120.19,
            color_hex: None,
            melting_point_c: Some(-25.15),
            boiling_point_c: Some(175.85),
            density_g_cm3: Some(0.89),
            heat_capacity_solid_j_g_c: None,
