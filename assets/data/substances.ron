    6064: (
            id: 6064,
            name: "Proguanil",
            formula: "C11H16ClN5",
            state: Solid,
            molar_mass_g_mol: 253.1094,
            color_hex: None,
            melting_point_c: Some(129.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.9186),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Proguanil, also known as chlorguanide and chloroguanide, is a medication used to treat and prevent malaria. It is often used together with chloroquine or atovaquone. When used with chloroquine the combination will treat mild chloroquine resistant malaria. It is taken by mouth.
Side effects include diarrhea, constipation, skin rashes, hair loss, and itchiness. Because malaria tends to be more severe in pregnancy, the benefit typically outweighs the risk. If used during pregnancy it should be taken with folate. It is likely safe for use during breastfeeding. Proguanil is converted by the liver to its active metabolite, cycloguanil.
It was removed from the World Health Organization's List of Essential Medicines in 2025. In the United States and Canada it is only available in combination as atovaquone/proguanil."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(2.53),
            appearance: None,
            synonyms: ["Chloroguanide", "Chlorguanide", "Chlorguanid", "Paludrin", "500-92-5", "Bigumal", "Proguanilum", "1-(p-Chlorophenyl)-5-isopropylbiguanide"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1899486"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C500925&Units=SI")],
            element_info: None,
        ),
