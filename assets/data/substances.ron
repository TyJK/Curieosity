    7233: (
            id: 7233,
            name: "Pergolide",
            formula: "C19H26N2S",
            state: Solid,
            molar_mass_g_mol: 314.1817,
            color_hex: None,
            melting_point_c: Some(207.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6846),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
