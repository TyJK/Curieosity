    3625: (
            id: 3625,
            name: "Ethanolamine",
            formula: "C2H7NO",
            state: Liquid,
            molar_mass_g_mol: 61.08,
            color_hex: None,
            melting_point_c: Some(10.25),
            boiling_point_c: Some(169.85),
            density_g_cm3: Some(1.0117),
