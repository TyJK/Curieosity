    2908: (
            id: 2908,
            name: "Donepezil",
            formula: "C24H29NO3",
            state: Solid,
            molar_mass_g_mol: 379.2147,
            color_hex: None,
            melting_point_c: Some(206.72),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6727),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Donepezil, sold under the brand name Aricept among others, is a medication used to treat dementia of the Alzheimer's type. It appears to result in a small benefit in mental function and ability to function. Use, however, has not been shown to change the progression of the disease. Treatment should be stopped if no benefit is seen. It is taken by mouth or via a transdermal patch.
Donepezil is a centrally acting reversible acetylcholinesterase inhibitor and structurally unrelated to other anticholinesterase agents. Common side effects include nausea, trouble sleeping, aggression, diarrhea, feeling tired, and muscle cramps. Serious side effects may include abnormal heart rhythms, urinary incontinence, and seizures. 
Donepezil was approved for medical use in the United States in 1996. It is available as a generic medication. In 2023, it was the 126th most commonly prescribed medication in the United States, with more than 4 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.6),
            appearance: None,
            synonyms: ["Donepezil hydrochloride (USAN US)", "120014-06-4", "donepezilo", "Donaz", "donepezilum", "Domepezil", "8SSC91326P", "D-797"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=730754"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C120014064&Units=SI")],
            element_info: None,
        ),
    2917: (
            id: 2917,
            name: "Sodium pentaborate",
            formula: "Na[B5O6(OH)4]orNa[B5O7(OH)2]·H2O",
            state: Solid,
            molar_mass_g_mol: 205.1,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(1.0463),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Sodium pentaborate, more properly disodium decaborate, is a chemical compound of sodium, boron, and oxygen; a salt with elemental formula NaB5O8, Na2B10O16, or Na2O·5B2O3.  It is a colorless crystalline solid, soluble in water.
The compound is often encountered or traded as hydrates NaB5O8·nH2O, Na2B10O16·2nH2O, or Na2O·5B2O3·2nH2O for n = 2, 4, 5, or other values. This formula is often misleading as some of the water molecules are actually hydroxyl groups covalently attached to boron atoms.  
The compound is used in agriculture as a boron supplement in fertilizer with various trade names such as Solubor and Aquabor. It has also been tested as an additive to improve plasma electrolytic oxidation of magnesium alloys. It is also used in nuclear reactors as a neutron absorber/poison. 
The name \"sodium pentaborate\" has also been used for a distinct compound with formula Na3B5O8·nH2O, better called trisodium pentaborate."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H360FD: May damage fertility; May damage the unborn child [Danger Reproductive toxicity]"),
            uses: [],
            logp: Some(-6.618),
            appearance: Some("Dry Powder; Liquid"),
            synonyms: ["Maveran", "Coumadin", "Jantoven", "Sodium coumadin", "Sodium warfarin", "warfarin sodium", "DL-warfarin sodium", "rac-warfarin sodium"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=71174336"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/131634859"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_10034"), ("Wikidata", "http://www.wikidata.org/entity/Q27293958"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C12007920&Units=SI")],
            element_info: None,
