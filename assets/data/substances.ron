    2656: (
            id: 2656,
            name: "1,5-Cyclooctadiene",
            formula: "C8H12",
            state: Liquid,
            molar_mass_g_mol: 108.18,
            color_hex: None,
            melting_point_c: Some(-69.15),
            boiling_point_c: Some(149.85),
            density_g_cm3: Some(0.882),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.5546),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("1,5-Cyclooctadiene (also known as cycloocta-1,5-diene) is a cyclic hydrocarbon (a cycloalkene) with the chemical formula C8H12, specifically [−(CH2)2−CH=CH−]2.
There are three configurational isomers with this structure, that differ by the arrangement of the four C–C single bonds adjacent to the double bonds.  Each pair of single bonds can be on the same side (cis,Z) or on opposite sides (trans,E) of the double bond's plane; the three possibilities are denoted cis,cis, trans,trans, and cis,trans; or (Z,Z), (E,E), and (Z,E). (Because of overall symmetry, trans,cis is the same configuration as cis,trans.)
Generally abbreviated COD, the cis,cis isomer of this diene is a useful precursor to other organic compounds and serves as a ligand in organometallic chemistry. It is a colorless liquid with a strong odor. 1,5-Cyclooctadiene can be prepared by dimerization of butadiene in the presence of a nickel catalyst, a coproduct being vinylcyclohexene. Approximately 10,000 tons were produced in 2005."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H304 (66.1%): May be fatal if swallowed and enters airways [Danger Aspiration hazard]"),
            uses: ["Catalyst", "Processing aids not otherwise specified", "RESIN INTERMEDIATE; THIRD MONOMER IN EPT RUBBER", "Synthetic Rubber Manufacturing"],
            logp: Some(2.673),
            appearance: Some("Liquid"),
            synonyms: ["COD", "1,5-Hexanediol", "hexane-1,5-diol", "cycloocta-1,5-diene", "111-78-4", "1,5-COD", "cis-1,5-cyclooctadiene", "1,5-cyclooctadiene, (1Z,5Z)-"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=4167607"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/8135"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_179534"), ("Wikidata", "http://www.wikidata.org/entity/Q161547"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C111784&Units=SI")],
            element_info: None,
        ),
