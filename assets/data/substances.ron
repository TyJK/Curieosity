    3116: (
            id: 3116,
            name: "1,2-Dibromo-1,1,2,2-tetrafluoroethane",
            formula: "C2Br2F4",
            state: Liquid,
            molar_mass_g_mol: 259.82,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: Some(47.25),
            density_g_cm3: Some(2180.0),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.5812),
