            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Deserpidine is an ester alkaloid derived from Rauwolfia canescens with antihypertensive activity. Deserpidine is a competitive inhibitor of the angiotensin converting enzyme (ACE). By competing with angiotensin I for ACE, deserpidine blocks the conversion of angiotensin I to angiotensin II, which is a potent vasoconstrictor. Reduced level of serum angiotensin II causes a decrease in blood pressure. Deserpidine also decreases angiotensin II-induced aldosterone secretion by the adrenal cortex."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(4.163),
            appearance: Some("Solid"),
            synonyms: ["Harmonyl", "Canescine", "Harmonyl®", "Raunormine", "recanescin", "Deserpidina", "Recanescine", "Deserpidinum"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=23294204"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/518697"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_27478"), ("Wikidata", "http://www.wikidata.org/entity/Q5263885"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C131011&Units=SI")],
            element_info: None,
