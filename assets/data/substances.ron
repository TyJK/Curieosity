    8928: (
            id: 8928,
            name: "L-Pyroglutamic acid",
            formula: "C5H7NO3",
            state: Liquid,
            molar_mass_g_mol: 129.11,
            color_hex: None,
            melting_point_c: Some(183.85),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.8721),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Pyroglutamic acid (also known as PCA, 5-oxoproline, pidolic acid) is a ubiquitous but understudied natural amino acid derivative in which the free amino group of glutamic acid or glutamine cyclizes to form a lactam. The names of pyroglutamic acid conjugate base, anion, salts, and esters are pyroglutamate, 5-oxoprolinate, or pidolate.

It is a metabolite in the glutathione cycle that is converted to glutamate by 5-oxoprolinase.  Pyroglutamate is found in many proteins including bacteriorhodopsin. N-terminal glutamic acid and glutamine residues can spontaneously cyclize to become pyroglutamate, or enzymatically converted by glutaminyl cyclases. This is one of several forms of blocked N-termini which present a problem for N-terminal sequencing using Edman chemistry, which requires a free primary amino group not present in pyroglutamic acid. The enzyme pyroglutamate aminopeptidase can restore a free N-terminus by cleaving off the pyroglutamate residue.
Pyroglutamic acid exists as two distinct enantiomers:

(2R) or D which happens to be (+) or d
(2S) or L which happens to be (–) or l"),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H302 (36.4%): Harmful if swallowed [Warning Acute toxicity, oral]"),
            uses: ["Humectant", "Miscellaneous Manufacturing"],
            logp: Some(-0.65),
            appearance: None,
            synonyms: ["5-oxoproline", "L-pidolic acid", "5-oxo-L-proline", "L-pyroglutamic acid", "L-5-pyrrolidone-2-carboxylic acid", "5-oxopyrrolidine-2-carboxylic acid", "(2S)-5-oxopyrrolidine-2-carboxylic acid", "(S)-(-)-2-pyrrolidone-5-carboxylic acid"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=953465"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/499"), ("Wikidata", "http://www.wikidata.org/entity/Q60998677"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C98793&Units=SI")],
            element_info: None,
        ),
