    8376: (
            id: 8376,
            name: "Zolpidem",
            formula: "C19H21N3O",
            state: Solid,
            molar_mass_g_mol: 307.1685,
            color_hex: None,
            melting_point_c: Some(197.0),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7624),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Zolpidem, sold under the brand name Ambien among others, is a medication primarily used for the short-term treatment of sleeping problems. Guidelines recommend that it be used only after cognitive behavioral therapy for insomnia and after behavioral changes, such as sleep hygiene, have been tried. It decreases the time to sleep onset by about fifteen minutes and at larger doses helps people stay asleep longer. It is taken by mouth and is available as conventional tablets, extended-release tablets, or sublingual tablets.
Common side effects include daytime sleepiness, headache, nausea, and diarrhea. More severe side effects include memory problems and hallucinations. While flumazenil, a GABAA receptor antagonist, can reverse zolpidem's effects, usually supportive care is all that is recommended in overdose.
Zolpidem is a nonbenzodiazepine, or Z-drug, which acts as a sedative and hypnotic as a positive allosteric modulator at the GABAA receptor. It is an imidazopyridine and increases GABA effects in the central nervous system by binding to GABAA receptors at the same location as benzodiazepines. It generally has a half-life of two to three hours. This, however, is increased in those with liver problems.
Zolpidem was approved for medical use in the United States in 1992. It became available as a generic medication in 2007. Zolpidem is a schedule IV controlled substance in the US under the Controlled Substances Act of 1970 (CSA). In 2023, it was the 54th most commonly prescribed medication in the United States, with more than 11 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(1.2),
            appearance: None,
            synonyms: ["82626-48-0", "Zolpidemum", "Sanval", "Zolpidem civ", "DTXSID7045946", "7K383OQI23", "DTXCID5025946", "CHEBI:10125"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=357828"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C82626480&Units=SI")],
            element_info: None,
        ),
