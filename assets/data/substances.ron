    5543: (
            id: 5543,
            name: "Rivaroxaban",
            formula: "C19H18ClN3O5S",
            state: Solid,
            molar_mass_g_mol: 435.0656,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8013),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Rivaroxaban, sold under the brand name Xarelto among others, is an anticoagulant medication (blood thinner) used to treat and reduce the risk of blood clots. Specifically it is used to treat deep vein thrombosis and pulmonary emboli and prevent blood clots in atrial fibrillation and following hip or knee surgery. It is taken by mouth.
Common side effects include bleeding. Other serious side effects may include spinal hematoma and anaphylaxis. It is unclear if use in pregnancy and breastfeeding is safe. Compared to warfarin it has fewer interactions with other medications. It works by blocking the activity of the clotting protein factor Xa. 
Rivaroxaban was patented in 2007 and approved for medical use in the United States in 2011. It is available as a generic medication. It is on the World Health Organization's List of Essential Medicines. In 2023, it was the 88th most commonly prescribed medication in the United States, with more than 7 million prescriptions."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(2.52),
            appearance: None,
            synonyms: ["BAY 59-7939", "366789-02-8", "Xarelto", "BAY59-7939", "BAY-59-7939", "9NDF7JZ4M3", "JNJ39039039", "JNJ-39039039"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=3488934"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C366789028&Units=SI")],
            element_info: None,
        ),
