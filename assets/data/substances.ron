            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Thiosulfate (IUPAC-recommended spelling; sometimes thiosulphate in British English) is an oxyanion of sulfur with the chemical formula S2O2−3. Thiosulfate also refers to the compounds containing this anion, which are the salts of thiosulfuric acid, such as sodium thiosulfate (Na2S2O3) and ammonium thiosulfate ((NH4)2S2O3).  Thiosulfate salts occur naturally. Thiosulfate rapidly dechlorinates water, and is  used to halt bleaching in the paper-making industry. Thiosulfate salts are mainly used for dyeing in textiles, and bleaching of natural substances."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Soil amendments (fertilizers)", "Leaching agent", "Reducing agent", "Services"],
            logp: Some(-0.662),
            appearance: None,
            synonyms: ["thiosulfate", "thiosulfates", "thiosulphate", "thiosulphates", "thiosulfate ester", "thiosulfate esters", "ester of thiosulfuric acid", "esters of thiosulfuric acid"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=4693311"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/131864669"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_26977"), ("Wikidata", "http://www.wikidata.org/entity/Q16706145"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C10124411&Units=SI")],
            element_info: None,
