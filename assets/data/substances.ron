    7757: (
            id: 7757,
            name: "Ceftazidime",
            formula: "C22H22N6O7S2",
            state: Solid,
            molar_mass_g_mol: 546.0991,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8737),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid, IsBase],
            description: Some("Ceftazidime, sold under the brand name Fortaz among others, is a third-generation cephalosporin antibiotic useful for the treatment of a number of bacterial infections. Specifically it is used for joint infections, meningitis, pneumonia, sepsis, urinary tract infections, malignant otitis externa, Pseudomonas aeruginosa infection, and vibrio infection. It is given by injection into a vein, muscle, or eye.
Common side effects include nausea, allergic reactions, and pain at the site of injection. Other side effects may include Clostridioides difficile diarrhea. It is not recommended in people who have had previous anaphylaxis to a penicillin. Its use is relatively safe during pregnancy and breastfeeding. It is in the third-generation cephalosporin family of medications and works by interfering with the bacteria's cell wall.
Ceftazidime was patented in 1978 and came into commercial use in 1984. It is on the World Health Organization's List of Essential Medicines. Ceftazidime is available as a generic medication."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(-1.6),
            appearance: None,
            synonyms: ["72558-82-8", "ceftazidima", "Fortaz", "ceftazidimum", "Fortum", "Tazidime", "Ceftazidime anhydrous", "Pentacef"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1994705"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C72558828&Units=SI")],
            element_info: None,
        ),
