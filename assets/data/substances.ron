            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Sodium chloroacetate is the organic compound with the formula CH2ClCO2Na.  A white, water-soluble solid, it is the sodium salt of chloroacetic acid. Many of its uses are similar to those of the parent acid.  It is prepared by treating chloroacetic acid with sodium carbonate."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Surfactant (surface active agent)", "All Other Basic Organic Chemical Manufacturing", "Intermediate", "Plastics Material and Resin Manufacturing"],
