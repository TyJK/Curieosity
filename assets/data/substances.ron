    7878: (
            id: 7878,
            name: "Iodoethane",
            formula: "C2H5I",
            state: Liquid,
            molar_mass_g_mol: 155.97,
            color_hex: None,
            melting_point_c: Some(-111.1),
            boiling_point_c: Some(72.35),
            density_g_cm3: Some(1.94),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.2629),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(-7.74),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Ethyl iodide (also iodoethane) is a colorless flammable chemical compound. It has the chemical formula C2H5I and is prepared by heating ethanol with iodine and phosphorus. On contact with air, especially on the effect of light, it decomposes and turns yellow or reddish from dissolved iodine.
It may also be prepared by the reaction between hydroiodic acid and ethanol, typically by generating the hydroiodic acid in situ via an iodide salt (such as sodium iodide) and an acid (such as sulfuric acid), after which the ethyl iodide is distilled off. Ethyl iodide should be stored in the presence of copper powder to avoid rapid decomposition, though even with this method samples do not last more than 1 year.

Because iodide is a good leaving group, ethyl iodide is an excellent ethylating agent. It is also used as the hydrogen radical promoter."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H334 (84.6%): May cause allergy or asthma symptoms or breathing difficulties if inhaled [Danger Sensitization, respiratory]"),
            uses: ["Plastics Material and Resin Manufacturing"],
            logp: None,
            appearance: Some("Liquid"),
            synonyms: ["ethyl iodide", "monoiodoethane", "75-03-6", "Ethane, iodo-", "Hydriodic ether", "Ethyljodid", "Jodethan", "59PO05D39L"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=14897149"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6340"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_42487"), ("Wikidata", "http://www.wikidata.org/entity/Q417320"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C75036&Units=SI")],
            element_info: None,
        ),
    7879: (
