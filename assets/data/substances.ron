    4434: (
            id: 4434,
            name: "Conivaptan",
            formula: "C32H26N4O2",
            state: Solid,
            molar_mass_g_mol: 498.2056,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7495),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Conivaptan, sold under the brand name Vaprisol, is a non-peptide inhibitor of the receptor for anti-diuretic hormone, also called vasopressin.  It was approved in 2004 for hyponatremia (low blood sodium levels). Additionally, conivaptan is used for the treatment of syndrome of inappropriate antidiuretic hormone secretion.
Conivaptan inhibits two of the three subtypes of the vasopressin receptor (V1A and V2). Effectively, it causes iatrogenic nephrogenic diabetes insipidus.
Conivaptan has not been approved by the US Food and Drug Administration (FDA) for the treatment of decompensated congestive heart failure. However, in theory, vasopressin receptor antagonism would be particularly useful in this setting, and an initial study shows that it has some promise."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(6.3),
            appearance: None,
            synonyms: ["YM 087", "210101-16-9", "YM087", "YM-087", "0NJ98Y462X", "CHEBI:681850", "DTXSID80175220", "conivaptanum"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1307383"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C210101169&Units=SI")],
            element_info: None,
        ),
