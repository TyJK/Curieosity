    6274: (
            id: 6274,
            name: "Estrone",
            formula: "C18H22O2",
            state: Liquid,
            molar_mass_g_mol: 270.162,
            color_hex: None,
            melting_point_c: Some(-18.65),
            boiling_point_c: Some(154.0),
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6233),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Estrone (E1), also spelled oestrone, is a steroid, a weak estrogen, and a minor female sex hormone. It is one of three major endogenous estrogens, the others being estradiol and estriol. Estrone, as well as the other estrogens, are synthesized from cholesterol and secreted mainly from the gonads, though they can also be formed from adrenal androgens in adipose tissue. Relative to estradiol, both estrone and estriol have far weaker activity as estrogens. Estrone can be converted into estradiol, and serves mainly as a precursor or metabolic intermediate of estradiol. It is both a precursor and metabolite of estradiol.
In addition to its role as a natural hormone, estrone has been used as a medication, for instance in menopausal hormone therapy; for information on estrone as a medication, see the estrone (medication) article."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.13),
            appearance: None,
            synonyms: ["53-16-7", "folliculin", "Theelin", "estrovarin", "Thelykinin", "Kestrone", "Ketohydroxyestrin", "Estrugenone"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=470095"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C53167&Units=SI")],
            element_info: None,
        ),
    6275: (
