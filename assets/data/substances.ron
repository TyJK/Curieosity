    2468: (
            id: 2468,
            name: "3-Hydroxybutanal",
            formula: "C4H8O2",
            state: Liquid,
            molar_mass_g_mol: 88.11,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: Some(161.85),
            density_g_cm3: Some(0.98),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.7196),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("In organic chemistry, 3-hydroxybutanal (acetaldol, aldol) is an organic compound with the formula CH3CH(OH)CH2CHO and the structure H3C−CH(OH)−CH2−CH=O. It is classified as an aldol (R−CH(OH)−CHR'−C(=O)−R\") and the word \"aldol\" can refer specifically to 3-hydroxybutanal. It is formally the product of the dimerization of acetaldehyde (CH3CHO). A thick colorless or pale-yellow liquid, it is a versatile and valuable intermediate with diverse impacts. The compound is chiral although this aspect is not often exploited."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H310 (66.7%): Fatal in contact with skin [Danger Acute toxicity, dermal]"),
            uses: ["Manufacture of rubber vulcanizers."],
            logp: Some(-0.044),
            appearance: Some("Aldol appears as a clear white to yellow syrupy liquid. Denser than water. Contact may irritate skin and eyes. Moderately toxic by ingestion, inhalation and skin absorption."),
            synonyms: ["acetaldol", "hydroxybutanal", "hydroxybutanals", "3-hydroxybutyraldehyde", "Aldol", "Butanal, 3-hydroxy-", "Oxybutanal", "107-89-1"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=22366247"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7897"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_24682"), ("Wikidata", "http://www.wikidata.org/entity/Q223087"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C107891&Units=SI")],
            element_info: None,
        ),
    2469: (
            id: 2469,
            name: "Butyric acid",
