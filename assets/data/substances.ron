    3948: (
            id: 3948,
            name: "Travoprost",
            formula: "C26H35F3O6",
            state: Solid,
            molar_mass_g_mol: 500.2386,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7161),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
