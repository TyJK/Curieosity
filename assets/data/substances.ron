    5264: (
            id: 5264,
            name: "Mebendazole",
            formula: "C16H13N3O3",
            state: Solid,
            molar_mass_g_mol: 295.0957,
            color_hex: None,
            melting_point_c: Some(288.5),
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.8306),
