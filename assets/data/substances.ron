    3089: (
            id: 3089,
            name: "1,4-Dioxane",
            formula: "C4H8O2",
            state: Liquid,
            molar_mass_g_mol: 88.11,
            color_hex: None,
            melting_point_c: Some(11.75),
            boiling_point_c: Some(101.05),
            density_g_cm3: Some(1.033),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.7196),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
