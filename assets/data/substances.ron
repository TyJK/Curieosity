    2389: (
            id: 2389,
            name: "1,4-Dichlorobenzene",
            formula: "C6H4Cl2",
            state: Solid,
            molar_mass_g_mol: 147.0,
            color_hex: None,
            melting_point_c: Some(53.45),
            boiling_point_c: Some(173.85),
            density_g_cm3: Some(1.25),
            heat_capacity_solid_j_g_c: Some(0.6463),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("1,4-Dichlorobenzene (1,4-DCB, p-DCB, or para-dichlorobenzene, sometimes abbreviated as PDCB or para) is an aryl chloride and isomer of dichlorobenzene with the formula C6H4Cl2. This colorless solid has a strong odor. The molecule consists of a benzene ring with two chlorine atoms (replacing hydrogen atoms) on opposing sites of the ring.
It is used as a disinfectant, pesticide, and deodorant, most familiarly in mothballs in which it is a replacement for the more traditional naphthalene because of naphthalene's greater flammability (though both chemicals have the same NFPA 704 rating).  It is also used as a precursor in the production of the chemically and thermally resistant polymer poly(p-phenylene sulfide)."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H360: May damage fertility or the unborn child [Danger Reproductive toxicity]"),
            uses: ["Deodorizer", "Plasticizer"],
            logp: Some(2.993),
            appearance: Some("P-dichlorobenzene appears as a white colored liquid with the odor of moth balls. Denser than water and insoluble in water. Flash point below 200 °F. Used as a moth repellent, to make other chemicals, as a fumigant, and for many other uses."),
            synonyms: ["PDB", "PARA", "PDCB", "p-DCB", "dichlorobenzene", "p-Dichlorbenzol", "p-dichlorbenzene", "p-dichlorobenzol"],
