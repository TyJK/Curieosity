            appearance: Some("Liquid"),
            synonyms: ["FEMA 2958", "Propyl propanoate", "n-Propyl propanoate", "n-Propyl propionate", "n-Propyl n-propionate", "Propanoic acid, propyl ester", "Propionic acid, propyl ester", "Propionic acid n-propyl ester"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=20772601"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7803"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_89828"), ("Wikidata", "http://www.wikidata.org/entity/Q3119221"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C106365&Units=SI")],
