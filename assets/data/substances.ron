    3639: (
            id: 3639,
            name: "Dronedarone",
            formula: "C31H44N2O5S",
            state: Solid,
            molar_mass_g_mol: 556.2971,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.6985),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Dronedarone, sold under the brand name Multaq, is a class III antiarrhythmic medication developed by Sanofi-Aventis. It was approved by the US Food and Drug Administration (FDA) in July 2009. Besides being indicated in arrhythmias, it was recommended as an alternative to amiodarone for the treatment of atrial fibrillation and atrial flutter in people whose hearts have either returned to normal rhythm or who undergo drug therapy or electric shock treatment i.e. direct current cardioversion (DCCV) to maintain normal rhythm. It is a class III antiarrhythmic drug. The FDA label includes a claim for reducing hospitalization, but not for reducing mortality, as a reduction in mortality was not demonstrated in the clinical development program. A trial of the drug in heart failure was stopped as an interim analysis showed a possible increase in heart failure deaths, in people with moderate to severe congestive heart failure.
The FDA label for dronedarone includes a boxed warning, stating that dronedarone is contraindicated in patients with NYHA Class IV heart failure, NYHA Class II and III heart failure with a recent decompensation requiring hospitalization or referral to a specialized heart failure clinic, or with permanent atrial fibrillation. Dronedarone is also associated with rare cases of severe liver damage, including liver failure.
It is approved as a generic medication."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(7.346),
            appearance: None,
            synonyms: ["SR33589", "141626-36-0", "SR 33589", "SR 33589B", "Dronedarona", "JQZ1L091Y2", "DTXSID3048653", "SR-33589"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=7778362"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C141626360&Units=SI")],
            element_info: None,
        ),
    3644: (
            id: 3644,
            name: "Bis(2-ethylhexyl) maleate",
            formula: "C20H36O4",
            state: Liquid,
            molar_mass_g_mol: 340.5,
            color_hex: None,
            melting_point_c: Some(-60.15),
            boiling_point_c: Some(155.85),
