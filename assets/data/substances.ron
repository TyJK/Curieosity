            uses: ["Absorbent", "Adsorbents and absorbents", "Dye", "Intermediate", "Lubricants and lubricant additives"],
            logp: Some(-0.938),
            appearance: Some("Lithium hydroxide, solution appears as a clear to water-white liquid which may have a pungent odor. Contact may cause severe irritation to skin, eyes, and mucous membranes. It may be toxic by ingestion, inhalation and skin absorption. It is used to make other chemicals."),
            synonyms: ["LiOH", "Lithiumhydroxid", "lithium hydrate", "lithium hydroxide anhydrous", "1310-65-2", "Lithium hydroxide (Li(OH))", "903YL31JAS", "CHEBI:33979"],
