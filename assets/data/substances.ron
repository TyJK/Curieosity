            description: Some("Stiripentol, sold under the brand name Diacomit, is an anticonvulsant medication used for the treatment of Dravet syndrome - a serious genetic brain disorder.
The most common side effects include loss of appetite, weight loss, insomnia (difficulty sleeping), drowsiness, ataxia (inability to co‑ordinate muscle movements), hypotonia (low muscle strength) and dystonia (muscle disorders)."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(3.53),
            appearance: None,
            synonyms: ["49763-96-4", "Diacomit", "BCX 2600", "Estiripentol", "Stiripentolum", "BCX-2600", "DTXSID6049068", "R02XOT8V8I"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2447743"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C49763964&Units=SI")],
