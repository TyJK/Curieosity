            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("2,2'-Azobis(2-amidinopropane) dihydrochloride (abbreviated AAPH or AMPA) is a chemical compound used to study the chemistry of the oxidation of drugs.
It is a free radical-generating azo compound. It is gaining prominence as a model oxidant in small molecule and protein therapeutics for its ability to initiate oxidation reactions via both nucleophilic and free radical mechanisms.
2,2′-azobis (2-amidinopropane) dihydrochloride has been used in experiments on linoleic acid subjected to induced oxidation with different combinations of binary mixtures of natural phenolics. The experiments show that some binary mixtures can lead to a synergetic antioxidant effect while other mixtures lead to an antagonistic effect."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Plastics Material and Resin Manufacturing", "Polymerization promoter"],
            logp: Some(1.29),
            appearance: None,
            synonyms: ["(E)-Azobis(isobutyronitrile)", "2-(2-cyanopropan-2-yldiazenyl)-2-methylpropanen…", "2997-92-4", "2,2'-Azodiisobutyramidine Dihydrochloride", "WAKO V-50", "Azobisisobutyramidinium dichloride", "2,2'-Azobisisobutyramidinium chloride", "Azobis(isobutyramidine) dihydrochloride"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=35625740"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/84924"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_189360"), ("Wikidata", "http://www.wikidata.org/entity/Q4596737"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C2997924&Units=SI")],
            element_info: None,
        ),
