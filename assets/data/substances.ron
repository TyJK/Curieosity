            decay_particle_id: None,
            properties: [IsBase],
            description: Some("3,3′-Diaminobenzidine (DAB) is an organic compound with the formula (C6H3(NH2)2)2.  This derivative of benzidine is a precursor to polybenzimidazole, which forms fibers that are renowned for their chemical and thermal stability.  As its water-soluble tetrahydrochloride, DAB has been used in immunohistochemical staining of nucleic acids and proteins."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H350: May cause cancer [Danger Carcinogenicity]"),
            uses: ["Intermediate", "All Other Basic Organic Chemical Manufacturing"],
            logp: Some(1.682),
