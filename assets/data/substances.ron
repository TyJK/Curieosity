    3022: (
            id: 3022,
            name: "Triolein",
            formula: "C57H104O6",
            state: Liquid,
            molar_mass_g_mol: 885.4,
            color_hex: None,
            melting_point_c: Some(4.85),
            boiling_point_c: Some(554.25),
