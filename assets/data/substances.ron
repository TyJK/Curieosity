            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Styrene is an organic compound with the chemical formula C6H5CH=CH2. Its structure consists of a vinyl group as substituent on benzene. Styrene is a colorless, oily liquid, although aged samples can appear yellowish. The compound evaporates easily and has a sweet smell, although high concentrations have a less pleasant odor. Styrene is the precursor to polystyrene and several copolymers, and is typically made from benzene for this purpose. Approximately 25 million tonnes of styrene were produced in 2010, increasing to around 35 million tonnes by 2018."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H372: Causes damage to organs through prolonged or repeated exposure [Danger Specific target organ toxicity, repeated exposure]"),
            uses: ["Water or Solvent Wet Solid", "Filler", "Fuel agents"],
            logp: Some(2.33),
            appearance: Some("Styrene monomer, stabilized appears as a clear colorless to dark liquid with an aromatic odor. Vapors heavier than air and irritating to the eyes and mucous membranes. Subject to polymerization. If the polymerization takes place inside a closed container, the container may rupture violently. Less dense than water and insoluble in water. Used to make plastics, paints, and synthetic rubber."),
            synonyms: ["Styren", "Styrol", "Cinnamol", "Cinnamene", "Styrolene", "Cinnamenol", "Cinnaminol", "Vinylbenzol"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=168394"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/7501"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_27452"), ("Wikidata", "http://www.wikidata.org/entity/Q28917"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C100425&Units=SI")],
            element_info: None,
