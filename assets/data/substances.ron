            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Formestane, formerly sold under the brand name Lentaron among others, is a steroidal, selective aromatase inhibitor which is used in the treatment of estrogen receptor-positive breast cancer in postmenopausal women. The drug is not active orally, and was available only as an intramuscular depot injection. Formestane was not approved by the United States FDA and the injectable form that was used in Europe in the past has been withdrawn from the market.   Formestane is an analogue of androstenedione.
Formestane is often used to suppress the production of estrogens from anabolic steroids or prohormones. It also acts as a prohormone to 4-hydroxytestosterone, an active steroid which displays weak androgenic activity in addition to acting as a weak aromatase inhibitor."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(2.66),
            appearance: None,
            synonyms: ["566-48-3", "4-Hydroxyandrost-4-ene-3,17-dione", "4-Hydroxyandrostenedione", "Lentaron", "CGP-32349", "4-OH-A", "CGP 32349", "4-Hydroxy-4-androstene-3,17-dione"],
