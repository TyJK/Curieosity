    5635: (
            id: 5635,
            name: "Potassium chlorate",
            formula: "KClO3",
            state: Solid,
            molar_mass_g_mol: 123.56,
            color_hex: None,
            melting_point_c: Some(355.85),
            boiling_point_c: Some(399.85),
            density_g_cm3: Some(2.32),
            heat_capacity_solid_j_g_c: Some(0.8182),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
