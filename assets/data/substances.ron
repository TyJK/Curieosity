    7835: (
            id: 7835,
            name: "Hydrogen cyanide",
            formula: "HCN",
            state: Liquid,
            molar_mass_g_mol: 27.025,
            color_hex: None,
            melting_point_c: Some(-13.29),
            boiling_point_c: Some(25.85),
            density_g_cm3: Some(0.6876),
