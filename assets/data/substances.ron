    7986: (
            id: 7986,
            name: "Sodium perchlorate",
            formula: "NaClO4(anhydrous)NaClO4·H2O(monohydrate)",
            state: Solid,
            molar_mass_g_mol: 123.45,
            color_hex: None,
            melting_point_c: Some(467.85),
            boiling_point_c: Some(481.85),
            density_g_cm3: Some(2.4994),
            heat_capacity_solid_j_g_c: Some(0.9542),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsMetal],
            description: Some("Sodium perchlorate is an inorganic compound with the chemical formula NaClO4. It consists of sodium cations Na+ and perchlorate anions ClO−4. It is a white crystalline, hygroscopic solid that is highly soluble in water and ethanol. It is usually encountered as sodium perchlorate monohydrate NaClO4·H2O. The compound is noteworthy as the most water-soluble of the common perchlorate salts.
Sodium perchlorate and other perchlorates have been found on the planet Mars, having first been detected by the NASA probe Phoenix in 2009. This was later confirmed by spectral analysis by the Mars Reconnaissance Orbiter in 2015 of what is thought to be brine seeps which may be the first evidence of flowing liquid water containing hydrated salts on Mars."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H271: May cause fire or explosion; strong Oxidizer [Danger Oxidizing liquids; Oxidizing solids]"),
            uses: ["Oxidizing agent", "Oxidizing/reducing agents", "Stabilizing agent", "All Other Basic Inorganic Chemical Manufacturing"],
            logp: Some(-4.505),
            appearance: Some("Sodium perchlorate appears as white crystalline solid. Noncombustible but will accelerate the burning of combustible materials. If large quantities are involved in a fire or the combustible material is finely divided, an explosion may result. Prolonged exposure to fire or heat may result in an explosion. Used in chemical analysis and in explosives."),
            synonyms: ["NaClO4", "Natriumperchlorat", "Perchlorate de sodium", "Perchloric acid, sodium salt", "7601-89-0", "Natriumperchloraat", "UN1502", "Sodio (perclorato di)"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2011471"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/45051975"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_132103"), ("Wikidata", "http://www.wikidata.org/entity/Q408491"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C7601890&Units=SI")],
            element_info: None,
        ),
