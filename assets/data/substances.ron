    6967: (
            id: 6967,
            name: "Methyl butyrate",
            formula: "C5H10O2",
            state: Liquid,
            molar_mass_g_mol: 102.13,
            color_hex: None,
            melting_point_c: Some(-95.15),
            boiling_point_c: Some(101.85),
            density_g_cm3: Some(0.898),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.6942),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: Some(-429.81),
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Methyl butyrate, also known under the systematic name methyl butanoate, is the methyl ester of butyric acid. Like most esters, it has a fruity odor, in this case resembling apples or pineapples. At room temperature, it is a colorless liquid with low solubility in water, upon which it floats to form an oily layer. Although it is flammable, it has a relatively low vapor pressure (40 mmHg at 30 °C (86 °F)), so it can be safely handled at room temperature without special safety precautions.
Methyl butyrate is present in small amounts in several plant products, especially pineapple oil. It can be produced by distillation from essential oils of vegetable origin, but is also manufactured on a small scale for use in perfumes and as a food flavoring.
Methyl butyrate has been used in combustion studies as a surrogate fuel for the larger fatty acid methyl esters found in biodiesel. However, studies have shown that, due to its short-chain length, methyl butyrate does not reproduce well the negative temperature coefficient (NTC) behaviour  and early CO2 formation characteristics of real biodiesel fuels.  Therefore, methyl butyrate is not a suitable surrogate fuel for biodiesel combustion studies."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H225 (99.9%): Highly Flammable liquid and vapor [Danger Flammable liquids]"),
            uses: ["Intermediate", "All Other Basic Organic Chemical Manufacturing", "Intermediates", "Mfr artificial rum and fruit essences"],
            logp: Some(0.96),
            appearance: Some("Methyl butyrate appears as a clear colorless liquid. Flash point 57 °F. Less dense than water and slightly soluble in water. Hence floats on water. Vapors heavier than air."),
            synonyms: ["Methyl butanoate", "Methyl N-butyrate", "Methyl N-butanoate", "Butyric acid, methyl ester", "Butanoic acid, methyl ester", "N-Butyric acid methyl ester", "Methyl ester of butanoic acid", "623-42-7"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1515436"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/12180"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_88806"), ("Wikidata", "http://www.wikidata.org/entity/Q420701"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C623427&Units=SI")],
            element_info: None,
        ),
    7013: (
            id: 7013,
            name: "Sulfanilamide",
            formula: "C6H8N2O2S",
            state: Solid,
            molar_mass_g_mol: 172.0306,
            color_hex: None,
            melting_point_c: Some(165.0),
