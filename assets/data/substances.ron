            state: Solid,
            molar_mass_g_mol: 103.09,
            color_hex: None,
            melting_point_c: Some(561.0),
            boiling_point_c: Some(132.0),
            density_g_cm3: Some(2.504),
            heat_capacity_solid_j_g_c: Some(0.9807),
            heat_capacity_liquid_j_g_c: None,
