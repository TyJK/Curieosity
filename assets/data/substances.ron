            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Hexachlorocyclopentadiene (HCCPD), also known as C-56, Graphlox, and HRS 1655, is an organochlorine compound with the formula C5Cl6. It is a precursor to pesticides, flame retardants, and dyes. It is a colourless liquid, although commercial samples appear lemon-yellow liquid sometimes with a bluish vapour.  Many of its derivatives proved to be highly controversial, as studies showed them to be persistent organic pollutants. An estimated 270,000 tons were produced until 1976, and smaller amounts continue to be produced today."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H311: Toxic in contact with skin [Danger Acute toxicity, dermal]"),
            uses: [],
            logp: Some(4.552),
            appearance: Some("Hexachlorocyclopentadiene appears as a pale yellow liquid with a pungent odor. Density 14.3 lb /gal. Solidifies at 50 °F. Insoluble in water. Noncombustible. Very toxic by skin absorption and inhalation. Corrosive to tissue."),
            synonyms: ["HCCPD", "Perchlorocyclopentadiene", "Hexachloro-1,3-cyclopentadiene", "1,2,3,4,5,5-Hexachloro-1,3-cyclopentadiene", "1,7,8,9,10,10-hexachloro-4-methyl-4-azatricyclo…", "(3aR,4S,7R,7aS)-4,5,6,7,8,8-hexachloro-2-methyl…", "77-47-4", "Graphlox"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=22929574"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/6478"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_47397"), ("Wikidata", "http://www.wikidata.org/entity/Q408998"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C77474&Units=SI")],
            element_info: None,
