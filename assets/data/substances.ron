    3840: (
            id: 3840,
            name: "Sodium dodecyl sulfate",
            formula: "C12H25NaSO4",
            state: Solid,
            molar_mass_g_mol: 289.39,
            color_hex: None,
            melting_point_c: Some(205.85),
            boiling_point_c: None,
            density_g_cm3: Some(1.01),
            heat_capacity_solid_j_g_c: Some(0.7098),
            heat_capacity_liquid_j_g_c: None,
