    2087: (
            id: 2087,
            name: "1,1,3,3,5,5-Hexamethylcyclotrisilazane",
            formula: "C6H21N3Si3",
            state: Liquid,
            molar_mass_g_mol: 219.51,
            color_hex: None,
            melting_point_c: Some(10.0),
            boiling_point_c: Some(188.0),
            density_g_cm3: Some(0.9196),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.764),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Hexamethylcyclotrisilazane is a chemical compound with formula C6H21N3Si3 or [–Si(CH3)2–NH–]3.  Its molecule consists of a six-member ring of three silicon atoms alternating with three nitrogen atoms, with two methyl groups bonded to each silicon and one hydrogen atom bonded to each nitrogen.  It can be described as a derivative of the hypothetical compound cyclotrisilazane [–SiH2–NH–]3, or as a cyclic trimer of hypothetical dimethylsilazane (CH3)2SiNH.
The compound is a clear colorless liquid at room temperature.
The compound has been extensively studied because of its applications in the semiconductor industry, as a precursor for the deposition of fils of silicon nitride and silicon carbonitride and as an additive in photoresist  formulations.  It has also been proposed as an additive to silica for liquid chromatography.
Other names for the compound are 2,2,4,4,6,6-hexamethyl-1,3,5,2,4,6-triazatrisilinane (IUPAC), 1,1,3,3,5,5-hexamethyl-2,4,6,1,3,5-triazatrisilinane, and 2,4,4,6,6-hexamethyl-1,3,5-triaza-2,4,6-trisilacyclohexane.  The name is often abbreviated HMCTS or HMCTSZN."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H226 (92.9%): Flammable liquid and vapor [Warning Flammable liquids]"),
            uses: ["All Other Basic Inorganic Chemical Manufacturing", "Intermediate"],
            logp: Some(0.874),
            appearance: Some("Liquid"),
            synonyms: ["1009-93-4", "2,2,4,4,6,6-Hexamethylcyclotrisilazane", "Hexamethylcyclotrisilazane", "Cyclotrisilazane, 2,2,4,4,6,6-hexamethyl-", "Dimethylsilazane trimer", "NSC 139842", "UNII-ECL2W6GI8L", "ECL2W6GI8L"],
