    7149: (
            id: 7149,
            name: "Ammonium nitrate",
            formula: "NH4NO3",
            state: Solid,
            molar_mass_g_mol: 80.044,
            color_hex: None,
            melting_point_c: Some(169.65),
            boiling_point_c: Some(209.85),
            density_g_cm3: Some(1.725),
            heat_capacity_solid_j_g_c: Some(1.2506),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
