    8069: (
            id: 8069,
            name: "Tris(hydroxymethyl)aminomethane",
            formula: "C4H11NO3",
            state: Solid,
            molar_mass_g_mol: 121.14,
            color_hex: None,
            melting_point_c: Some(175.35),
            boiling_point_c: Some(218.85),
            density_g_cm3: Some(1.328),
            heat_capacity_solid_j_g_c: Some(0.8676),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsBase],
            description: Some("Tris, or tris(hydroxymethyl)aminomethane, or known during medical use as tromethamine or THAM, is an organic compound with the formula (HOCH2)3CNH2. It is extensively used in biochemistry and molecular biology as a component of buffer solutions such as in TAE and TBE buffers, especially for solutions of nucleic acids. It contains a primary amine and thus undergoes the reactions associated with typical amines, e.g., condensations with aldehydes. Tris also complexes with metal ions in solution. In medicine, tris (known as tromethamine) is occasionally used as a drug, given in intensive care for its properties as a buffer for the treatment of severe metabolic acidosis in specific circumstances. Some medications are formulated as the \"tromethamine salt\" including Hemabate (carboprost as trometamol salt), and \"ketorolac trometamol\". In 2023 a strain of Pseudomonas hunanensis was found to be able to degrade TRIS buffer.
Since Tris' pKa is more strongly temperature dependent, its use is not recommended in biochemical applications requiring consistent pH over a range of temperatures. Moreover, the temperature dependence of the pKa (and in turn buffer solution pH) makes pH adjustment difficult. (E.g., the 'room temperature' pH adjustment would not translate to 'measurement conditions' pH, unless care is taken to calculate the effect of temperature, see below.)"),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Non-TSCA Use", "Processing as a reactant", "Processing—repackaging"],
            logp: Some(-2.339),
            appearance: Some("White crystalline powder"),
            synonyms: ["Trometamol", "TROMETHAMINE", "77-86-1", "Tham", "Trisamine", "2-Amino-2-(hydroxymethyl)-1,3-propanediol", "Tris buffer", "Tromethane"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=496251"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C77861&Units=SI")],
            element_info: None,
        ),
