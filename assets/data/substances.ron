    5969: (
            id: 5969,
            name: "Clocapramine",
            formula: "C28H37ClN4O",
            state: Solid,
            molar_mass_g_mol: 480.2656,
            color_hex: None,
            melting_point_c: None,
            boiling_point_c: None,
            density_g_cm3: None,
            heat_capacity_solid_j_g_c: Some(0.7323),
            heat_capacity_liquid_j_g_c: None,
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
