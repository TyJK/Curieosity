            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Sodium dichloroisocyanurate (INN: sodium troclosene, troclosenum natricum or NaDCC or SDIC) is a chemical compound widely used as a cleansing agent and disinfectant.  It is a colorless, water-soluble solid, produced as a result of reaction of cyanuric acid with chlorine. The dihydrate is also known (51580-86-0 ) as is the potassium salt (2244-21-5 )."),
            text_source: Some("Wikipedia"),
            hazard_summary: Some("H272: May intensify fire; oxidizer [Danger Oxidizing liquids; Oxidizing solids]"),
