    3079: (
            id: 3079,
            name: "Paraldehyde",
            formula: "C6H12O3",
            state: Liquid,
            molar_mass_g_mol: 132.0786,
            color_hex: None,
            melting_point_c: Some(11.85),
            boiling_point_c: Some(123.85),
            density_g_cm3: Some(0.996),
            heat_capacity_solid_j_g_c: None,
            heat_capacity_liquid_j_g_c: Some(0.72),
            heat_capacity_gas_j_g_c: None,
            enthalpy_fusion_kj_mol: None,
            enthalpy_vaporization_kj_mol: None,
            enthalpy_formation_kj_mol: None,
            solubility_g_per_100ml_h2o: None,
            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Paraldehyde is the cyclic trimer of acetaldehyde molecules. Formally, it is a derivative of 1,3,5-trioxane, with a methyl group substituted for a hydrogen atom at each carbon. The corresponding tetramer is metaldehyde. A colourless liquid, it is sparingly soluble in water and highly soluble in ethanol. Paraldehyde slowly oxidizes in air, turning brown and producing an odour of acetic acid. It attacks most plastics and rubbers and should be kept in glass bottles.
Paraldehyde was first observed in 1835 by the German chemist Justus Liebig; its empirical formula was determined in 1838 by Liebig's student Hermann Fehling. The German chemist Valentin Hermann Weidenbusch (1821–1893), another of Liebig's students, synthesized paraldehyde in 1848 by treating acetaldehyde with acid (either sulfuric or nitric acid) and cooling to 0°C. He found it quite remarkable that when paraldehyde was heated with a trace of the same acid, the reaction went the other way, recreating acetaldehyde.
Paraldehyde has uses in industry and medicine."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: [],
            logp: Some(0.73),
            appearance: Some("Colourless liquid"),
            synonyms: ["2,4,6-Trimethyl-1,3,5-trioxane", "123-63-7", "Paracetaldehyde", "Paral", "Paraldehyd", "Paraacetaldehyde", "Elaldehyde", "Triacetaldehyde"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=1328932"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C123637&Units=SI")],
            element_info: None,
        ),
