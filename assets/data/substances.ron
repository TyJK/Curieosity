            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [],
            description: Some("Sodium methanethiolate or sodium thiomethoxide is an organosulfur compound with the formula CH3SNa. It is the sodium salt of the conjugate base of methanethiol. This compound is commercially available as a white solid that is soluble in polar organic solvents.  Sodium methanethiolate is a reagent in organic synthesis and a byproduct of some industrial processes. Hydrolysis of sodium methanethiolate, e.g. in humid air, produces methanethiol, which has a low odor threshold and a noxious \"rotten egg\" smell."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Intermediate", "Abrasives", "All Other Basic Organic Chemical Manufacturing", "Intermediates", "Odor agents"],
            logp: Some(0.165),
            appearance: Some("white"),
            synonyms: ["Maveran", "Coumadin", "Jantoven", "Sodium coumadin", "Sodium warfarin", "warfarin sodium", "DL-warfarin sodium", "rac-warfarin sodium"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=20325453"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/45051789"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_10034"), ("Wikidata", "http://www.wikidata.org/entity/Q6553913"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C5188078&Units=SI")],
            element_info: None,
