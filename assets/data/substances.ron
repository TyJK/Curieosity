            standard_potential_v: None,
            half_life_seconds: None,
            decay_product_id: None,
            decay_particle_id: None,
            properties: [IsAcid],
            description: Some("Calcium pyrophosphate refers to any member of a series of inorganic compound with the formula Ca2P2O7(H2O)n.  They are white solids that are insoluble in water. They  contain the pyrophosphate anion, although sometimes they are referred to as phosphates. The inventory includes an anhydrous form, a dihydrate (Ca2P2O7·2H2O), and a tetrahydrate (Ca2P2O7·4H2O). Deposition of dihydrate crystals in cartilage is responsible for the severe joint pain in cases of calcium pyrophosphate deposition disease (pseudo gout) whose symptoms are similar to those of gout. Ca2P2O7 is commonly used as a mild abrasive agent in toothpastes because of its insolubility and nonreactivity toward fluoride."),
            text_source: Some("Wikipedia"),
            hazard_summary: None,
            uses: ["Fillers", "Plastics Material and Resin Manufacturing"],
            logp: Some(-1.192),
            appearance: Some("White powder"),
            synonyms: ["Ca2P2O7", "calcium titanate", "calcium titanium trioxide", "calcium titanium oxide (CaTiO3)", "calcium titanium(4+) oxide (1/1/3)", "diphosphoric acid, calcium salt (2:1)", "Dicalcium diphosphate (acidity regulator)", "CALCIUM PYROPHOSPHATE"],
            references: [("Wikipedia", "https://en.wikipedia.org/?curid=2699300"), ("PubChem", "https://pubchem.ncbi.nlm.nih.gov/compound/16212584"), ("ChEBI", "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI_139502"), ("Wikidata", "http://www.wikidata.org/entity/Q4363460"), ("NIST", "https://webbook.nist.gov/cgi/cbook.cgi?ID=C7790763&Units=SI")],
