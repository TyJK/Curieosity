    glossary: {
        "Ion": (term: "Ion", text: "An atom or group of atoms with an electric charge, because it has gained or lost electrons. Salts are built from ions held together by their opposite charges.", url: "https://en.wikipedia.org/wiki/Ion", lesson: Some("Ion"), forms: ["ions", "ion"]),
        "Anion": (term: "Anion", text: "A negatively charged ion: it has gained electrons. Chloride (Cl⁻), sulfate (SO₄²⁻) and hydroxide (OH⁻) are anions.", url: "https://en.wikipedia.org/wiki/Ion", lesson: Some("Ion"), forms: ["anions", "anion"]),
        "Cation": (term: "Cation", text: "A positively charged ion: it has lost electrons. Metals form cations, such as sodium (Na⁺) and calcium (Ca²⁺); ammonium (NH₄⁺) is one made of several atoms.", url: "https://en.wikipedia.org/wiki/Ion", lesson: Some("Ion"), forms: ["cations", "cation"]),
        "PolyatomicIon": (term: "Polyatomic ion", text: "An ion made of several atoms bonded together that moves through reactions as one unit, like nitrate (NO₃⁻), sulfate (SO₄²⁻) or ammonium (NH₄⁺).", url: "https://en.wikipedia.org/wiki/Polyatomic_ion", lesson: None, forms: ["polyatomic ions", "polyatomic ion"]),
        "Salt": (term: "Salt", text: "A compound of cations and anions, the product of an acid meeting a base. Table salt is one (sodium chloride); so are chalk, saltpetre and alum.", url: "https://en.wikipedia.org/wiki/Salt_(chemistry)", lesson: Some("Salt"), forms: ["salts", "salt"]),
        "IdeEnding": (term: "-ide", text: "The ending of an anion made from a single element: chloride (Cl⁻) from chlorine, oxide (O²⁻) from oxygen, sulfide (S²⁻) from sulfur. A few groups keep it too: hydroxide (OH⁻) and cyanide (CN⁻).", url: "https://en.wikipedia.org/wiki/Binary_compound", lesson: None, forms: []),
        "Chloride": (term: "Chloride", text: "The chloride ion, Cl⁻: a chlorine atom that has gained one electron, or a compound containing it. Sodium chloride is table salt. Not to be confused with chlorate (ClO₃⁻) or chlorite (ClO₂⁻), which carry oxygen.", url: "https://en.wikipedia.org/wiki/Chloride", lesson: None, forms: ["sesquichlorides", "pentachlorides", "sesquichloride", "tetrachlorides", "hexachlorides", "monochlorides", "pentachloride", "tetrachloride", "hexachloride", "monochloride", "trichlorides", "dichlorides", "trichloride", "dichloride", "chlorides", "chloride"]),
        "Bromide": (term: "Bromide", text: "The bromide ion, Br⁻, or a compound containing it. Silver bromide's sensitivity to light made photographic film possible.", url: "https://en.wikipedia.org/wiki/Bromide", lesson: None, forms: ["sesquibromides", "pentabromides", "sesquibromide", "tetrabromides", "hexabromides", "monobromides", "pentabromide", "tetrabromide", "hexabromide", "monobromide", "tribromides", "dibromides", "tribromide", "dibromide", "bromides", "bromide"]),
        "Iodide": (term: "Iodide", text: "The iodide ion, I⁻, or a compound containing it. Potassium iodide is the iodine added to table salt.", url: "https://en.wikipedia.org/wiki/Iodide", lesson: None, forms: ["sesquiiodides", "sesquiiodide", "pentiodides", "tetriodides", "hexiodides", "moniodides", "pentiodide", "tetriodide", "triiodides", "diiodides", "hexiodide", "moniodide", "triiodide", "diiodide", "iodides", "iodide"]),
        "Fluoride": (term: "Fluoride", text: "The fluoride ion, F⁻, or a compound containing it. Small amounts harden tooth enamel; fluorine's compounds range from toothpaste to Teflon.", url: "https://en.wikipedia.org/wiki/Fluoride", lesson: None, forms: ["sesquifluorides", "pentafluorides", "sesquifluoride", "tetrafluorides", "hexafluorides", "monofluorides", "pentafluoride", "tetrafluoride", "hexafluoride", "monofluoride", "trifluorides", "difluorides", "trifluoride", "difluoride", "fluorides", "fluoride"]),
        "Oxide": (term: "Oxide", text: "A compound of oxygen with another element. A prefix counts the oxygens: carbon monoxide (CO) has one, carbon dioxide (CO₂) two, sulfur trioxide (SO₃) three. Rust and quicklime are oxides.", url: "https://en.wikipedia.org/wiki/Oxide", lesson: None, forms: ["sesquioxides", "sesquioxide", "pentoxides", "tetroxides", "hexoxides", "monoxides", "pentoxide", "suboxides", "tetroxide", "trioxides", "dioxides", "hexoxide", "monoxide", "suboxide", "trioxide", "dioxide", "oxides", "oxide"]),
        "Peroxide": (term: "Peroxide", text: "A compound with two oxygen atoms bonded to each other (O–O), like hydrogen peroxide (H₂O₂). That weak bond breaks easily, which makes peroxides bleaches and oxidizers.", url: "https://en.wikipedia.org/wiki/Peroxide", lesson: None, forms: ["peroxides", "peroxide"]),
        "Hydroxide": (term: "Hydroxide", text: "The hydroxide ion, OH⁻: one oxygen and one hydrogen. Metal hydroxides such as lye (NaOH) and slaked lime (Ca(OH)₂) are bases.", url: "https://en.wikipedia.org/wiki/Hydroxide", lesson: None, forms: ["sesquihydroxides", "pentahydroxides", "sesquihydroxide", "tetrahydroxides", "hexahydroxides", "monohydroxides", "pentahydroxide", "tetrahydroxide", "hexahydroxide", "monohydroxide", "trihydroxides", "dihydroxides", "trihydroxide", "dihydroxide", "hydroxides", "hydroxide"]),
        "Sulfide": (term: "Sulfide", text: "The sulfide ion, S²⁻, or a compound of sulfur with another element and no oxygen. Many metal ores are sulfides, like galena (lead sulfide) and pyrite. Compare sulfite and sulfate, which carry oxygen.", url: "https://en.wikipedia.org/wiki/Sulfide", lesson: None, forms: ["sesquisulphides", "pentasulphides", "sesquisulfides", "sesquisulphide", "tetrasulphides", "hexasulphides", "monosulphides", "pentasulfides", "pentasulphide", "sesquisulfide", "tetrasulfides", "tetrasulphide", "hexasulfides", "hexasulphide", "monosulfides", "monosulphide", "pentasulfide", "tetrasulfide", "trisulphides", "disulphides", "hexasulfide", "monosulfide", "trisulfides", "trisulphide", "disulfides", "disulphide", "trisulfide", "disulfide", "sulphides", "sulfides", "sulphide", "sulfide"]),
        "Nitride": (term: "Nitride", text: "A compound of nitrogen with a less electronegative element and no oxygen, such as silicon nitride or gallium nitride, the blue LED's material.", url: "https://en.wikipedia.org/wiki/Nitride", lesson: None, forms: ["sesquinitrides", "pentanitrides", "sesquinitride", "tetranitrides", "hexanitrides", "mononitrides", "pentanitride", "tetranitride", "hexanitride", "mononitride", "trinitrides", "dinitrides", "trinitride", "dinitride", "nitrides", "nitride"]),
        "Carbide": (term: "Carbide", text: "A compound of carbon with a metal or metalloid. Calcium carbide fizzes acetylene in water; tungsten carbide is hard enough to cut steel.", url: "https://en.wikipedia.org/wiki/Carbide", lesson: None, forms: ["sesquicarbides", "pentacarbides", "sesquicarbide", "tetracarbides", "hexacarbides", "monocarbides", "pentacarbide", "tetracarbide", "hexacarbide", "monocarbide", "tricarbides", "dicarbides", "tricarbide", "dicarbide", "carbides", "carbide"]),
        "Hydride": (term: "Hydride", text: "A compound of hydrogen with another element in which hydrogen carries a negative charge, H⁻, as in sodium hydride or lithium aluminium hydride, strong reducing agents.", url: "https://en.wikipedia.org/wiki/Hydride", lesson: None, forms: ["sesquihydrides", "pentahydrides", "sesquihydride", "tetrahydrides", "hexahydrides", "monohydrides", "pentahydride", "tetrahydride", "hexahydride", "monohydride", "trihydrides", "dihydrides", "trihydride", "dihydride", "hydrides", "hydride"]),
        "Cyanide": (term: "Cyanide", text: "The cyanide group, C≡N, one carbon triple-bonded to nitrogen. As the ion CN⁻ it is a deadly poison that blocks cells from using oxygen; it also dissolves gold from ore.", url: "https://en.wikipedia.org/wiki/Cyanide", lesson: None, forms: ["cyanides", "cyanide"]),
        "AteIte": (term: "-ate and -ite", text: "Endings of anions that carry oxygen. The -ate ion has more oxygen, the -ite one less: nitrate is NO₃⁻ and nitrite NO₂⁻; sulfate is SO₄²⁻ and sulfite SO₃²⁻. Per- adds one oxygen more (perchlorate) and hypo- takes one more away (hypochlorite).", url: "https://en.wikipedia.org/wiki/Polyatomic_ion", lesson: None, forms: []),
        "Nitrate": (term: "Nitrate", text: "The nitrate ion, NO₃⁻: one nitrogen and three oxygens, or a salt containing it, such as saltpetre (potassium nitrate). It has one oxygen more than nitrite (NO₂⁻), and gives that oxygen up readily, which is why nitrates feed gunpowder and plants.", url: "https://en.wikipedia.org/wiki/Nitrate", lesson: None, forms: ["nitrates", "nitrate"]),
        "Nitrite": (term: "Nitrite", text: "The nitrite ion, NO₂⁻: one nitrogen and two oxygens, one oxygen fewer than nitrate (NO₃⁻). Sodium nitrite cures meat pink; nitrites are made by taking oxygen away from nitrates.", url: "https://en.wikipedia.org/wiki/Nitrite", lesson: None, forms: ["nitrites", "nitrite"]),
        "Sulfate": (term: "Sulfate", text: "The sulfate ion, SO₄²⁻: one sulfur and four oxygens, or a salt containing it, such as gypsum (calcium sulfate) or blue vitriol (copper sulfate). Sulfite (SO₃²⁻) has one oxygen fewer; sulfide has none.", url: "https://en.wikipedia.org/wiki/Sulfate", lesson: None, forms: ["hydrogen sulfates", "hydrogen sulfate", "bisulphates", "bisulfates", "bisulphate", "bisulfate", "sulphates", "sulfates", "sulphate", "sulfate"]),
        "Sulfite": (term: "Sulfite", text: "The sulfite ion, SO₃²⁻: one sulfur and three oxygens, one fewer than sulfate. Sulfites take up oxygen readily, which is why they preserve wine and dried fruit.", url: "https://en.wikipedia.org/wiki/Sulfite", lesson: None, forms: ["bisulphites", "bisulfites", "bisulphite", "bisulfite", "sulphites", "sulfites", "sulphite", "sulfite"]),
        "Thiosulfate": (term: "Thiosulfate", text: "S₂O₃²⁻: a sulfate with one oxygen swapped for sulfur (thio- means sulfur). Sodium thiosulfate is the photographer's 'hypo' that fixes an image.", url: "https://en.wikipedia.org/wiki/Thiosulfate", lesson: None, forms: ["thiosulphates", "thiosulfates", "thiosulphate", "thiosulfate"]),
        "Chlorate": (term: "Chlorate", text: "The chlorate ion, ClO₃⁻: chlorine with three oxygens, or a salt containing it. A powerful oxidizer used in matches and fireworks. Perchlorate has four oxygens, chlorite two, hypochlorite one, chloride none.", url: "https://en.wikipedia.org/wiki/Chlorate", lesson: None, forms: ["chlorates", "chlorate"]),
        "Perchlorate": (term: "Perchlorate", text: "The perchlorate ion, ClO₄⁻: chlorine with four oxygens, the most of the chlorine series (per- means 'beyond' the -ate). Ammonium perchlorate is the oxidizer in solid rocket fuel.", url: "https://en.wikipedia.org/wiki/Perchlorate", lesson: None, forms: ["perchlorates", "perchlorate"]),
        "Chlorite": (term: "Chlorite", text: "The chlorite ion, ClO₂⁻: chlorine with two oxygens, one fewer than chlorate. (Chlorite is also the name of an unrelated green mineral.)", url: "https://en.wikipedia.org/wiki/Chlorite", lesson: None, forms: ["chlorites", "chlorite"]),
        "Hypochlorite": (term: "Hypochlorite", text: "The hypochlorite ion, ClO⁻: chlorine with a single oxygen, the fewest of the series (hypo- means 'under' the -ite). Sodium hypochlorite in water is household bleach.", url: "https://en.wikipedia.org/wiki/Hypochlorite", lesson: None, forms: ["hypochlorites", "hypochlorite"]),
        "Carbonate": (term: "Carbonate", text: "The carbonate ion, CO₃²⁻, or a salt containing it: chalk, limestone and marble are calcium carbonate, and washing soda is sodium carbonate. Acids fizz carbon dioxide out of carbonates.", url: "https://en.wikipedia.org/wiki/Carbonate", lesson: None, forms: ["carbonates", "carbonate"]),
        "Bicarbonate": (term: "Bicarbonate", text: "The hydrogen carbonate ion, HCO₃⁻: a carbonate that still holds one hydrogen. Baking soda is sodium bicarbonate, and the bicarbonate in your blood keeps its pH steady.", url: "https://en.wikipedia.org/wiki/Bicarbonate", lesson: None, forms: ["hydrogen carbonates", "hydrogen carbonate", "hydrogencarbonates", "hydrogencarbonate", "bicarbonates", "bicarbonate"]),
        "Phosphate": (term: "Phosphate", text: "The phosphate ion, PO₄³⁻, or a salt or ester containing it. Bones and teeth are calcium phosphate, and phosphate links the backbone of DNA. Fertilizers supply it to crops.", url: "https://en.wikipedia.org/wiki/Phosphate", lesson: None, forms: ["dihydrogen phosphates", "dihydrogen phosphate", "hydrogen phosphates", "hydrogen phosphate", "orthophosphates", "orthophosphate", "phosphates", "phosphate"]),
        "Silicate": (term: "Silicate", text: "A compound built from silicon and oxygen, SiO₄ units linked into chains, sheets or frameworks. Most rocks, clays, sand and glass are silicates.", url: "https://en.wikipedia.org/wiki/Silicate", lesson: None, forms: ["silicates", "silicate"]),
        "Borate": (term: "Borate", text: "A compound of boron and oxygen, or a salt of boric acid, such as borax. Borates make heat-proof borosilicate glass and act as fluxes for welding.", url: "https://en.wikipedia.org/wiki/Borate", lesson: None, forms: ["tetraborates", "tetraborate", "borates", "borate"]),
        "Acetate": (term: "Acetate", text: "The acetate ion, CH₃COO⁻, from acetic acid (vinegar), or a salt or ester of it. Cellulose acetate was the safety film of cinema; ethyl acetate is nail-polish remover.", url: "https://en.wikipedia.org/wiki/Acetate", lesson: None, forms: ["ethanoates", "ethanoate", "acetates", "acetate"]),
        "Formate": (term: "Formate", text: "The formate ion, HCOO⁻, from formic acid (the sting of ants), or a salt or ester of it.", url: "https://en.wikipedia.org/wiki/Formate", lesson: None, forms: ["methanoates", "methanoate", "formates", "formate"]),
        "Oxalate": (term: "Oxalate", text: "The oxalate ion, C₂O₄²⁻, from oxalic acid, found in rhubarb leaves. Calcium oxalate is the stuff of most kidney stones.", url: "https://en.wikipedia.org/wiki/Oxalate", lesson: None, forms: ["oxalates", "oxalate"]),
        "Citrate": (term: "Citrate", text: "The ion or a salt of citric acid, the sourness of lemons. Citrates keep drinks tart and stop stored blood from clotting.", url: "https://en.wikipedia.org/wiki/Citrate", lesson: None, forms: ["citrates", "citrate"]),
        "Lactate": (term: "Lactate", text: "The ion or a salt of lactic acid, which sours milk and builds up in working muscles.", url: "https://en.wikipedia.org/wiki/Lactate", lesson: None, forms: ["lactates", "lactate"]),
        "Permanganate": (term: "Permanganate", text: "The permanganate ion, MnO₄⁻, deep purple and a strong oxidizer. Potassium permanganate disinfects water and turns colourless as it oxidizes what it meets.", url: "https://en.wikipedia.org/wiki/Permanganate", lesson: None, forms: ["permanganates", "permanganate"]),
        "Chromate": (term: "Chromate", text: "CrO₄²⁻ (yellow) and its doubled form dichromate, Cr₂O₇²⁻ (orange): chromium with oxygen, strong oxidizers and pigments. Chromates are toxic and cause cancer.", url: "https://en.wikipedia.org/wiki/Chromate_and_dichromate", lesson: None, forms: ["dichromates", "dichromate", "chromates", "chromate"]),
        "Thiocyanate": (term: "Thiocyanate", text: "SCN⁻: a cyanide with a sulfur added. With iron(III) it turns blood-red, a classic test.", url: "https://en.wikipedia.org/wiki/Thiocyanate", lesson: None, forms: ["thiocyanates", "thiocyanate"]),
        "Ammonium": (term: "Ammonium", text: "The ammonium ion, NH₄⁺: ammonia that has taken on a hydrogen ion. It behaves like a metal ion in salts such as sal ammoniac (ammonium chloride).", url: "https://en.wikipedia.org/wiki/Ammonium", lesson: None, forms: ["ammoniums", "ammonium"]),
        "Hydrate": (term: "Hydrate", text: "A crystal that holds water molecules in its structure. Blue vitriol is copper sulfate pentahydrate (five waters); heat drives the water off and leaves the anhydrous salt.", url: "https://en.wikipedia.org/wiki/Hydrate", lesson: Some("Hydrate"), forms: ["heptahydrates", "pentahydrates", "decahydrates", "heptahydrate", "hexahydrates", "monohydrates", "pentahydrate", "decahydrate", "hexahydrate", "monohydrate", "trihydrates", "dihydrates", "trihydrate", "dihydrate", "hydrates", "hydrate"]),
        "Anhydrous": (term: "Anhydrous", text: "Containing no water. Anhydrous salts are often a different colour from their hydrates and pull water from the air.", url: "https://en.wikipedia.org/wiki/Anhydrous", lesson: Some("Hydrate"), forms: ["anhydrous"]),
        "Anhydride": (term: "Anhydride", text: "A compound that becomes an acid when it takes up water: sulfur trioxide is sulfuric acid's anhydride, and acetic anhydride gives acetic acid.", url: "https://en.wikipedia.org/wiki/Acid_anhydride", lesson: None, forms: ["anhydrides", "anhydride"]),
        "Hydrochloride": (term: "Hydrochloride", text: "A salt of an amine with hydrochloric acid. Medicines are often sold as hydrochlorides because the salt dissolves in water and keeps better than the free base.", url: "https://en.wikipedia.org/wiki/Hydrochloride", lesson: None, forms: ["dihydrochlorides", "dihydrochloride", "hydrochlorides", "hydrochloride"]),
        "OxidationState": (term: "Oxidation state", text: "The charge an atom would carry if all its bonds were ionic. Roman numerals in names give it: iron(II) chloride is FeCl₂ and iron(III) chloride FeCl₃.", url: "https://en.wikipedia.org/wiki/Oxidation_state", lesson: Some("OxidationState"), forms: ["oxidation numbers", "oxidation number", "oxidation states", "oxidation state"]),
        "Ferrous": (term: "Ferrous and ferric", text: "Old names for a metal's two oxidation states: -ous is the lower, -ic the higher. Ferrous is iron(II), ferric iron(III); cuprous is copper(I), cupric copper(II).", url: "https://en.wikipedia.org/wiki/Ferrous", lesson: None, forms: ["cobaltous", "manganous", "mercurous", "chromous", "mercuric", "plumbous", "stannous", "chromic", "cuprous", "ferrous", "plumbic", "stannic", "cupric", "ferric"]),
        "Element": (term: "Element", text: "A substance made of only one kind of atom, set by the number of protons in its nucleus. There are 118; everything else is built from them.", url: "https://en.wikipedia.org/wiki/Chemical_element", lesson: Some("ChemicalElement"), forms: ["chemical element"]),
        "Compound": (term: "Compound", text: "A substance of two or more elements bonded in fixed proportions. Water is always two hydrogens to one oxygen.", url: "https://en.wikipedia.org/wiki/Chemical_compound", lesson: Some("ChemicalCompound"), forms: ["chemical compounds", "chemical compound"]),
        "Mixture": (term: "Mixture", text: "Substances mingled without bonding to each other, in any proportion, and separable by physical means: air, seawater, brass.", url: "https://en.wikipedia.org/wiki/Mixture", lesson: Some("Mixture"), forms: ["mixtures", "mixture"]),
        "Alloy": (term: "Alloy", text: "A metal mixed with other elements to improve it: bronze is copper with tin, steel is iron with a little carbon.", url: "https://en.wikipedia.org/wiki/Alloy", lesson: Some("Alloy"), forms: ["alloys", "alloy"]),
        "Solution": (term: "Solution", text: "A mixture in which one substance (the solute) is spread evenly, molecule by molecule, through another (the solvent). In an aqueous solution, the solvent is water.", url: "https://en.wikipedia.org/wiki/Solution_(chemistry)", lesson: Some("Solution"), forms: ["aqueous solutions", "aqueous solution", "solutions", "solution"]),
        "Aqueous": (term: "Aqueous", text: "In water, or dissolved in water. Written (aq) after a formula.", url: "https://en.wikipedia.org/wiki/Aqueous_solution", lesson: Some("Solution"), forms: ["aqueous"]),
        "Solvent": (term: "Solvent", text: "A substance, usually a liquid, that dissolves others. Water is the most common; organic solvents like ethanol, acetone and hexane dissolve oils, fats and resins that water won't.", url: "https://en.wikipedia.org/wiki/Solvent", lesson: Some("Solvent"), forms: ["solvent"]),
        "Solubility": (term: "Solubility", text: "How much of a substance will dissolve in a given amount of a solvent, often given in grams per litre of water at a stated temperature. Insoluble means almost none does.", url: "https://en.wikipedia.org/wiki/Solubility", lesson: Some("Solubility"), forms: ["sparingly soluble", "slightly soluble", "solubility", "insoluble", "soluble"]),
        "Miscible": (term: "Miscible", text: "Able to mix in any proportion. Alcohol and water are miscible; oil and water are immiscible and separate into layers.", url: "https://en.wikipedia.org/wiki/Miscibility", lesson: None, forms: ["immiscible", "miscible"]),
        "Concentration": (term: "Concentration", text: "How much of a substance is in a given volume of a mixture, as grams per litre, a percentage, or moles per litre (molarity).", url: "https://en.wikipedia.org/wiki/Concentration", lesson: None, forms: ["concentrations", "concentration"]),
        "Precipitate": (term: "Precipitate", text: "A solid that forms out of a solution when two dissolved substances react to make one that won't stay dissolved. It clouds the liquid and settles.", url: "https://en.wikipedia.org/wiki/Precipitation_(chemistry)", lesson: Some("Precipitation"), forms: ["precipitations", "precipitation", "precipitates", "precipitate"]),
        "Suspension": (term: "Colloid", text: "Particles too small to settle but much larger than molecules, spread through another substance: milk, fog, smoke and gelatin are colloids.", url: "https://en.wikipedia.org/wiki/Colloid", lesson: Some("Colloid"), forms: ["suspensions", "suspension", "colloidal", "colloids", "colloid"]),
        "Emulsion": (term: "Emulsion", text: "Droplets of one liquid held suspended in another it won't mix with, like oil in water. Mayonnaise and milk are emulsions; an emulsifier keeps them from separating.", url: "https://en.wikipedia.org/wiki/Emulsion", lesson: None, forms: ["emulsifiers", "emulsifier", "emulsions", "emulsion"]),
        "Crystal": (term: "Crystal", text: "A solid whose atoms are arranged in a repeating pattern, which shows as flat faces and sharp angles. Salt, quartz and sugar are crystalline.", url: "https://en.wikipedia.org/wiki/Crystal", lesson: Some("CrystalStructure"), forms: ["crystallines", "crystalline", "crystal"]),
        "Amorphous": (term: "Amorphous", text: "A solid without a repeating order to its atoms, like glass or many plastics. It softens over a range of temperatures instead of melting sharply.", url: "https://en.wikipedia.org/wiki/Amorphous_solid", lesson: None, forms: ["amorphous"]),
        "Hygroscopic": (term: "Hygroscopic", text: "Pulling water vapour out of the air. A deliquescent substance takes up so much that it dissolves in it, as calcium chloride and lye do left open.", url: "https://en.wikipedia.org/wiki/Hygroscopy", lesson: None, forms: ["deliquescent", "deliquesces", "hygroscopic"]),
        "Volatile": (term: "Volatile", text: "Evaporating easily at ordinary temperatures. Volatile liquids, like ether or acetone, smell strongly because so many molecules leave them.", url: "https://en.wikipedia.org/wiki/Volatility_(chemistry)", lesson: None, forms: ["volatile"]),
        "Viscous": (term: "Viscous", text: "Thick and slow to flow. Viscosity measures a fluid's resistance to flowing: honey is far more viscous than water.", url: "https://en.wikipedia.org/wiki/Viscosity", lesson: None, forms: ["viscosity", "viscous"]),
        "Sublimation": (term: "Sublimation", text: "A solid turning straight into a gas without melting first, as dry ice and iodine do. Such a substance has no boiling point at ordinary pressure.", url: "https://en.wikipedia.org/wiki/Sublimation_(phase_transition)", lesson: Some("Sublimation"), forms: ["sublimation", "sublimes", "sublime"]),
        "MeltingPoint": (term: "Melting point", text: "The temperature at which a solid turns to liquid. A pure substance melts sharply at its melting point; an impure one melts lower, over a range.", url: "https://en.wikipedia.org/wiki/Melting_point", lesson: Some("MeltingPoint"), forms: ["melting points", "melting point"]),
        "BoilingPoint": (term: "Boiling point", text: "The temperature at which a liquid's vapour pressure equals the pressure around it, so it boils. Water boils at 100 °C at sea level but lower up a mountain.", url: "https://en.wikipedia.org/wiki/Boiling_point", lesson: Some("BoilingPoint"), forms: ["boiling points", "boiling point"]),
        "Density": (term: "Density", text: "Mass per volume, in grams per cubic centimetre (g/cm³). Water's is 1: anything denser sinks in it, anything less dense floats.", url: "https://en.wikipedia.org/wiki/Density", lesson: Some("Density"), forms: ["densities", "density"]),
        "MolarMass": (term: "Molar mass", text: "The mass of one mole of a substance, in grams per mole: the sum of its atoms' atomic masses. Water's is 18 g/mol.", url: "https://en.wikipedia.org/wiki/Molar_mass", lesson: Some("MolarMass"), forms: ["molecular weights", "molecular weight", "molar masses", "molar mass"]),
        "Mole": (term: "Mole", text: "Chemistry's counting unit: 6.022 × 10²³ particles. A mole of any substance weighs its molar mass in grams, which lets chemists weigh out atoms by the count.", url: "https://en.wikipedia.org/wiki/Mole_(unit)", lesson: Some("Mole"), forms: ["moles", "mole"]),
        "Vapor": (term: "Vapour pressure", text: "The pressure of a substance's own vapour above it. It rises with temperature; when it matches the air's pressure, the liquid boils.", url: "https://en.wikipedia.org/wiki/Vapor_pressure", lesson: Some("VaporPressure"), forms: ["vapour pressures", "vapor pressures", "vapour pressure", "vapor pressure"]),
        "Purity": (term: "Purity", text: "How much of a sample is the substance itself rather than something else. Reagent-grade chemicals are often 99.9 % pure; refining semiconductors needs far better.", url: "https://en.wikipedia.org/wiki/Chemical_purity", lesson: Some("Purity"), forms: ["impurities", "impurity", "purity"]),
        "Isotope": (term: "Isotope", text: "Atoms of the same element with different numbers of neutrons, and so different masses. Carbon-12 and carbon-14 are isotopes; some isotopes are radioactive.", url: "https://en.wikipedia.org/wiki/Isotope", lesson: Some("Isotope"), forms: ["isotopes", "isotope"]),
        "Allotrope": (term: "Allotrope", text: "One of the different forms an element takes, its atoms bonded in different ways: diamond, graphite and fullerenes are all pure carbon.", url: "https://en.wikipedia.org/wiki/Allotropy", lesson: Some("Allotropy"), forms: ["allotropies", "allotropes", "allotrope", "allotropy"]),
        "Metalloid": (term: "Metalloid", text: "An element between metals and nonmetals in its behaviour, such as boron, silicon, germanium, arsenic, antimony and tellurium. Several are semiconductors.", url: "https://en.wikipedia.org/wiki/Metalloid", lesson: Some("Metalloid"), forms: ["metalloids", "metalloid", "semimetal"]),
        "Halogen": (term: "Halogen", text: "The elements of group 17: fluorine, chlorine, bromine, iodine and astatine. Each is one electron short of a full shell, so they react fiercely and form salts with metals (halogen means 'salt-maker').", url: "https://en.wikipedia.org/wiki/Halogen", lesson: Some("Halogen"), forms: ["halogens", "halogen"]),
        "NobleGas": (term: "Noble gas", text: "The elements of group 18: helium, neon, argon, krypton, xenon and radon. Their full electron shells make them barely react at all.", url: "https://en.wikipedia.org/wiki/Noble_gas", lesson: Some("NobleGas"), forms: ["inert gases", "noble gases", "inert gas", "noble gas"]),
        "AlkaliMetal": (term: "Alkali metal", text: "The soft, reactive metals of group 1: lithium, sodium, potassium, rubidium, caesium. Each gives up one electron easily, and they react with water to make hydrogen and an alkali.", url: "https://en.wikipedia.org/wiki/Alkali_metal", lesson: Some("AlkaliMetal"), forms: ["alkali metal"]),
        "AlkalineEarth": (term: "Alkaline earth metal", text: "The metals of group 2: beryllium, magnesium, calcium, strontium, barium and radium. They give up two electrons and form oxides that make water alkaline.", url: "https://en.wikipedia.org/wiki/Alkaline_earth_metal", lesson: Some("AlkalineEarth"), forms: ["alkaline earth metal", "alkaline earths", "alkaline earth"]),
        "TransitionMetal": (term: "Transition metal", text: "The metals of the periodic table's middle block, such as iron, copper and gold. They take several oxidation states, form coloured compounds and make good catalysts.", url: "https://en.wikipedia.org/wiki/Transition_metal", lesson: Some("TransitionMetal"), forms: ["transition metal"]),
        "RareEarth": (term: "Rare-earth element", text: "The lanthanides plus scandium and yttrium: chemically alike metals that occur together and are hard to separate. Neodymium's magnets and europium's red phosphor are two uses.", url: "https://en.wikipedia.org/wiki/Rare-earth_element", lesson: Some("Lanthanide"), forms: ["rare earth element", "rare-earth element", "lanthanides", "rare earths", "rare-earths", "lanthanide", "rare earth", "rare-earth"]),
        "Actinide": (term: "Actinide", text: "The fifteen radioactive elements from actinium to lawrencium, including uranium and plutonium.", url: "https://en.wikipedia.org/wiki/Actinide", lesson: Some("Actinide"), forms: ["actinides", "actinide"]),
        "Radioactive": (term: "Radioactive", text: "Having an unstable nucleus that breaks down on its own, giving off radiation (alpha, beta or gamma) and turning into another element or isotope.", url: "https://en.wikipedia.org/wiki/Radioactive_decay", lesson: Some("Radioactivity"), forms: ["radioactivity", "radioisotope", "radioactive"]),
        "HalfLife": (term: "Half-life", text: "The time it takes for half of a radioactive sample to decay. It never changes for a given isotope: a second half-life leaves a quarter.", url: "https://en.wikipedia.org/wiki/Half-life", lesson: Some("HalfLife"), forms: ["half-lives", "half-life"]),
        "Electronegativity": (term: "Electronegativity", text: "How strongly an atom pulls shared electrons toward itself. Fluorine pulls hardest; a big difference between two atoms makes their bond ionic.", url: "https://en.wikipedia.org/wiki/Electronegativity", lesson: Some("Electronegativity"), forms: ["electronegativity", "electronegative"]),
        "CovalentBond": (term: "Covalent bond", text: "A bond in which two atoms share a pair of electrons. Molecules such as water, methane and sugar are held together by covalent bonds.", url: "https://en.wikipedia.org/wiki/Covalent_bond", lesson: Some("CovalentBond"), forms: ["covalent bonds", "covalent bond", "covalentlies", "covalently", "covalent"]),
        "IonicBond": (term: "Ionic bond", text: "The attraction between oppositely charged ions, formed when one atom hands electrons to another. Salts are ionic: hard, high-melting, and conducting electricity when molten or dissolved.", url: "https://en.wikipedia.org/wiki/Ionic_bonding", lesson: Some("IonicBond"), forms: ["ionic compounds", "ionic compound", "ionic bonding", "ionic bonds", "ionic bond", "ionic"]),
        "HydrogenBond": (term: "Hydrogen bond", text: "A weak attraction between a hydrogen on one molecule and an oxygen, nitrogen or fluorine on another. It makes water boil so high and holds DNA's two strands together.", url: "https://en.wikipedia.org/wiki/Hydrogen_bond", lesson: Some("HydrogenBond"), forms: ["hydrogen bonding", "hydrogen bonds", "hydrogen bond"]),
        "Molecule": (term: "Molecule", text: "A group of atoms bonded together, the smallest unit of a covalent substance: O₂, H₂O, C₆H₁₂O₆.", url: "https://en.wikipedia.org/wiki/Molecule", lesson: Some("Molecule"), forms: ["molecular", "molecules", "molecule"]),
        "Isomer": (term: "Isomer", text: "Compounds with the same formula but atoms arranged differently, and so different properties. Ethanol and dimethyl ether are both C₂H₆O.", url: "https://en.wikipedia.org/wiki/Isomer", lesson: Some("Isomer"), forms: ["isomerisms", "isomerism", "isomeric", "isomers", "isomer"]),
        "Chiral": (term: "Chiral", text: "A molecule that can't be laid over its mirror image, like a left and a right hand. The two mirror forms are enantiomers; a racemic mix holds equal amounts of both.", url: "https://en.wikipedia.org/wiki/Chirality_(chemistry)", lesson: Some("Chirality"), forms: ["enantiomer", "chirality", "racemate", "racemic", "chiral"]),
        "Complex": (term: "Coordination complex", text: "A metal atom or ion surrounded by molecules or ions (ligands) that each lend it a pair of electrons. Haemoglobin, chlorophyll and the deep blue of copper in ammonia are complexes.", url: "https://en.wikipedia.org/wiki/Coordination_complex", lesson: Some("CoordinationComplex"), forms: ["coordination complexes", "coordination compounds", "coordination compound", "coordination complex", "complex ions", "complex ion", "ligands", "ligand"]),
        "Chelate": (term: "Chelate", text: "A ligand that grips a metal ion at two or more points, like a claw. EDTA chelates calcium to soften water and lead to treat poisoning.", url: "https://en.wikipedia.org/wiki/Chelation", lesson: Some("Chelation"), forms: ["chelations", "chelating", "chelation", "chelators", "chelates", "chelator", "chelate"]),
        "Radical": (term: "Radical", text: "A molecule or atom with an unpaired electron, which makes it very reactive. Radicals drive combustion, chain polymerization and the ageing of plastics and cells.", url: "https://en.wikipedia.org/wiki/Radical_(chemistry)", lesson: None, forms: ["radical polymerizations", "radical polymerization", "radical chains", "radical chain", "free radical", "radicalses", "radicals"]),
        "Reagent": (term: "Reagent", text: "A substance put into a reaction to make it happen, or used to test for something.", url: "https://en.wikipedia.org/wiki/Reagent", lesson: Some("ChemicalReaction"), forms: ["reactant", "reagent"]),
        "Intermediate": (term: "Intermediate", text: "A substance made on the way from starting materials to a product, then used up. In industry, an intermediate is a chemical made to be turned into others.", url: "https://en.wikipedia.org/wiki/Reaction_intermediate", lesson: Some("ReactionIntermediate"), forms: ["intermediates", "intermediate"]),
        "Byproduct": (term: "By-product", text: "A substance a reaction or process makes besides the one wanted. Some, like the chlorine from making lye, became industries of their own.", url: "https://en.wikipedia.org/wiki/By-product", lesson: Some("SideReaction"), forms: ["side products", "side product", "by-products", "by-product", "byproducts", "byproduct"]),
        "Yield": (term: "Yield", text: "How much product a reaction actually gives, often as a percentage of the most it could in theory.", url: "https://en.wikipedia.org/wiki/Yield_(chemistry)", lesson: Some("Yield"), forms: ["percentage yield", "percent yield", "yield of"]),
        "Catalyst": (term: "Catalyst", text: "A substance that speeds a reaction up without being used up itself, by offering an easier path. Platinum, iron, acids and enzymes are catalysts.", url: "https://en.wikipedia.org/wiki/Catalysis", lesson: Some("Catalysis"), forms: ["catalyseses", "catalysises", "catalyzeses", "catalysed", "catalyses", "catalysis", "catalysts", "catalytic", "catalyzed", "catalyzes", "catalyst"]),
        "Enzyme": (term: "Enzyme", text: "A protein that catalyses a reaction in a living thing. Yeast's enzymes turn sugar into alcohol; your saliva's start breaking down starch.", url: "https://en.wikipedia.org/wiki/Enzyme", lesson: Some("Enzyme"), forms: ["enzymes", "enzyme"]),
        "Oxidation": (term: "Oxidation", text: "Losing electrons, which often means gaining oxygen or losing hydrogen. Rusting, burning and the browning of a cut apple are oxidations. It always comes paired with a reduction.", url: "https://en.wikipedia.org/wiki/Redox", lesson: Some("Redox"), forms: ["oxidation", "oxidised", "oxidises", "oxidized", "oxidizes", "oxidise", "oxidize"]),
        "Reduction": (term: "Reduction", text: "Gaining electrons, which often means losing oxygen or gaining hydrogen. Smelting reduces a metal oxide to the metal. It always comes paired with an oxidation.", url: "https://en.wikipedia.org/wiki/Redox", lesson: Some("Redox"), forms: ["reduced to the metal", "chemical reduction", "reduction reaction", "reductive"]),
        "Redox": (term: "Redox", text: "A reaction in which electrons move from one substance (oxidized) to another (reduced). Burning, rusting, batteries and smelting are all redox reactions.", url: "https://en.wikipedia.org/wiki/Redox", lesson: Some("Redox"), forms: ["redox"]),
        "Oxidizer": (term: "Oxidizing agent", text: "A substance that takes electrons from others, oxidizing them, and is reduced itself: oxygen, chlorine, nitrates, permanganate. Oxidizers make fuels burn fiercely.", url: "https://en.wikipedia.org/wiki/Oxidizing_agent", lesson: Some("OxidizingAgent"), forms: ["oxidising agent", "oxidizing agent", "oxidisers", "oxidizers", "oxidiser", "oxidizer", "oxidant"]),
        "Reducer": (term: "Reducing agent", text: "A substance that gives electrons to others, reducing them, and is oxidized itself. Carbon (as coke) is the reducing agent that frees iron from its ore.", url: "https://en.wikipedia.org/wiki/Reducing_agent", lesson: Some("ReducingAgent"), forms: ["reducing agent", "reductant"]),
        "Combustion": (term: "Combustion", text: "Burning: a fast reaction of a fuel with an oxidizer, usually oxygen, giving off heat and light. Hydrocarbons burn to carbon dioxide and water.", url: "https://en.wikipedia.org/wiki/Combustion", lesson: Some("Combustion"), forms: ["combustion"]),
        "Decomposition": (term: "Decomposition", text: "A substance breaking down into simpler ones. Many compounds decompose when heated instead of melting or boiling, so they have no boiling point.", url: "https://en.wikipedia.org/wiki/Chemical_decomposition", lesson: Some("Decomposition"), forms: ["decomposition", "decomposed", "decomposes", "decompose"]),
        "Hydrolysis": (term: "Hydrolysis", text: "Splitting a compound by reaction with water. Digestion hydrolyses food; esters hydrolyse back into an acid and an alcohol.", url: "https://en.wikipedia.org/wiki/Hydrolysis", lesson: Some("Hydrolysis"), forms: ["hydrolysed", "hydrolyses", "hydrolysis", "hydrolyzed", "hydrolyzes"]),
        "Dehydration": (term: "Dehydration", text: "A reaction that removes water, either from a hydrate or from within molecules, as sulfuric acid chars sugar to carbon.", url: "https://en.wikipedia.org/wiki/Dehydration_reaction", lesson: Some("Dehydration"), forms: ["dehydration reaction", "dehydrating agent", "dehydrated"]),
        "Condensation": (term: "Condensation reaction", text: "Two molecules joining and giving off a small one, usually water. Esters, proteins and nylon are made by condensation.", url: "https://en.wikipedia.org/wiki/Condensation_reaction", lesson: Some("Condensation"), forms: ["condensation reactions", "condensation polymers", "condensation reaction", "condensation polymer"]),
        "Neutralization": (term: "Neutralization", text: "An acid and a base reacting to make a salt and water, cancelling each other out.", url: "https://en.wikipedia.org/wiki/Neutralization_(chemistry)", lesson: Some("Neutralization"), forms: ["neutralisation", "neutralization", "neutralises", "neutralizes", "neutralise", "neutralize"]),
        "Exothermic": (term: "Exothermic", text: "Giving off heat. Burning, rusting and mixing quicklime with water are exothermic; the game shows a negative enthalpy change (ΔH) for them.", url: "https://en.wikipedia.org/wiki/Exothermic_reaction", lesson: Some("Exothermic"), forms: ["exothermic"]),
        "Endothermic": (term: "Endothermic", text: "Taking in heat, so it needs heating to go, or cools its surroundings, like an instant cold pack. Its enthalpy change (ΔH) is positive.", url: "https://en.wikipedia.org/wiki/Endothermic_process", lesson: Some("Endothermic"), forms: ["endothermic"]),
        "Enthalpy": (term: "Enthalpy", text: "A substance's heat content. The enthalpy change of a reaction (ΔH, in kJ/mol) is the heat it gives off (negative) or takes in (positive).", url: "https://en.wikipedia.org/wiki/Enthalpy", lesson: Some("Enthalpy"), forms: ["enthalpy of formation", "heat of formation", "enthalpy"]),
        "Equilibrium": (term: "Equilibrium", text: "The point at which a reversible reaction runs forward and back at the same rate, so the amounts stop changing. Pressure, temperature and concentration shift it.", url: "https://en.wikipedia.org/wiki/Chemical_equilibrium", lesson: Some("Equilibrium"), forms: ["reversible reaction", "equilibrium"]),
        "Stoichiometry": (term: "Stoichiometry", text: "The arithmetic of reactions: how many of each molecule react and form, from the balanced equation, and so how many grams of each.", url: "https://en.wikipedia.org/wiki/Stoichiometry", lesson: Some("Stoichiometry"), forms: ["stoichiometric", "stoichiometry"]),
        "Polymerization": (term: "Polymerization", text: "Joining many small molecules (monomers) into long chains (polymers), by adding them end to end or by condensation.", url: "https://en.wikipedia.org/wiki/Polymerization", lesson: Some("Polymerization"), forms: ["polymerisation", "polymerization", "polymerised", "polymerises", "polymerized", "polymerizes"]),
        "Hydrogenation": (term: "Hydrogenation", text: "Adding hydrogen to a molecule, usually across a double bond, with a metal catalyst. It turns vegetable oils into margarine.", url: "https://en.wikipedia.org/wiki/Hydrogenation", lesson: Some("Hydrogenation"), forms: ["hydrogenation", "hydrogenated"]),
        "Esterification": (term: "Esterification", text: "Making an ester from an acid and an alcohol, giving off water.", url: "https://en.wikipedia.org/wiki/Fischer%E2%80%93Speier_esterification", lesson: Some("Esterification"), forms: ["esterification", "esterified"]),
        "Saponification": (term: "Saponification", text: "Breaking fats apart with a strong base such as lye, making soap and glycerol. The word means 'soap-making'.", url: "https://en.wikipedia.org/wiki/Saponification", lesson: Some("Saponification"), forms: ["saponification", "saponified"]),
        "Fermentation": (term: "Fermentation", text: "Microbes such as yeast or bacteria breaking down sugars without air, making alcohol, lactic acid or gas: bread, beer, wine, yogurt.", url: "https://en.wikipedia.org/wiki/Fermentation", lesson: Some("Fermentation"), forms: ["fermentation", "fermenting", "fermented"]),
        "Electrolysis": (term: "Electrolysis", text: "Driving a reaction with an electric current: splitting water into hydrogen and oxygen, or freeing reactive metals like aluminium and sodium from their compounds.", url: "https://en.wikipedia.org/wiki/Electrolysis", lesson: Some("Electrolysis"), forms: ["electrolysed", "electrolysis", "electrolytic", "electrolyzed"]),
        "Electrolyte": (term: "Electrolyte", text: "A substance that conducts electricity when molten or dissolved, because it splits into ions. Batteries and electrolysis need one.", url: "https://en.wikipedia.org/wiki/Electrolyte", lesson: Some("Electrolyte"), forms: ["electrolytes", "electrolyte"]),
        "Corrosion": (term: "Corrosion", text: "A metal slowly destroyed by reacting with its surroundings, as iron rusts in damp air.", url: "https://en.wikipedia.org/wiki/Corrosion", lesson: Some("Corrosion"), forms: ["corrosion", "corroded", "corrodes", "corrode"]),
        "Acid": (term: "Acid", text: "A substance that gives up hydrogen ions (H⁺) in water, tastes sour and turns litmus red. Acids dissolve many metals and carbonates and neutralize bases.", url: "https://en.wikipedia.org/wiki/Acid", lesson: Some("Acid"), forms: ["acidities", "acidity", "acidic", "acids", "acid"]),
        "Base": (term: "Base", text: "A substance that accepts hydrogen ions, such as a hydroxide, ammonia or a carbonate. Bases feel slippery, turn litmus blue and neutralize acids.", url: "https://en.wikipedia.org/wiki/Base_(chemistry)", lesson: Some("Base"), forms: ["strong bases", "strong base", "free bases", "weak bases", "free base", "weak base", "bases", "base"]),
        "Alkali": (term: "Alkali", text: "A base that dissolves in water, such as lye (sodium hydroxide) or potash. Strong alkalis are caustic: they burn skin and dissolve fats.", url: "https://en.wikipedia.org/wiki/Alkali", lesson: Some("Alkali"), forms: ["alkalinities", "alkalinity", "alkalines", "alkaline", "alkalis", "caustic", "alkali"]),
        "pH": (term: "pH", text: "A scale of how acidic or alkaline a water solution is: 7 is neutral, lower is acidic, higher is alkaline. Each step is ten times stronger.", url: "https://en.wikipedia.org/wiki/PH", lesson: Some("pH"), forms: ["pH"]),
        "Buffer": (term: "Buffer", text: "A solution that holds its pH steady when acid or base is added, made from a weak acid and its salt. Blood is buffered near pH 7.4.", url: "https://en.wikipedia.org/wiki/Buffer_solution", lesson: Some("Buffer"), forms: ["buffer solutions", "buffer solution", "buffers", "buffer"]),
        "MineralAcid": (term: "Mineral acid", text: "An acid made from minerals rather than living things: sulfuric, nitric, hydrochloric and phosphoric acid.", url: "https://en.wikipedia.org/wiki/Mineral_acid", lesson: Some("MineralAcid"), forms: ["mineral acids", "mineral acid"]),
        "Organic": (term: "Organic compound", text: "A compound built on carbon, usually with hydrogen: fuels, plastics, drugs, dyes and the molecules of life. (Organic food is a different meaning.)", url: "https://en.wikipedia.org/wiki/Organic_compound", lesson: Some("OrganicChemistry"), forms: ["organic compounds", "organic compound", "organic"]),
        "Inorganic": (term: "Inorganic compound", text: "A compound not built on carbon–hydrogen bonds: salts, minerals, metals' oxides, acids like sulfuric acid.", url: "https://en.wikipedia.org/wiki/Inorganic_compound", lesson: None, forms: ["inorganic compounds", "inorganic compound", "inorganic"]),
        "Hydrocarbon": (term: "Hydrocarbon", text: "A compound of only carbon and hydrogen: methane, petrol, paraffin wax. Crude oil and natural gas are mostly hydrocarbons.", url: "https://en.wikipedia.org/wiki/Hydrocarbon", lesson: Some("Hydrocarbon"), forms: ["hydrocarbons", "hydrocarbon"]),
        "Alkane": (term: "Alkane", text: "A hydrocarbon with only single bonds, CₙH₂ₙ₊₂: methane, propane, octane. Alkanes burn well but otherwise react little.", url: "https://en.wikipedia.org/wiki/Alkane", lesson: Some("Alkane"), forms: ["paraffins", "paraffin", "alkanes", "alkane"]),
        "Alkene": (term: "Alkene", text: "A hydrocarbon with a carbon–carbon double bond, such as ethylene. The double bond opens up to add other atoms or to link into polymers.", url: "https://en.wikipedia.org/wiki/Alkene", lesson: Some("Alkene"), forms: ["alkenes", "olefins", "alkene", "olefin"]),
        "Alkyne": (term: "Alkyne", text: "A hydrocarbon with a carbon–carbon triple bond, such as acetylene, whose flame cuts steel.", url: "https://en.wikipedia.org/wiki/Alkyne", lesson: Some("Alkyne"), forms: ["alkynes", "alkyne"]),
        "Aromatic": (term: "Aromatic", text: "Built on a ring like benzene's, six carbons sharing their electrons all round, which makes the ring unusually stable. (Many first ones found did smell strongly.)", url: "https://en.wikipedia.org/wiki/Aromaticity", lesson: Some("Aromaticity"), forms: ["aromatic hydrocarbons", "aromatic hydrocarbon", "aromatic compounds", "aromatic compound", "aromatic amines", "aromatic amine", "aromatic ring", "aromaticities", "aromaticity", "arenes", "arene"]),
        "FunctionalGroup": (term: "Functional group", text: "A particular cluster of atoms in a molecule that gives it its typical reactions, such as an alcohol's –OH or an acid's –COOH.", url: "https://en.wikipedia.org/wiki/Functional_group", lesson: Some("FunctionalGroup"), forms: ["functional groups", "functional group"]),
        "Alkyl": (term: "Alkyl group", text: "A fragment of an alkane attached to a molecule: methyl is –CH₃, ethyl –C₂H₅, propyl –C₃H₇, butyl –C₄H₉.", url: "https://en.wikipedia.org/wiki/Alkyl", lesson: Some("FunctionalGroup"), forms: ["methyl groups", "alkyl groups", "ethyl groups", "methyl group", "alkyl group", "ethyl group", "alkyls", "alkyl"]),
        "Hydroxyl": (term: "Hydroxyl group", text: "An –OH group attached to a molecule. It makes alcohols and sugars dissolve in water.", url: "https://en.wikipedia.org/wiki/Hydroxy_group", lesson: Some("FunctionalGroup"), forms: ["hydroxyl groups", "hydroxyl group", "hydroxyls", "hydroxyl"]),
        "Carbonyl": (term: "Carbonyl group", text: "A carbon double-bonded to an oxygen, C=O, the reactive heart of aldehydes, ketones, acids and esters. (A metal carbonyl is a metal bonded to carbon monoxide.)", url: "https://en.wikipedia.org/wiki/Carbonyl_group", lesson: Some("FunctionalGroup"), forms: ["carbonyl groups", "carbonyl group", "carbonyls", "carbonyl"]),
        "Alcohol": (term: "Alcohol", text: "An organic compound with an –OH group on a carbon. Ethanol is the one in drinks; methanol, glycerol and cholesterol are alcohols too.", url: "https://en.wikipedia.org/wiki/Alcohol_(chemistry)", lesson: Some("Alcohol"), forms: ["alcohols", "alcohol"]),
        "Aldehyde": (term: "Aldehyde", text: "An organic compound with a –CHO group at the end of a chain. Formaldehyde, vanillin and cinnamaldehyde are aldehydes.", url: "https://en.wikipedia.org/wiki/Aldehyde", lesson: Some("Aldehyde"), forms: ["aldehydes", "aldehyde"]),
        "Ketone": (term: "Ketone", text: "An organic compound with a C=O group between two carbons, such as acetone.", url: "https://en.wikipedia.org/wiki/Ketone", lesson: Some("Ketone"), forms: ["ketones", "ketone"]),
        "CarboxylicAcid": (term: "Carboxylic acid", text: "An organic acid with a –COOH group: acetic acid in vinegar, citric acid in lemons, the fatty acids in fats.", url: "https://en.wikipedia.org/wiki/Carboxylic_acid", lesson: Some("CarboxylicAcid"), forms: ["carboxylic acids", "carboxylic acid", "carboxylates", "carboxylate", "fatty acids", "carboxylic", "fatty acid"]),
        "Ester": (term: "Ester", text: "A compound made from an acid and an alcohol. Small esters smell of fruit (pear drops, bananas); fats and polyester are esters too.", url: "https://en.wikipedia.org/wiki/Ester", lesson: Some("Ester"), forms: ["esters", "ester"]),
        "Ether": (term: "Ether", text: "An organic compound with an oxygen between two carbon groups, C–O–C. Diethyl ether was the first surgical anaesthetic.", url: "https://en.wikipedia.org/wiki/Ether", lesson: Some("Ether"), forms: ["ethers", "ether"]),
        "Amine": (term: "Amine", text: "An organic compound derived from ammonia, with carbon groups in place of hydrogens. Amines smell fishy and are bases; many drugs and dyes are amines.", url: "https://en.wikipedia.org/wiki/Amine", lesson: Some("Amine"), forms: ["amines", "amine"]),
        "Amide": (term: "Amide", text: "A compound with a nitrogen bonded to a C=O group. The bonds that link amino acids in proteins, and the units of nylon, are amides.", url: "https://en.wikipedia.org/wiki/Amide", lesson: Some("Amide"), forms: ["amides", "amide"]),
        "Nitrile": (term: "Nitrile", text: "An organic compound with a –C≡N group. Acrylonitrile makes acrylic fibres and nitrile gloves.", url: "https://en.wikipedia.org/wiki/Nitrile", lesson: Some("Nitrile"), forms: ["nitriles", "nitrile"]),
        "Phenol": (term: "Phenol", text: "An –OH group on a benzene ring, or the compound C₆H₅OH itself, Lister's carbolic acid antiseptic. Phenols are weak acids.", url: "https://en.wikipedia.org/wiki/Phenols", lesson: Some("FunctionalGroup"), forms: ["phenolic", "phenols", "phenol"]),
        "Glycol": (term: "Glycol", text: "An alcohol with two –OH groups, such as ethylene glycol, the main ingredient of antifreeze.", url: "https://en.wikipedia.org/wiki/Diol", lesson: Some("Alcohol"), forms: ["glycols", "glycol", "diols", "diol"]),
        "Monomer": (term: "Monomer", text: "A small molecule that links with others like it to build a polymer: ethylene makes polyethylene, styrene polystyrene.", url: "https://en.wikipedia.org/wiki/Monomer", lesson: Some("Monomer"), forms: ["monomers", "monomer"]),
        "Polymer": (term: "Polymer", text: "A giant molecule of many repeating units linked in a chain or network. Plastics, rubber, proteins, starch and DNA are polymers.", url: "https://en.wikipedia.org/wiki/Polymer", lesson: Some("Polymer"), forms: ["macromolecules", "macromolecule", "copolymers", "copolymer", "polymers", "polymer"]),
        "Resin": (term: "Resin", text: "A thick, sticky substance that hardens: natural ones ooze from trees (amber is fossil resin); synthetic ones such as epoxy set into hard plastics.", url: "https://en.wikipedia.org/wiki/Resin", lesson: Some("Thermoset"), forms: ["resins", "resin"]),
        "Plasticizer": (term: "Plasticizer", text: "A substance added to a plastic to make it soft and flexible, like the phthalates in PVC hoses.", url: "https://en.wikipedia.org/wiki/Plasticizer", lesson: Some("Plastic"), forms: ["plasticisers", "plasticizers", "plasticiser", "plasticizer"]),
        "Surfactant": (term: "Surfactant", text: "A molecule with a water-loving head and an oil-loving tail, so it gathers at surfaces and lifts grease into water. Soaps and detergents are surfactants.", url: "https://en.wikipedia.org/wiki/Surfactant", lesson: Some("Surfactant"), forms: ["wetting agent", "surfactant", "detergent"]),
        "Alkaloid": (term: "Alkaloid", text: "A nitrogen-containing base made by plants, often bitter and acting strongly on the body: caffeine, nicotine, quinine.", url: "https://en.wikipedia.org/wiki/Alkaloid", lesson: Some("Alkaloid"), forms: ["alkaloids", "alkaloid"]),
        "Terpene": (term: "Terpene", text: "A compound built from five-carbon isoprene units, made by plants: the scents of pine, citrus and mint, and natural rubber.", url: "https://en.wikipedia.org/wiki/Terpene", lesson: Some("Terpene"), forms: ["terpenoids", "terpenoid", "terpenes", "terpene"]),
        "Steroid": (term: "Steroid", text: "A compound with four fused carbon rings. Cholesterol, the sex hormones and cortisone are steroids.", url: "https://en.wikipedia.org/wiki/Steroid", lesson: None, forms: ["corticosteroids", "corticosteroid", "steroids", "steroid"]),
        "Ore": (term: "Ore", text: "Rock with enough of a metal or mineral in it to be worth mining.", url: "https://en.wikipedia.org/wiki/Ore", lesson: Some("Ore"), forms: ["ores", "ore"]),
        "Mineral": (term: "Mineral", text: "A naturally formed solid with a definite composition and crystal structure, such as quartz, calcite or galena. Rocks are made of minerals.", url: "https://en.wikipedia.org/wiki/Mineral", lesson: Some("Ore"), forms: ["mineral"]),
        "Smelting": (term: "Smelting", text: "Getting a metal out of its ore by heating it with a reducing agent, usually carbon, and a flux to carry off the rock.", url: "https://en.wikipedia.org/wiki/Smelting", lesson: Some("Smelting"), forms: ["smelting", "smelted", "smelt"]),
        "Flux": (term: "Flux", text: "A substance added in smelting or soldering that combines with impurities so they melt off as slag, or that keeps metal surfaces clean.", url: "https://en.wikipedia.org/wiki/Flux_(metallurgy)", lesson: Some("Flux"), forms: ["fluxes", "flux"]),
        "Slag": (term: "Slag", text: "The glassy waste that floats on molten metal in smelting, made of the ore's rock and the flux.", url: "https://en.wikipedia.org/wiki/Slag", lesson: Some("Slag"), forms: ["slag"]),
        "Calcination": (term: "Calcination", text: "Heating a solid hard to drive off water or carbon dioxide, as limestone is burned to quicklime.", url: "https://en.wikipedia.org/wiki/Calcination", lesson: Some("Calcination"), forms: ["calcination", "calcining", "calcined"]),
        "Roasting": (term: "Roasting", text: "Heating a sulfide ore in air, which burns off the sulfur and leaves an oxide ready for smelting.", url: "https://en.wikipedia.org/wiki/Roasting_(metallurgy)", lesson: Some("Roasting"), forms: ["roasting", "roasted"]),
        "Pyrolysis": (term: "Pyrolysis", text: "Breaking a substance down by heat without air: wood turns to charcoal, coal to coke and coal tar.", url: "https://en.wikipedia.org/wiki/Pyrolysis", lesson: Some("Pyrolysis"), forms: ["destructive distillation", "pyrolysis"]),
        "Distillation": (term: "Distillation", text: "Separating liquids by boiling and condensing them: the one that boils lower comes over first. It purifies water and makes spirits and petrol.", url: "https://en.wikipedia.org/wiki/Distillation", lesson: Some("Distillation"), forms: ["fractional distillation", "distillation", "distilling", "distilled"]),
        "Extraction": (term: "Extraction", text: "Pulling a substance out of a mixture with a solvent it prefers, as coffee is extracted with hot water or oils with hexane.", url: "https://en.wikipedia.org/wiki/Extraction_(chemistry)", lesson: Some("Extraction"), forms: ["extraction", "extracted"]),
        "Cracking": (term: "Cracking", text: "Breaking large hydrocarbon molecules into smaller ones with heat and catalysts: how refineries turn heavy oil into petrol and ethylene.", url: "https://en.wikipedia.org/wiki/Cracking_(chemistry)", lesson: Some("Cracking"), forms: ["steam cracking", "cracking"]),
        "Ceramic": (term: "Ceramic", text: "A hard, heat-proof material made by firing clay or other inorganic powders: pottery, brick, porcelain, and modern ones in engines and armour.", url: "https://en.wikipedia.org/wiki/Ceramic", lesson: Some("Ceramic"), forms: ["ceramic"]),
        "Pigment": (term: "Pigment", text: "A coloured powder that doesn't dissolve in what carries it, so it colours by covering: the ochres, lead white and Prussian blue of paints.", url: "https://en.wikipedia.org/wiki/Pigment", lesson: Some("Pigment"), forms: ["pigment"]),
        "Dye": (term: "Dye", text: "A coloured substance that dissolves and binds into what it colours, such as cloth. Indigo and mauveine are dyes.", url: "https://en.wikipedia.org/wiki/Dye", lesson: Some("Dye"), forms: ["dyestuffs", "dyestuff", "dyes", "dye"]),
        "Mordant": (term: "Mordant", text: "A substance, usually a metal salt such as alum, that fixes a dye to cloth by binding to both.", url: "https://en.wikipedia.org/wiki/Mordant", lesson: Some("Dye"), forms: ["mordant"]),
        "Fertilizer": (term: "Fertilizer", text: "A substance that supplies plants with nutrients, chiefly nitrogen, phosphorus and potassium.", url: "https://en.wikipedia.org/wiki/Fertilizer", lesson: Some("Fertilizer"), forms: ["fertilisers", "fertilizers", "fertiliser", "fertilizer"]),
        "Pesticide": (term: "Pesticide", text: "A substance that kills pests: insecticides kill insects, herbicides weeds, fungicides moulds and fungi.", url: "https://en.wikipedia.org/wiki/Pesticide", lesson: Some("Pesticide"), forms: ["insecticides", "rodenticides", "insecticide", "rodenticide", "fungicides", "herbicides", "pesticides", "fungicide", "herbicide", "pesticide"]),
        "Refrigerant": (term: "Refrigerant", text: "A fluid that boils at a low temperature, carrying heat out of a fridge as it evaporates and condenses again.", url: "https://en.wikipedia.org/wiki/Refrigerant", lesson: Some("Refrigerant"), forms: ["refrigerant"]),
        "Semiconductor": (term: "Semiconductor", text: "A material that conducts electricity better than an insulator but worse than a metal, and can be tuned by adding traces of other elements: silicon, germanium, gallium arsenide.", url: "https://en.wikipedia.org/wiki/Semiconductor", lesson: Some("Semiconductor"), forms: ["semiconductors", "semiconductor"]),
        "Toxic": (term: "Toxic", text: "Harmful to living things. How harmful depends on the dose: 'the dose makes the poison'.", url: "https://en.wikipedia.org/wiki/Toxicity", lesson: Some("LabSafety"), forms: ["poisonous", "toxicity", "toxic"]),
        "Corrosive": (term: "Corrosive", text: "Destroying what it touches, such as skin, eyes or metal, by chemical reaction. Strong acids and alkalis are corrosive.", url: "https://en.wikipedia.org/wiki/Corrosive_substance", lesson: Some("LabSafety"), forms: ["corrosive"]),
        "Irritant": (term: "Irritant", text: "Causing redness, itching or inflammation of skin, eyes or airways on contact, without lasting damage.", url: "https://en.wikipedia.org/wiki/Irritation", lesson: Some("LabSafety"), forms: ["irritant"]),
        "Carcinogen": (term: "Carcinogen", text: "A substance that can cause cancer, such as asbestos, benzene or tobacco smoke.", url: "https://en.wikipedia.org/wiki/Carcinogen", lesson: Some("LabSafety"), forms: ["carcinogenic", "carcinogens", "carcinogen"]),
        "Flammable": (term: "Flammable", text: "Catching fire easily. (Inflammable means the same thing.) A pyrophoric substance ignites on its own in air.", url: "https://en.wikipedia.org/wiki/Flammability", lesson: Some("LabSafety"), forms: ["flammability", "inflammable", "pyrophoric", "flammable"]),
        "Explosive": (term: "Explosive", text: "A substance that reacts so fast it releases its energy as a sudden blast of hot gas.", url: "https://en.wikipedia.org/wiki/Explosive", lesson: Some("Explosive"), forms: ["explosive"]),
        "Analgesic": (term: "Analgesic", text: "A medicine that relieves pain, such as aspirin, paracetamol or ibuprofen.", url: "https://en.wikipedia.org/wiki/Analgesic", lesson: Some("Pharmacology"), forms: ["pain relievers", "pain reliever", "painkillers", "painkiller", "analgesic"]),
        "NSAID": (term: "NSAID", text: "A non-steroidal anti-inflammatory drug, such as aspirin, ibuprofen or naproxen: it eases pain, fever and swelling by blocking the enzymes that make prostaglandins.", url: "https://en.wikipedia.org/wiki/Nonsteroidal_anti-inflammatory_drug", lesson: Some("Pharmacology"), forms: ["nonsteroidal anti-inflammatory drugs", "nonsteroidal anti-inflammatory drug", "anti-inflammatories", "anti-inflammatory", "nsaids", "nsaid"]),
        "Anesthetic": (term: "Anaesthetic", text: "A drug that blocks feeling, either in one place (local anaesthetic) or by putting the patient to sleep (general anaesthetic).", url: "https://en.wikipedia.org/wiki/Anesthetic", lesson: Some("Pharmacology"), forms: ["anaesthesias", "anaesthesia", "anaesthetic", "anesthesias", "anesthesia", "anesthetic"]),
        "Antibiotic": (term: "Antibiotic", text: "A medicine that kills bacteria or stops them growing. Penicillin was the first; antibiotics do nothing against viruses.", url: "https://en.wikipedia.org/wiki/Antibiotic", lesson: Some("Antibiotic"), forms: ["antibacterial", "antibiotic"]),
        "Antiseptic": (term: "Antiseptic", text: "A substance that kills germs on skin or in wounds (an antiseptic) or on surfaces (a disinfectant), such as iodine, alcohol or bleach.", url: "https://en.wikipedia.org/wiki/Antiseptic", lesson: Some("Antibiotic"), forms: ["disinfectant", "antiseptic"]),
        "Antiviral": (term: "Antiviral", text: "A medicine against viruses, which works by stopping them copying themselves inside cells.", url: "https://en.wikipedia.org/wiki/Antiviral_drug", lesson: Some("Pharmacology"), forms: ["antiretroviral", "antiviral"]),
        "Antifungal": (term: "Antifungal", text: "A medicine against fungal infections such as athlete's foot or thrush.", url: "https://en.wikipedia.org/wiki/Antifungal", lesson: Some("Pharmacology"), forms: ["antifungal"]),
        "Antihistamine": (term: "Antihistamine", text: "A medicine that blocks histamine, the body's messenger of allergy, easing hay fever and itching. Older ones also cause drowsiness.", url: "https://en.wikipedia.org/wiki/Antihistamine", lesson: Some("Pharmacology"), forms: ["antihistamines", "antihistamine"]),
        "Antidepressant": (term: "Antidepressant", text: "A medicine for depression and often anxiety, which acts on messengers in the brain such as serotonin and noradrenaline.", url: "https://en.wikipedia.org/wiki/Antidepressant", lesson: Some("Pharmacology"), forms: ["antidepressant"]),
        "Antipsychotic": (term: "Antipsychotic", text: "A medicine for psychosis, schizophrenia and bipolar disorder, usually by blocking dopamine receptors.", url: "https://en.wikipedia.org/wiki/Antipsychotic", lesson: Some("Pharmacology"), forms: ["antipsychotic"]),
        "Anticonvulsant": (term: "Anticonvulsant", text: "A medicine that prevents or stops seizures, used for epilepsy.", url: "https://en.wikipedia.org/wiki/Anticonvulsant", lesson: Some("Pharmacology"), forms: ["anticonvulsant", "antiepileptic"]),
        "Sedative": (term: "Sedative", text: "A medicine that calms (a sedative or, against anxiety, an anxiolytic) or brings on sleep (a hypnotic).", url: "https://en.wikipedia.org/wiki/Sedative", lesson: Some("Pharmacology"), forms: ["anxiolytic", "sedations", "hypnotic", "sedation", "sedative"]),
        "Diuretic": (term: "Diuretic", text: "A medicine that makes the kidneys pass more water and salt, lowering blood pressure and swelling.", url: "https://en.wikipedia.org/wiki/Diuretic", lesson: Some("Pharmacology"), forms: ["diuretic"]),
        "Hormone": (term: "Hormone", text: "A chemical messenger made by a gland and carried in the blood to act elsewhere in the body: insulin, adrenaline, oestrogen, thyroxine.", url: "https://en.wikipedia.org/wiki/Hormone", lesson: Some("Biochemistry"), forms: ["hormones", "hormone"]),
        "Neurotransmitter": (term: "Neurotransmitter", text: "A chemical a nerve cell releases to signal the next one: dopamine, serotonin, acetylcholine, noradrenaline.", url: "https://en.wikipedia.org/wiki/Neurotransmitter", lesson: Some("Biochemistry"), forms: ["neurotransmitters", "neurotransmitter"]),
        "Receptor": (term: "Receptor", text: "A protein on or in a cell that a particular molecule fits like a key, triggering a response. A drug that switches a receptor on is an agonist; one that blocks it, an antagonist.", url: "https://en.wikipedia.org/wiki/Receptor_(biochemistry)", lesson: Some("Pharmacology"), forms: ["antagonists", "antagonist", "receptors", "agonists", "receptor", "agonist"]),
        "Metabolite": (term: "Metabolite", text: "A substance the body makes while processing another. Many drugs act through, or are cleared as, their metabolites.", url: "https://en.wikipedia.org/wiki/Metabolite", lesson: Some("Biochemistry"), forms: ["metabolised", "metabolisms", "metabolites", "metabolized", "metabolism", "metabolite"]),
        "Prodrug": (term: "Prodrug", text: "A medicine given in an inactive form that the body converts into the active drug.", url: "https://en.wikipedia.org/wiki/Prodrug", lesson: Some("Pharmacology"), forms: ["prodrugs", "prodrug"]),
        "Vitamin": (term: "Vitamin", text: "A substance the body needs in small amounts but can't make enough of, so it must come from food, such as vitamin C, whose lack causes scurvy.", url: "https://en.wikipedia.org/wiki/Vitamin", lesson: Some("Biochemistry"), forms: ["vitamins", "vitamin"]),
        "AminoAcid": (term: "Amino acid", text: "A molecule with both an amine and a carboxylic acid group; twenty kinds chain together to build every protein.", url: "https://en.wikipedia.org/wiki/Amino_acid", lesson: Some("AminoAcid"), forms: ["amino acids", "amino acid"]),
    },
