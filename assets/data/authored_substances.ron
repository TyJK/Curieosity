({
    1: (formula: "H2", state: Gas, description: "The lightest element, two protons sharing two electrons. Cavendish called it inflammable air (1766); Lavoisier named it hydrogen, 'water-former', because it burns to water.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hydrogen")]),
    4: (formula: "N2", state: Gas, description: "Four-fifths of the air, held together by one of the strongest bonds in chemistry. Breaking it to make fertilizer took Haber and Bosch until 1913.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nitrogen")]),
    5: (formula: "O2", state: Gas, description: "A fifth of the air, and the gas every fire and every breath consumes. Scheele and Priestley found it independently in the 1770s; Lavoisier explained what it does.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Oxygen")]),
    6: (formula: "Na", state: Solid, properties: [IsMetal], description: "A soft, silvery metal that can be cut with a knife and fizzes violently in water. Davy isolated it in 1807 by electrolysing molten caustic soda.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium")]),
    8: (formula: "H2O", state: Liquid, color_hex: "#4aa8ff", description: "The universal solvent: two hydrogens on an oxygen, bent at 104.5 degrees. It covers 71% of Earth, dissolves more substances than any other liquid, and takes part in more of the reactions in this game than anything else.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Water")]),
    10: (formula: "NaCl", state: Solid, description: "Common salt. Once so precious it paid Roman soldiers (hence 'salary'), it is the starting point of the chlor-alkali, Leblanc and Solvay industries.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_chloride")]),
    11: (formula: "NH3", state: Gas, properties: [IsBase], description: "A pungent, alkaline gas: one nitrogen and three hydrogens. Fixed from the air by the Haber-Bosch process, it feeds roughly half of humanity through fertilizer.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ammonia")]),
    12: (formula: "CO2", state: Gas, description: "Joseph Black's 'fixed air' (1754), the first gas recognised as distinct from ordinary air. The end point of every combustion of carbon, and the gas plants breathe in.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Carbon_dioxide")]),
    13: (formula: "(NH4)2CO3", state: Solid, description: "Sal volatile, the 'smelling salts' of fainting Victorians and the raising agent 'baker's ammonia'. It slowly gives off ammonia and carbon dioxide at room temperature.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ammonium_carbonate")]),
    14: (name: "Wood", formula: "(C6H10O5)n", state: Solid, molar_mass_g_mol: 162.141, color_hex: "#8a5a32", description: "Mostly cellulose: long chains of glucose that trees lay down as their skeleton. Humanity's first fuel; charred in a smothered pile it becomes charcoal.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Wood")]),
    15: (name: "Clay (kaolinite)", formula: "Al2Si2O5(OH)4", state: Solid, molar_mass_g_mol: 258.157, color_hex: "#c8a888", description: "Kaolinite, the fine weathering product of feldspar. Wet, it can be shaped; fired, it becomes pottery, the oldest synthetic material.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Kaolinite")]),
    16: (name: "Fired Clay", formula: "Al2Si2O7", state: Solid, molar_mass_g_mol: 222.127, color_hex: "#b5603a", description: "What kaolinite becomes above about 550 C, when its bound water is driven out: the hard, porous body of terracotta.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Metakaolin")]),
    17: (name: "Copper(II) Oxide", formula: "CuO", state: Solid, molar_mass_g_mol: 79.545, color_hex: "#1c1c1c", description: "Tenorite: the black scale that forms on copper heated in air. Potters used it to colour glazes green and blue.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Copper(II)_oxide")]),
    18: (name: "Copper(I) Oxide", formula: "Cu2O", state: Solid, molar_mass_g_mol: 143.091, color_hex: "#a02818", description: "Cuprite, a red copper oxide. It colours red glass and is the reason old copper roofs pass through a reddish stage before turning green.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Copper(I)_oxide")]),
    19: (name: "Galena", formula: "PbS", state: Solid, molar_mass_g_mol: 239.26, color_hex: "#6a6e78", description: "Lead sulfide, heavy and metallic grey, often carrying silver. The main ore of lead since antiquity; early radios used its crystals as detectors.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Galena")]),
    20: (name: "Litharge", formula: "PbO", state: Solid, molar_mass_g_mol: 223.199, color_hex: "#e8a830", description: "Lead(II) oxide, a yellow-orange powder. Used in glazes and crystal glass, and the oxide that cupellation skims off to free silver.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lead(II)_oxide")]),
    21: (name: "Cinnabar (vermilion)", formula: "HgS", state: Solid, molar_mass_g_mol: 232.65, color_hex: "#d02818", description: "Mercury sulfide: scarlet ore of mercury and, ground fine, the pigment vermilion that coloured Roman walls and Chinese lacquer.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cinnabar")]),
    22: (name: "Stibnite", formula: "Sb2S3", state: Solid, molar_mass_g_mol: 339.7, color_hex: "#5c6068", description: "Antimony sulfide in long grey needles. Ancient Egyptians used it as kohl eyeliner.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Stibnite")]),
    23: (name: "Iron(II) Sulfide", formula: "FeS", state: Solid, molar_mass_g_mol: 87.905, color_hex: "#2a2420", description: "A black solid formed when iron and sulfur are heated together. With acid it releases rotten-egg hydrogen sulfide.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Iron(II)_sulfide")]),
    24: (name: "Red Lead", formula: "Pb3O4", state: Solid, molar_mass_g_mol: 685.596, color_hex: "#e8381c", description: "Minium, a brilliant red lead oxide: the original 'miniature' paint for manuscripts and the rust-proof primer on old ironwork.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lead(II,IV)_oxide")]),
    25: (name: "Pewter", formula: "Sn4Pb", state: Solid, molar_mass_g_mol: 682.04, properties: [IsMetal], color_hex: "#a8acb0", description: "A soft, silvery alloy of mostly tin. Medieval plates, tankards and spoons were pewter; modern pewter replaces the lead with antimony and copper.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Pewter")]),
    26: (name: "Egyptian Blue", formula: "CaCuSi4O10", state: Solid, molar_mass_g_mol: 375.954, color_hex: "#2850c8", description: "Calcium copper silicate, the first synthetic pigment (around 2500 BCE). It glows in infrared, which lets archaeologists find traces of it on ancient statues.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Egyptian_blue")]),
    27: (name: "Yellow Ochre", formula: "FeO(OH)", state: Solid, molar_mass_g_mol: 88.851, color_hex: "#c8962a", description: "Goethite, hydrated iron oxide: the yellow-brown earth pigment of cave painters for 40,000 years, and the main ingredient of rust.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ochre")]),
    28: (name: "Acanthite", formula: "Ag2S", state: Solid, molar_mass_g_mol: 247.8, color_hex: "#3a3a3e", description: "Silver sulfide, the principal ore of silver; also the black tarnish that forms on silverware.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Acanthite")]),
    29: (name: "Electrum", formula: "AuAg", state: Solid, molar_mass_g_mol: 304.84, properties: [IsMetal], color_hex: "#e0c860", description: "A natural pale-gold alloy of gold and silver. The first coins, struck in Lydia around 600 BCE, were electrum.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Electrum")]),
    30: (name: "Gypsum", formula: "CaSO4·2H2O", state: Solid, molar_mass_g_mol: 172.164, color_hex: "#f2f0ea", description: "Hydrated calcium sulfate, a soft white mineral. Gently heated it loses water and becomes plaster of Paris.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Gypsum")]),
    31: (name: "Plaster of Paris", formula: "CaSO4·½H2O", state: Solid, molar_mass_g_mol: 290.283, color_hex: "#fafaf6", description: "Calcium sulfate hemihydrate. Mixed with water it re-forms interlocking gypsum crystals and sets hard within minutes: casts, mouldings, and broken-bone splints.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Plaster")]),
    32: (name: "Pyrite", formula: "FeS2", state: Solid, molar_mass_g_mol: 119.965, color_hex: "#c8b048", description: "Fool's gold: brassy cubes of iron disulfide. Struck against flint it sparks; roasted, it was a major source of sulfuric acid.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Pyrite")]),
    33: (name: "Natron", formula: "Na2CO3·10H2O", state: Solid, molar_mass_g_mol: 286.138, color_hex: "#f6f2e4", description: "Natural soda from dried salt lakes. Egyptians used it to dry mummies, wash, and make faience and the first glass.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Natron")]),
    34: (name: "Potash", formula: "K2CO3", state: Solid, molar_mass_g_mol: 138.204, properties: [IsBase], description: "Potassium carbonate leached from wood ashes in pots, hence the name. It gave its name to potassium.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_carbonate")]),
    35: (name: "Soft Soap", formula: "C18H35KO2", state: Solid, molar_mass_g_mol: 322.574, color_hex: "#e8dca0", description: "Potassium stearate: the soft, jelly-like soap made from fat and potash lye, used for washing since Babylon.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Soap")]),
    36: (name: "Copper(II) Acetate", formula: "C4H6CuO4", state: Solid, molar_mass_g_mol: 181.634, color_hex: "#2aa088", description: "Verdigris, the blue-green crust that forms on copper exposed to vinegar fumes. A prized and poisonous pigment in medieval and Renaissance painting.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Copper(II)_acetate")]),
    37: (name: "White Lead", formula: "PbCO3", state: Solid, molar_mass_g_mol: 267.208, color_hex: "#f8f8f0", description: "Lead carbonate (cerussite), the dense, opaque white of painters from Greece to the 20th century, and a slow poison to those who made it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lead(II)_carbonate")]),
    38: (name: "Sugar of Lead", formula: "C4H6O4Pb", state: Solid, molar_mass_g_mol: 325.288, description: "Lead(II) acetate. It tastes sweet; Romans boiled grape juice in lead pots to make sapa, a sweetener that slowly poisoned them.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lead(II)_acetate")]),
    39: (name: "Alum", formula: "KAl(SO4)2·12H2O", state: Solid, molar_mass_g_mol: 474.372, color_hex: "#f4f4fa", description: "Potassium alum, the classic mordant: it binds dyes to wool and cloth. Mined and traded across the ancient world.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_alum")]),
    40: (name: "Burnt Alum", formula: "KAl(SO4)2", state: Solid, molar_mass_g_mol: 258.192, description: "Anhydrous alum, a light powder left when alum's water of crystallisation is driven off; an astringent and styptic.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_alum")]),
    41: (name: "Indican", formula: "C14H17NO6", state: Solid, molar_mass_g_mol: 295.291, description: "The colourless glucoside in the leaves of woad and the indigo plant. Fermented in a vat, it releases the precursor of indigo.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Indican")]),
    42: (name: "Indigo", formula: "C16H10N2O2", state: Solid, molar_mass_g_mol: 262.268, color_hex: "#203080", description: "The blue of denim and of royal robes. Once the most valuable plant dye in the world, it has been made synthetically since 1897.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Indigo_dye")]),
    43: (name: "Seawater", formula: "NaCl(aq)", state: Aqueous, molar_mass_g_mol: 76.455, color_hex: "#2a78b8", description: "About 3.5% dissolved salts, mostly sodium chloride. Evaporated in pans, it gave salt to every coastal civilisation.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Seawater")]),
    44: (name: "Pozzolana", formula: "SiO2·Al2O3", state: Solid, molar_mass_g_mol: 162.044, description: "Volcanic ash from Pozzuoli near Naples. Mixed with lime it sets even under water: the secret of Roman concrete.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Pozzolana")]),
    45: (name: "Roman Concrete", formula: "CaO·SiO2·Al2O3", state: Solid, molar_mass_g_mol: 218.121, color_hex: "#b8b0a0", description: "Opus caementicium, lime and volcanic ash bound around rubble. The Pantheon's unreinforced dome has stood for nineteen centuries.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Roman_concrete")]),
    46: (name: "Green Vitriol", formula: "FeSO4·7H2O", state: Solid, molar_mass_g_mol: 278.006, color_hex: "#8ad0a0", description: "Melanterite, iron(II) sulfate heptahydrate: pale green crystals that, distilled, gave alchemists 'oil of vitriol' (sulfuric acid). Also the base of iron gall ink.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Iron(II)_sulfate")]),
    47: (name: "Chloroauric Acid", formula: "HAuCl4", state: Solid, molar_mass_g_mol: 339.778, color_hex: "#e8c020", description: "Gold dissolved in aqua regia: golden-yellow crystals of tetrachloroauric acid, the starting point for gold nanoparticles and ruby glass.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chloroauric_acid")]),
    48: (name: "Sal Ammoniac", formula: "NH4Cl", state: Solid, molar_mass_g_mol: 53.489, description: "Ammonium chloride, found around volcanic vents and first imported from Egypt near the temple of Ammon. Used in soldering, dry cells, and licorice.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ammonium_chloride")]),
    49: (name: "Glauber's Salt", formula: "Na2SO4·10H2O", state: Solid, molar_mass_g_mol: 322.186, description: "Sodium sulfate decahydrate, Glauber's 'wonderful salt', sold as a laxative. It melts at 32 C and stores heat, so it has been tried in solar heating.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_sulfate")]),
    50: (name: "Blue Vitriol", formula: "CuSO4·5H2O", state: Solid, molar_mass_g_mol: 249.677, color_hex: "#1060e0", description: "Copper(II) sulfate pentahydrate: vivid blue crystals. Heated, they lose their water and turn white; add water back and the blue returns.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Copper(II)_sulfate")]),
    51: (name: "Mercury(II) Oxide", formula: "HgO", state: Solid, molar_mass_g_mol: 216.589, color_hex: "#d03010", description: "Red calx of mercury. Priestley heated it with a burning lens in 1774 and collected a gas that made a candle burn fiercely: oxygen.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Mercury(II)_oxide")]),
    52: (name: "Corrosive Sublimate", formula: "HgCl2", state: Solid, molar_mass_g_mol: 271.49, description: "Mercury(II) chloride, a violent poison once used against syphilis and to preserve wood and specimens.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Mercury(II)_chloride")]),
    53: (name: "Calomel", formula: "Hg2Cl2", state: Solid, molar_mass_g_mol: 472.08, description: "Mercury(I) chloride, a heavy white powder taken for centuries as a purgative; today the reference standard in the calomel electrode.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Mercury(I)_chloride")]),
    54: (name: "Microcosmic Salt", formula: "NaNH4HPO4·4H2O", state: Solid, molar_mass_g_mol: 209.067, description: "Sodium ammonium phosphate, crystallised from evaporated urine. Hennig Brand boiled down 1,500 gallons of urine in 1669 hunting for the philosophers' stone.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_ammonium_phosphate")]),
    55: (name: "Sodium Metaphosphate", formula: "NaPO3", state: Solid, molar_mass_g_mol: 101.961, description: "A glassy phosphate formed when microcosmic salt is fused; it dissolves metal oxides into coloured beads, a classic blowpipe test.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_metaphosphate")]),
    56: (name: "Water Glass", formula: "Na2SiO3", state: Solid, molar_mass_g_mol: 122.062, description: "Sodium silicate, glassy yet soluble in water. Used to preserve eggs, seal engines, make silica gel, and fireproof wood.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_silicate")]),
    57: (name: "Phosphoric Acid", formula: "H3PO4", state: Liquid, molar_mass_g_mol: 97.994, properties: [IsAcid], description: "A mild, non-toxic acid that gives cola its tang and fertilizer its phosphorus.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Phosphoric_acid")]),
    58: (name: "Mosaic Gold", formula: "SnS2", state: Solid, molar_mass_g_mol: 182.83, color_hex: "#d8a830", description: "Tin(IV) sulfide in golden flakes, an alchemists' imitation gold used to gild picture frames.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tin(IV)_sulfide")]),
    59: (name: "Orpiment", formula: "As2S3", state: Solid, molar_mass_g_mol: 246.024, color_hex: "#f0b020", description: "Arsenic sulfide, a glowing golden-yellow mineral. Painters prized it and feared it: it is deadly poisonous.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Orpiment")]),
    60: (name: "White Arsenic", formula: "As2O3", state: Solid, molar_mass_g_mol: 197.841, description: "Arsenic trioxide, the classic poison of history and, today, a leukemia treatment.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Arsenic_trioxide")]),
    61: (name: "Bismuthinite", formula: "Bi2S3", state: Solid, molar_mass_g_mol: 514.14, color_hex: "#7a7e88", description: "Bismuth sulfide, the chief ore of bismuth, a metal 15th-century miners confused with lead and tin.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Bismuthinite")]),
    62: (name: "Bismuth Oxide", formula: "Bi2O3", state: Solid, molar_mass_g_mol: 465.957, color_hex: "#f0e060", description: "Bismite, a yellow oxide. Bismuth compounds settle stomachs and colour cosmetics with pearly lustre.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Bismuth(III)_oxide")]),
    63: (name: "Zinc Oxide", formula: "ZnO", state: Solid, molar_mass_g_mol: 81.379, color_hex: "#fafafa", description: "Philosophers' wool: the white, fluffy smoke of burning zinc. A sunscreen, a white pigment, and a catalyst for methanol synthesis.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Zinc_oxide")]),
    64: (name: "Silver Chloride", formula: "AgCl", state: Solid, molar_mass_g_mol: 143.32, color_hex: "#f0f0f0", description: "Horn silver: a white precipitate that darkens in light as silver metal forms, the observation that led to photography.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Silver_chloride")]),
    65: (name: "Witherite", formula: "BaCO3", state: Solid, molar_mass_g_mol: 197.338, description: "Barium carbonate, named for William Withering who described it in 1784 (he also introduced digitalis to medicine).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Witherite")]),
    66: (name: "Baryta", formula: "BaO", state: Solid, molar_mass_g_mol: 153.329, description: "Barium oxide, a strong base. Heated in air it takes up extra oxygen to become the peroxide, the basis of the Brin process for oxygen.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Barium_oxide")]),
    67: (name: "Barium Peroxide", formula: "BaO2", state: Solid, molar_mass_g_mol: 169.328, description: "Barium peroxide: Thénard treated it with acid in 1818 and discovered hydrogen peroxide.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Barium_peroxide")]),
    68: (name: "Barium Chloride", formula: "BaCl2", state: Solid, molar_mass_g_mol: 208.23, description: "A soluble barium salt that throws down white barium sulfate with any sulfate: the classic sulfate test. It colours fireworks green.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Barium_chloride")]),
    69: (name: "White Vitriol", formula: "ZnSO4", state: Solid, molar_mass_g_mol: 161.436, description: "Zinc sulfate, 'white vitriol'. Cavendish dissolved zinc in acid to make his inflammable air and left this behind.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Zinc_sulfate")]),
    70: (name: "Iron(II) Chloride", formula: "FeCl2", state: Solid, molar_mass_g_mol: 126.745, color_hex: "#a8d8a0", description: "A pale green salt, the waste 'pickle liquor' left when steel is cleaned in hydrochloric acid.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Iron(II)_chloride")]),
    71: (name: "Hydrogen Sulfide", formula: "H2S", state: Gas, molar_mass_g_mol: 34.076, description: "The rotten-egg gas. Poisonous, flammable, and the workhorse reagent of 19th-century qualitative analysis.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hydrogen_sulfide")]),
    72: (name: "Iron(III) Chloride", formula: "FeCl3", state: Solid, molar_mass_g_mol: 162.195, color_hex: "#6a3810", description: "Ferric chloride: dark crystals that dissolve to a rust-brown solution. Etches copper circuit boards and clarifies drinking water.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Iron(III)_chloride")]),
    73: (name: "Yellow Prussiate of Potash", formula: "K4[Fe(CN)6]", state: Solid, molar_mass_g_mol: 368.345, color_hex: "#f0d040", description: "Potassium ferrocyanide, made in the 18th century by fusing dried blood with potash and iron. Despite the cyanide groups it is not very toxic.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_ferrocyanide")]),
    74: (name: "Prussian Blue", formula: "Fe4[Fe(CN)6]3", state: Solid, molar_mass_g_mol: 859.239, color_hex: "#103a7a", description: "Discovered by accident in Berlin around 1706: the first modern synthetic pigment, the blue of Hokusai's Great Wave and of architects' blueprints. Today it also treats radioactive caesium poisoning.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Prussian_blue")]),
    75: (name: "Silver Cyanate", formula: "AgOCN", state: Solid, molar_mass_g_mol: 149.887, description: "Wöhler's starting material in 1828: same formula as Liebig's explosive silver fulminate, utterly different behaviour. Isomerism, discovered.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Silver_cyanate")]),
    76: (name: "Ammonium Cyanate", formula: "NH4OCN", state: Solid, molar_mass_g_mol: 60.056, description: "An inorganic salt that, gently heated, rearranges into urea: the experiment that began to dissolve the wall between living and non-living chemistry.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ammonium_cyanate")]),
    77: (name: "Magnesite", formula: "MgCO3", state: Solid, molar_mass_g_mol: 84.313, description: "Magnesium carbonate. Black's experiments on 'magnesia alba' in 1754 led him to fixed air.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Magnesite")]),
    78: (name: "Strontianite", formula: "SrCO3", state: Solid, molar_mass_g_mol: 147.628, description: "Strontium carbonate from the lead mines of Strontian, Scotland, which gave its name to the element.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Strontianite")]),
    79: (name: "Strontium Chloride", formula: "SrCl2", state: Solid, molar_mass_g_mol: 158.52, description: "A salt that colours flames crimson; Davy electrolysed it to isolate strontium in 1808.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Strontium_chloride")]),
    80: (name: "Borax", formula: "Na2B4O7·10H2O", state: Solid, molar_mass_g_mol: 381.363, description: "Tincal, from the dry lakes of Tibet and later Death Valley's twenty-mule teams. A flux for gold-smithing and the source of boron.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Borax")]),
    81: (name: "Boric Acid", formula: "H3BO3", state: Solid, molar_mass_g_mol: 61.831, properties: [IsAcid], description: "A weak acid of boron, an antiseptic and insecticide, and the feed for boron oxide.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Boric_acid")]),
    82: (name: "Boron Trioxide", formula: "B2O3", state: Solid, molar_mass_g_mol: 69.617, description: "Glassy boron oxide, the ingredient that turns ordinary glass into heat-resistant borosilicate.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Boron_trioxide")]),
    83: (name: "Kelp Ash", formula: "NaI", state: Solid, molar_mass_g_mol: 149.89, description: "Burned seaweed, rich in sodium iodide. Napoleon's saltpeter makers used it, and Bernard Courtois found iodine in the residue in 1811.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_iodide")]),
    84: (name: "Bittern Salts", formula: "NaBr", state: Solid, molar_mass_g_mol: 102.894, description: "Sodium bromide from the bitter brine left after salt crystallises from seawater; Balard found bromine in it in 1826.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_bromide")]),
    85: (name: "Fluorite", formula: "CaF2", state: Solid, molar_mass_g_mol: 78.074, color_hex: "#a070e0", description: "Calcium fluoride: glowing violet and green crystals that gave fluorescence its name. A flux for smelting and the source of all fluorine chemistry.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Fluorite")]),
    86: (name: "Hydrofluoric Acid", formula: "HF", state: Liquid, molar_mass_g_mol: 20.006, properties: [IsAcid], description: "Hydrogen fluoride, the only common acid that eats glass. Scheele made it from fluorspar in 1771. It is deceptively dangerous: it seeps through skin and attacks bone.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hydrofluoric_acid")]),
    87: (name: "Fluorosilicic Acid", formula: "H2SiF6", state: Aqueous, molar_mass_g_mol: 144.089, properties: [IsAcid], description: "Formed when hydrofluoric acid attacks silica. Today it fluoridates drinking water.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hexafluorosilicic_acid")]),
    88: (name: "Potassium Fluorosilicate", formula: "K2SiF6", state: Solid, molar_mass_g_mol: 220.269, description: "The salt Berzelius reduced with potassium in 1823 to obtain the first silicon.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_fluorosilicate")]),
    89: (name: "Dried Blood", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, description: "Slaughterhouse blood, dried: the nitrogen and carbon source from which 18th-century chemists fused yellow prussiate with potash and iron.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_ferrocyanide#History")]),
    90: (name: "Cobaltite", formula: "CoAsS", state: Solid, molar_mass_g_mol: 165.915, description: "Cobalt arsenic sulfide. Miners blamed the poisonous ore on goblins, 'kobolds'; Georg Brandt showed in 1735 it held a new metal.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cobaltite")]),
    91: (name: "Cobalt(II) Oxide", formula: "CoO", state: Solid, molar_mass_g_mol: 74.932, color_hex: "#203890", description: "Cobalt oxide fused into glass makes the deep cobalt blue of Ming porcelain and medieval stained glass.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cobalt(II)_oxide")]),
    92: (name: "Nickeline", formula: "NiAs", state: Solid, molar_mass_g_mol: 133.615, description: "Copper-coloured nickel arsenide. Saxon miners called it Kupfernickel, 'copper demon', because it yielded no copper; Cronstedt found nickel in it in 1751.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nickeline")]),
    93: (name: "Nickel(II) Oxide", formula: "NiO", state: Solid, molar_mass_g_mol: 74.692, description: "Green-black nickel oxide, the feed for nickel smelting and a component of nickel batteries.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nickel(II)_oxide")]),
    94: (name: "Scheelite", formula: "CaWO4", state: Solid, molar_mass_g_mol: 287.914, description: "Calcium tungstate, which glows blue under UV. Scheele found a new acid in it in 1781; the Elhuyar brothers made tungsten from it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Scheelite")]),
    95: (name: "Tungstic Acid", formula: "H2WO4", state: Solid, molar_mass_g_mol: 249.852, description: "A yellow acid of tungsten, precipitated from scheelite with acid.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tungstic_acid")]),
    96: (name: "Tungsten Trioxide", formula: "WO3", state: Solid, molar_mass_g_mol: 231.837, color_hex: "#e0d040", description: "Yellow tungsten oxide, reduced with hydrogen to make tungsten powder for lamp filaments.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tungsten(VI)_oxide")]),
    97: (name: "Molybdenite", formula: "MoS2", state: Solid, molar_mass_g_mol: 160.07, description: "Molybdenum disulfide, so soft and greasy it was mistaken for graphite and lead. Today a dry lubricant.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Molybdenite")]),
    98: (name: "Molybdenum Trioxide", formula: "MoO3", state: Solid, molar_mass_g_mol: 143.947, description: "The oxide Hjelm reduced with carbon in 1781 to obtain molybdenum.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Molybdenum_trioxide")]),
    99: (name: "Chromite", formula: "FeCr2O4", state: Solid, molar_mass_g_mol: 223.833, description: "Iron chromium oxide, the only ore of chromium.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chromite")]),
    100: (formula: "C", state: Solid, color_hex: "#2a2420", description: "Wood baked in a smothered pile until only carbon is left: light, black and porous. It burned hotter than wood and fuelled every smelter until coke replaced it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Charcoal")]),
    101: (formula: "Cu2(OH)2CO3", state: Solid, color_hex: "#1f9e5a", description: "A banded green copper carbonate mineral. Ground as eye paint in Egypt and smelted into the first copper around 5000 BCE.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Malachite")]),
    102: (formula: "SnO2", state: Solid, color_hex: "#5a3a2a", description: "Tin stone, the chief ore of tin. Its scarcity made Bronze Age tin a prized trade good shipped across the Mediterranean from Cornwall and Afghanistan.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cassiterite")]),
    103: (formula: "Fe2O3", state: Solid, color_hex: "#8b2a1a", description: "Iron(III) oxide: the red-grey ore that colours rust, red ochre, and the surface of Mars. The most important ore of iron.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hematite")]),
    104: (formula: "CaCO3", state: Solid, color_hex: "#d8d2c0", description: "Rock made from the shells of ancient sea creatures. Burned for lime, fluxed into furnaces, and ground into cement, it is the most-used chemical raw material after water and salt.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Limestone")]),
    105: (formula: "SiO2", state: Solid, color_hex: "#e3c88a", description: "Quartz sand, silicon dioxide. Melted with soda and lime it becomes glass; reduced with carbon it gives silicon, the heart of every chip.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Silicon_dioxide")]),
    106: (formula: "ZnCO3", state: Solid, color_hex: "#c9d8d0", description: "Smithsonite, zinc carbonate. Heated with copper and charcoal it made brass long before zinc itself was isolated.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Smithsonite")]),
    107: (formula: "CaO", state: Solid, properties: [IsBase], color_hex: "#f4f1e8", description: "Calcium oxide, made by burning limestone. It reacts with water so violently it can boil it; ancient builders slaked it to make mortar.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Calcium_oxide")]),
    108: (formula: "Ca(OH)2", state: Solid, properties: [IsBase], color_hex: "#f8f8f4", description: "Calcium hydroxide. The binder in lime mortar and whitewash, and a cheap strong base used to soften water, treat sewage and make bleach.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Calcium_hydroxide")]),
    109: (formula: "CO", state: Gas, description: "A colourless, odourless, poisonous gas from burning carbon in too little air. It is the real reducing agent inside a furnace, stripping oxygen from ores.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Carbon_monoxide")]),
    110: (formula: "CuSn", state: Solid, properties: [IsMetal], color_hex: "#b0782a", description: "Copper hardened with about one part tin in ten. Harder and easier to cast than copper, it gave its name to an age of weapons, tools and bells.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Bronze")]),
    111: (formula: "CuZn", state: Solid, properties: [IsMetal], color_hex: "#d4b040", description: "Copper alloyed with zinc: golden, workable and corrosion resistant. Romans made it by cementation of copper with calamine for coins and armour.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Brass")]),
    120: (name: "Sodium Chromate", formula: "Na2CrO4", state: Solid, molar_mass_g_mol: 161.972, color_hex: "#f0d000", description: "A bright yellow salt made by roasting chromite with soda: the gateway to every chromium chemical.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_chromate")]),
    121: (name: "Sodium Dichromate", formula: "Na2Cr2O7", state: Solid, molar_mass_g_mol: 261.965, color_hex: "#f07010", description: "An orange oxidiser used to tan leather, plate chrome and, in the 1850s, by Perkin to make mauve.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_dichromate")]),
    122: (name: "Chrome Yellow", formula: "PbCrO4", state: Solid, molar_mass_g_mol: 323.192, color_hex: "#f8c800", description: "Lead chromate, the brilliant yellow of Van Gogh's sunflowers (1809). It darkens over time, which is why some of those sunflowers are turning brown.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chrome_yellow")]),
    123: (name: "Chromium(III) Oxide", formula: "Cr2O3", state: Solid, molar_mass_g_mol: 151.989, color_hex: "#2a7a30", description: "Chrome green, a tough, stable green pigment; the colour of banknotes and camouflage paint.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chromium(III)_oxide")]),
    124: (name: "Pitchblende", formula: "UO2", state: Solid, molar_mass_g_mol: 270.028, properties: [IsRadioactive], description: "Uraninite, a black, heavy uranium oxide. Klaproth found uranium in it in 1789; a century later the Curies found polonium and radium.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Uraninite")]),
    125: (name: "Spodumene", formula: "LiAlSi2O6", state: Solid, molar_mass_g_mol: 186.086, description: "A lithium pyroxene in giant crystals; Arfwedson found lithium in its cousin petalite in 1817.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Spodumene")]),
    126: (name: "Leached Spodumene", formula: "HAlSi2O6", state: Solid, molar_mass_g_mol: 180.154, description: "Spodumene with its lithium swapped for hydrogen by hot sulfuric acid.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Spodumene")]),
    127: (name: "Lithium Carbonate", formula: "Li2CO3", state: Solid, molar_mass_g_mol: 73.888, description: "The commodity form of lithium: battery cathodes, ceramics and, since 1949, a mood stabiliser for bipolar disorder.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lithium_carbonate")]),
    128: (name: "Cadmium Sulfide", formula: "CdS", state: Solid, molar_mass_g_mol: 144.47, color_hex: "#f8d018", description: "Greenockite, and the pigment cadmium yellow, beloved of Monet and Matisse.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cadmium_sulfide")]),
    129: (name: "Cadmium Oxide", formula: "CdO", state: Solid, molar_mass_g_mol: 128.409, description: "The brown oxide Stromeyer reduced in 1817 to discover cadmium.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cadmium_oxide")]),
    130: (name: "Silver Iodide", formula: "AgI", state: Solid, molar_mass_g_mol: 234.77, description: "The light-sensitive coating of Daguerre's silvered plates (1839). Today it is sprayed into clouds to seed rain.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Silver_iodide")]),
    131: (name: "Cotton", formula: "(C6H10O5)n", state: Solid, molar_mass_g_mol: 162.141, properties: [IsPolymer], color_hex: "#f8f8f4", description: "Nearly pure cellulose, the most abundant organic polymer on Earth.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cellulose")]),
    132: (name: "Guncotton", formula: "C6H7N3O11", state: Solid, molar_mass_g_mol: 297.132, description: "Nitrocellulose, discovered by Schönbein in 1846 when he wiped spilled acid with his wife's cotton apron and it vanished in a flash.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nitrocellulose")]),
    133: (name: "Ozone", formula: "O3", state: Gas, molar_mass_g_mol: 47.997, description: "Three-atom oxygen with a sharp electric smell, named by Schönbein in 1840 from the Greek for 'to smell'. High in the stratosphere it shields life from UV.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ozone")]),
    134: (name: "Magnetite", formula: "Fe3O4", state: Solid, molar_mass_g_mol: 231.531, color_hex: "#202020", description: "Lodestone, naturally magnetic iron oxide: the first compass. Also the black oxide on blued steel and the iron sludge of the Béchamp reduction.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Magnetite")]),
    135: (name: "Blast-Furnace Slag", formula: "CaSiO3", state: Solid, molar_mass_g_mol: 116.16, color_hex: "#8a8478", description: "The molten rock that floats on iron in the furnace, carrying away the ore's sand as calcium silicate. Today it is ground into cement.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Slag")]),
    136: (name: "Air", formula: "N2+O2+Ar", state: Gas, molar_mass_g_mol: 144.054, description: "Roughly 78% nitrogen, 21% oxygen and 1% argon, with a trace of everything else. Lavoisier showed it was a mixture, not an element.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Atmosphere_of_Earth")]),
    137: (name: "Liquid Air", formula: "N2+O2+Ar", state: Liquid, molar_mass_g_mol: 144.054, color_hex: "#a8d0ff", description: "Air cooled to about -194 C. Carl von Linde liquefied it on an industrial scale in 1895, then separated it by distillation.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Liquid_air")]),
    138: (name: "Antimony Pentachloride", formula: "SbCl5", state: Liquid, molar_mass_g_mol: 299.01, description: "A fuming liquid and Swarts' catalyst for swapping chlorine for fluorine, the chemistry behind the Freons.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Antimony_pentachloride")]),
    139: (name: "Oleum", formula: "H2S2O7", state: Liquid, molar_mass_g_mol: 178.129, properties: [IsAcid], description: "Fuming sulfuric acid: sulfur trioxide dissolved in sulfuric acid. Shipped as oleum because SO3 dissolves badly in water but readily in acid.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Oleum")]),
    140: (name: "Calcium Carbide", formula: "CaC2", state: Solid, molar_mass_g_mol: 64.1, color_hex: "#4a4a50", description: "Grey lumps made in an electric arc furnace from lime and coke (Willson, 1892). Drop it in water and it fizzes out acetylene, the fuel of miners' and cyclists' lamps.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Calcium_carbide")]),
    141: (name: "Calcium Cyanamide", formula: "CaCN2", state: Solid, molar_mass_g_mol: 80.103, description: "Nitrolime, the first synthetic nitrogen fertilizer (Frank and Caro, 1898): calcium carbide heated in nitrogen. It releases ammonia slowly in moist soil.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Calcium_cyanamide")]),
    142: (name: "Bauxite", formula: "Al(OH)3", state: Solid, molar_mass_g_mol: 78.003, color_hex: "#b0502a", description: "A reddish laterite rich in aluminium hydroxides, named for Les Baux in Provence. Nearly all the world's aluminium starts as bauxite.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Bauxite")]),
    143: (name: "Sodium Aluminate", formula: "NaAl(OH)4", state: Aqueous, molar_mass_g_mol: 118.0, description: "The hot caustic liquor of the Bayer process (1888): bauxite's alumina dissolves in it, the iron-red mud does not.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_aluminate")]),
    144: (name: "Nickel Carbonyl", formula: "Ni(CO)4", state: Gas, molar_mass_g_mol: 170.733, description: "A volatile, extremely toxic nickel compound. Ludwig Mond found (1890) that carbon monoxide carries nickel away from impure metal at 50 C and drops it again, pure, at 230 C.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nickel_tetracarbonyl")]),
    145: (name: "Carborundum", formula: "SiC", state: Solid, molar_mass_g_mol: 40.096, color_hex: "#2a5a50", description: "Silicon carbide, which Edward Acheson made in 1891 trying to make diamonds. Nearly as hard as diamond, it became the grinding wheel of the machine age.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Silicon_carbide")]),
    146: (name: "Graphite", formula: "C", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#303034", description: "Carbon in flat hexagonal sheets that slide over each other: soft, black, slippery, and electrically conductive. Acheson made it synthetically from coke in 1896.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Graphite")]),
    147: (name: "Sodium Dicyanoaurate", formula: "NaAu(CN)2", state: Aqueous, molar_mass_g_mol: 271.996, description: "Gold dissolved by cyanide and air. The MacArthur-Forrest process (1887) saved the gold fields of the Witwatersrand, whose ore was too poor to work any other way.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Gold_cyanidation")]),
    148: (name: "Sodium Tetracyanozincate", formula: "Na2Zn(CN)4", state: Aqueous, molar_mass_g_mol: 215.432, description: "The spent cyanide left after zinc dust has thrown down the gold.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Gold_cyanidation")]),
    149: (name: "Lead Dioxide", formula: "PbO2", state: Solid, molar_mass_g_mol: 239.198, color_hex: "#3a2418", description: "Dark brown lead(IV) oxide, the positive plate of every lead-acid battery since Gaston Planté (1859).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lead_dioxide")]),
    150: (name: "Lead(II) Sulfate", formula: "PbSO4", state: Solid, molar_mass_g_mol: 303.256, description: "Anglesite, white lead sulfate. It coats both plates of a lead-acid battery as it discharges.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lead(II)_sulfate")]),
    151: (name: "Radium Chloride", formula: "RaCl2", state: Solid, molar_mass_g_mol: 296.9, properties: [IsRadioactive], description: "The salt Marie Curie concentrated from tonnes of pitchblende residue. A tenth of a gram of it, in 1902, glowed faintly blue in the dark.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Radium_chloride")]),
    152: (name: "Mauveine", formula: "C26H23N4", state: Solid, molar_mass_g_mol: 391.498, color_hex: "#8a2a9a", description: "The first synthetic dye. William Perkin, 18 and trying to make quinine in his home lab (1856), got a black sludge that dyed silk a brilliant purple. Mauve became the colour of the decade.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Mauveine")]),
    153: (name: "Alizarin", formula: "C14H8O4", state: Solid, molar_mass_g_mol: 240.214, color_hex: "#c82818", description: "The red of madder root, the dye of British redcoats. Graebe and Liebermann synthesised it from coal-tar anthracene in 1868, the first natural dye made in a factory, and the madder fields of France were ruined within a decade.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Alizarin")]),
    154: (name: "Phthalic Anhydride", formula: "C8H4O3", state: Solid, molar_mass_g_mol: 148.117, description: "Made by oxidising naphthalene. A BASF worker broke a thermometer into the reaction in 1896 and the mercury turned out to be the catalyst that made synthetic indigo pay.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Phthalic_anhydride")]),
    155: (name: "Celluloid", formula: "C6H8N2O9+C10H16O", state: Solid, molar_mass_g_mol: 404.372, description: "Nitrocellulose plasticised with camphor (Hyatt, 1870), the first thermoplastic: billiard balls, combs, collars, and the film the cinema was born on.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Celluloid")]),
    156: (name: "Viscose", formula: "C7H9NaO5S2", state: Aqueous, molar_mass_g_mol: 260.254, description: "Cellulose dissolved as its xanthate in caustic soda and carbon disulfide (Cross, Bevan and Beadle, 1892): a honey-thick orange syrup.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Viscose")]),
    157: (name: "Rayon", formula: "(C6H10O5)n", state: Solid, molar_mass_g_mol: 162.141, properties: [IsPolymer], description: "Viscose squirted through a spinneret into an acid bath, which turns it back into cellulose as a glossy thread: 'artificial silk'.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Rayon")]),
    158: (name: "Diatomaceous Earth", formula: "SiO2", state: Solid, molar_mass_g_mol: 60.083, color_hex: "#e8e4d8", description: "A chalky rock made of the glassy shells of diatoms. Nobel found it soaked up three times its weight of nitroglycerin and made it safe to handle.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Diatomaceous_earth")]),
    159: (name: "Dynamite", formula: "C3H5N3O9+SiO2", state: Solid, molar_mass_g_mol: 287.168, description: "Alfred Nobel's 1867 patent: nitroglycerin absorbed into kieselguhr. It built railways and canals, and its fortune funded the Nobel Prizes.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Dynamite")]),
    160: (name: "Methane", formula: "CH4", state: Gas, molar_mass_g_mol: 16.043, description: "The simplest hydrocarbon, one carbon and four hydrogens. Marsh gas, firedamp, and the main part of natural gas; Volta collected it bubbling up from Lake Maggiore in 1776.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Methane")]),
    161: (name: "Silver Bromide", formula: "AgBr", state: Solid, molar_mass_g_mol: 187.774, color_hex: "#f0eab8", description: "The pale yellow, light-sensitive salt in the gelatin of photographic film and paper (Maddox, 1871). Each crystal grain that catches a few photons becomes a speck of the image.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Silver_bromide")]),
    162: (name: "Sodium Sulfite", formula: "Na2SO3", state: Solid, molar_mass_g_mol: 126.037, description: "A mild reducing agent used to preserve food and wine and, in photography, to keep developer from oxidising.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_sulfite")]),
    163: (name: "Sodium Argentothiosulfate", formula: "Na3Ag(S2O3)2", state: Aqueous, molar_mass_g_mol: 401.074, description: "The soluble complex that 'hypo' forms with unexposed silver bromide. Washing it away fixes a photograph: Herschel's discovery of 1819.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Photographic_fixer")]),
    164: (name: "Benzenesulfonic Acid", formula: "C6H6O3S", state: Solid, molar_mass_g_mol: 158.171, properties: [IsAcid], description: "Benzene with a sulfonic acid group attached. Fused with caustic soda it gave the first synthetic phenol (1890s).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Benzenesulfonic_acid")]),
    165: (name: "Synthetic Ruby", formula: "Al2O3(Cr)", state: Solid, molar_mass_g_mol: 101.961, color_hex: "#c8102e", description: "Alumina with a trace of chromium, grown drop by drop in an oxy-hydrogen flame by Auguste Verneuil (1902). In 1960 a ruby rod became the first laser.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Verneuil_method")]),
    166: (name: "Blister Copper", formula: "Cu", state: Solid, molar_mass_g_mol: 63.546, properties: [IsMetal], color_hex: "#b05830", description: "Converter copper about 98% pure, its surface pocked with blisters where sulfur dioxide escaped as it cooled.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Blister_copper")]),
    167: (name: "Iron Silicate Slag", formula: "FeSiO3", state: Solid, molar_mass_g_mol: 131.927, color_hex: "#2a2a2a", description: "The iron of copper ore, carried off as a glassy silicate slag in the converter.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Slag")]),
    168: (name: "Anode Slime", formula: "Ag+Au+Se+Te", state: Solid, molar_mass_g_mol: 511.411, description: "The black mud that collects under the anodes when copper is refined electrolytically: rich in silver, gold, selenium and tellurium.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Anode_slime")]),
    169: (name: "Crude Oil", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#201810", description: "Petroleum: a dark mixture of hydrocarbons from ancient plankton. Edwin Drake drilled the first commercial oil well in Pennsylvania in 1859, to make kerosene for lamps.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Petroleum")]),
    170: (name: "Gasoline", formula: "C8H18", state: Liquid, molar_mass_g_mol: 114.232, color_hex: "#f0d890", description: "The light, volatile fraction of petroleum, at first a dangerous waste product of kerosene refining, until the motor car made it the main one.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Gasoline")]),
    171: (name: "Kerosene", formula: "C12H26", state: Liquid, molar_mass_g_mol: 170.34, description: "Paraffin oil, the middle distillate of petroleum. It replaced whale oil in lamps in the 1860s, and now fuels jet aircraft.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Kerosene")]),
    172: (name: "Naphtha", formula: "C6H14", state: Liquid, molar_mass_g_mol: 86.178, description: "Light distillate between gasoline and kerosene. Cracked with steam, it is the source of most of the world's ethylene and propylene.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Naphtha")]),
    173: (name: "Bitumen", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#101010", description: "The black, sticky residue left when the volatile parts of petroleum are distilled away: asphalt for roads and roofs.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Bitumen")]),
    174: (name: "Liquid Hydrogen", formula: "H2", state: Liquid, molar_mass_g_mol: 2.016, description: "Hydrogen below -253 C. James Dewar liquefied it in 1898, using the vacuum flask he invented for the purpose.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Liquid_hydrogen")]),
    175: (name: "Liquid Helium", formula: "He", state: Liquid, molar_mass_g_mol: 4.003, description: "Helium below -269 C, first liquefied by Heike Kamerlingh Onnes in 1908. Cooling mercury with it, he discovered superconductivity three years later.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Liquid_helium")]),
    176: (name: "Ammonium Sulfate", formula: "(NH4)2SO4", state: Solid, molar_mass_g_mol: 132.134, description: "The fertilizer gasworks made from the ammonia in coal gas, and later the main outlet for Haber-Bosch ammonia.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ammonium_sulfate")]),
    177: (name: "Thomas Slag", formula: "Ca3(PO4)2", state: Solid, molar_mass_g_mol: 310.174, description: "Gilchrist and Thomas's basic lining (1878) let steelmakers burn the phosphorus out of iron ore into the slag, which farmers then bought as fertilizer.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Gilchrist-Thomas_process")]),
    178: (name: "Stainless Steel", formula: "Fe(Cr,Ni)", state: Solid, molar_mass_g_mol: 166.534, properties: [IsMetal], color_hex: "#c0c8d0", description: "Steel with at least 10.5% chromium, which forms an invisible self-healing oxide film. Harry Brearley noticed in 1913 that his chromium gun-barrel steel would not etch.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Stainless_steel")]),
    179: (name: "High-Speed Steel", formula: "Fe(W,Cr)", state: Solid, molar_mass_g_mol: 239.685, properties: [IsMetal], color_hex: "#707a88", description: "Tool steel with tungsten and chromium (Taylor and White, 1900) that stays hard red-hot, letting lathes cut several times faster.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/High-speed_steel")]),
    180: (name: "n-Octane", formula: "C8H18", state: Liquid, molar_mass_g_mol: 114.232, description: "A straight eight-carbon alkane, a typical molecule of gasoline. Fischer and Tropsch made fuels like it from coal gas in the 1920s.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Octane")]),
    181: (name: "Hexadecane", formula: "C16H34", state: Liquid, molar_mass_g_mol: 226.448, description: "Cetane, a sixteen-carbon alkane: the reference fuel for diesel ignition quality and a typical molecule of heavy gas oil.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hexadecane")]),
    182: (name: "Natural Gas", formula: "CH4+C2H6+C3H8", state: Gas, molar_mass_g_mol: 12.011, description: "Mostly methane, with ethane, propane and butane. Once flared off as a nuisance at oil wells, it now heats homes and feeds the chemical industry.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Natural_gas")]),
    183: (name: "Ethane", formula: "C2H6", state: Gas, molar_mass_g_mol: 30.07, description: "The two-carbon alkane. Steam cracked, it gives ethylene more cleanly than any other feed.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ethane")]),
    184: (name: "Propane", formula: "C3H8", state: Gas, molar_mass_g_mol: 44.097, description: "A three-carbon alkane, liquefied under modest pressure as bottled gas for camping stoves and barbecues.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Propane")]),
    185: (name: "1,2-Dichloroethane", formula: "C2H4Cl2", state: Liquid, molar_mass_g_mol: 98.954, description: "Ethylene dichloride, the 'oil of the Dutch chemists' (1795). Cracked hot, it gives vinyl chloride for PVC; it is made in larger volume than almost any other organochlorine.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/1,2-Dichloroethane")]),
    186: (name: "PVC", formula: "(C2H3Cl)n", state: Solid, molar_mass_g_mol: 62.496, properties: [IsPolymer], color_hex: "#e8ecf0", description: "Polyvinyl chloride. Waldo Semon at B.F. Goodrich (1926) found how to plasticise it; now pipes, window frames, cable insulation and vinyl records.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polyvinyl_chloride")]),
    187: (name: "Polystyrene", formula: "(C8H8)n", state: Solid, molar_mass_g_mol: 104.152, properties: [IsPolymer], color_hex: "#f4f4f8", description: "Clear, rigid and brittle; foamed with gas it becomes Styrofoam. BASF began making it in 1931.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polystyrene")]),
    188: (name: "Teflon (PTFE)", formula: "(C2F4)n", state: Solid, molar_mass_g_mol: 100.014, properties: [IsPolymer], color_hex: "#f8f8f8", description: "Roy Plunkett (1938) opened a cylinder of tetrafluoroethylene that should have been full and found it empty, its inside coated with a slippery white wax. Nothing sticks to it, and almost nothing attacks it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polytetrafluoroethylene")]),
    189: (name: "Nylon 6", formula: "(C6H11NO)n", state: Solid, molar_mass_g_mol: 113.16, properties: [IsPolymer], description: "Paul Schlack at IG Farben (1938) polymerised caprolactam into a nylon that dodged DuPont's patents: Perlon.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nylon_6")]),
    190: (name: "PET (polyester)", formula: "(C10H8O4)n", state: Solid, molar_mass_g_mol: 192.17, properties: [IsPolymer], description: "Polyethylene terephthalate (Whinfield and Dickson, 1941): Terylene and Dacron fibres, then the clear plastic of drinks bottles.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polyethylene_terephthalate")]),
    191: (name: "Methyl Methacrylate", formula: "C5H8O2", state: Liquid, molar_mass_g_mol: 100.117, properties: [IsMonomer], description: "The monomer of Perspex and Plexiglas, made since 1933 from acetone and hydrogen cyanide.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Methyl_methacrylate")]),
    192: (name: "Acrylic Glass (PMMA)", formula: "(C5H8O2)n", state: Solid, molar_mass_g_mol: 100.117, properties: [IsPolymer], color_hex: "#e8f4ff", description: "Polymethyl methacrylate: clear, shatter-resistant 'organic glass' for Spitfire canopies, aquarium walls and contact lenses.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Poly(methyl_methacrylate)")]),
    193: (name: "Vinylacetylene", formula: "C4H4", state: Gas, molar_mass_g_mol: 52.076, description: "Two acetylenes joined: Julius Nieuwland's copper-catalysed dimer (1920s), the route to neoprene.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Vinylacetylene")]),
    194: (name: "Chloroprene", formula: "C4H5Cl", state: Liquid, molar_mass_g_mol: 88.534, properties: [IsMonomer], description: "2-Chlorobutadiene, the monomer of neoprene.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chloroprene")]),
    195: (name: "Neoprene", formula: "(C4H5Cl)n", state: Solid, molar_mass_g_mol: 88.534, properties: [IsPolymer], color_hex: "#202020", description: "DuPont's synthetic rubber (1931): oil- and weatherproof, the stuff of wetsuits and laptop sleeves.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Neoprene")]),
    196: (name: "Styrene-Butadiene Rubber", formula: "(C12H14)n", state: Solid, molar_mass_g_mol: 158.244, properties: [IsPolymer], color_hex: "#2a2a2a", description: "Buna-S (1929), and the American GR-S that replaced lost natural rubber in the Second World War. Most car tyres are still made of it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Styrene-butadiene")]),
    197: (name: "Polypropylene", formula: "(C3H6)n", state: Solid, molar_mass_g_mol: 42.081, properties: [IsPolymer], description: "Giulio Natta (1954) used Ziegler's titanium catalysts to line up propylene units the same way round, making a tough, heat-resistant plastic: car bumpers, ropes, food tubs.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polypropylene")]),
    198: (name: "High-Density Polyethylene", formula: "(C2H4)n", state: Solid, molar_mass_g_mol: 28.054, properties: [IsPolymer], description: "Karl Ziegler (1953) made linear polyethylene at low pressure with a titanium catalyst: stiffer and stronger than ICI's branched kind. Milk jugs and Hula Hoops.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/High-density_polyethylene")]),
    199: (name: "Rutile", formula: "TiO2", state: Solid, molar_mass_g_mol: 79.865, color_hex: "#f8f8f8", description: "Titanium dioxide, the brilliant white pigment in paint, paper and toothpaste, and the ore of titanium metal.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Rutile")]),
    200: (formula: "Fe(C)", state: Solid, properties: [IsMetal], color_hex: "#8a96a8", description: "Iron with a fraction of a percent of carbon dissolved in it, enough to make it far harder and tougher than pure iron. Quenched and tempered, it holds an edge.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Steel")]),
    201: (formula: "Na2CaSi6O14", state: Solid, color_hex: "#bfe8f0", description: "Soda-lime glass: sand melted with soda ash and lime. Its atoms freeze in a disordered network rather than a crystal, which is why it is transparent.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Soda-lime_glass")]),
    202: (formula: "Na2CO3", state: Solid, properties: [IsBase], color_hex: "#f4f4f4", description: "Sodium carbonate, once leached from plant ashes and natron. The bulk alkali of glassmaking and soapmaking; the Leblanc and Solvay processes were invented to make it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_carbonate")]),
    203: (name: "Sugar (glucose)", formula: "C6H12O6", state: Solid, color_hex: "#fff6e0", description: "Grape sugar, the fuel of almost every living cell. Yeast ferments it to alcohol and carbon dioxide.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Glucose")]),
    205: (formula: "C2H6O", state: Liquid, description: "Drinking alcohol, made by yeast from sugar since prehistory. A solvent, a fuel, a disinfectant, and the starting point for vinegar, ether and ethylene.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ethanol")]),
    206: (formula: "C2H4O2", state: Liquid, properties: [IsAcid], description: "The acid of vinegar, formed when bacteria oxidise wine. The first acid known to humans, and today a feedstock for plastics, solvents and aspirin.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Acetic_acid")]),
    207: (formula: "C57H110O6", state: Solid, color_hex: "#f0e6c8", description: "Rendered animal fat, mostly tristearin: three stearic acid chains on a glycerol backbone. Boiled with lye, it becomes soap and glycerol.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tallow")]),
    209: (formula: "C3H8O3", state: Liquid, description: "A sweet, syrupy triple alcohol freed from fats when soap is made. Nitrated, it becomes nitroglycerin.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Glycerol")]),
    210: (formula: "KNO3", state: Solid, description: "Potassium nitrate, scraped from cave walls and nitre beds. The oxidiser in black powder and a key source of nitric acid before the 20th century.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_nitrate")]),
    211: (formula: "KNO3+S+C", state: Solid, color_hex: "#2a2a2a", description: "Gunpowder: about 75% saltpeter, 15% charcoal and 10% sulfur, ground together. Invented in 9th-century China, it reshaped warfare and mining.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Gunpowder")]),
    217: (name: "Titanium Tetrachloride", formula: "TiCl4", state: Liquid, molar_mass_g_mol: 189.667, description: "A colourless liquid that fumes into a dense white smoke in moist air. The intermediate in both titanium metal and the Ziegler-Natta catalyst.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Titanium_tetrachloride")]),
    218: (name: "Dimethyldichlorosilane", formula: "C2H6Cl2Si", state: Liquid, molar_mass_g_mol: 129.055, description: "The main product of Rochow's direct process (1945), and the building block of silicones.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Dimethyldichlorosilane")]),
    219: (name: "Silicone (PDMS)", formula: "(C2H6OSi)n", state: Solid, molar_mass_g_mol: 74.154, properties: [IsPolymer], description: "Polydimethylsiloxane: a backbone of silicon and oxygen, like quartz, dressed in methyl groups. Sealants, breast implants, Silly Putty.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polydimethylsiloxane")]),
    220: (name: "Polyurethane", formula: "(C11H12N2O4)n", state: Solid, molar_mass_g_mol: 236.227, properties: [IsPolymer], description: "Otto Bayer (1937) joined diisocyanates to diols. Foamed, it fills mattresses and car seats; as a coating, it varnishes floors.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polyurethane")]),
    221: (name: "Kevlar", formula: "(C14H10N2O2)n", state: Solid, molar_mass_g_mol: 238.246, properties: [IsPolymer], color_hex: "#e8c040", description: "Stephanie Kwolek (1965) spun a cloudy liquid-crystal solution her colleagues thought should be thrown away: a fibre five times stronger than steel by weight. Bulletproof vests, tyres, fibre-optic cables.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Kevlar")]),
    222: (name: "Bisphenol A", formula: "C15H16O2", state: Solid, molar_mass_g_mol: 228.291, description: "Two phenols bridged by acetone (Dianin, 1891). The monomer of polycarbonate and epoxy resin.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Bisphenol_A")]),
    223: (name: "Epoxy Resin", formula: "(C21H24O4)n", state: Solid, molar_mass_g_mol: 320.813, properties: [IsPolymer], description: "Bisphenol A and epichlorohydrin, cured with a hardener into one of the toughest adhesives known (Castan and Greenlee, 1940s).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Epoxy")]),
    224: (name: "Polycarbonate", formula: "(C16H14O3)n", state: Solid, molar_mass_g_mol: 254.285, properties: [IsPolymer], description: "Hermann Schnell at Bayer (1953): a clear plastic tough enough for riot shields, spectacle lenses and CDs.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polycarbonate")]),
    225: (name: "Acrylic Fibre (PAN)", formula: "(C3H3N)n", state: Solid, molar_mass_g_mol: 53.064, properties: [IsPolymer], description: "Polyacrylonitrile, DuPont's Orlon (1950): a wool substitute, and when charred under tension, the precursor of carbon fibre.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polyacrylonitrile")]),
    226: (name: "Polyvinyl Acetate", formula: "(C4H6O2)n", state: Solid, molar_mass_g_mol: 86.09, properties: [IsPolymer], description: "Fritz Klatte's 1912 polymer, sold as white wood glue and school glue.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polyvinyl_acetate")]),
    227: (name: "4-Nitrotoluene", formula: "C7H7NO2", state: Solid, molar_mass_g_mol: 137.138, description: "Toluene with a nitro group opposite its methyl: pale yellow crystals, the start of the route to PABA and benzocaine.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/4-Nitrotoluene")]),
    228: (name: "4-Aminobenzoic Acid", formula: "C7H7NO2", state: Solid, molar_mass_g_mol: 137.138, description: "PABA: a vitamin for bacteria (which sulfa drugs block), the first sunscreen ingredient, and the backbone of benzocaine.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/4-Aminobenzoic_acid")]),
    229: (name: "DDT", formula: "C14H9Cl5", state: Solid, molar_mass_g_mol: 354.476, description: "First made in 1874, its insect-killing power found by Paul Muller in 1939 (Nobel Prize, 1948). It all but ended malaria in Europe, then thinned eagles' eggshells; Rachel Carson's Silent Spring (1962) led to its ban on farms.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/DDT")]),
    230: (name: "Sorbitol", formula: "C6H14O6", state: Solid, molar_mass_g_mol: 182.172, description: "A sugar alcohol made by hydrogenating glucose: sugar-free sweets, and the first step in Reichstein's vitamin C synthesis.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sorbitol")]),
    231: (name: "Penicillium Culture", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, description: "A blue-green mould. A strain from a mouldy cantaloupe in a Peoria market (1943) yielded 200 times more penicillin than Fleming's original.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Penicillium")]),
    232: (name: "Penicillin G", formula: "C16H18N2O4S", state: Solid, molar_mass_g_mol: 334.39, description: "Benzylpenicillin. Alexander Fleming saw mould killing bacteria on a culture plate in 1928; Florey, Chain and Heatley made it a drug in 1940-41. By D-Day there was enough for every Allied soldier.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Penicillin")]),
    233: (name: "Corn Steep Liquor", formula: "mixture", state: Aqueous, molar_mass_g_mol: 12.011, description: "The syrupy by-product of starch milling. Added to the fermentation broth in Peoria, it multiplied penicillin yields.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Corn_steep_liquor")]),
    234: (name: "Polysilicon", formula: "Si", state: Solid, molar_mass_g_mol: 28.085, color_hex: "#5a6070", description: "Silicon purified to 99.9999999%, nine nines, by decomposing trichlorosilane on hot rods (the Siemens process, 1950s).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polycrystalline_silicon")]),
    235: (name: "Silicon Wafer", formula: "Si", state: Solid, molar_mass_g_mol: 28.085, color_hex: "#6a7488", description: "A slice of a single crystal of silicon, pulled from the melt by the Czochralski method. Every chip starts as one.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Wafer_(electronics)")]),
    236: (name: "p-Type Silicon", formula: "Si(B)", state: Solid, molar_mass_g_mol: 28.085, description: "Silicon doped with a trace of boron: each boron leaves a 'hole' that carries current.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Extrinsic_semiconductor")]),
    237: (name: "n-Type Silicon", formula: "Si(P)", state: Solid, molar_mass_g_mol: 28.085, description: "Silicon doped with a trace of phosphorus, each of which donates a spare electron.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Extrinsic_semiconductor")]),
    238: (name: "Transistor", formula: "Si", state: Solid, molar_mass_g_mol: 56.17, description: "Bardeen, Brattain and Shockley at Bell Labs (1947): a sandwich of doped semiconductor that switches and amplifies. Billions sit in every phone.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Transistor")]),
    239: (name: "Diamond", formula: "C", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#e8f8ff", description: "Carbon in a three-dimensional lattice, the hardest natural material. General Electric made the first reproducible synthetic diamonds in 1954 at 50,000 atmospheres.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Diamond")]),
    240: (name: "Uranium Tetrafluoride", formula: "UF4", state: Solid, molar_mass_g_mol: 314.022, properties: [IsRadioactive], color_hex: "#40a040", description: "Green salt, the intermediate between uranium oxide and the metal or the hexafluoride.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Uranium_tetrafluoride")]),
    241: (name: "Uranium Hexafluoride", formula: "UF6", state: Solid, molar_mass_g_mol: 352.018, properties: [IsRadioactive], description: "A white solid that sublimes at 57 C, the only uranium compound volatile enough to be separated by gaseous diffusion.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Uranium_hexafluoride")]),
    242: (name: "Lauryl Alcohol", formula: "C12H26O", state: Liquid, molar_mass_g_mol: 186.339, description: "1-Dodecanol, made from coconut and palm-kernel oil. Sulfated, it becomes the foaming agent in shampoo.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Dodecanol")]),
    243: (name: "Coconut Oil", formula: "C39H74O6", state: Solid, molar_mass_g_mol: 639.015, description: "A fat rich in twelve-carbon lauric acid, pressed from dried coconut meat.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Coconut_oil")]),
    244: (name: "Silica Gel", formula: "SiO2", state: Solid, molar_mass_g_mol: 60.083, description: "A porous form of silica with an enormous internal surface. Those 'do not eat' sachets are full of it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Silica_gel")]),
    245: (name: "Silica Aerogel", formula: "SiO2", state: Solid, molar_mass_g_mol: 60.083, color_hex: "#c8e0f8", description: "Samuel Kistler (1931) dried a gel without letting it collapse: a solid that is 99% air, so light it looks like frozen smoke.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Aerogel")]),
    246: (name: "Bromobenzene", formula: "C6H5Br", state: Liquid, molar_mass_g_mol: 157.01, description: "Benzene with one bromine: a heavy, pleasant-smelling liquid and the classic starting point for Grignard and Suzuki chemistry.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Bromobenzene")]),
    247: (name: "Phenylmagnesium Bromide", formula: "C6H5BrMg", state: Liquid, molar_mass_g_mol: 181.315, description: "A Grignard reagent: magnesium inserted between carbon and bromine makes the carbon act like a carbanion, ready to attack almost any carbonyl. Victor Grignard, Nobel Prize 1912.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Phenylmagnesium_bromide")]),
    248: (name: "Buckminsterfullerene", formula: "C60", state: Solid, molar_mass_g_mol: 720.66, color_hex: "#4a3a5a", description: "Sixty carbon atoms in a hollow football. Kroto, Curl and Smalley (1985) found it in laser-blasted graphite vapour and named it for Buckminster Fuller's geodesic domes. Nobel Prize, 1996.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Buckminsterfullerene")]),
    249: (name: "Carbon Nanotubes", formula: "C", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#202020", description: "Graphite sheets rolled into seamless tubes a nanometre across. Sumio Iijima's 1991 images set off a rush; they are stronger than any steel and conduct like copper.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Carbon_nanotube")]),
    250: (name: "Graphene", formula: "C", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#404048", description: "A single sheet of graphite one atom thick. Geim and Novoselov (2004) peeled it off with sticky tape on a Friday-evening experiment. Nobel Prize, 2010.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Graphene")]),
    251: (name: "CVD Diamond", formula: "C", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f0faff", description: "Diamond grown atom by atom from a methane-hydrogen plasma (1980s). Lab-grown gems and the diamond windows of high-power lasers.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chemical_vapor_deposition_of_diamond")]),
    252: (name: "YBCO Superconductor", formula: "YBa2Cu3O7", state: Solid, molar_mass_g_mol: 666.197, color_hex: "#1a1a1a", description: "Yttrium barium copper oxide (Wu and Chu, 1987): superconducting at 93 K, above the boiling point of liquid nitrogen. A black ceramic that levitates magnets.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Yttrium_barium_copper_oxide")]),
    253: (name: "Lithium Cobalt Oxide", formula: "LiCoO2", state: Solid, molar_mass_g_mol: 97.871, description: "John Goodenough's 1980 cathode: lithium ions slip in and out between layers of cobalt oxide. Nobel Prize, 2019, at 97.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lithium_cobalt_oxide")]),
    254: (name: "Lithium-Ion Cell", formula: "LiCoO2+C6", state: Solid, molar_mass_g_mol: 169.937, description: "Goodenough's cathode plus Akira Yoshino's carbon anode (1985), sold by Sony from 1991. It made phones, laptops and electric cars possible.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lithium-ion_battery")]),
    255: (name: "Lithium Iron Phosphate", formula: "LiFePO4", state: Solid, molar_mass_g_mol: 157.755, description: "John Goodenough's second great cathode (Padhi, 1997): cheaper and safer than cobalt, with no fire risk. Most electric buses and many cars use it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lithium_iron_phosphate")]),
    256: (name: "Monazite", formula: "NdPO4", state: Solid, molar_mass_g_mol: 239.21, color_hex: "#a06030", description: "A heavy reddish phosphate sand carrying the light rare earths: cerium, lanthanum, neodymium, and some thorium. We follow its neodymium.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Monazite")]),
    257: (name: "Neodymium Chloride", formula: "NdCl3", state: Solid, molar_mass_g_mol: 250.59, color_hex: "#c8a8d0", description: "A mauve salt; electrolysed molten, it yields neodymium metal.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Neodymium(III)_chloride")]),
    258: (name: "Neodymium Magnet", formula: "Nd2Fe14B", state: Solid, molar_mass_g_mol: 1081.12, color_hex: "#909aa8", description: "Masato Sagawa (1982): the strongest permanent magnets known. In every hard drive, wind turbine and electric car motor.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Neodymium_magnet")]),
    259: (name: "Gallium Nitride", formula: "GaN", state: Solid, molar_mass_g_mol: 83.73, description: "A hard, wide-bandgap semiconductor. Akasaki, Amano and Nakamura grew good enough crystals of it in the early 1990s to make the blue LED. Nobel Prize, 2014.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Gallium_nitride")]),
    260: (name: "Blue LED", formula: "InGaN", state: Solid, molar_mass_g_mol: 198.55, description: "Indium gallium nitride layers on sapphire, glowing blue. With a yellow phosphor it makes the white LED, which uses a tenth of the power of a bulb.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Light-emitting_diode#Blue_and_white_LEDs")]),
    261: (name: "Lead(II) Iodide", formula: "PbI2", state: Solid, molar_mass_g_mol: 461.0, color_hex: "#f8d020", description: "Golden flakes that crystallise from hot water: the 'golden rain' demonstration, and half of a perovskite solar cell.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lead(II)_iodide")]),
    262: (name: "Hydroiodic Acid", formula: "HI", state: Gas, molar_mass_g_mol: 127.908, properties: [IsAcid], description: "Hydrogen iodide, the strongest of the hydrohalic acids.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hydrogen_iodide")]),
    263: (name: "Methylammonium Iodide", formula: "CH6IN", state: Solid, molar_mass_g_mol: 158.966, description: "The organic salt that goes into perovskite solar cells.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Methylammonium_lead_halide")]),
    264: (name: "Perovskite Solar Film", formula: "CH6NPbI3", state: Solid, molar_mass_g_mol: 619.966, color_hex: "#2a1a10", description: "Methylammonium lead iodide (Kojima and Miyasaka, 2009). In a decade perovskite cells went from 4% to over 25% efficient, faster than any solar material before.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Perovskite_solar_cell")]),
    265: (name: "Cadmium Selenide Quantum Dots", formula: "CdSe", state: Solid, molar_mass_g_mol: 191.381, color_hex: "#e85020", description: "Nanocrystals a few nanometres across whose colour depends only on their size (Brus, Ekimov; Bawendi's hot-injection synthesis, 1993). Nobel Prize, 2023. They colour QLED televisions.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Quantum_dot")]),
    266: (name: "MOF-5", formula: "Zn4O(C8H4O4)3", state: Solid, molar_mass_g_mol: 769.867, description: "Omar Yaghi's metal-organic framework (1999): zinc clusters linked by terephthalate struts into a crystal sponge with the surface area of a football pitch per gram. Nobel Prize, 2025.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Metal-organic_framework")]),
    267: (name: "Ruthenium(III) Chloride", formula: "RuCl3", state: Solid, molar_mass_g_mol: 207.42, description: "The usual starting point for ruthenium chemistry.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ruthenium(III)_chloride")]),
    268: (name: "Grubbs Catalyst", formula: "C43H72Cl2P2Ru", state: Solid, molar_mass_g_mol: 822.967, color_hex: "#8a3a8a", description: "Robert Grubbs' ruthenium carbene (1992-95), stable in air, that swaps the ends of carbon-carbon double bonds. Nobel Prize, 2005, with Chauvin and Schrock.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Grubbs_catalyst")]),
    269: (name: "Phenylboronic Acid", formula: "C6H7BO2", state: Solid, molar_mass_g_mol: 121.93, description: "A benzene ring on a boron. The partner in the Suzuki coupling.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Phenylboronic_acid")]),
    270: (name: "4-Isobutylacetophenone", formula: "C12H16O", state: Liquid, molar_mass_g_mol: 176.259, description: "The first intermediate of the BHC ibuprofen process.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ibuprofen#Synthesis")]),
    271: (name: "1-(4-Isobutylphenyl)ethanol", formula: "C12H18O", state: Liquid, molar_mass_g_mol: 178.275, description: "The alcohol that palladium carbonylates into ibuprofen.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ibuprofen#Synthesis")]),
    272: (name: "Lactose", formula: "C12H22O11", state: Solid, molar_mass_g_mol: 342.297, description: "Milk sugar, a disaccharide of glucose and galactose. Lactic bacteria ferment it to lactic acid.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lactose")]),
    273: (name: "Polylactic Acid", formula: "(C3H4O2)n", state: Solid, molar_mass_g_mol: 72.063, properties: [IsPolymer], description: "A compostable plastic made from plant sugar (NatureWorks, 2002): 3D-printer filament, cups, and dissolving surgical stitches.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polylactic_acid")]),
    274: (name: "Sweet Wormwood", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, description: "Artemisia annua, a Chinese herbal fever remedy for 1,600 years.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Artemisia_annua")]),
    275: (name: "Artemisinin", formula: "C15H22O5", state: Solid, molar_mass_g_mol: 282.336, description: "Tu Youyou (1972) read a 4th-century recipe that said to soak wormwood in cold water, not boil it, extracted it with cold ether, and found the most important antimalarial of modern times. Nobel Prize, 2015.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Artemisinin")]),
    276: (name: "Potassium Tetrachloroplatinate", formula: "K2PtCl4", state: Solid, molar_mass_g_mol: 415.076, color_hex: "#c84028", description: "A red salt, the usual source of platinum for platinum complexes.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_tetrachloroplatinate")]),
    277: (name: "Cisplatin", formula: "PtCl2(NH3)2", state: Solid, molar_mass_g_mol: 300.042, color_hex: "#f0e040", description: "Barnett Rosenberg (1965) saw bacteria stop dividing near platinum electrodes and traced it to this compound. Approved in 1978, it turned testicular cancer from a killer into a curable disease.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cisplatin")]),
    278: (name: "Green Coffee Beans", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, description: "Raw coffee, about 1% caffeine by weight.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Coffee_bean")]),
    279: (name: "Chlorine Monoxide", formula: "ClO", state: Gas, molar_mass_g_mol: 51.449, description: "The radical that eats the ozone layer. Rowland and Molina (1974) showed CFCs release chlorine high in the stratosphere; each atom destroys thousands of ozone molecules. Nobel Prize, 1995.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chlorine_monoxide")]),
    280: (name: "Silicon Solar Cell", formula: "Si", state: Solid, molar_mass_g_mol: 56.17, color_hex: "#203060", description: "A p-n junction that turns light into current: Chapin, Fuller and Pearson at Bell Labs (1954). Solar is now the cheapest electricity in history.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Solar_cell")]),
    281: (name: "Microprocessor", formula: "Si", state: Solid, molar_mass_g_mol: 147.801, color_hex: "#3a6a40", description: "Kilby and Noyce invented the integrated circuit in 1958-59; the Intel 4004 (1971) put a whole computer's processor on one chip, with 2,300 transistors. Today's chips have tens of billions.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Microprocessor")]),
    282: (name: "Gore-Tex", formula: "(C2F4)n", state: Solid, molar_mass_g_mol: 100.014, description: "Bob Gore (1969) yanked a heated rod of PTFE in frustration and it stretched 800% into a porous membrane that lets vapour out and keeps rain off.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Gore-Tex")]),
    283: (name: "Platina", formula: "Pt(Pd,Rh,Ir,Os,Ru)", state: Solid, molar_mass_g_mol: 195.08, color_hex: "#b8bcc0", description: "Native platinum grains from the rivers of Colombia, which Spanish miners called platina, 'little silver', and threw back. It carries all six platinum-group metals.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Platinum#History")]),
    284: (name: "Zinc Blende", formula: "ZnS", state: Solid, molar_mass_g_mol: 97.44, color_hex: "#6a4a2a", description: "Zinc sulfide, the main ore of zinc. Reich and Richter (1863) found a brilliant indigo line in the spectrum of a Freiberg blende: indium.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sphalerite")]),
    285: (name: "Clove Oil", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, description: "Oil distilled from the dried flower buds of the clove tree, about 85% eugenol.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Clove")]),
    286: (name: "Wine", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#7a1830", description: "Fermented grape juice, about 12% alcohol. Distilled in the alembics of 12th-century Salerno it gave aqua vitae, the 'water of life'.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Wine")]),
    287: (name: "Lavender", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#9a80c8", description: "Lavandula flowers, steam-distilled since Roman bath-houses for an oil rich in linalool and linalyl acetate.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lavandula")]),
    288: (name: "Peppermint", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#3a9a50", description: "Mentha x piperita, a natural hybrid of watermint and spearmint, whose oil is about 40% menthol.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Peppermint")]),
    289: (name: "Spearmint", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#4aaa5a", description: "Mentha spicata. Its oil is mostly (R)-carvone; the mirror-image molecule smells of caraway instead.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Spearmint")]),
    290: (name: "Orange Peel", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f08020", description: "The rind of the sweet orange, whose oil glands burst with limonene when squeezed.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Orange_oil")]),
    291: (name: "Cinnamon Bark", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#a0582a", description: "The inner bark of Cinnamomum trees, once worth more than gold by weight; its warmth is cinnamaldehyde.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cinnamon")]),
    292: (name: "Rose Petals", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#d84868", description: "Damask rose petals: it takes about four tonnes of them to distil a kilogram of attar of roses.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Rose_oil")]),
    293: (name: "Pine Resin", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#d8a840", description: "The sticky sap that oozes from wounded pine bark. Distilled, it splits into turpentine and rosin.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Resin")]),
    294: (name: "Aniseed", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#a89060", description: "Seeds of Pimpinella anisum, flavour of ouzo, pastis and sambuca, all from anethole.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Anise")]),
    295: (name: "Thyme", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#6a8a50", description: "Thymus vulgaris; its oil's thymol was the antiseptic of 19th-century hospitals and is still in mouthwash.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Thyme")]),
    296: (name: "Jasmine Flowers", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f8f4e0", description: "Picked at night when their scent peaks; the absolute is rich in benzyl acetate.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Jasmine")]),
    297: (name: "Oak Galls", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#8a6a40", description: "Hard swellings that oaks grow around wasp larvae, packed with tannins. Crushed with green vitriol they made the black ink of a thousand years of manuscripts.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Oak_apple")]),
    298: (name: "Wine Lees", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#c8b0b0", description: "The crust that crystallises inside wine casks, mostly potassium bitartrate: cream of tartar.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_bitartrate")]),
    299: (name: "Lemon Juice", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#f0e040", description: "About 6% citric acid. The Royal Navy's lemon rations, from 1795, ended scurvy aboard its ships.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lemon")]),
    300: (formula: "H2SO4", state: Liquid, properties: [IsAcid]),
    301: (formula: "HCl", state: Liquid, properties: [IsAcid]),
    303: (formula: "MnO2", state: Solid, color_hex: "#3a3030", description: "Pyrolusite, a black mineral used since cave painting. Scheele heated it with hydrochloric acid in 1774 and discovered chlorine.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Manganese_dioxide")]),
    305: (formula: "SO2", state: Gas, references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sulfur_dioxide")]),
    306: (formula: "Na2SO4", state: Solid, description: "Glauber's 'sal mirabilis' (1625), made from salt and sulfuric acid. The Leblanc process turned it into soda ash; today it fills powdered detergents.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_sulfate")]),
    307: (formula: "CaS", state: Solid, description: "The foul-smelling waste of the Leblanc process ('galligu'), heaped in mountains around 19th-century alkali works.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Calcium_sulfide")]),
    308: (name: "Manganese(II) Chloride", formula: "MnCl2", state: Solid, color_hex: "#f2c8d8", description: "The pink salt left over after making chlorine from pyrolusite. Walter Weldon's 1866 process recycled it back to manganese dioxide.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Manganese(II)_chloride")]),
    309: (formula: "CaOCl2", state: Solid, references: [("Wikipedia", "https://en.wikipedia.org/wiki/Bleaching_powder")]),
    310: (name: "Portland Cement", formula: "Ca3SiO5", state: Solid, references: [("Wikipedia", "https://en.wikipedia.org/wiki/Portland_cement")]),
    311: (name: "Voltaic Pile", formula: "Zn|Cu", state: Solid, references: [("Wikipedia", "https://en.wikipedia.org/wiki/Voltaic_pile")]),
    312: (name: "Coal", formula: "C", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#181818", description: "Fossilised plant matter, mostly carbon. The fuel of the Industrial Revolution and the source of coke, coal gas and coal tar.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Coal")]),
    313: (name: "Coke", formula: "C", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#3a3a3a", description: "Coal baked to drive off its volatiles: nearly pure, strong, porous carbon. Abraham Darby used it in place of charcoal at Coalbrookdale in 1709, unchaining iron from the forests.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Coke_(fuel)")]),
    314: (name: "Coal Gas", formula: "H2+CH4+CO", state: Gas, molar_mass_g_mol: 16.043, description: "Town gas: hydrogen, methane and carbon monoxide distilled from coal. It lit the streets of 19th-century cities.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Coal_gas")]),
    316: (name: "Pig Iron", formula: "Fe(C)", state: Solid, molar_mass_g_mol: 55.845, properties: [IsMetal], color_hex: "#5a5e66", description: "Iron straight from the blast furnace, carrying about 4% carbon: hard, brittle, and cast in sand channels that looked like piglets suckling a sow.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Pig_iron")]),
    319: (name: "Phosphate Rock", formula: "Ca3(PO4)2", state: Solid, molar_mass_g_mol: 310.174, color_hex: "#d8c8a8", description: "Calcium phosphate, mined from ancient seabeds or burned from bones. Almost all the phosphorus in fertilizer starts here.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Phosphorite")]),
    320: (name: "Superphosphate", formula: "Ca(H2PO4)2", state: Solid, molar_mass_g_mol: 234.05, description: "John Bennet Lawes patented it in 1842: phosphate rock treated with sulfuric acid so plants can take up its phosphorus. The first manufactured fertilizer.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Superphosphate")]),
    321: (name: "Natural Rubber", formula: "(C5H8)n", state: Solid, molar_mass_g_mol: 68.119, properties: [IsPolymer], color_hex: "#c8a050", description: "Polyisoprene from the latex of the rubber tree. Sticky in summer and brittle in winter until Goodyear vulcanised it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Natural_rubber")]),
    322: (name: "Vulcanised Rubber", formula: "(C5H8)nS", state: Solid, molar_mass_g_mol: 100.179, properties: [IsPolymer], color_hex: "#2a2a2a", description: "Rubber cross-linked by sulfur bridges: elastic in heat and cold. Goodyear stumbled on it in 1839 by dropping rubber and sulfur on a hot stove.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Vulcanization")]),
    330: (formula: "Al2O3", state: Solid, description: "Aluminium oxide. Ruby and sapphire are alumina with traces of chromium and titanium; refined from bauxite, it is the feed of every aluminium smelter.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Aluminium_oxide")]),
    331: (formula: "NaOH", state: Solid, properties: [IsBase]),
    332: (formula: "HNO3", state: Liquid, properties: [IsAcid]),
    335: (formula: "mixture", state: Liquid, references: [("Wikipedia", "https://en.wikipedia.org/wiki/Coal_tar")]),
    336: (formula: "C6H6", state: Liquid),
    339: (formula: "C6H5NO2", state: Liquid, references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nitrobenzene")]),
    340: (formula: "C6H7N", state: Liquid, properties: [IsBase]),
    341: (formula: "C6H6O", state: Solid, properties: [IsAcid]),
    342: (formula: "CH2O", state: Gas, references: [("Wikipedia", "https://en.wikipedia.org/wiki/Formaldehyde")]),
    343: (formula: "(C7H6O)n", state: Solid),
    370: (formula: "C2H4", state: Gas, properties: [IsMonomer]),
    371: (formula: "(C2H4)n", state: Solid, properties: [IsPolymer], references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polyethylene")]),
    372: (formula: "C7H6O3", state: Solid, properties: [IsAcid], description: "The pain-relieving principle of willow bark, made from phenol and carbon dioxide by the Kolbe-Schmitt reaction. Too harsh on the stomach to swallow, it was tamed into aspirin.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Salicylic_acid")]),
    373: (formula: "C9H8O4", state: Solid, properties: [IsAcid]),
    374: (formula: "C6H10O4", state: Solid, properties: [IsAcid], description: "A six-carbon diacid, made by oxidising cyclohexane. Half of the nylon-6,6 molecule; most of the world's supply goes into nylon.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Adipic_acid")]),
    375: (formula: "C6H16N2", state: Liquid, properties: [IsBase], description: "A six-carbon chain with an amine at each end, the other half of nylon-6,6.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hexamethylenediamine")]),
    376: (name: "Nylon 6,6", formula: "(C12H22N2O2)n", state: Solid, properties: [IsPolymer]),
    388: (name: "Apple Juice", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#c8d040", description: "Sour with malic acid, named from the Latin malum, apple.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Apple")]),
    389: (name: "Amber", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#e8a020", description: "Fossilised tree resin. Georgius Agricola (1546) distilled it and collected 'salt of amber', succinic acid.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Amber")]),
    390: (name: "Red Ants", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#802018", description: "Wood ants spray formic acid in defence. John Ray distilled a mass of dead ants in 1671 and isolated it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Formica_rufa")]),
    391: (name: "Butter", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f8e080", description: "Mostly milk fat, whose short-chain acids (butyric, caproic) give rancid butter its smell.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Butter")]),
    392: (name: "Gelatin", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f0e0b0", description: "Boiled-down collagen from bones and skin. Henri Braconnot (1820) boiled it with sulfuric acid and got a sweet crystalline substance: glycine.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Gelatin")]),
    393: (name: "Cheese", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f0c850", description: "Concentrated milk protein, casein. Proust found leucine in it (1818); Liebig found tyrosine, from the Greek tyros, cheese (1846).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cheese")]),
    394: (name: "Asparagus Juice", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#78a048", description: "Vauquelin and Robiquet (1806) crystallised asparagine from it: the first amino acid ever isolated.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Asparagus")]),
    395: (name: "Willow Bark", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#8a7050", description: "Chewed for pain and fever since ancient Sumer and Egypt; Edward Stone reported its effect on agues to the Royal Society in 1763.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Willow#Medicinal_uses")]),
    396: (name: "Cinchona Bark", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#a0502a", description: "Jesuits' bark from the Andes, the only remedy for malaria for three centuries.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cinchona")]),
    397: (name: "Tea Leaves", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#4a6a30", description: "Camellia sinensis; about 3% caffeine by dry weight, more than coffee beans.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tea")]),
    398: (name: "Cocoa Beans", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#5a3020", description: "The seeds of Theobroma cacao, 'food of the gods'; their stimulant is theobromine.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cocoa_bean")]),
    399: (name: "Tobacco Leaves", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#8a6a30", description: "Nicotiana tabacum, named for Jean Nicot who sent it to the French court in 1560.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tobacco")]),
    400: (name: "Turmeric Root", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#e8a010", description: "The golden rhizome of Curcuma longa, a dye and spice for four thousand years.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Turmeric")]),
    401: (name: "Deadly Nightshade", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#3a2040", description: "Atropa belladonna: Venetian women dropped its juice in their eyes to dilate the pupils, hence 'beautiful lady'.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Atropa_belladonna")]),
    402: (name: "Foxglove Leaves", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#c060a0", description: "Digitalis purpurea. William Withering (1785) learned from a folk remedy that it treated dropsy, and described how to dose it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Digitalis")]),
    403: (name: "Tonka Beans", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#2a1a10", description: "Black, wrinkled seeds that smell of vanilla and new-mown hay: coumarin, isolated by Vogel in 1820.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tonka_bean")]),
    404: (name: "Bitter Almonds", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#d8c0a0", description: "Their oil, mostly benzaldehyde, led Liebig and Wohler (1832) to the benzoyl radical, a group of atoms that passes intact through reactions.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Bitter_almond")]),
    405: (name: "Gum Benzoin", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#c89060", description: "A balsamic resin from Styrax trees. Sublimed, it gives flowers of benzoin, benzoic acid (Nostradamus described it in 1556).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Benzoin_(resin)")]),
    406: (name: "Potato Starch", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f8f8f0", description: "Long chains of glucose. Konstantin Kirchhoff (1811) boiled starch with dilute acid and got glucose syrup.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Starch")]),
    407: (name: "Palm Oil", formula: "C51H98O6", state: Solid, molar_mass_g_mol: 807.339, color_hex: "#e86020", description: "Pressed from the fruit of the oil palm; rich in tripalmitin.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Palm_oil")]),
    408: (name: "Gadolinite", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#2a2a2a", description: "A black mineral from Ytterby, Sweden, a village that gave its name to four elements. Johan Gadolin found a new earth, yttria, in it in 1794.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Gadolinite")]),
    409: (name: "Cerite", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#a05050", description: "A reddish silicate from Bastnas, Sweden, in which Berzelius and Hisinger found ceria (1803), named for the new asteroid Ceres.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cerite")]),
    410: (name: "Samarskite", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#202020", description: "A black rare-earth mineral named for a Russian mine official, Colonel Samarsky: the first person to have an element (samarium) named after him, indirectly.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Samarskite")]),
    411: (name: "Beryl", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#60c0a0", description: "Beryllium aluminium silicate: emerald and aquamarine are beryl. Vauquelin found a new earth in it in 1798.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Beryl")]),
    412: (name: "Thorite", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#3a3020", description: "A thorium silicate from Norway in which Berzelius found thorium (1829), named for Thor.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Thorite")]),
    413: (name: "Lepidolite", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#b090c0", description: "A lilac lithium mica. Bunsen and Kirchhoff (1861) saw two new deep-red lines in its spectrum: rubidium, from rubidus, deep red.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lepidolite")]),
    414: (name: "Durkheim Mineral Water", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#90c0e0", description: "Bunsen evaporated 44,000 litres of it (1860) and found two blue spectral lines no known element made: caesium, from caesius, sky blue.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Caesium#History")]),
    415: (name: "Argyrodite", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#505058", description: "A silver germanium sulfide from Freiberg in which Clemens Winkler (1886) found germanium, the 'eka-silicon' Mendeleev had predicted.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Argyrodite")]),
    416: (name: "Vanadinite", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#d04020", description: "Bright red-orange lead vanadate crystals. Del Rio found vanadium in it in 1801, was talked out of it, and Sefstrom rediscovered it in 1830.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Vanadinite")]),
    417: (name: "Zircon", formula: "ZrSiO4", state: Solid, molar_mass_g_mol: 183.305, color_hex: "#c08040", description: "Zirconium silicate, among the oldest minerals on Earth (4.4 billion years). Klaproth found zirconia in it in 1789.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Zircon")]),
    418: (name: "Columbite", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#2a2a30", description: "An iron niobium-tantalum oxide. Hatchett found 'columbium' in a sample from Connecticut (1801); Ekeberg found tantalum in a similar ore (1802).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Columbite")]),
    419: (name: "Iron Gall Ink", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#101018", description: "Gallic acid and tannins with iron(II) sulfate: pale when written, darkening to permanent black as it oxidises in air. The Dead Sea Scrolls, Leonardo's notebooks and the US Constitution are written in it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Iron_gall_ink")]),
    420: (name: "Tartaric Acid", formula: "C4H6O6", state: Solid, molar_mass_g_mol: 150.086, properties: [IsAcid], description: "The acid of grapes. Scheele isolated it in 1769; Pasteur (1848) sorted its salt's crystals by hand with tweezers into left- and right-handed forms, discovering molecular chirality.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tartaric_acid")]),
    421: (name: "Benzoic Acid", formula: "C7H6O2", state: Solid, molar_mass_g_mol: 122.123, properties: [IsAcid], description: "The simplest aromatic acid, sublimed from gum benzoin since the 16th century. A food preservative (E210) and the acid of the benzoyl radical.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Benzoic_acid")]),
    422: (name: "Cinnamic Acid", formula: "C9H8O2", state: Solid, molar_mass_g_mol: 148.161, properties: [IsAcid], description: "The acid of cinnamon and storax, made by Perkin's reaction (1868) from benzaldehyde and acetic anhydride.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cinnamic_acid")]),
    423: (name: "Turpentine", formula: "C10H16", state: Liquid, molar_mass_g_mol: 136.238, description: "Spirit of turpentine, mostly pinenes: the painters' solvent and, in the 19th century, a remedy for almost everything.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Turpentine")]),
    424: (name: "Rosin", formula: "C20H30O2", state: Solid, molar_mass_g_mol: 302.458, color_hex: "#c87820", description: "Colophony, the glassy residue of distilled pine resin, mostly abietic acid. Violinists rub it on their bows.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Rosin")]),
    425: (name: "Salicin", formula: "C13H18O7", state: Solid, molar_mass_g_mol: 286.28, description: "The bitter glucoside of willow bark (Leroux, 1828). Raffaele Piria (1838) split it and oxidised the fragment to salicylic acid.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Salicin")]),
    426: (name: "Stearic Acid", formula: "C18H36O2", state: Solid, molar_mass_g_mol: 284.484, properties: [IsAcid], description: "Chevreul's 'stearin', the hard waxy acid of tallow. Stearin candles (1825) burned brighter and without the stink of tallow.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Stearic_acid")]),
    427: (name: "1-Butanol", formula: "C4H10O", state: Liquid, molar_mass_g_mol: 74.123, description: "Butyl alcohol. Chaim Weizmann's bacterial fermentation (1916) made acetone for British cordite and butanol as the by-product; his reward helped bring about the Balfour Declaration.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/1-Butanol")]),
    428: (name: "Salicylaldehyde", formula: "C7H6O2", state: Liquid, molar_mass_g_mol: 122.123, description: "2-Hydroxybenzaldehyde, the scent of meadowsweet. Reimer and Tiemann made it from phenol and chloroform (1876).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Salicylaldehyde")]),
    429: (name: "Oat Hulls", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, description: "The husks of oats, full of pentose sugars. Quaker Oats made furfural from them from 1921.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Furfural#Production")]),
    430: (name: "Alanine", formula: "C3H7NO2", state: Solid, molar_mass_g_mol: 89.094, description: "The simplest chiral amino acid. Adolph Strecker made it from acetaldehyde, ammonia and hydrogen cyanide in 1850: the first laboratory synthesis of an amino acid.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Alanine")]),
    431: (name: "Didymium", formula: "(Pr,Nd)(NO3)3", state: Solid, molar_mass_g_mol: 326.922, color_hex: "#b0a0c0", description: "Mosander's 'twin' of lanthanum (1841), accepted as an element for 44 years, until Carl Auer von Welsbach split it into praseodymium ('green twin') and neodymium ('new twin').", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Didymium")]),
    432: (name: "Erbia", formula: "Er2O3", state: Solid, molar_mass_g_mol: 382.517, color_hex: "#f0b0c0", description: "Mosander's rose-pink earth from yttria (1843), which itself hid holmium and thulium.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Erbium#History")]),
    433: (name: "Terbia", formula: "Tb4O7", state: Solid, molar_mass_g_mol: 747.713, color_hex: "#5a4030", description: "A dark earth Mosander separated from yttria (1843); Lecoq de Boisbaudran later pulled dysprosium ('hard to get at') out of it with 32 precipitations.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Terbium#History")]),
    434: (name: "Ytterbia", formula: "Yb2O3", state: Solid, molar_mass_g_mol: 394.097, description: "Marignac's earth (1878) from erbia, which Urbain (1907) showed still hid lutetium.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ytterbium#History")]),
    435: (name: "Samaria", formula: "Sm2O3", state: Solid, molar_mass_g_mol: 348.717, description: "Lecoq de Boisbaudran's earth from samarskite (1879), which held samarium, gadolinium and europium.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Samarium#History")]),
    436: (name: "Beryllium Chloride", formula: "BeCl2", state: Solid, molar_mass_g_mol: 79.912, description: "The salt Wohler and Bussy independently reduced with potassium in 1828 to isolate beryllium.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Beryllium_chloride")]),
    437: (name: "Thoria", formula: "ThO2", state: Solid, molar_mass_g_mol: 264.038, description: "Thorium dioxide, with the highest melting point of any oxide (3350 C). Glowing in a gas flame, it lit Victorian streets.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Thorium_dioxide")]),
    438: (name: "Welsbach Gas Mantle", formula: "ThO2(Ce)", state: Solid, molar_mass_g_mol: 264.038, color_hex: "#f8f8e8", description: "Auer von Welsbach's 1891 mantle: 99% thoria, 1% ceria, glowing brilliant white over a gas flame. It saved gas lighting from the electric bulb for decades.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Gas_mantle")]),
    439: (name: "Rubidium Chloride", formula: "RbCl", state: Solid, molar_mass_g_mol: 120.918, description: "The salt Bunsen and Kirchhoff concentrated from lepidolite (1861).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Rubidium_chloride")]),
    440: (name: "Caesium Chloride", formula: "CsCl", state: Solid, molar_mass_g_mol: 168.36, description: "Bunsen's 17 grams of caesium chloride from 44 tonnes of mineral water (1860). Its crystal structure is the textbook simple cubic lattice.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Caesium_chloride")]),
    441: (name: "Germanium Dioxide", formula: "GeO2", state: Solid, molar_mass_g_mol: 104.628, description: "The oxide Winkler reduced in 1886. Its measured properties matched Mendeleev's 1871 predictions for eka-silicon almost exactly.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Germanium_dioxide")]),
    442: (name: "Vanadium Pentoxide", formula: "V2O5", state: Solid, molar_mass_g_mol: 181.879, color_hex: "#e88020", description: "An orange oxide that has catalysed the Contact process for sulfuric acid since 1915.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Vanadium(V)_oxide")]),
    443: (name: "Zirconium Tetrachloride", formula: "ZrCl4", state: Solid, molar_mass_g_mol: 233.024, description: "The volatile chloride Kroll reduced with magnesium for nuclear-grade zirconium, transparent to neutrons.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Zirconium(IV)_chloride")]),
    444: (name: "Raw Silk", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f8f0e0", description: "Fibroin from silkworm cocoons, rich in glycine, alanine and serine (named from sericum, silk, by Cramer, 1865).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Silk")]),
    445: (name: "Horn Shavings", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#806040", description: "Keratin, the protein of horn, hair and hooves, cross-linked by the sulfur of cysteine.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Keratin")]),
    446: (name: "Lupin Seedlings", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#a0b060", description: "Ernst Schulze (1879-86) found phenylalanine and arginine in sprouting lupins.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lupinus")]),
    447: (name: "Kombu Seaweed", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#304020", description: "The kelp of Japanese dashi stock. Kikunae Ikeda (1908) traced its savoury taste to glutamate and named it umami.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Kombu")]),
    448: (name: "Malted Barley", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#c8a060", description: "Sprouted, dried barley. Payen and Persoz (1833) found the substance in it that turns starch into sugar, diastase: the first enzyme discovered.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Malt")]),
    449: (name: "Manna Ash Sap", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#e8e0c0", description: "The dried sweet sap of the Mediterranean manna ash, from which Proust crystallised mannitol (1806).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Fraxinus_ornus")]),
    450: (name: "Whey", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#e0e880", description: "The yellow-green liquid left after cheese-making; its colour is riboflavin, 'lactoflavin' (Kuhn, 1933).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Whey")]),
    451: (name: "Rice Bran", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#c0a070", description: "The outer layers polished off rice. Their loss caused beriberi, which led Funk to coin the word 'vitamine' (1912).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Rice_bran")]),
    452: (name: "Egg Yolk", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f0c020", description: "Kogl (1936) extracted a milligram of biotin from 250 kg of dried duck egg yolk.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Yolk")]),
    453: (name: "Spinach", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#2a6a20", description: "Folic acid was isolated from four tonnes of spinach leaves in 1941 (Latin folium, leaf).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Spinach")]),
    454: (name: "Cod Liver Oil", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#e8c040", description: "A Victorian cure for rickets long before anyone knew it was rich in vitamins A and D.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cod_liver_oil")]),
    455: (name: "Lanolin", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f0e0a0", description: "Wool grease, rich in sterols such as 7-dehydrocholesterol, which ultraviolet light turns into vitamin D3.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lanolin")]),
    456: (name: "Carrots", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f07010", description: "Wackenroder (1831) crystallised their orange pigment and named it carotene.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Carrot")]),
    457: (name: "Tomatoes", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#e02010", description: "Their red is lycopene, named by Schunck (1903).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tomato")]),
    458: (name: "Adrenal Glands", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#a04030", description: "Jokichi Takamine (1901) crystallised adrenaline from them, the first hormone isolated pure.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Adrenal_gland")]),
    459: (name: "Eucalyptus Leaves", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#5a8a70", description: "Their oil is up to 90% 1,8-cineole, the smell of cough drops.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Eucalyptus_oil")]),
    460: (name: "Lemongrass", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#a0c050", description: "Its oil is rich in citral, a lemon scent with no lemons.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cymbopogon")]),
    461: (name: "Cumin Seeds", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#906030", description: "Their warm, earthy smell is cuminaldehyde.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cumin")]),
    462: (name: "Tarragon", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#5a8040", description: "Its aniseed note is estragole, named for the plant's French name, estragon.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tarragon")]),
    463: (name: "Ginger Root", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#d0a050", description: "Cooking turns fresh ginger's pungent gingerol into sweeter zingerone.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ginger")]),
    464: (name: "Buckwheat", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#806040", description: "Rich in rutin, a flavonoid named for rue (Ruta), in which it was first found (1842).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Buckwheat")]),
    465: (name: "Crab Shells", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#d06040", description: "Chitin, the shell polymer of crustaceans and insects. Ledderhose (1876) hydrolysed it to glucosamine.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chitin")]),
    466: (name: "Shark Liver Oil", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#c0a060", description: "Mitsumaru Tsujimoto (1916) found it full of a hydrocarbon he named squalene, after the shark genus Squalus.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Squalene")]),
    467: (name: "Brewer's Yeast", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#d8c090", description: "Saccharomyces, rich in nucleic acid. Albrecht Kossel (1885-1901) took yeast and thymus nucleic acids apart into their bases. Nobel Prize, 1910.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nucleobase#History")]),
    468: (name: "Comfrey Root", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#405030", description: "Knitbone, a folk remedy for wounds, rich in allantoin.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Symphytum")]),
    469: (name: "Rowan Berries", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#e04010", description: "Mountain ash berries, from which A. W. Hofmann (1859) distilled parasorbic acid; boiled, it becomes sorbic acid, the preservative E200.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sorbus_aucuparia")]),
    470: (name: "Valerian Root", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#806040", description: "A sedative herb whose foot-sock smell is isovaleric acid.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Valerian_(herb)")]),
    471: (name: "Nutmeg Butter", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#a06030", description: "Pressed from nutmegs; Lyon Playfair (1841) found myristic acid in it, named for Myristica.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nutmeg")]),
    472: (name: "Linseed Oil", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#d8b040", description: "Pressed from flax seed. Its linoleic and linolenic acids soak up oxygen and set hard: the binder of oil paint since the 15th century.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Linseed_oil")]),
    473: (name: "Castor Beans", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#5a4030", description: "Seeds of Ricinus communis, pressed for castor oil. The press cake is toxic and must be treated.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Castor_oil_plant")]),
    474: (name: "Cork", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#c09060", description: "The bark of the cork oak. Brugnatelli (1787) oxidised it with nitric acid to suberic acid, from suber, cork.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cork_(material)")]),
    475: (name: "Castor Oil", formula: "C57H104O9", state: Liquid, molar_mass_g_mol: 933.45, description: "About 90% ricinolein, an unusual fatty acid with an OH group. A purgative, a lubricant for early aero engines (hence Castrol), and a feedstock for nylon 11.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Castor_oil")]),
    476: (name: "Linoxyn", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, description: "The tough, rubbery film linseed oil becomes as it oxidises: dried oil paint.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Drying_oil")]),
    477: (name: "Linoleum", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#b07040", description: "Frederick Walton's 1860 floor covering: linoxyn, cork dust and rosin on jute. He named it from linum (flax) and oleum (oil).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Linoleum")]),
    478: (name: "Nylon 6,10", formula: "(C16H30N2O2)n", state: Solid, molar_mass_g_mol: 282.428, properties: [IsPolymer], description: "Hexamethylenediamine and sebacic acid from castor oil: a nylon that absorbs less water, used for bristles. The 'nylon rope trick' demonstration makes it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nylon")]),
    479: (name: "Nylon 11", formula: "(C11H21NO)n", state: Solid, molar_mass_g_mol: 183.295, properties: [IsPolymer], description: "Rilsan (1955), the first bio-based nylon, made from castor oil via undecylenic acid.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nylon_11")]),
    480: (name: "Alkyd Resin", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, properties: [IsPolymer], description: "Glyptal (General Electric, 1927): glycerol and phthalic anhydride, the binder of most gloss paints.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Alkyd")]),
    481: (name: "Synthetic Polyisoprene", formula: "(C5H8)n", state: Solid, molar_mass_g_mol: 68.119, properties: [IsPolymer], description: "Goodrich (1954) polymerised isoprene with a Ziegler catalyst into a rubber chemically identical to the natural kind.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polyisoprene")]),
    482: (name: "Grapes", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#5a2a6a", description: "Vitis vinifera, domesticated in the Caucasus around 6000 BCE. The bloom on the skin is wild yeast: crush them and they ferment on their own.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Grape")]),
    483: (name: "Honey", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#e0a020", description: "Nectar concentrated by bees to about 80% sugar, mostly fructose and glucose. Honey hunters appear in Spanish cave paintings 8,000 years old.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Honey")]),
    484: (name: "Milk", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#f0ece0", description: "Cow, sheep and goat milk: water, fat, the protein casein and the sugar lactose. Dairying began in the Near East about 9,000 years ago.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Milk")]),
    485: (name: "Soybeans", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#d8c070", description: "Glycine max, domesticated in northern China about 7000 BCE: 40% protein and 20% oil.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Soybean")]),
    486: (name: "Aspergillus niger", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#2a2a2a", description: "The black mould of onions and damp walls. James Currie found in 1917 that it pours out citric acid; it still makes nearly all of the world's supply.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Aspergillus_niger")]),
    487: (name: "Streptomyces", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#b8a080", description: "Soil bacteria that grow like a fungus and give earth its smell (geosmin). They make two-thirds of all natural antibiotics.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Streptomyces")]),
    488: (name: "Corynebacterium glutamicum", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#d0c8a0", description: "A soil bacterium found by Kinoshita at Kyowa Hakko in 1956 that leaks glutamic acid; it now makes millions of tonnes of amino acids a year.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Corynebacterium_glutamicum")]),
    489: (name: "Escherichia coli", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#c8a8a0", description: "The gut bacterium Theodor Escherich described in 1885, and the workhorse of molecular biology: the first organism given a human gene to express (insulin, 1978).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Escherichia_coli")]),
    490: (name: "Beer", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#c88a20", description: "Sumerian beer was drunk through reed straws from a shared jar; the 'Hymn to Ninkasi' (c. 1800 BCE) is both a prayer and a recipe.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/History_of_beer")]),
    491: (name: "Mead", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#e0b040", description: "Honey wine, perhaps the oldest fermented drink: residues in Jiahu, China (7000 BCE) mix honey, rice and fruit.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Mead")]),
    492: (name: "Yogurt", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f4f0e8", description: "Milk soured and thickened by lactic acid bacteria. Metchnikoff credited Bulgarian yogurt for long lives (1907) and made it fashionable in Europe.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Yogurt")]),
    493: (name: "Han Purple", formula: "BaCuSi2O6", state: Solid, molar_mass_g_mol: 353.04, color_hex: "#6a4aa0", description: "Barium copper silicate, made in China from about 800 BCE and painted on the Terracotta Army. It glows in near-infrared light.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Han_purple_and_Han_blue")]),
    494: (name: "Naples Yellow", formula: "Pb2Sb2O7", state: Solid, molar_mass_g_mol: 769.913, color_hex: "#f0c850", description: "Lead antimonate, an opaque yellow used in Egyptian and Babylonian glass and glazes long before it was a painter's colour.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Naples_yellow")]),
    495: (name: "Lead Crystal", formula: "mixture", state: Solid, molar_mass_g_mol: 283.282, color_hex: "#e8f0f8", description: "George Ravenscroft's glass (1674): lead oxide in place of lime makes it heavy, soft to cut and brilliant, with a high refractive index.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lead_glass")]),
    496: (name: "Gold Ruby Glass", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#c02040", description: "Glass coloured red by gold nanoparticles. Johann Kunckel made it in Potsdam around 1679; Faraday worked out in 1857 that the gold was finely divided metal.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cranberry_glass")]),
    497: (name: "Smalt", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#3050b0", description: "Potash glass coloured blue with cobalt and ground to a powder: the cheap blue of 16th-century painters and of Delftware.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Smalt")]),
    498: (name: "Tin(IV) Chloride", formula: "SnCl4", state: Liquid, molar_mass_g_mol: 260.51, color_hex: "#e8e8e0", description: "Spiritus fumans Libavii: Andreas Libavius made this fuming liquid in 1605 by distilling tin with corrosive sublimate. It fumes because air's moisture hydrolyses it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tin(IV)_chloride")]),
    499: (name: "Antimony Trichloride", formula: "SbCl3", state: Solid, molar_mass_g_mol: 228.11, color_hex: "#f0f0e0", description: "Butter of antimony, a soft, fuming, buttery solid known to the alchemists; Glauber made it from stibnite and sea salt.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Antimony_trichloride")]),
    500: (name: "Mullite", formula: "Al6Si2O13", state: Solid, molar_mass_g_mol: 426.049, color_hex: "#f4f0ec", description: "The needle-shaped aluminium silicate that forms when clay is fired above 1,100 C; its interlocking crystals make porcelain hard and translucent.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Mullite")]),
    501: (name: "Dry Ice", formula: "CO2", state: Solid, molar_mass_g_mol: 44.009, color_hex: "#e8f4ff", description: "Solid carbon dioxide at -78.5 C. It sublimes straight to gas without melting, hence 'dry'. Adrien-Jean-Pierre Thilorier first made it in 1835.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Dry_ice")]),
    502: (name: "Liquid Ammonia", formula: "NH3", state: Liquid, molar_mass_g_mol: 17.031, color_hex: "#e0f0ff", description: "Ammonia boils at -33 C. Liquefied, it was the working fluid of the first refrigerators (Linde, 1876) and dissolves sodium into a deep blue solution of free electrons.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ammonia#Liquid_ammonia")]),
    503: (name: "Cobalt Blue", formula: "CoAl2O4", state: Solid, molar_mass_g_mol: 176.893, color_hex: "#0047ab", description: "Cobalt aluminate, invented by Louis Jacques Thenard in 1802 for the Sevres porcelain works at the request of the French government.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cobalt_blue")]),
    504: (name: "Synthetic Ultramarine", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#1f3fa8", description: "Lapis lazuli's blue, once dearer than gold. In 1824 the Societe d'Encouragement offered 6,000 francs for a synthesis; Jean-Baptiste Guimet won it in 1828.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ultramarine#Synthetic_ultramarine")]),
    505: (name: "Uranium Glass", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#b8e830", description: "Glass with a little uranium oxide, yellow-green by day and glowing green under ultraviolet. Josef Riedel made it in Bohemia in the 1830s.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Uranium_glass")]),
    506: (name: "Benzoin", formula: "C14H12O2", state: Solid, molar_mass_g_mol: 212.248, description: "Two benzaldehyde molecules joined head to tail; it has nothing to do with gum benzoin except that both smell faintly of almonds.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Benzoin_(organic_compound)")]),
    507: (name: "Benzilic Acid", formula: "C14H12O3", state: Solid, molar_mass_g_mol: 228.247, description: "Liebig's 1838 rearrangement product of benzil with potash: the first rearrangement reaction ever described.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Benzilic_acid")]),
    508: (name: "Zeise's Salt", formula: "KPtCl3C2H4", state: Solid, molar_mass_g_mol: 368.582, color_hex: "#f0d040", description: "K[PtCl3(C2H4)]: William Zeise's yellow salt (Copenhagen, 1827), the first organometallic compound. How ethylene could bind to platinum was a puzzle for 120 years.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Zeise%27s_salt")]),
    509: (name: "Potassium Manganate", formula: "K2MnO4", state: Solid, molar_mass_g_mol: 197.13, color_hex: "#2a7a3a", description: "Glauber's 'mineral chameleon' (1659): its green solution turns violet, then brown, as it changes to permanganate and manganese dioxide.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_manganate")]),
    510: (name: "Dynamo", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#b87333", description: "Werner von Siemens' self-exciting dynamo (1866) turned mechanical work into current with no battery at all, and made electricity cheap enough to smelt with.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Dynamo")]),
    511: (name: "Ferromanganese", formula: "FeMn", state: Solid, molar_mass_g_mol: 110.783, properties: [IsMetal], color_hex: "#8a8a90", description: "An iron alloy with up to 80% manganese. Robert Mushet's 1856 discovery that it 'cures' Bessemer steel of its brittleness saved the process.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ferromanganese")]),
    512: (name: "Calcium Aluminate Cement", formula: "CaAl2O4", state: Solid, molar_mass_g_mol: 158.038, color_hex: "#5a5a58", description: "Jules Bied's Ciment Fondu (Lafarge, 1908): sets in hours rather than weeks and shrugs off sulfate water and fire.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Calcium_aluminate_cements")]),
    513: (name: "Copper(I) Sulfide", formula: "Cu2S", state: Solid, molar_mass_g_mol: 159.152, color_hex: "#3a3a40", description: "Chalcocite, the copper-rich sulfide of matte: smelters concentrate copper ore into this before blowing it to metal.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Copper(I)_sulfide")]),
    514: (name: "Iron(II) Oxide", formula: "FeO", state: Solid, molar_mass_g_mol: 71.844, color_hex: "#2a2a2a", description: "Wustite, the black oxide that sits between iron and magnetite; in a smelter it is slagged off with silica.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Iron(II)_oxide")]),
    515: (name: "Tungsten Carbide", formula: "WC", state: Solid, molar_mass_g_mol: 195.851, color_hex: "#6a6a72", description: "Twice as stiff as steel and nearly as hard as diamond. Henri Moissan made it in his arc furnace in 1896; drill bits and cutting tools have used it since the 1920s.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tungsten_carbide")]),
    516: (name: "Titanium Carbide", formula: "TiC", state: Solid, molar_mass_g_mol: 59.878, color_hex: "#7a7a80", description: "A hard, refractory carbide melting at 3,160 C, alloyed into cermets for cutting tools and the heat shields of re-entering spacecraft.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Titanium_carbide")]),
    517: (name: "Tantalum Carbide", formula: "TaC", state: Solid, molar_mass_g_mol: 192.961, color_hex: "#a08040", description: "One of the highest-melting substances known, about 3,880 C; a golden-brown ceramic.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tantalum_carbide")]),
    518: (name: "Niobium Carbide", formula: "NbC", state: Solid, molar_mass_g_mol: 104.917, color_hex: "#8a80a0", description: "A lavender-grey refractory carbide added to steels and cemented carbides as a grain refiner.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Niobium_carbide")]),
    519: (name: "Molybdenum Carbide", formula: "Mo2C", state: Solid, molar_mass_g_mol: 203.911, color_hex: "#707078", description: "A hard carbide that behaves curiously like platinum as a catalyst for hydrogen reactions.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Molybdenum_carbide")]),
    520: (name: "Chromium Carbide", formula: "Cr3C2", state: Solid, molar_mass_g_mol: 180.01, color_hex: "#808088", description: "Sprayed onto turbine parts and valves as a hard coating that resists wear and corrosion at high temperature.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chromium(II)_carbide")]),
    521: (name: "Aluminium Carbide", formula: "Al4C3", state: Solid, molar_mass_g_mol: 143.961, color_hex: "#e0d080", description: "Pale yellow crystals that Moissan made in the arc furnace; with water they give off methane, an odd source of natural gas in a test tube.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Aluminium_carbide")]),
    522: (name: "Beryllium Carbide", formula: "Be2C", state: Solid, molar_mass_g_mol: 30.035, color_hex: "#b05030", description: "A brick-red, very hard carbide that also releases methane with water.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Beryllium_carbide")]),
    523: (name: "Calcium Hexaboride", formula: "CaB6", state: Solid, molar_mass_g_mol: 104.938, color_hex: "#303038", description: "A black, lustrous boride of cages of boron atoms, made by Moissan; used to deoxidise copper.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Calcium_hexaboride")]),
    524: (name: "Titanium Diboride", formula: "TiB2", state: Solid, molar_mass_g_mol: 69.487, color_hex: "#606878", description: "Extremely hard and yet electrically conducting, so it can be shaped by spark machining; it lines aluminium smelting cells.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Titanium_diboride")]),
    525: (name: "Calcium Silicide", formula: "CaSi2", state: Solid, molar_mass_g_mol: 96.248, color_hex: "#8890a0", description: "Calcium silicon alloy used to deoxidise steel; it also heats self-heating food cans.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Calcium_silicide")]),
    526: (name: "Ferrosilicon", formula: "FeSi", state: Solid, molar_mass_g_mol: 83.93, properties: [IsMetal], color_hex: "#8a9098", description: "Iron-silicon alloy, the steelmaker's deoxidiser and the reducing agent of the Pidgeon magnesium process; in WWII it filled hydrogen generators for barrage balloons.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ferrosilicon")]),
    527: (name: "Ferrochrome", formula: "FeCr2", state: Solid, molar_mass_g_mol: 159.837, properties: [IsMetal], color_hex: "#9098a0", description: "Iron with 50-70% chromium, smelted straight from chromite; four-fifths of it goes into stainless steel.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ferrochrome")]),
    528: (name: "Ferrovanadium", formula: "FeV", state: Solid, molar_mass_g_mol: 106.787, properties: [IsMetal], color_hex: "#90a0a8", description: "The vanadium alloy that makes tough, springy steels; Henry Ford built the Model T's chassis from vanadium steel.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ferrovanadium")]),
    529: (name: "Fused Alumina", formula: "Al2O3", state: Solid, molar_mass_g_mol: 101.961, color_hex: "#c8b8a8", description: "Alumina melted in the arc furnace and recrystallised as corundum: Norton's 'Alundum' (1900), the grit of grinding wheels and sandpaper.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Fused_alumina")]),
    530: (name: "Peroxydisulfuric Acid", formula: "H2S2O8", state: Solid, molar_mass_g_mol: 194.128, description: "Marshall's acid (1891), made at a platinum anode from cold sulfuric acid. It was the industrial source of hydrogen peroxide from 1908.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Peroxydisulfuric_acid")]),
    531: (name: "Potassium Permanganate", formula: "KMnO4", state: Solid, molar_mass_g_mol: 158.032, color_hex: "#7a1a8a", description: "Deep purple crystals, a strong oxidiser. Henry Condy sold it as a disinfectant ('Condy's crystals', 1857); it treats water and was the flash in early photography.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_permanganate")]),
    532: (name: "Benzenediazonium Chloride", formula: "C6H5N2Cl", state: Aqueous, molar_mass_g_mol: 140.57, description: "Peter Griess's diazonium salt (1858): stable only near 0 C, it couples with phenols and amines into the whole family of azo dyes.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Benzenediazonium_chloride")]),
    533: (name: "4-Hydroxyazobenzene", formula: "C12H10N2O", state: Solid, molar_mass_g_mol: 198.225, color_hex: "#f09020", description: "Orange-yellow dye from diazonium and phenol: the simplest azo coupling, the chemistry behind most synthetic dyes and food colours.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Azo_coupling")]),
    534: (name: "Methyl Orange", formula: "C14H14N3NaO3S", state: Solid, molar_mass_g_mol: 327.334, color_hex: "#f07020", description: "The indicator that is red below pH 3.1 and yellow above 4.4; made by coupling diazotised sulfanilic acid onto dimethylaniline.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Methyl_orange")]),
    535: (name: "Iodobenzene", formula: "C6H5I", state: Liquid, molar_mass_g_mol: 204.006, description: "A dense oily liquid; the iodine makes it the favourite partner in modern palladium cross-couplings.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Iodobenzene")]),
    536: (name: "Dibenzalacetone", formula: "C17H14O", state: Solid, molar_mass_g_mol: 234.298, color_hex: "#f0e060", description: "Yellow crystals from a double aldol condensation (Claisen and Schmidt, 1881); an ingredient of some sunscreens and the ligand of a famous palladium catalyst.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Dibenzylideneacetone")]),
    537: (name: "Chalcone", formula: "C15H12O", state: Solid, molar_mass_g_mol: 208.26, color_hex: "#f0e080", description: "The aromatic ketone at the root of the flavonoids, the pigments of flowers and fruit.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chalcone")]),
    538: (name: "Phenolphthalein", formula: "C20H14O4", state: Solid, molar_mass_g_mol: 318.328, description: "Adolf von Baeyer's 1871 indicator: colourless in acid, pink above pH 8.2. For a century it was also the active ingredient of laxatives.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Phenolphthalein")]),
    539: (name: "Benzene-1,3-disulfonic Acid", formula: "C6H6O6S2", state: Solid, molar_mass_g_mol: 238.228, description: "Benzene sulfonated twice; fused with caustic soda it gives resorcinol.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Resorcinol#Production")]),
    540: (name: "Eosin Y", formula: "C20H8Br4O5", state: Solid, molar_mass_g_mol: 647.895, color_hex: "#f04080", description: "Fluorescein brominated four times (Heinrich Caro, 1874): the pink of red ink and the counterstain of every hospital's tissue slides.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Eosin")]),
    541: (name: "2-Diethylaminoethanol", formula: "C6H15NO", state: Liquid, molar_mass_g_mol: 117.192, description: "An amino alcohol from diethylamine and ethylene oxide, the half of procaine that makes it soluble.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Diethylethanolamine")]),
    542: (name: "Hexamminecobalt(III) Chloride", formula: "Co(NH3)6Cl3", state: Solid, molar_mass_g_mol: 267.469, color_hex: "#e07020", description: "Orange crystals whose structure Alfred Werner explained in 1893 with six ammonias around one cobalt: the founding idea of coordination chemistry (Nobel, 1913).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hexamminecobalt(III)_chloride")]),
    543: (name: "Schweizer's Reagent", formula: "Cu(NH3)4(OH)2", state: Aqueous, molar_mass_g_mol: 165.684, color_hex: "#1830c0", description: "Deep blue tetraamminecopper hydroxide (Matthias Schweizer, 1857), the one common solvent that dissolves cellulose; it made 'Bemberg' cuprammonium rayon.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Schweizer%27s_reagent")]),
    544: (name: "Dry Cell", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#8a8a8a", description: "Leclanche's zinc-carbon cell (1866), made 'dry' by Carl Gassner in 1886 with a paste of ammonium chloride: the first battery you could carry.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Zinc%E2%80%93carbon_battery")]),
    545: (name: "Nickel-Cadmium Cell", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#6a7a6a", description: "Waldemar Jungner's rechargeable cell (1899): nickel oxyhydroxide against cadmium in potash, reliable for a century of power tools and satellites.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nickel%E2%80%93cadmium_battery")]),
    546: (name: "o-Xylene", formula: "C8H10", state: Liquid, molar_mass_g_mol: 106.168, description: "The ortho isomer of xylene, cut from coal tar and reformate; nearly all of it is oxidised to phthalic anhydride for plasticisers.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/O-Xylene")]),
    547: (name: "Triple Superphosphate", formula: "Ca(H2PO4)2", state: Solid, molar_mass_g_mol: 234.05, color_hex: "#d8d0c0", description: "Phosphate rock treated with phosphoric acid instead of sulfuric: nearly three times the phosphorus of ordinary superphosphate.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Superphosphate#Triple_superphosphate")]),
    548: (name: "Kraft Pulp", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#a87848", description: "Carl Dahl's sulfate pulp (Danzig, 1879): the strong brown fibre of paper bags and cardboard. 'Kraft' is German for strength.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Kraft_process")]),
    549: (name: "Lignin", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#5a3a1a", description: "The aromatic glue that stiffens wood, a third of its weight. The kraft process dissolves it into black liquor, which the mill burns for power.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lignin")]),
    550: (name: "Calcium Silicate", formula: "CaSiO3", state: Solid, molar_mass_g_mol: 116.16, color_hex: "#f0f0ec", description: "Wollastonite, the binder of autoclaved sand-lime bricks (Michaelis, 1880) and a filler in ceramics and plastics.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Wollastonite")]),
    551: (name: "Lubricating Oil", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#a07020", description: "The heavy, viscous cut of crude oil, distilled under vacuum so it does not crack; it ended the age of whale oil for machinery.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Motor_oil")]),
    552: (name: "Paraffin Wax", formula: "C25H52", state: Solid, molar_mass_g_mol: 352.691, color_hex: "#f8f4e8", description: "James Young's paraffin (1850) and the wax of candles, crayons and cheese rinds: long straight-chain alkanes.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Paraffin_wax")]),
    553: (name: "Liquid Nitrogen", formula: "N2", state: Liquid, molar_mass_g_mol: 28.014, color_hex: "#e8f0ff", description: "Boils at -196 C. Wroblewski and Olszewski first held it in a test tube at Krakow in 1883.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Liquid_nitrogen")]),
    554: (name: "Liquid Oxygen", formula: "O2", state: Liquid, molar_mass_g_mol: 31.998, color_hex: "#a8c8ff", description: "Pale blue and attracted to a magnet, boiling at -183 C; the oxidiser of almost every liquid-fuelled rocket since Goddard.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Liquid_oxygen")]),
    555: (name: "Dextran", formula: "(C6H10O5)n", state: Solid, molar_mass_g_mol: 162.141, properties: [IsPolymer], description: "A glucose polymer slimed out by Leuconostoc bacteria in sugar refineries; Swedish chemists made it the first blood-plasma substitute (1947).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Dextran")]),
    556: (name: "Vitamin B12", formula: "C63H88CoN14O14P", state: Solid, molar_mass_g_mol: 1355.388, color_hex: "#c02030", description: "Cyanocobalamin, the only vitamin built around a metal atom. Dorothy Hodgkin solved its structure by X-ray crystallography in 1956; bacteria are its only makers.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Vitamin_B12")]),
    557: (name: "6-Aminopenicillanic Acid", formula: "C8H12N2O3S", state: Solid, molar_mass_g_mol: 216.255, description: "The bare penicillin core, isolated by Beecham's scientists in 1957: hang any side chain on it and you have a new penicillin.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/6-APA")]),
    558: (name: "Phenylglycine", formula: "C8H9NO2", state: Solid, molar_mass_g_mol: 151.165, description: "An amino acid not found in proteins, made by the Strecker synthesis from benzaldehyde; the side chain of ampicillin.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Phenylglycine")]),
    559: (name: "1,4-Butanediol", formula: "C4H10O2", state: Liquid, molar_mass_g_mol: 90.122, description: "A four-carbon diol from Reppe's acetylene chemistry; it becomes spandex, PBT plastic and the solvent THF.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/1,4-Butanediol")]),
    560: (name: "Cultured Quartz", formula: "SiO2", state: Solid, molar_mass_g_mol: 60.083, color_hex: "#f4f8ff", description: "Single quartz crystals grown from hot alkaline water in steel autoclaves; Bell Labs' process (1950s) freed radio and clock makers from Brazilian mines.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hydrothermal_synthesis#Synthetic_quartz")]),
    561: (name: "Zeolite A", formula: "mixture", state: Solid, molar_mass_g_mol: 142.053, color_hex: "#f8f8f4", description: "Robert Milton's synthetic zeolite (Union Carbide, 1949): a cage of aluminosilicate that swaps sodium for calcium, so it softens water and replaced phosphate in detergents.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Zeolite#Synthetic")]),
    562: (name: "Heavy Water", formula: "D2O", state: Liquid, molar_mass_g_mol: 18.015, color_hex: "#d0e8ff", description: "Water whose hydrogen is deuterium, 11% denser. Norsk Hydro at Vemork concentrated it from 1934; Canada's CANDU reactors use it to run on unenriched uranium.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Heavy_water")]),
    563: (name: "Liquefied Natural Gas", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#e0f0ff", description: "Natural gas chilled to -162 C shrinks 600-fold; the Methane Pioneer carried the first cargo across the Atlantic in 1959.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Liquefied_natural_gas")]),
    564: (name: "Superfluid Helium", formula: "He", state: Liquid, molar_mass_g_mol: 4.003, color_hex: "#f0f8ff", description: "Below 2.17 K liquid helium-4 flows with no viscosity at all and climbs out of its beaker: Kapitza, Allen and Misener, 1937.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Superfluid_helium-4")]),
    565: (name: "Enriched Uranium Hexafluoride", formula: "UF6", state: Solid, molar_mass_g_mol: 352.018, properties: [IsRadioactive], description: "UF6 with its uranium-235 raised from 0.7% to a few percent. Oak Ridge's K-25 plant, a mile-long building, pumped it through porous barriers 3,000 times.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Enriched_uranium")]),
    566: (name: "Enriched Uranium", formula: "U", state: Solid, molar_mass_g_mol: 238.03, properties: [IsMetal, IsRadioactive], description: "Uranium fuel rich in the fissile isotope 235; a few kilograms hold the energy of thousands of tonnes of coal.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Enriched_uranium")]),
    567: (name: "Cobalt-60", formula: "Co", state: Solid, molar_mass_g_mol: 58.933, properties: [IsMetal, IsRadioactive], description: "Gamma-emitting cobalt (half-life 5.3 years) made in reactors. The first cobalt-60 cancer treatments were given in Canada, at Saskatoon and London, Ontario, in 1951.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cobalt-60")]),
    568: (name: "Molybdenum-99", formula: "Mo", state: Solid, molar_mass_g_mol: 95.95, properties: [IsMetal, IsRadioactive], description: "A fission product (half-life 66 hours) that decays to technetium-99m, the tracer of 40 million medical scans a year; Chalk River's NRU reactor once made a third of it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Molybdenum-99")]),
    569: (name: "Iodine-131", formula: "I2", state: Solid, molar_mass_g_mol: 253.8, properties: [IsRadioactive], description: "A fission product (half-life 8 days) that the thyroid concentrates, so it both treats thyroid cancer and is the main hazard of reactor accidents.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Iodine-131")]),
    570: (name: "Strontium-90", formula: "Sr", state: Solid, molar_mass_g_mol: 87.62, properties: [IsMetal, IsRadioactive], description: "A fission product (half-life 29 years) that the body files as calcium in bone; its rise in children's teeth helped end atmospheric bomb tests (1963).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Strontium-90")]),
    571: (name: "Caesium-137", formula: "Cs", state: Solid, molar_mass_g_mol: 132.91, properties: [IsMetal, IsRadioactive], description: "A fission product (half-life 30 years), the long-lived contamination of Chernobyl and Fukushima, and a calibration source for radiation meters.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Caesium-137")]),
    572: (name: "Tritium", formula: "H2", state: Gas, molar_mass_g_mol: 2.016, properties: [IsRadioactive], description: "Hydrogen-3 (half-life 12.3 years), bred from lithium-6 in reactors; it lights exit signs and watch dials and fuels fusion experiments.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tritium")]),
    573: (name: "Carbon-14", formula: "C", state: Solid, molar_mass_g_mol: 12.011, properties: [IsRadioactive], description: "Made from nitrogen by neutrons, in the upper air and in reactors; Willard Libby used its 5,730-year half-life to date the past (1949).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Carbon-14")]),
    574: (name: "Plutonium-238", formula: "Pu", state: Solid, molar_mass_g_mol: 244.0, properties: [IsMetal, IsRadioactive], description: "Glows red with its own heat (half-life 88 years): the fuel of the radioisotope generators powering Voyager, Cassini and Perseverance.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Plutonium-238")]),
    575: (name: "Uranium-233", formula: "U", state: Solid, molar_mass_g_mol: 238.03, properties: [IsMetal, IsRadioactive], description: "Fissile uranium bred from thorium-232, the fuel of the thorium cycle tested at Oak Ridge's Molten-Salt Reactor (1965-69).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Uranium-233")]),
    576: (name: "Iridium-192", formula: "Ir", state: Solid, molar_mass_g_mol: 192.22, properties: [IsMetal, IsRadioactive], description: "A gamma source (half-life 74 days) used to radiograph welds in pipelines and to treat cancers from inside (brachytherapy).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Iridium-192")]),
    577: (name: "Technetium-99m", formula: "Tc", state: Solid, molar_mass_g_mol: 98.0, properties: [IsMetal, IsRadioactive], description: "Metastable technetium (half-life 6 hours) milked from a molybdenum generator at the hospital (Brookhaven, 1958): the most used medical isotope.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Technetium-99m")]),
    578: (name: "Sodium-24", formula: "Na", state: Solid, molar_mass_g_mol: 22.99, properties: [IsMetal, IsRadioactive], description: "Ernest Lawrence's cyclotron made 'radio-sodium' in 1934, and his brother John used it in some of the first radiotracer medicine.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Isotopes_of_sodium#Sodium-24")]),
    579: (name: "Germanium Crystal", formula: "Ge", state: Solid, molar_mass_g_mol: 72.63, description: "Gordon Teal and John Little pulled single crystals of germanium at Bell Labs in 1948; transistors made from them worked far better than from polycrystals.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Czochralski_method#History")]),
    580: (name: "Gallium Arsenide", formula: "GaAs", state: Solid, molar_mass_g_mol: 144.645, color_hex: "#4a4a58", description: "A semiconductor whose electrons move six times faster than in silicon and which emits light: lasers, LEDs, mobile-phone amplifiers and space solar cells.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Gallium_arsenide")]),
    581: (name: "Synthetic Sapphire", formula: "Al2O3", state: Solid, molar_mass_g_mol: 101.961, color_hex: "#d8e8f8", description: "Single-crystal alumina grown from the melt by Kyropoulos's method (1926): watch glasses, scanner windows and the substrate of blue LEDs.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sapphire#Synthetic_sapphire")]),
    582: (name: "Nd:YAG Crystal", formula: "Y3Al5O12", state: Solid, molar_mass_g_mol: 593.616, color_hex: "#e0b0e0", description: "Yttrium aluminium garnet doped with neodymium (Geusic, Bell Labs, 1964): the infrared laser of surgery, tattoo removal and range-finders.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nd:YAG_laser")]),
    583: (name: "Lithium Niobate", formula: "LiNbO3", state: Solid, molar_mass_g_mol: 147.843, color_hex: "#f0f0f8", description: "A crystal that squeezes out voltage when pressed and bends light under voltage: the modulators of fibre-optic networks and green laser pointers.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lithium_niobate")]),
    584: (name: "Oxidised Wafer", formula: "SiO2", state: Solid, molar_mass_g_mol: 60.083, description: "Mohamed Atalla found in 1957 that a thin thermal oxide 'passivates' silicon's surface so electrons stop getting trapped there: the trick behind every chip.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Surface_passivation")]),
    585: (name: "MOSFET", formula: "mixture", state: Solid, molar_mass_g_mol: 28.085, description: "Atalla and Dawon Kahng's metal-oxide-semiconductor field-effect transistor (1959), the most manufactured device in history, over 10^22 so far.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/MOSFET")]),
    586: (name: "Laser Diode", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, description: "Robert Hall's GaAs diode laser (GE, 1962); heterostructures of AlGaAs (Alferov, Kroemer, Nobel 2000) made it work at room temperature, and then in every CD player.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Laser_diode")]),
    587: (name: "Cubic Boron Nitride", formula: "BN", state: Solid, molar_mass_g_mol: 24.817, color_hex: "#c8a060", description: "Borazon (Robert Wentorf, GE, 1957), second only to diamond in hardness and stable in air to 1,300 C, so it grinds the hardened steels that dissolve diamond.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Boron_nitride#Cubic_boron_nitride")]),
    588: (name: "Coesite", formula: "SiO2", state: Solid, molar_mass_g_mol: 60.083, color_hex: "#f0f0f0", description: "A dense form of silica Loring Coes made at 35,000 atmospheres in 1953; found in nature in 1960 at Meteor Crater, it became the fingerprint of an impact.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Coesite")]),
    589: (name: "Stishovite", formula: "SiO2", state: Solid, molar_mass_g_mol: 60.083, color_hex: "#f8f8f8", description: "Silica with silicon six-coordinated like in rutile, made by Sergei Stishov at 100,000 atmospheres (1961): the densest silica.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Stishovite")]),
    590: (name: "Black Phosphorus", formula: "P", state: Solid, molar_mass_g_mol: 30.974, color_hex: "#2a2a30", description: "Percy Bridgman squeezed white phosphorus to 12,000 atmospheres in 1914 and got a flaky black solid like graphite; peeled to one layer it is phosphorene.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Allotropes_of_phosphorus#Black_phosphorus")]),
    591: (name: "Cemented Carbide", formula: "WC-Co", state: Solid, molar_mass_g_mol: 254.784, color_hex: "#5a5a62", description: "Tungsten carbide grains sintered in cobalt (Krupp's Widia, 1926; GE's Carboloy, 1928): 'wie Diamant'. It made the anvils of the diamond press.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cemented_carbide")]),
    592: (name: "Lithium Nitride", formula: "Li3N", state: Solid, molar_mass_g_mol: 34.827, color_hex: "#a03050", description: "Lithium is the only metal that burns in nitrogen at room temperature; the red-purple nitride is the flux of cubic boron nitride synthesis.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lithium_nitride")]),
    593: (name: "Lithium Aluminium Hydride", formula: "LiAlH4", state: Solid, molar_mass_g_mol: 37.954, description: "Finholt, Bond and Schlesinger's hydride (1947), the reagent that reduces almost any carbonyl group to an alcohol; it ignites with water.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lithium_aluminium_hydride")]),
    594: (name: "Sodium Borohydride", formula: "NaBH4", state: Solid, molar_mass_g_mol: 37.832, description: "H. C. Brown's gentle reducing agent (1942, with Schlesinger, while looking for volatile uranium compounds for the bomb): it reduces aldehydes and ketones even in water.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_borohydride")]),
    595: (name: "Ferrocene", formula: "Fe(C5H5)2", state: Solid, molar_mass_g_mol: 186.035, color_hex: "#e07020", description: "An iron atom sandwiched between two cyclopentadienyl rings (Kealy and Pauson, 1951). Wilkinson and Fischer, who worked out sandwich compounds, shared the 1973 Nobel.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ferrocene")]),
    596: (name: "Ruby Laser", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#e02040", description: "Theodore Maiman's ruby rod in a coiled flash lamp (Hughes, 16 May 1960) gave the first laser light, deep red at 694 nm.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ruby_laser")]),
    597: (name: "Platinum Hexafluoride", formula: "PtF6", state: Gas, molar_mass_g_mol: 309.068, color_hex: "#a01818", description: "A dark red, astonishingly strong oxidiser that can tear an electron off an oxygen molecule.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Platinum_hexafluoride")]),
    598: (name: "Xenon Hexafluoroplatinate", formula: "XePtF6", state: Solid, molar_mass_g_mol: 440.358, color_hex: "#e8b020", description: "Neil Bartlett, at the University of British Columbia in 1962, mixed xenon with PtF6 and got an orange-yellow solid: the first noble gas compound.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Xenon_hexafluoroplatinate")]),
    599: (name: "Xenon Tetrafluoride", formula: "XeF4", state: Solid, molar_mass_g_mol: 207.282, description: "Colourless crystals made weeks after Bartlett's discovery at Argonne by heating xenon and fluorine (1962); the 'inert' gases were inert no more.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Xenon_tetrafluoride")]),
    600: (name: "Xenon Difluoride", formula: "XeF2", state: Solid, molar_mass_g_mol: 169.286, description: "Forms when xenon and fluorine are left in sunlight; etches silicon in chip making.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Xenon_difluoride")]),
    601: (name: "Human Insulin", formula: "C257H383N65O77S6", state: Solid, molar_mass_g_mol: 5807.629, description: "Banting and Best's hormone (Toronto, 1921) came from pig and cow pancreas until Genentech had E. coli make the human protein (1978).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Insulin_(medication)#History")]),
    602: (name: "Chymosin", formula: "mixture", state: Solid, molar_mass_g_mol: 12.011, description: "The milk-clotting enzyme of calf rennet. Made by microbes since 1990, it now curdles most of the world's cheese.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chymosin")]),
    603: (name: "1,3-Propanediol", formula: "C3H8O2", state: Liquid, molar_mass_g_mol: 76.095, description: "A diol DuPont and Genencor taught E. coli to make from corn sugar (2006), for the polyester Sorona.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/1,3-Propanediol")]),
    604: (name: "Artemisinic Acid", formula: "C15H22O2", state: Solid, molar_mass_g_mol: 234.339, description: "The precursor of artemisinin, made by yeast given wormwood genes (Jay Keasling, 2006; Sanofi production 2013).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Artemisinic_acid")]),
    605: (name: "Polyhydroxybutyrate", formula: "(C4H6O2)n", state: Solid, molar_mass_g_mol: 86.09, properties: [IsPolymer], description: "A polyester bacteria store as fat (Lemoigne, 1926); ICI sold it as Biopol, a plastic that rots in soil.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polyhydroxybutyrate")]),
    606: (name: "Avermectin", formula: "C48H72O14", state: Solid, molar_mass_g_mol: 873.09, description: "Satoshi Omura found the microbe at a Japanese golf course; William Campbell found its avermectins killed parasitic worms (Nobel, 2015).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Avermectin")]),
    607: (name: "Ivermectin", formula: "C48H74O14", state: Solid, molar_mass_g_mol: 875.106, description: "Avermectin with one double bond hydrogenated (Merck, 1981): it has nearly ended river blindness in Africa and the Americas.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ivermectin")]),
    608: (name: "ZSM-5", formula: "mixture", state: Solid, molar_mass_g_mol: 60.083, color_hex: "#f4f4f0", description: "Mobil's 1972 zeolite with ten-ring channels just wide enough for benzene rings; it turns methanol into gasoline and sorts xylenes by shape.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/ZSM-5")]),
    609: (name: "Silicon Nitride", formula: "Si3N4", state: Solid, molar_mass_g_mol: 140.283, color_hex: "#c0c0c8", description: "A hard, tough ceramic and the insulating and etch-stop layer of chips, deposited from chlorosilanes and ammonia.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Silicon_nitride")]),
    610: (name: "Tungsten Hexafluoride", formula: "WF6", state: Gas, molar_mass_g_mol: 297.828, description: "One of the densest gases known, eleven times heavier than air; it deposits the tungsten plugs that wire transistors together.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tungsten_hexafluoride")]),
    611: (name: "Hafnium Tetrachloride", formula: "HfCl4", state: Solid, molar_mass_g_mol: 320.29, description: "The precursor of the hafnium oxide gate insulator.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hafnium(IV)_chloride")]),
    612: (name: "Hafnium Dioxide", formula: "HfO2", state: Solid, molar_mass_g_mol: 210.488, color_hex: "#f0f0f0", description: "A 'high-k' insulator that replaced silica in transistor gates at Intel's 45 nm node (2007), stopping electrons tunnelling through.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hafnium(IV)_oxide")]),
    613: (name: "Optical Fibre", formula: "SiO2", state: Solid, molar_mass_g_mol: 60.083, color_hex: "#e8f8ff", description: "Charles Kao (1966) argued pure silica could carry light 100 km; Corning drew such a fibre in 1970. Kao shared the 2009 Nobel.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Optical_fiber#History")]),
    614: (name: "Indium Phosphide", formula: "InP", state: Solid, molar_mass_g_mol: 145.794, color_hex: "#4a4a50", description: "The semiconductor of the lasers and detectors that send internet traffic down fibres at 1.55 micrometres.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Indium_phosphide")]),
    615: (name: "Single-Crystal Turbine Blade", formula: "mixture", state: Solid, molar_mass_g_mol: 58.693, color_hex: "#a0a0a8", description: "A nickel superalloy blade grown as one crystal so no grain boundaries can creep at 1,100 C: the hot heart of every jet engine since the 1980s.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Superalloy#Single_crystal_superalloys")]),
    616: (name: "Polycrystalline Diamond", formula: "C", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#404048", description: "Diamond grit sintered with cobalt into a tough compact (GE Compax, 1973), the cutter of oil-well drill bits.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Polycrystalline_diamond")]),
    617: (name: "Fluorine-18", formula: "F2", state: Gas, molar_mass_g_mol: 37.996, properties: [IsRadioactive], description: "A positron emitter (half-life 110 minutes) made by bombarding oxygen-18 water with protons in a hospital cyclotron.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Fluorine-18")]),
    618: (name: "Fludeoxyglucose", formula: "C6H11FO5", state: Solid, molar_mass_g_mol: 182.147, description: "Glucose with one OH swapped for fluorine-18 (Ido and Wolf, Brookhaven, 1976): hungry cancer cells take it up and light up a PET scan.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Fludeoxyglucose_(18F)")]),
    619: (name: "Zinc Chloride", formula: "ZnCl2", state: Solid, molar_mass_g_mol: 136.28, color_hex: "#f4f4f0", description: "So hungry for water it dissolves in what it pulls from the air; tinsmiths' 'killed spirits' soldering flux.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Zinc_chloride")]),
    620: (name: "Nickel(II) Chloride", formula: "NiCl2", state: Solid, molar_mass_g_mol: 129.593, color_hex: "#7ab060", description: "Yellow when dry and green as the hexahydrate; a nickel source for electroplating.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nickel(II)_chloride")]),
    621: (name: "Cobalt(II) Chloride", formula: "CoCl2", state: Solid, molar_mass_g_mol: 129.833, color_hex: "#3050c0", description: "Blue when dry and pink when damp: the indicator in humidity cards and the 'sympathetic ink' that appears on warming.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cobalt(II)_chloride")]),
    622: (name: "Copper(II) Chloride", formula: "CuCl2", state: Solid, molar_mass_g_mol: 134.446, color_hex: "#30a0b0", description: "Brown when dry, blue-green in water; it gives fireworks their blue.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Copper(II)_chloride")]),
    623: (name: "Cadmium Chloride", formula: "CdCl2", state: Solid, molar_mass_g_mol: 183.31, color_hex: "#f4f4f4", description: "A white salt whose layered crystal is the textbook prototype for dozens of others.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cadmium_chloride")]),
    624: (name: "Lead(II) Chloride", formula: "PbCl2", state: Solid, molar_mass_g_mol: 278.1, color_hex: "#f8f8f8", description: "Barely soluble cold, soluble hot: the first precipitate of the classic qualitative analysis scheme.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lead(II)_chloride")]),
    625: (name: "Bismuth Trichloride", formula: "BiCl3", state: Solid, molar_mass_g_mol: 315.33, color_hex: "#f4f4f4", description: "Water turns it into milky bismuth oxychloride, the pearly shimmer of nail varnish.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Bismuth_chloride")]),
    626: (name: "Chromium(III) Chloride", formula: "CrCl3", state: Solid, molar_mass_g_mol: 158.346, color_hex: "#6a2a8a", description: "Violet flakes that dissolve to green solutions; a catalyst for making polyethylene.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chromium(III)_chloride")]),
    627: (name: "Copper(I) Chloride", formula: "CuCl", state: Solid, molar_mass_g_mol: 98.996, color_hex: "#f0f0e8", description: "White when pure; it catalyses Sandmeyer reactions and absorbs carbon monoxide from gas mixtures.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Copper(I)_chloride")]),
    628: (name: "Nickel(II) Sulfate", formula: "NiSO4", state: Solid, molar_mass_g_mol: 154.749, color_hex: "#4aa060", description: "Emerald crystals as the hydrate; the main salt of nickel-plating baths.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nickel(II)_sulfate")]),
    629: (name: "Manganese(II) Sulfate", formula: "MnSO4", state: Solid, molar_mass_g_mol: 150.994, color_hex: "#f0d0d8", description: "Pale pink; the manganese of fertilisers, animal feed and electrolytic manganese.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Manganese(II)_sulfate")]),
    630: (name: "Magnesium Sulfate", formula: "MgSO4", state: Solid, molar_mass_g_mol: 120.361, color_hex: "#f8f8f8", description: "Anhydrous Epsom salt, the organic chemist's drying powder.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Magnesium_sulfate")]),
    631: (name: "Cadmium Sulfate", formula: "CdSO4", state: Solid, molar_mass_g_mol: 208.466, color_hex: "#f8f8f8", description: "The electrolyte of the Weston standard cell, the world's voltage reference from 1911 to 1990.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cadmium_sulfate")]),
    632: (name: "Chromium(III) Sulfate", formula: "Cr2(SO4)3", state: Solid, molar_mass_g_mol: 392.16, color_hex: "#4a6a8a", description: "The basic chromium sulfate that tans most of the world's leather.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chromium(III)_sulfate")]),
    633: (name: "Cobalt(II) Nitrate", formula: "Co(NO3)2", state: Solid, molar_mass_g_mol: 182.941, color_hex: "#c03050", description: "Red crystals; the cobalt of many Fischer-Tropsch catalysts.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cobalt(II)_nitrate")]),
    634: (name: "Manganese(II) Nitrate", formula: "Mn(NO3)2", state: Solid, molar_mass_g_mol: 178.946, color_hex: "#f0d0d8", description: "A pink salt that decomposes cleanly to manganese dioxide for batteries.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Manganese(II)_nitrate")]),
    635: (name: "Bismuth(III) Nitrate", formula: "Bi(NO3)3", state: Solid, molar_mass_g_mol: 394.992, color_hex: "#f8f8f8", description: "The starting salt of most bismuth compounds, from stomach remedies to the 'subnitrate' of old cosmetics.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Bismuth(III)_nitrate")]),
    636: (name: "Mercury(II) Nitrate", formula: "Hg(NO3)2", state: Solid, molar_mass_g_mol: 324.598, color_hex: "#f8f8f8", description: "Felters brushed it onto rabbit fur for hats; the mercury poisoning that followed is the likely origin of 'mad as a hatter'.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Mercury(II)_nitrate")]),
    637: (name: "Copper(II) Hydroxide", formula: "Cu(OH)2", state: Solid, molar_mass_g_mol: 97.56, color_hex: "#40a0d0", description: "A pale blue jelly that falls out when alkali meets a copper salt.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Copper(II)_hydroxide")]),
    638: (name: "Nickel(II) Hydroxide", formula: "Ni(OH)2", state: Solid, molar_mass_g_mol: 92.707, color_hex: "#60b070", description: "Apple-green; the positive plate of nickel-cadmium and nickel-metal hydride cells.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nickel(II)_hydroxide")]),
    639: (name: "Cobalt(II) Hydroxide", formula: "Co(OH)2", state: Solid, molar_mass_g_mol: 92.947, color_hex: "#e07090", description: "Blue at first, turning rose-red as it ages; a drying agent in paints.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cobalt(II)_hydroxide")]),
    640: (name: "Zinc Hydroxide", formula: "Zn(OH)2", state: Solid, molar_mass_g_mol: 99.394, color_hex: "#f8f8f8", description: "White and amphoteric: it dissolves in acid and in excess alkali alike.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Zinc_hydroxide")]),
    641: (name: "Cadmium Hydroxide", formula: "Cd(OH)2", state: Solid, molar_mass_g_mol: 146.424, color_hex: "#f8f8f8", description: "The negative plate of nickel-cadmium cells.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cadmium_hydroxide")]),
    642: (name: "Iron(III) Hydroxide", formula: "Fe(OH)3", state: Solid, molar_mass_g_mol: 106.866, color_hex: "#a0501a", description: "Rust-brown and gelatinous: the ochre of mine drainage and the stain of iron-rich springs.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Iron(III)_oxide-hydroxide")]),
    643: (name: "Chromium(III) Hydroxide", formula: "Cr(OH)3", state: Solid, molar_mass_g_mol: 103.017, color_hex: "#4a7a5a", description: "A grey-green, amphoteric precipitate; heated, it gives chrome green.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chromium(III)_hydroxide")]),
    644: (name: "Nickel(II) Carbonate", formula: "NiCO3", state: Solid, molar_mass_g_mol: 118.701, color_hex: "#7ac080", description: "A light green powder used to make nickel catalysts and ceramic glazes.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Nickel(II)_carbonate")]),
    645: (name: "Cobalt(II) Carbonate", formula: "CoCO3", state: Solid, molar_mass_g_mol: 118.941, color_hex: "#e080a0", description: "Pink, and the potter's way of adding cobalt blue to a glaze.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cobalt(II)_carbonate")]),
    646: (name: "Manganese(II) Carbonate", formula: "MnCO3", state: Solid, molar_mass_g_mol: 114.946, color_hex: "#f0b0c0", description: "The rose-pink mineral rhodochrosite, Argentina's national gemstone.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Manganese(II)_carbonate")]),
    647: (name: "Cadmium Carbonate", formula: "CdCO3", state: Solid, molar_mass_g_mol: 172.418, color_hex: "#f8f8f8", description: "The rare mineral otavite, named for Otavi in Namibia.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cadmium_carbonate")]),
    648: (name: "Iron(II) Carbonate", formula: "FeCO3", state: Solid, molar_mass_g_mol: 115.853, color_hex: "#b0a080", description: "Siderite, the 'spathic iron ore' of the Styrian Erzberg, mined since Roman times.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Siderite")]),
    649: (name: "Copper(II) Sulfide", formula: "CuS", state: Solid, molar_mass_g_mol: 95.606, color_hex: "#1a2050", description: "Black precipitate, and as a mineral the indigo-blue covellite, named for Niccolo Covelli who found it on Vesuvius.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Copper_monosulfide")]),
    650: (name: "Cadmium Sulfide", formula: "CdS", state: Solid, molar_mass_g_mol: 144.47, color_hex: "#f8c000", description: "Cadmium yellow, the brilliant pigment Monet and Van Gogh adopted; also the light-sensitive cell of old camera meters.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cadmium_sulfide")]),
    651: (name: "Cobalt(II) Sulfide", formula: "CoS", state: Solid, molar_mass_g_mol: 90.993, color_hex: "#1a1a1a", description: "A black precipitate, part of the fourth group of classical analysis.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cobalt_sulfide")]),
    652: (name: "Manganese(II) Sulfide", formula: "MnS", state: Solid, molar_mass_g_mol: 86.998, color_hex: "#e8a8a0", description: "The salmon-pink precipitate that tells an analyst manganese is present.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Manganese(II)_sulfide")]),
    653: (name: "Potassium Chromate", formula: "K2CrO4", state: Solid, molar_mass_g_mol: 194.188, color_hex: "#f0e020", description: "Lemon-yellow; the indicator of Mohr's chloride titration.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_chromate")]),
    654: (name: "Potassium Dichromate", formula: "K2Cr2O7", state: Solid, molar_mass_g_mol: 294.181, color_hex: "#f07010", description: "Orange crystals, a classic oxidant: the breathalyser turned green when it met ethanol.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_dichromate")]),
    655: (name: "Silver Chromate", formula: "Ag2CrO4", state: Solid, molar_mass_g_mol: 331.732, color_hex: "#a03020", description: "Brick red; its appearance marks the end point in Mohr's titration (1856).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Silver_chromate")]),
    656: (name: "Barium Chromate", formula: "BaCrO4", state: Solid, molar_mass_g_mol: 253.322, color_hex: "#f0e040", description: "Lemon chrome, a yellow pigment and corrosion inhibitor.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Barium_chromate")]),
    657: (name: "Ammonium Dichromate", formula: "(NH4)2Cr2O7", state: Solid, molar_mass_g_mol: 252.063, color_hex: "#f06010", description: "Orange crystals that, lit, burn into a 'volcano' of green chromium oxide.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ammonium_dichromate")]),
    658: (name: "Manganese(II) Oxide", formula: "MnO", state: Solid, molar_mass_g_mol: 70.937, color_hex: "#3a5a3a", description: "Green-grey manganosite, a fertiliser and feed additive.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Manganese(II)_oxide")]),
    659: (name: "Manganese(III) Oxide", formula: "Mn2O3", state: Solid, molar_mass_g_mol: 157.873, color_hex: "#3a2a20", description: "Black; forms when manganese dioxide is heated above 500 C.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Manganese(III)_oxide")]),
    660: (name: "Strontium Oxide", formula: "SrO", state: Solid, molar_mass_g_mol: 103.619, color_hex: "#f8f8f8", description: "Strontia, which Thomas Hope recognised in 1791 by the crimson flame of its salts.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Strontium_oxide")]),
    661: (name: "Potassium Superoxide", formula: "KO2", state: Solid, molar_mass_g_mol: 71.096, color_hex: "#f0d040", description: "Potassium burned in air: yellow crystals that absorb exhaled CO2 and release oxygen, in mine rescue sets and Soyuz capsules.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_superoxide")]),
    662: (name: "Sodium Peroxide", formula: "Na2O2", state: Solid, molar_mass_g_mol: 77.978, color_hex: "#f8f0c0", description: "A pale yellow oxidiser that turns CO2 back into oxygen; it purified the air of early submarines.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_peroxide")]),
    663: (name: "Magnesium Nitride", formula: "Mg3N2", state: Solid, molar_mass_g_mol: 100.929, color_hex: "#e0e080", description: "The greenish-yellow powder that forms when magnesium burns in air; Rayleigh and Ramsay used it to strip nitrogen and find argon (1894).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Magnesium_nitride")]),
    664: (name: "Zinc Bromide", formula: "ZnBr2", state: Solid, molar_mass_g_mol: 225.188, color_hex: "#f8f8f8", description: "Its dense solutions shield the windows of nuclear 'hot cells' and weigh down oil wells.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Zinc_bromide")]),
    665: (name: "Aluminium Bromide", formula: "AlBr3", state: Solid, molar_mass_g_mol: 266.694, color_hex: "#f8f8f8", description: "Like aluminium chloride, a Lewis acid that catalyses Friedel-Crafts reactions.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Aluminium_bromide")]),
    666: (name: "Iron(III) Bromide", formula: "FeBr3", state: Solid, molar_mass_g_mol: 295.557, color_hex: "#6a2a10", description: "Red-brown; the catalyst that lets bromine attack a benzene ring.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Iron(III)_bromide")]),
    667: (name: "Tin(IV) Iodide", formula: "SnI4", state: Solid, molar_mass_g_mol: 626.31, color_hex: "#f07010", description: "Bright orange crystals that sublime easily.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Tin(IV)_iodide")]),
    668: (name: "Mercury(II) Iodide", formula: "HgI2", state: Solid, molar_mass_g_mol: 454.39, color_hex: "#f02010", description: "Scarlet, turning yellow above 126 C and red again on cooling: a thermochromic textbook example.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Mercury(II)_iodide")]),
    669: (name: "Copper(I) Iodide", formula: "CuI", state: Solid, molar_mass_g_mol: 190.446, color_hex: "#f0f0e0", description: "Released with iodine when iodide meets a copper(II) salt; the basis of an old copper assay.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Copper(I)_iodide")]),
    670: (name: "Germanium Tetrachloride", formula: "GeCl4", state: Liquid, molar_mass_g_mol: 214.43, color_hex: "#f0f8ff", description: "A colourless fuming liquid; burnt with silicon tetrachloride, it raises the refractive index of an optical fibre's core.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Germanium_tetrachloride")]),
    671: (name: "Fumed Silica", formula: "SiO2", state: Solid, molar_mass_g_mol: 60.083, color_hex: "#f8f8ff", description: "Degussa's Aerosil (1942): silica smoke so fine that a gram has the surface of a tennis court; it thickens toothpaste and paint.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Fumed_silica")]),
    672: (name: "Hydroxyapatite", formula: "Ca10(PO4)6(OH)2", state: Solid, molar_mass_g_mol: 1004.614, color_hex: "#f4f0e8", description: "The mineral of bone and tooth enamel; fluoride hardens teeth by swapping in for its OH.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hydroxyapatite")]),
    673: (name: "Struvite", formula: "MgNH4PO4·6H2O", state: Solid, molar_mass_g_mol: 245.404, color_hex: "#f0f0e0", description: "Magnesium ammonium phosphate: kidney stones, a crust in sewage pipes, and slow-release fertiliser recovered from wastewater.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Struvite")]),
    674: (name: "Epsom Salt", formula: "MgSO4·7H2O", state: Solid, molar_mass_g_mol: 246.466, color_hex: "#f8f8f8", description: "Found in a bitter spring on Epsom common in 1618; Nehemiah Grew sold it as a purge from 1695.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Magnesium_sulfate#Epsom_salt")]),
    675: (name: "White Vitriol", formula: "ZnSO4·7H2O", state: Solid, molar_mass_g_mol: 287.541, color_hex: "#f8f8f8", description: "Zinc sulfate heptahydrate, goslarite; an old eye-wash and a source of zinc in feed.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Zinc_sulfate")]),
    676: (name: "Cobalt Chloride Hexahydrate", formula: "CoCl2·6H2O", state: Solid, molar_mass_g_mol: 237.923, color_hex: "#e04070", description: "Deep pink crystals that turn blue as they lose their water.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cobalt(II)_chloride#Properties")]),
    677: (name: "Chrome Alum", formula: "KCr(SO4)2·12H2O", state: Solid, molar_mass_g_mol: 499.386, color_hex: "#4a2060", description: "Deep purple octahedra, the most beautiful crystals a school lab can grow.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chrome_alum")]),
    678: (name: "Iron(III) Thiocyanate", formula: "Fe(SCN)3", state: Solid, molar_mass_g_mol: 230.079, color_hex: "#900010", description: "The blood-red colour that reveals even traces of ferric iron.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Iron(III)_thiocyanate")]),
    679: (name: "Ethyl Lactate", formula: "C5H10O3", state: Liquid, molar_mass_g_mol: 118.132, color_hex: "#f8f8f8", description: "A biodegradable solvent made from corn sugar and ethanol, replacing chlorinated solvents.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ethyl_lactate")]),
    680: (name: "Ethyl Salicylate", formula: "C9H10O3", state: Liquid, molar_mass_g_mol: 166.176, color_hex: "#f8f8f8", description: "The wintergreen-scented ester of salicylic acid and ethanol, in perfumes and flavours.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ethyl_salicylate")]),
    681: (name: "Methyl Propionate", formula: "C4H8O2", state: Liquid, molar_mass_g_mol: 88.106, color_hex: "#f8f8f8", description: "A rum-like ester and a step toward methyl methacrylate in the Alpha process.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Methyl_propionate")]),
    682: (name: "Isoamyl Butyrate", formula: "C9H18O2", state: Liquid, molar_mass_g_mol: 158.241, color_hex: "#f8f8f8", description: "Smells of apricot and pear drops.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Isoamyl_butyrate")]),
    683: (name: "Benzyl Formate", formula: "C8H8O2", state: Liquid, molar_mass_g_mol: 136.15, color_hex: "#f8f8f8", description: "A fruity, jasmine-like ester.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Benzyl_formate")]),
    684: (name: "Ethyl Anthranilate", formula: "C9H11NO2", state: Liquid, molar_mass_g_mol: 165.192, color_hex: "#f8f8f8", description: "The grape-and-orange-blossom ester, also used to scare birds off crops.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ethyl_anthranilate")]),
    685: (name: "Hexane", formula: "C6H14", state: Liquid, molar_mass_g_mol: 86.178, description: "A light naphtha alkane; the solvent that extracts most of the world's soybean oil.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Hexane")]),
    686: (name: "Heptane", formula: "C7H16", state: Liquid, molar_mass_g_mol: 100.205, description: "Straight-chain heptane knocks so badly in an engine that it defines zero on the octane scale (isooctane is 100).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Heptane")]),
    687: (name: "Liquid Neon", formula: "Ne", state: Liquid, molar_mass_g_mol: 20.18, color_hex: "#ffd0c0", description: "Boils at -246 C with forty times the cooling power of liquid helium per litre; Travers liquefied it in 1898.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Neon#Production")]),
    688: (name: "Liquid Fluorine", formula: "F2", state: Liquid, molar_mass_g_mol: 37.996, description: "Pale yellow, condensed by Moissan and Dewar in 1897 with liquid air; fierce enough that rocket engineers tested it as an oxidiser.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Fluorine#History")]),
    689: (name: "Niobium-Titanium", formula: "NbTi", state: Solid, molar_mass_g_mol: 140.773, properties: [IsMetal], description: "The workhorse superconducting alloy (1962): below 9 K it carries current with no resistance at all. Every MRI scanner and the LHC's magnets are wound from it.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Niobium%E2%80%93titanium")]),
    690: (name: "Superconducting Magnet", formula: "mixture", state: Solid, molar_mass_g_mol: 140.773, description: "Coils of niobium-titanium bathed in liquid helium: fields of several tesla with no power used once the current is flowing.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Superconducting_magnet")]),
    691: (name: "Ice VII", formula: "H2O", state: Solid, molar_mass_g_mol: 18.015, color_hex: "#e0f0ff", description: "A dense cubic ice that is stable above 20,000 atmospheres even far above 100 C. Bridgman made it in 1937; it has since been found trapped in diamonds.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Ice_VII")]),
    692: (name: "Gem-Quality Diamond", formula: "C", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#f0f8ff", description: "GE grew the first jewel-quality synthetic diamonds in 1970, over a week each, from a seed in a temperature gradient.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Synthetic_diamond#High_pressure,_high_temperature")]),
    693: (name: "Nano-Polycrystalline Diamond", formula: "C", state: Solid, molar_mass_g_mol: 12.011, color_hex: "#e8e8f0", description: "Tetsuo Irifune's 'hyperdiamond' (Ehime, 2003): graphite or fullerene squeezed straight into nanocrystals, harder than single-crystal diamond.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Aggregated_diamond_nanorods")]),
    694: (name: "Bismuth Germanate", formula: "Bi4Ge3O12", state: Solid, molar_mass_g_mol: 1245.798, color_hex: "#f4f4e8", description: "A dense scintillator crystal that flashes when gamma rays hit it: the detector ring of PET scanners and of the L3 experiment at CERN.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Bismuth_germanate")]),
    695: (name: "Silicon Carbide Crystal", formula: "SiC", state: Solid, molar_mass_g_mol: 40.096, color_hex: "#507050", description: "Jan Anthony Lely sublimed silicon carbide into clean crystals in 1955; their wafers now switch power in electric cars.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Silicon_carbide#Electronic_applications")]),
    696: (name: "Fluorite Optics", formula: "CaF2", state: Solid, molar_mass_g_mol: 78.074, color_hex: "#f0f0ff", description: "Calcium fluoride crystal transparent deep into the ultraviolet: the lenses of the 193 nm lithography that prints chips.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Calcium_fluoride#Uses")]),
    697: (name: "Soy Sauce", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#3a1a08", description: "Soybeans and grain fermented with salt for months; its Chinese ancestor, jiang, dates back to the Han dynasty.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Soy_sauce")]),
    698: (name: "Kombucha", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#c08040", description: "Sweet tea fermented by a mat of yeast and acetic bacteria into a tart drink.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Kombucha")]),
    699: (name: "Phosphorus-32", formula: "P", state: Solid, molar_mass_g_mol: 30.974, properties: [IsRadioactive], description: "A beta emitter (half-life 14 days) made from sulfur in reactors; John Lawrence treated leukaemia with it in 1936.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Phosphorus-32")]),
    700: (name: "Lutetium-177", formula: "Lu", state: Solid, molar_mass_g_mol: 174.97, properties: [IsMetal, IsRadioactive], description: "A short-lived radiometal that, bound to a peptide, hunts down neuroendocrine tumours (Lutathera, 2018).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lutetium-177")]),
    701: (name: "Anthrahydroquinone", formula: "C14H10O2", state: Solid, molar_mass_g_mol: 210.232, description: "The reduced form of anthraquinone; air oxidises it straight back, handing over hydrogen peroxide.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Anthraquinone_process")]),
    702: (name: "Magnesium Silicide", formula: "Mg2Si", state: Solid, molar_mass_g_mol: 76.695, description: "Blue-grey crystals that give off silane when acid touches them.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Magnesium_silicide")]),
    703: (name: "Silane", formula: "SiH4", state: Gas, molar_mass_g_mol: 32.117, description: "Silicon's hydride, which bursts into flame in air; decomposed on hot glass it lays down the amorphous silicon of thin-film solar panels and screens.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Silane")]),
    704: (name: "Amorphous Silicon", formula: "Si", state: Solid, molar_mass_g_mol: 28.085, color_hex: "#5a4a40", description: "Hydrogenated, disordered silicon a micrometre thick: the switches behind every pixel of a flat-panel display (Spear and LeComber, 1975).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Amorphous_silicon")]),
