    3201: (formula: "C10H16", state: Liquid),
    3235: (formula: "C16H10", state: Solid, description: "Four benzene rings fused into a flat sheet: a pale yellow hydrocarbon from coal tar whose blue fluorescence makes it a favourite probe in the lab."),
    3250: (formula: "C20H24N2O2", state: Solid, description: "The bitter alkaloid of cinchona bark, isolated by Pelletier and Caventou in 1820. For centuries the only effective treatment for malaria, and still the bitterness in tonic water."),
    3271: (formula: "BeO", state: Solid),
    3275: (formula: "CaO2", state: Solid, description: "A white powder that slowly releases oxygen in water: used to bleach and strengthen flour (E930), to clean up polluted soil, and to aerate fish ponds."),
    3282: (name: "Chalcopyrite", formula: "CuFeS2", state: Solid, color_hex: "#c8a028", description: "Copper iron sulfide, CuFeS2: a brassy golden mineral and the world's most important copper ore. Roasting and smelting it has supplied copper since the Bronze Age."),
    3286: (formula: "Mg(OH)2", state: Solid, properties: [IsBase]),
    3287: (formula: "MgO", state: Solid),
    3288: (formula: "Sb2O3", state: Solid),
    3299: (formula: "KOH", state: Solid, properties: [IsBase]),
    3300: (formula: "LiOH", state: Solid),
    3306: (formula: "K2S", state: Solid, description: "The main solid left after black powder burns, together with carbonate and sulfate; the rotten-egg smell of old gun barrels.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_sulfide")]),
    3307: (formula: "K2SiO3", state: Solid, description: "Potassium water glass: a silicate that dissolves in water and sets hard as it dries. A binder for mineral paints and welding rods, and an old fireproof coating."),
    3313: (formula: "Na2O", state: Solid),
    3314: (formula: "Na2S", state: Solid),
    3315: (formula: "Nb2O5", state: Solid),
    3317: (formula: "Ni(NO3)2", state: Solid),
    3320: (formula: "P4O10", state: Solid, description: "The white smoke of burning phosphorus. It snatches water from almost anything, which makes it one of the strongest drying agents known.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Phosphorus_pentoxide")]),
    3321: (formula: "Ta2O5", state: Solid),
    3334: (formula: "Cu3(CO3)2(OH)2", state: Solid, color_hex: "#2050c0"),
    3390: (formula: "Be(OH)2", state: Solid, description: "Beryllium hydroxide, the form beryllium takes on its way out of beryl and bertrandite ores. It is amphoteric: it dissolves in acids and in strong bases alike."),
    3413: (formula: "C8H9NO2", state: Liquid),
    3416: (formula: "C14H10O2", state: Solid),
    3448: (formula: "Al(NO3)3", state: Solid),
    3458: (formula: "BeSO4", state: Solid),
    3472: (formula: "Co(C18H35O2)2", state: Solid),
    3514: (formula: "C5H12O", state: Liquid),
    3515: (formula: "NaC3H5O2", state: Solid, description: "Sodium propionate, the sodium salt of propionic acid: a food preservative (E281) that keeps mould off bread and cakes."),
    3545: (formula: "C10H16", state: Liquid),
    3594: (formula: "C9H10O2", state: Liquid),
    3598: (formula: "C10H12O", state: Liquid),
    3610: (name: "Menthone", formula: "C10H18O", state: Liquid),
    3619: (formula: "C18H34O3", state: Liquid),
    3622: (formula: "C10H16O", state: Liquid, description: "Citral A, one of the two forms of citral: the strong lemon scent of lemongrass and lemon myrtle, and the starting point for ionones and synthetic vitamin A."),
    3627: (formula: "CHNaO2", state: Solid, description: "The sodium salt of formic acid, the simplest carboxylic acid.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_formate")]),
    3631: (formula: "C4H8O2", state: Liquid),
    3632: (formula: "C3H4O4", state: Solid),
    3634: (formula: "C6H10O3", state: Liquid),
    3652: (formula: "C5H8NNaO4", state: Solid),
    3655: (formula: "C6H12O2", state: Liquid, properties: [IsAcid]),
    3657: (formula: "Mg(C2H3O2)2", state: Solid, description: "The magnesium salt of acetic acid, and with calcium acetate the makings of calcium magnesium acetate, a road de-icer far gentler on concrete and steel than salt."),
    3663: (formula: "C19H38O2", state: Liquid),
    3682: (formula: "C12H24O2", state: Solid, properties: [IsAcid], description: "A twelve-carbon fatty acid that makes up about half of coconut and palm kernel oil, and the base of a great many soaps and shampoos."),
    3688: (formula: "NaCN", state: Solid),
    3704: (formula: "NaHCO3", state: Solid),
    3705: (formula: "C2H2O4", state: Solid, properties: [IsAcid]),
    3764: (name: "Proline", formula: "C5H9NO2", state: Solid),
    3806: (formula: "C7H6O5", state: Solid, properties: [IsAcid]),
    3807: (formula: "C10H20O", state: Solid),
    3840: (formula: "C12H25NaO4S", state: Solid),
    3841: (formula: "KCN", state: Solid, description: "A deadly poison and an indispensable reagent: gold mining, electroplating, and the start of Wöhler's road to urea.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_cyanide")]),
    3871: (formula: "C27H30O16", state: Solid),
    3941: (formula: "C13H18O2", state: Solid, description: "A painkiller and anti-inflammatory found in 1961 by Stewart Adams and John Nicholson at Boots in Nottingham. Adams famously tried it on his own hangover before giving a talk."),
    3966: (formula: "Ca(C18H35O2)2", state: Solid),
    4090: (formula: "AgSCN", state: Solid),
    4138: (formula: "NH4C3H5O2", state: Solid, description: "The ammonium salt of propionic acid: a preservative that keeps mould out of grain and animal feed."),
    4420: (formula: "C41H64O14", state: Solid),
    4425: (formula: "Ca(C7H5O2)2", state: Solid, description: "The calcium salt of benzoic acid: a food preservative (E213) against moulds and yeasts in acidic foods."),
    4469: (name: "Aluminium Hydroxide", formula: "Al(OH)3", state: Solid),
    4569: (formula: "C20H12O5", state: Solid),
    4639: (formula: "AlN", state: Solid),
    4670: (formula: "C6H7KO2", state: Solid),
    4785: (formula: "SF6", state: Gas),
    4884: (formula: "C9H6N2O2", state: Liquid),
    5132: (formula: "C2H2O3", state: Solid),
    5140: (formula: "C12H22CaO14", state: Solid, description: "The calcium salt of gluconic acid: a gentle source of calcium for supplements and hospital drips, and the antidote gel for hydrofluoric acid burns."),
    5171: (formula: "N2H4", state: Liquid),
    5172: (formula: "C2H3Cl3O2", state: Solid, description: "The first synthetic sleeping drug (1869), the 'knockout drops' of Victorian crime fiction.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chloral_hydrate")]),
    5241: (formula: "Fe(C2H3O2)2", state: Solid),
    5257: (formula: "C4H8N2O3", state: Solid, description: "The first amino acid ever found, crystallised from asparagus juice in 1806 by Vauquelin and Robiquet, which is how it got its name."),
    5321: (formula: "Cu(NO3)2", state: Solid),
    5359: (formula: "KSCN", state: Solid, description: "Potassium thiocyanate. Its blood-red colour with iron(III) is one of the classic tests for iron; it is also used in dyeing and photography."),
    5368: (formula: "C10H20O2", state: Solid),
    5404: (formula: "C6H13NO5", state: Solid),
    5586: (formula: "Ni(C2H3O2)2", state: Solid, description: "A green salt of nickel and acetic acid, used in nickel plating, as a mordant for dyes, and to seal the pores of anodised aluminium."),
    5635: (formula: "KClO3", state: Solid, description: "Berthollet's salt, a powerful oxidiser. The heads of safety matches, the oxygen in emergency candles, and the source of many accidents.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_chlorate")]),
    5736: (formula: "Ca(C3H5O2)2", state: Solid, description: "Calcium propionate: the most common bread preservative (E282), stopping mould and the bacteria that make bread go stringy."),
    5778: (formula: "C4H6O", state: Liquid),
    5789: (formula: "CH2N2", state: Solid),
    5844: (formula: "C27H44O", state: Solid, description: "The cholesterol relative in your skin that sunlight's ultraviolet turns into vitamin D3. Windaus worked out the chemistry in the 1930s."),
    5882: (formula: "LiC18H35O2", state: Solid),
    5904: (formula: "C21H20O6", state: Solid, description: "The bright yellow pigment of turmeric root, used to colour curry, mustard and butter (E100). It turns red-brown in alkali, which made turmeric paper an early chemical test paper."),
    5922: (formula: "C10H16O", state: Solid, description: "A waxy, white, strongly aromatic solid from the camphor laurel tree. Celluloid, the first commercial plastic (Hyatt, 1870), is nitrocellulose softened with camphor."),
    5939: (formula: "C10H18O", state: Liquid, description: "Eucalyptol: the cool, camphor-like scent of eucalyptus oil, used in mouthwashes, cough sweets and liniments."),
    5942: (formula: "CaCO3", state: Solid),
    6030: (formula: "C6H6O6", state: Solid),
    6040: (formula: "C3H6O3", state: Liquid, properties: [IsAcid]),
    6060: (name: "Vitamin C", formula: "C6H8O6", state: Solid, properties: [IsAcid]),
    6072: (formula: "C40H56", state: Solid, description: "The red pigment of tomatoes, watermelon and pink grapefruit: a long chain of alternating double bonds that soaks up blue-green light. A carotenoid, cousin to beta-carotene."),
    6077: (formula: "C5H10O2", state: Liquid),
    6087: (formula: "C8H14O4", state: Solid),
    6125: (formula: "C9H13NO3", state: Solid),
    6181: (formula: "NH4C3H5O3", state: Solid),
    6185: (formula: "BaC2O4", state: Solid),
    6209: (name: "Cysteine", formula: "C3H7NO2S", state: Solid),
