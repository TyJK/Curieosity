    6343: (formula: "C7H14O2", state: Liquid),
    6358: (formula: "C10H14N2", state: Liquid),
    6373: (formula: "NH4CHO2", state: Solid),
    6374: (formula: "NaSCN", state: Solid),
    6375: (formula: "C8H18", state: Liquid),
    6387: (formula: "C3H5ClO2", state: Liquid),
    6399: (formula: "C5H6", state: Liquid),
    6404: (formula: "Ba(C2H3O2)2", state: Solid),
    6411: (formula: "Ca(CHO2)2", state: Solid),
    6413: (formula: "NH4C18H33O2", state: Solid),
    6414: (formula: "C14H28O2", state: Solid),
    6426: (formula: "LiC2H3O2", state: Solid),
    6448: (formula: "C3H5N3O9", state: Liquid),
    6472: (formula: "Li2C2O4", state: Solid),
    6490: (formula: "LiCHO2", state: Solid),
    6495: (formula: "Mg(C18H35O2)2", state: Solid),
    6496: (formula: "Zn(C18H35O2)2", state: Solid, description: "Zinc stearate: a soft, white zinc soap that repels water. It keeps plastics and rubber from sticking to their moulds, and gives face powder its slip."),
    6500: (formula: "Zn(C2H3O2)2", state: Solid),
    6518: (formula: "CCl4", state: Liquid),
    6523: (formula: "C2H5NO2", state: Solid),
    6525: (formula: "C3H7NO3", state: Solid, description: "An amino acid first isolated in 1865 from sericin, the gum of silk (Latin sericum). Its OH group is where many enzymes do their chemistry."),
    6529: (name: "Aspartic acid", formula: "C4H7NO4", state: Solid, description: "An acidic amino acid, first obtained from asparagine in 1827. One half of the sweetener aspartame."),
    6530: (name: "Glutamine", formula: "C5H10N2O3", state: Solid, description: "Glutamic acid with its side-chain acid turned into an amide: the most plentiful amino acid in the blood, and a carrier of nitrogen around the body."),
    6531: (name: "Glutamic acid", formula: "C5H9NO4", state: Solid, description: "The amino acid behind umami, the savoury fifth taste. Kikunae Ikeda isolated its taste from kombu seaweed in 1908 and sold its sodium salt as MSG."),
    6532: (name: "Lysine", formula: "C6H14N2O2", state: Solid, description: "An essential amino acid with a long, positively charged side chain. Today it is fermented by the million tonnes with Corynebacterium glutamicum, mostly for animal feed."),
    6551: (formula: "AgC2H3O2", state: Solid),
    6587: (formula: "C16H32O2", state: Solid, properties: [IsAcid]),
    6588: (formula: "CH4N2O", state: Solid),
    6592: (formula: "C15H12N2O2", state: Solid),
    6596: (formula: "C6H12O6", state: Solid, description: "Fruit sugar, the sweetest natural sugar. Together with glucose it makes up invert sugar and honey.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Fructose")]),
    6597: (formula: "C12H22O11", state: Solid),
    6607: (formula: "C21H39N7O12", state: Solid, description: "The first antibiotic that worked against tuberculosis, isolated in 1943 by Albert Schatz in Selman Waksman's lab from the soil bacterium Streptomyces griseus."),
    6647: (formula: "C8H10N4O2", state: Solid, description: "The stimulant in coffee, tea and cocoa. Runge isolated it from coffee beans in 1819, reportedly at Goethe's suggestion; it works by blocking the brain's adenosine receptors."),
    6661: (formula: "C7H8N4O2", state: Solid, description: "A close cousin of caffeine found in tea leaves, isolated by Albrecht Kossel in 1888. It relaxes the airways and was long a treatment for asthma."),
    6668: (formula: "C10H16N2O3S", state: Solid),
    6669: (formula: "C5H10O5", state: Solid),
    6684: (formula: "KC7H5O2", state: Solid, description: "The potassium salt of benzoic acid: a preservative (E212) for soft drinks and other acidic foods."),
    6708: (formula: "C10H16", state: Liquid),
    6712: (formula: "La2(CO3)3", state: Solid, description: "Lanthanum carbonate: a white, nearly insoluble salt. Taken with meals, it locks up phosphate in the gut, which helps people whose kidneys have failed."),
    6729: (formula: "C19H19N7O6", state: Solid),
    6734: (formula: "C13H20N2O2", state: Solid, description: "Novocaine, made by Alfred Einhorn in 1905: the first widely used synthetic local anaesthetic, a safer, non-addictive replacement for cocaine in dentistry."),
    6738: (formula: "C6H5NO2", state: Solid),
    6746: (formula: "KOCN", state: Solid, description: "The cyanate ion is cyanide with one extra oxygen, and far less toxic. Liebig and Wöhler's quarrel over cyanates and fulminates gave chemistry the idea of isomers.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Potassium_cyanate")]),
    6747: (formula: "KCHO2", state: Solid, description: "The potassium salt of formic acid: a very soluble salt used to de-ice runways and to make the dense, clean drilling brines of oil wells."),
    6818: (formula: "C8H10O", state: Liquid),
    6819: (name: "Tyrosine", formula: "C9H11NO3", state: Solid, description: "An amino acid Liebig first found in cheese (Greek tyros) in 1846. The body builds adrenaline, dopamine, thyroid hormones and the pigment melanin from it."),
    6821: (formula: "C4H10O", state: Liquid),
    6823: (formula: "C18H32O2", state: Liquid),
    6824: (formula: "C2H5NO", state: Solid),
    6826: (formula: "C22H24N2O8", state: Solid, description: "A broad-spectrum antibiotic from Streptomyces bacteria, patented in 1955 by Lloyd Conover at Pfizer. Its four fused rings give the family its name."),
    6880: (name: "Leucine", formula: "C6H13NO2", state: Solid),
    6905: (formula: "C3H6O3", state: Liquid),
    6938: (formula: "C7H5NO4", state: Solid, properties: [IsAcid]),
    6940: (formula: "C10H13NO2", state: Solid, description: "One of the first synthetic painkillers (Bayer, 1887). Much of its effect comes from the paracetamol the body makes from it; it was withdrawn once it was found to damage the kidneys."),
    6942: (formula: "Ca(C2H3O2)2", state: Solid),
    6943: (formula: "CH4N2S", state: Solid),
    6944: (formula: "Na2C2O4", state: Solid),
    6967: (formula: "C5H10O2", state: Liquid),
    7013: (formula: "C6H8N2O2S", state: Solid),
    7015: (name: "Phenylalanine", formula: "C9H11NO2", state: Solid),
    7025: (formula: "NH4C2H3O2", state: Solid),
    7084: (formula: "CH2O2", state: Liquid, properties: [IsAcid], description: "The simplest carboxylic acid, first distilled from crushed ants (Latin formica) by John Ray in 1671. It is part of the sting in ant bites and nettles."),
    7149: (formula: "NH4NO3", state: Solid),
    7151: (name: "Carvone", formula: "C10H14O", state: Liquid, description: "One molecule, two smells: (-)-carvone is spearmint, while its mirror image, (+)-carvone, is caraway and dill. Your nose can tell left from right."),
    7163: (formula: "C8H11NO3", state: Solid, description: "Vitamin B6, isolated in 1938. The body turns it into pyridoxal phosphate, the helper molecule of more than a hundred enzymes that handle amino acids."),
    7165: (formula: "C7H7NO2", state: Solid, description: "The amide of salicylic acid: a mild painkiller and fever reducer, once sold over the counter, often alongside aspirin and caffeine."),
    7274: (formula: "C4H4N2O3", state: Solid),
    7275: (formula: "CH4O", state: Liquid),
    7276: (formula: "C3H8O", state: Liquid),
    7277: (formula: "C3H6O", state: Liquid),
    7278: (formula: "CHCl3", state: Liquid),
    7279: (formula: "C2H6OS", state: Liquid),
    7284: (formula: "C27H44O", state: Solid, description: "Cholecalciferol, made in the skin when sunlight's UVB opens a ring of 7-dehydrocholesterol. Windaus (Nobel 1928) found it by irradiating sterols.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Cholecalciferol")]),
    7368: (formula: "C20H30O", state: Solid, description: "Vitamin A1, the vitamin of vision: the eye uses its close relative, retinal, to catch light. First synthesised in 1947 by Otto Isler at Roche."),
    7590: (formula: "C16H19N3O4S", state: Solid, description: "A penicillin with one extra amino group that gets it into many more kinds of bacteria. Beecham launched it in 1961 as the first broad-spectrum penicillin."),
    7591: (formula: "C6H14O6", state: Solid, description: "A sugar alcohol first isolated from the sap of the manna ash, hence the name: a low-calorie sweetener, and a medicine that draws water out of swollen tissue."),
    7592: (formula: "C12H22O11", state: Solid),
    7594: (formula: "C5H4N4O2", state: Solid),
    7610: (formula: "C4H6O5", state: Solid, properties: [IsAcid]),
    7690: (formula: "C3H8O", state: Liquid),
    7691: (formula: "Co(C2H3O2)2", state: Solid),
    7695: (formula: "C41H64O13", state: Solid),
    7732: (formula: "NaC3H5O3", state: Solid, description: "The sodium salt of lactic acid, with a mild salty taste: a preservative and moisturiser (E325), and the lactate in the Ringer's lactate drip given in hospitals."),
    7733: (name: "Valine", formula: "C5H11NO2", state: Solid, description: "An essential amino acid with a branched side chain, named after valeric acid. One valine in place of glutamic acid in haemoglobin is what causes sickle-cell disease."),
    7734: (name: "Threonine", formula: "C4H9NO3", state: Solid, description: "The last of the twenty common amino acids to be found, by William Rose in 1935. It completed the list of amino acids our food must provide."),
    7752: (name: "beta-Carotene", formula: "C40H56", state: Solid, description: "The orange pigment of carrots, named after them. The body splits each molecule into two of vitamin A."),
    7778: (formula: "C5H5N5", state: Solid, description: "The A of DNA, always paired with thymine, and the core of ATP, the cell's energy currency. In 1960 Joan Oro made it from nothing but hydrogen cyanide and ammonia."),
    7780: (name: "Isoleucine", formula: "C6H13NO2", state: Solid, description: "An essential amino acid, an isomer of leucine, discovered by Felix Ehrlich in 1903 in sugar-beet molasses."),
    7829: (name: "Arginine", formula: "C6H14N4O2", state: Solid),
    7830: (formula: "CH3Br", state: Gas),
    7831: (formula: "C2H2", state: Gas),
    7832: (formula: "CH3Cl", state: Gas),
    7833: (formula: "CH3I", state: Liquid),
    7834: (formula: "CH5N", state: Gas, properties: [IsBase]),
    7835: (formula: "HCN", state: Gas),
    7836: (formula: "CH4S", state: Gas),
    7837: (formula: "C3H4", state: Gas),
    7853: (formula: "SO3", state: Gas),
    7855: (name: "Aluminium Chloride", formula: "AlCl3", state: Solid),
    7857: (formula: "KCl", state: Solid),
    7858: (formula: "LiCl", state: Solid, description: "A salt so hygroscopic it pulls water from air. Electrolysed molten, it yields lithium metal (Bunsen and Matthiessen, 1855).", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Lithium_chloride")]),
    7870: (formula: "SnSO4", state: Solid),
    7876: (formula: "C2H3Cl", state: Gas, properties: [IsMonomer]),
    7879: (formula: "C2H7N", state: Gas, properties: [IsBase]),
    7880: (formula: "C2H3N", state: Liquid),
    7881: (formula: "C2H4O", state: Liquid),
    7882: (formula: "C2H6S", state: Liquid),
    7885: (formula: "CH3NO", state: Liquid),
    7886: (formula: "CS2", state: Liquid),
    7887: (formula: "C2H6S", state: Liquid),
    7888: (formula: "C2H4O", state: Gas),
    7889: (formula: "Al2(CH3)6", state: Liquid, description: "Trimethylaluminium, a liquid that bursts into flame in air: a co-catalyst for Ziegler-Natta polymerisation, and the aluminium source for growing semiconductor crystal layers."),
    7891: (formula: "C4H10", state: Gas),
    7896: (formula: "C2H3ClO", state: Liquid),
    7899: (formula: "COCl2", state: Gas),
    7900: (name: "Freon-22", formula: "CHClF2", state: Gas, description: "R-22: for decades the commonest refrigerant in air conditioners, and the raw material for tetrafluoroethylene. Gentler on ozone than the CFCs it replaced, it is now phased out too."),
    7915: (name: "Freon-12", formula: "CCl2F2", state: Gas),
    7922: (formula: "C2HCl3O", state: Liquid, description: "Trichloroacetaldehyde, made by Liebig in 1832 by passing chlorine through alcohol.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Chloral")]),
    7932: (formula: "C24H36O5", state: Solid),
    7941: (formula: "LiBr", state: Solid),
    7958: (formula: "LiH", state: Solid),
    7985: (formula: "Na3PO4", state: Solid),
    7986: (formula: "NaClO4", state: Solid, description: "Made by electrolysing sodium chlorate further; the starting point of every other perchlorate.", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Sodium_perchlorate")]),
    7987: (formula: "HClO4", state: Liquid),
    8004: (formula: "NaHSO3", state: Solid, description: "Sodium bisulfite: a reducing agent and preservative (E222) that strips chlorine from water and stops wine and dried fruit from browning."),
    8005: (formula: "NaNO3", state: Solid),
    8007: (formula: "NaNO2", state: Solid),
    8015: (formula: "NaH", state: Solid),
    8032: (formula: "KI", state: Solid),
    8033: (formula: "NaHSO4", state: Solid),
    8034: (formula: "NaF", state: Solid),
    8035: (formula: "NaClO", state: Aqueous),
    8064: (formula: "C10H12", state: Liquid),
    8065: (formula: "C2H6O4S", state: Liquid),
    8072: (formula: "C6H8O7", state: Solid, properties: [IsAcid]),
    8080: (formula: "PCl3", state: Liquid),
    8081: (formula: "FeSO4", state: Solid),
    8083: (formula: "H2O2", state: Liquid),
    8085: (formula: "BaSO4", state: Solid),
