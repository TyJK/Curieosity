    777: (name: "Low-Density Lipoprotein", formula: "mixture", state: Liquid, molar_mass_g_mol: 12.011, color_hex: "#e0b850", description: "The particles that carry cholesterol out to the body's cells; high levels clog arteries ('bad cholesterol').", references: [("Wikipedia", "https://en.wikipedia.org/wiki/Low-density_lipoprotein")]),
