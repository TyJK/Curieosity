    6315: (formula: "Ag2CO3", state: Solid),
    6328: (formula: "Ce2(CO3)3", state: Solid, description: "Cerium(III) carbonate: a white powder that is a convenient start for other cerium compounds. Heated, it leaves ceria, the polish that finishes lenses and glass."),
