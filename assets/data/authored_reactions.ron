        (on: 300, grant: [54, 59, 61, 48, 6597, 390, 405, 289, 290, 296, 400], message: Some("Oil of vitriol. The alchemists' cabinet fills with strange salts.")),
        (on: 332, unlock: [Flask], message: Some("Aqua fortis eats metal and stone; only glass can hold it. The Glass Flask is unlocked.")),
        (on: 1015, grant: [312, 136, 65, 77, 78, 80, 83, 84, 85, 780], message: Some("Brand's phosphorus ends the age of alchemy. Coal, air and the mineral cabinets of the new chemists.")),
