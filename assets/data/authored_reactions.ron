        (on: 313, unlock: [BlastFurnace], message: Some("Abraham Darby's coke (1709) burns hot enough to smelt iron by the ton: the Blast Furnace is unlocked.")),
        (on: 316, unlock: [Pressurize], grant: [90, 92, 94, 97, 99, 125, 128, 283], message: Some("Coke iron makes boilers: Papin's digester becomes the Autoclave, and the mines go deeper.")),
        (on: 322, unlock: [Polymerize], message: Some("Goodyear's rubber: long chains are a material of their own. Polymerisation unlocked.")),
        (on: 1, grant: [124, 408, 409, 411, 412, 417, 416, 418], message: Some("Cavendish's inflammable air. The hunt for new elements begins in earnest.")),
        (on: 1017, grant: [319, 131, 89, 406, 407, 444, 445, 737], message: Some("Scheele's chlorine bleaches linen, and chemists start taking apart animal and vegetable matter.")),
        (on: 311, unlock: [Electrolysis], message: Some("Volta's pile: electricity tears compounds apart. Electrolysis unlocked.")),
        (on: 1053, grant: [395, 396, 397, 398, 399, 401, 402, 403, 404, 1274, 1453, 1468], message: Some("Courtois's iodine came out of seaweed: plants hide elements, and medicines too. The apothecaries send their herbs.")),
        (on: 1078, unlock: [Catalysis], message: Some("Platinum makes reactions go without being used up. Catalysis unlocked.")),
        (on: 501, unlock: [AirLiquefier], message: Some("Thilorier's dry ice at -78 C. The race to liquefy every gas has begun: the Air Liquefier is unlocked.")),
        (on: 1002, unlock: [Cryostat], message: Some("Ramsay's helium is the last gas nobody has liquefied. Dewar in London and Kamerlingh Onnes in Leiden race to reach it, with nested vacuum flasks cooled stage by stage: the Cryostat is unlocked.")),
        (on: 336, unlock: [Column], message: Some("Charles Mansfield fractionates coal tar into pure benzene (1849): the Fractionating Column is unlocked.")),
        (on: 6588, grant: [5922, 285, 394, 446, 449, 456, 459, 461], message: Some("Wohler's urea: organic chemistry is just chemistry. The apothecary's shelf opens.")),
        (on: 3250, grant: [462, 464, 460, 467, 468, 469, 470, 471, 472, 473, 474], message: Some("Quinine from cinchona bark: chemists race to extract every plant's secret.")),
        (on: 510, unlock: [ElectrolyticCell], grant: [169, 142, 3282, 1528], message: Some("Siemens' dynamo makes electricity by the ton: the Electrolytic Cell is unlocked, and oil, bauxite, copper ore and gold telluride are worth digging.")),
        (on: 3704, grant: [158, 284, 410, 413, 414, 415, 765], message: Some("Solvay's ammonia soda (1861) founds the heavy chemical industry.")),
        (on: 1009, unlock: [ArcFurnace], message: Some("Henri Moissan isolated fluorine (1886); his electric arc furnace (1892) reaches 3,500 C. The Arc Furnace is unlocked.")),
        (on: 170, unlock: [Cracker], message: Some("Gasoline for the motor car. Catalytic crackers will make more of it from heavy oil: the Catalytic Cracker is unlocked.")),
        (on: 178, unlock: [HighPressure], message: Some("Alloy steel strong enough to hold 200 atmospheres: the High-Pressure Reactor is unlocked.")),
        (on: 373, grant: [447, 458, 465, 457, 463, 1358, 1359, 1360, 1361], message: Some("Bayer's aspirin (1899): the pharmaceutical industry is born.")),
        (on: 343, grant: [182, 199, 243], message: Some("The age of plastics. Natural gas and rutile arrive.")),
        (on: 2980, message: Some("Tiemann and Haarmann's synthetic vanilla (1874): the flavour industry learns to make what plants make.")),
        (on: 438, message: Some("Welsbach's thorium mantle (1891) turns a gas flame into brilliant white light: the rare earths find their first use.")),
        (on: 3652, message: Some("Kikunae Ikeda tastes kombu broth and names a fifth taste, umami (1908).")),
        (on: 544, message: Some("Gassner's dry cell (1886): electricity you can carry in your pocket.")),
        (on: 515, message: Some("Moissan's carbides: in the arc furnace almost anything will combine with carbon, and the results are nearly as hard as diamond.")),
        (on: 371, grant: [429, 451, 452, 453], message: Some("ICI's polythene (1933), found by accident at 1,400 atmospheres. Meanwhile biochemists hunt the vitamins in bran, egg and spinach.")),
        (on: 376, message: Some("Carothers' nylon (1935): 'as strong as steel, as fine as a spider's web'. Stockings sold out in a day in 1940.")),
        (on: 7013, unlock: [Bioreactor], grant: [231, 233, 486, 487, 489, 766], message: Some("The sulfa drugs work, and Florey and Chain need penicillin by the vat: the Bioreactor is unlocked.")),
        (on: 6060, grant: [454, 455, 466, 488], message: Some("Szent-Gyorgyi and Reichstein's vitamin C (1933): the hunt for every vitamin is on.")),
        (on: 591, unlock: [DiamondPress], message: Some("Cemented carbide anvils hold 50,000 atmospheres: the Diamond Press is unlocked.")),
        (on: 234, unlock: [CrystalPuller], message: Some("Silicon pure to one part in a billion. Teal's Crystal Puller grows it into one flawless crystal.")),
        (on: 238, unlock: [CvdChamber], grant: [278, 274, 256, 272], message: Some("The transistor (1947). The silicon age opens: the CVD Chamber is unlocked.")),
        (on: 1092, unlock: [NuclearReactor], message: Some("Uranium metal for Fermi's pile (Chicago, 2 December 1942): the Nuclear Reactor is unlocked.")),
        (on: 1093, unlock: [Cyclotron], message: Some("Neptunium, the first element beyond uranium. Lawrence's cyclotron will reach further: the Cyclotron is unlocked.")),
        (on: 6607, message: Some("Streptomycin cures tuberculosis (1944): the golden age of antibiotics, dug out of the soil.")),
        (on: 585, message: Some("Atalla and Kahng's MOSFET (1959). Every chip ever since is built from it.")),
        (on: 281, message: Some("The microprocessor (Intel 4004, 1971): 2,300 transistors on a chip. Today's carry tens of billions.")),
        (on: 260, message: Some("The blue LED (Akasaki, Amano, Nakamura, 1993; Nobel 2014). White light from a diode at last.")),
        (on: 601, message: Some("Human insulin from bacteria (1978): biology becomes a factory.")),
        (on: 1118, message: Some("Oganesson (Dubna, 2002; named 2016): the seventh row of the periodic table is complete.")),
        (on: 767, unlock: [Centrifuge], message: Some("Steam sugar mills spin their syrup in perforated baskets to throw off the molasses, and Gustaf de Laval does the same to milk: the Centrifuge is unlocked.")),
        (on: 773, unlock: [Ultracentrifuge], message: Some("Theodor Svedberg's ultracentrifuge (1924; Nobel Prize 1926) spins hard enough to weigh a protein molecule: the Ultracentrifuge is unlocked.")),
        (on: 733, message: Some("Henkel's Persil (1907): perborate and silicate, the first washing powder that bleached by itself.")),
        (on: 2113, message: Some("Otto Bayer's polyurethanes (1937): two isocyanate groups meet a polyol, and foam rises in the mould.")),
        (on: 8793, message: Some("2,4-D (1946), the first selective weedkiller: it kills the weeds and spares the wheat.")),
        (on: 8562, message: Some("Walter Reppe's acetylene chemistry under pressure opens the vinyl monomers. Polyvinylpyrrolidone even stood in for blood plasma in the war.")),
        (on: 6817, message: Some("EDTA (Ferdinand Munz, 1935): a molecule that wraps around a metal ion and won't let go.")),
        (on: 3415, message: Some("DEET (1946): the US Army's answer to jungle mosquitoes, still the standard insect repellent.")),
        (on: 2992, message: Some("RDX, a medicine in 1898, became Britain's 'Research Department Explosive' in the Second World War.")),
        (on: 7917, message: Some("Tetramethylsilane becomes the zero of the NMR scale (1958): chemists read molecules by their nuclei.")),
        (on: 7680, message: Some("Harry Coover's cyanoacrylate (1951) was rejected for sticking to everything; in 1958 it went on sale as superglue.")),
        (on: 7270, message: Some("Gadolinium held tight in DTPA (1988): the first MRI contrast agent lights up blood vessels and tumours.")),
        (on: 6536, message: Some("Sucralose (1976): a student told to 'test' a chlorinated sugar thought he had been told to taste it.")),
        (on: 3037, message: Some("Perfume goes synthetic: Galaxolide (1965), Hedione (1962) and their kin are now the backbone of every fragrance, from fine perfume to washing powder.")),
        (on: 2219, message: Some("Gerhard Domagk's red dye Prontosil (1932) cured streptococcal infections; the dye half turned out not to matter. The sulfa drugs were the first antibacterials.")),
        (on: 4014, message: Some("Unleaded petrol (1975 on) needs its octane from somewhere: the refinery ethers fill the gap.")),
        (on: 4271, message: Some("Synthetic biology: engineered yeast turns cane sugar into farnesene, a jet fuel and a rubber monomer.")),
        (on: 8597, message: Some("Kapton (DuPont, 1960s): polyimide film from pyromellitic dianhydride shrugs off 400 C and near absolute zero, and flew on Apollo.")),
        (on: 8334, message: Some("The Montreal Protocol (1987) phases out the ozone-eating CFCs; HFC-134a cools the world's cars and fridges instead.")),
        (on: 819, message: Some("Guerlain's Mitsouko (1919) wrapped a synthetic peach lactone in oakmoss; two years later Chanel No. 5 did the same with aldehydes. Perfume becomes chemistry.")),
        (on: 8515, message: Some("Otto Wichterle's soft contact lens (1961): a gel of poly-HEMA that drinks water, cast on a machine he built from a children's construction set.")),
        (on: 6267, message: Some("Plastics that survive the sun: hindered amines (1970s) catch the radicals that light makes, and are given back to catch more.")),
        (on: 2564, message: Some("Butyllithium starts the 'living' anionic polymerisations Michael Szwarc described in 1956: chains that grow until told to stop, and so the block copolymers of shoe soles and road asphalt.")),
        (on: 972, message: Some("Ceramic magnets: Philips' barium ferrite (1952) is cheap, never rusts and holds its field, so it went on every fridge door and into every loudspeaker.")),
        (on: 8160, message: Some("Periodate cuts a carbon chain wherever two hydroxyls sit side by side (Malaprade, 1928): the cut pieces told chemists how sugars are built.")),
        (on: 5068, message: Some("Imidazole is the ring of histidine, which passes protons back and forth in the active sites of enzymes; in industry it cures epoxies.")),
        (on: 973, message: Some("A ripening hormone in a bottle: ethephon gives plants ethylene on demand, and cotton fields open all at once for the picker.")),
        (on: 1167, message: Some("A branch in the chain keeps a fatty acid liquid: isostearic acid is as stable as stearic acid without setting into wax.")),
        (on: 1178, message: Some("Diuron (DCMU) blocks photosystem II at one exact point, so plant scientists use it to switch photosynthesis off where they choose.")),
        (on: 6120, message: Some("One fluorine atom where a hydrogen should be: cancer cells mistake fluorouracil for uracil and jam their own DNA synthesis (Heidelberger, 1957).")),
        (on: 1292, message: Some("Mobil's ZSM-5 zeolite (1972) crystallises around tetrapropylammonium ions; the channels they leave later turned methanol into petrol in New Zealand.")),
        (on: 6672, message: Some("Merck's chlorothiazide (1958), the first thiazide diuretic: high blood pressure became a thing a daily pill could treat.")),
        (on: 4457, message: Some("Carbazole dioxazine violet: so strong that a pinch tints a can of paint, and the base of nearly every purple you see.")),
        (on: 4305, message: Some("Tartrazine (1884): a coal-tar yellow that became the most familiar food colour in the world.")),
        (on: 1498, message: Some("Ambrox (Firmenich, 1950): the scent of ambergris, which sperm whales make, rebuilt from a herb.")),
        (on: 6367, message: Some("Isoniazid (1952): with streptomycin, tuberculosis, the great killer of the 1800s, becomes curable.")),
    ],
